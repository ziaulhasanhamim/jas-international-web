@inherits LayoutComponentBase
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities

<div class="min-h-screen bg-slate-50 lg:pl-64 w-full max-w-full overflow-x-hidden font-sans">
    <!-- Mobile Drawer Peer Toggle -->
    <input type="checkbox" id="mobile-nav-toggle" class="peer hidden" aria-hidden="true" />

    <!-- Backdrop Overlay for Mobile Drawer -->
    <label for="mobile-nav-toggle" class="fixed inset-0 z-40 bg-slate-950/60 backdrop-blur-xs transition-opacity duration-200 opacity-0 pointer-events-none peer-checked:opacity-100 peer-checked:pointer-events-auto lg:hidden" aria-hidden="true"></label>

    <aside class="sidebar fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] -translate-x-full peer-checked:translate-x-0 transition-transform duration-200 ease-in-out overflow-y-auto lg:translate-x-0 lg:fixed lg:inset-y-0 lg:left-0 lg:z-20 lg:w-64 lg:border-r lg:border-slate-800 lg:overflow-y-auto flex flex-col justify-between">
        <div>
            <div class="flex items-center justify-between px-6 py-6 border-b border-white/10">
                <a href="/admin" class="flex items-center gap-3">
                    <img src="/jas-logo.png" alt="JAS International logo" class="size-11 rounded-xl shadow-md" />
                    <span class="text-base font-bold tracking-tight text-white block">
                        JAS Int.
                        <span class="mt-0.5 block text-[10px] font-medium tracking-[0.18em] text-slate-400 uppercase">Command Center</span>
                    </span>
                </a>
                <label for="mobile-nav-toggle" class="lg:hidden text-slate-400 hover:text-white p-2 cursor-pointer text-lg" aria-label="Close navigation">✕</label>
            </div>

            <AdminNavigation />
        </div>

        <div class="p-4 border-t border-white/10 flex flex-col gap-2">
            <a href="/" target="_blank" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-colors">
                <span class="flex items-center gap-2">
                    <Icon Name="arrow" Class="size-3.5 rotate-[-45deg] text-blue-400" />
                    View Storefront
                </span>
                <span class="text-[10px] bg-blue-500/20 text-blue-300 px-2 py-0.5 rounded-full">Live</span>
            </a>
            <div class="px-3 pt-2 text-[11px] text-slate-400 flex items-center justify-between">
                <span>JAS Int. © @DateTime.UtcNow.Year</span>
                <a href="https://github.com/ziaulhasanhamim" target="_blank" rel="noopener noreferrer" class="font-medium text-slate-400 hover:text-white transition-colors" title="Developer: Ziaul Hasan Hamim">
                    Ziaul Hasan Hamim
                </a>
            </div>
        </div>
    </aside>

    <div class="flex flex-col min-h-screen">
        <header class="flex h-16 sm:h-18 items-center justify-between border-b border-slate-200 bg-white px-4 sm:px-6 lg:px-8 w-full sticky top-0 z-30 shadow-xs">
            <div class="flex items-center gap-2 sm:gap-4 min-w-0">
                <label for="mobile-nav-toggle" class="icon-button shrink-0 lg:hidden cursor-pointer" aria-label="Open menu" title="Open menu">
                    <Icon Name="dashboard" Class="size-5 text-slate-700" />
                </label>
                <div class="flex items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 ring-1 ring-emerald-600/20">
                        <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        E-Commerce Live
                    </span>
                    <span class="text-xs text-slate-400 hidden sm:inline">|</span>
                    <span class="text-xs font-medium text-slate-500 tracking-wider uppercase hidden sm:inline">Khulna Central Hub</span>
                </div>
            </div>

            <div class="flex items-center gap-3 sm:gap-4 shrink-0">
                <AuthorizeView>
                    <Authorized Context="state">
                        <div class="flex items-center gap-3">
                            <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-tr from-blue-600 to-indigo-600 text-xs font-bold text-white shadow-xs">
                                @(state.User.Identity?.Name?.FirstOrDefault().ToString().ToUpperInvariant() ?? "A")
                            </span>
                            <div class="hidden sm:block text-left">
                                <span class="block text-xs font-semibold text-slate-800 leading-tight">@(state.User.Identity?.Name ?? "Administrator")</span>
                                <span class="block text-[10px] text-slate-500 font-medium uppercase tracking-wider">Store Admin</span>
                            </div>
                            <a href="/account/logout" class="icon-button text-slate-500 hover:text-red-600 hover:bg-red-50" title="Sign out" aria-label="Sign out">
                                <Icon Name="logout" Class="size-4" />
                            </a>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto w-full">
            @if (QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query).TryGetValue("saved", out var saved) && saved == "true")
            {
                <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800 shadow-xs" role="status">
                    <Icon Name="check" Class="size-5 text-emerald-600 shrink-0" />
                    <span class="font-medium">Success!</span> Changes were saved successfully.
                </div>
            }
            @Body
        </main>

        <footer class="border-t border-slate-200 bg-white px-4 py-4 text-xs text-slate-400 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-2">
            <span>JAS International E-Commerce Management Hub · System version 2.0</span>
            <span>Developed by <a href="https://github.com/ziaulhasanhamim" target="_blank" rel="noopener noreferrer" class="font-semibold text-slate-600 hover:text-blue-600 transition-colors">Ziaul Hasan Hamim</a></span>
        </footer>
    </div>
</div>
