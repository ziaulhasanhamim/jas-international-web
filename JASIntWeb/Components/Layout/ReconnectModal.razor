@inject NavigationManager Nav

<div
    id="components-reconnect-modal"
    class="components-reconnect-hide"
    role="alert"
    aria-live="assertive"
    data-nosnippet
>
    <div class="reconnect-card">
        <h2>Connection interrupted</h2>
        <p>Reconnecting to the store. If the connection does not return, reload this page.</p>
        <a href="@Nav.Uri" data-enhance-nav="false" class="shop-button">Reload page</a>
    </div>
</div>
