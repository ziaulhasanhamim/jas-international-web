<div id="jas-cart-drawer" class="fixed inset-0 z-[100] pointer-events-none transition-all duration-300" aria-hidden="true">
    <!-- Backdrop overlay -->
    <div id="jas-cart-backdrop"
         data-overlay-backdrop
         data-overlay-close="jas-cart-drawer"
         class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs opacity-0 transition-opacity duration-300 pointer-events-none cursor-pointer">
    </div>

    <!-- Slide-over drawer panel -->
    <aside id="jas-cart-panel"
           data-overlay-panel
           role="dialog"
           aria-modal="true"
           aria-label="Shopping Cart"
           class="fixed top-0 right-0 bottom-0 z-10 flex h-full w-full max-w-md flex-col bg-white shadow-2xl transform translate-x-full transition-transform duration-300 ease-out pointer-events-none">
        
        <!-- Header -->
        <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
            <div class="flex items-center gap-2">
                <h2 class="text-lg font-bold text-slate-900">Shopping Cart</h2>
                <span data-cart-count class="rounded-full bg-blue-100 px-2 py-0.5 text-xs font-bold text-blue-700">0</span>
            </div>
            <button type="button"
                    data-overlay-close="jas-cart-drawer"
                    class="size-8 rounded-full hover:bg-slate-100 text-slate-500 hover:text-slate-900 flex items-center justify-center font-bold text-sm transition cursor-pointer"
                    aria-label="Close cart">
                ✕
            </button>
        </div>

        <!-- Free Delivery Progress Bar -->
        <div id="jas-cart-drawer-delivery" class="border-b border-slate-100 bg-slate-50 px-6 py-3">
            <div class="flex items-center justify-between text-[11px] mb-1.5 font-medium">
                <span id="jas-cart-drawer-delivery-text" class="text-slate-600">Add <strong class="text-blue-600 font-bold">৳5,000</strong> for Free Delivery</span>
                <span id="jas-cart-drawer-delivery-pct" class="font-bold text-slate-500">0%</span>
            </div>
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-slate-200">
                <div id="jas-cart-drawer-delivery-bar" class="h-full bg-blue-600 transition-all duration-300" style="width: 0%"></div>
            </div>
        </div>

        <!-- Scrollable Items Container (Populated by modules/cart-drawer.js) -->
        <div id="jas-cart-drawer-items" class="flex-1 overflow-y-auto px-6 py-4 space-y-3">
            <div class="py-16 text-center text-slate-400 text-xs flex items-center justify-center gap-2">
                <span class="size-2 rounded-full bg-blue-600 animate-ping"></span>
                <span>Loading cart…</span>
            </div>
        </div>

        <!-- Sticky Footer -->
        <div id="jas-cart-drawer-footer" class="border-t border-slate-200 bg-slate-50/90 p-5 space-y-3">
            <div class="flex items-center justify-between text-sm">
                <span class="text-slate-600 font-medium">Subtotal</span>
                <strong id="jas-cart-drawer-subtotal" class="font-extrabold text-slate-900 text-base tabular-nums">৳0</strong>
            </div>
            <p class="text-[11px] text-slate-500">Shipping &amp; delivery calculated during checkout.</p>
            <div class="space-y-2 pt-1">
                <a href="/checkout" class="btn-primary w-full py-3 text-xs sm:text-sm font-bold flex items-center justify-center gap-2 shadow-sm">
                    <span>Proceed to Checkout</span>
                    <span>→</span>
                </a>
                <a href="/cart" class="btn-secondary w-full py-2 text-xs font-semibold flex items-center justify-center text-slate-700">
                    View Full Cart
                </a>
            </div>
        </div>
    </aside>
</div>
