@inherits LayoutComponentBase
@using JASIntWeb.Endpoints
@using JASIntWeb.Persistence
@using JASIntWeb.Persistence.Entities
@using JASIntWeb.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

<div class="min-h-screen flex flex-col">
    <SiteHeader InitialCartCount="@initialCartCount" />
    <main class="flex-1 pb-[calc(4.75rem+env(safe-area-inset-bottom,0px))] md:pb-0">@Body</main>
    <CartDrawer />
    <FloatingSupportWidget />
    <CookieConsentBanner />
    <SiteFooter />
</div>
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private int initialCartCount;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext != null)
        {
            var (token, userId) = CartEndpoints.ResolveCartIdentity(HttpContext);
            if (userId.HasValue || token.HasValue)
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                if (userId.HasValue)
                {
                    initialCartCount = await db.CartItems.AsNoTracking()
                        .Where(i => i.Cart.UserId == userId.Value && i.Cart.Status == CartStatus.Active)
                        .SumAsync(i => (int?)i.Quantity) ?? 0;
                }
                if (initialCartCount == 0 && token.HasValue)
                {
                    initialCartCount = await db.CartItems.AsNoTracking()
                        .Where(i => i.Cart.Token == token.Value && i.Cart.Status == CartStatus.Active)
                        .SumAsync(i => (int?)i.Quantity) ?? 0;
                }
            }
        }
    }
}
