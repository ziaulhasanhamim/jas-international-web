<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
        <meta name="theme-color" content="#0f172a" />
        <base href="/" />
        <HeadOutlet />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <ResourcePreloader />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Space+Grotesk:wght@500;600;700&display=swap"
            rel="stylesheet"
        />
        <link rel="stylesheet" href="@Assets["app.css"]" />
        <link rel="stylesheet" href="@Assets["JASIntWeb.styles.css"]" />
        <link rel="stylesheet" href="@Assets["css/output.css"]" />
        <link rel="stylesheet" href="@Assets["commerce.css"]" />
        <link rel="stylesheet" href="@Assets["confidence.css"]" />
        <MetaPixelTracking />
        <ImportMap />
    </head>
    <body data-enhance="true">
        <!-- High-Visibility Dual Navigation Indicator (Vibrant Top Bar + Floating Mobile Capsule) -->
        <div id="navigation-progress" class="navigation-progress" hidden>
            <div class="navigation-progress-bar"></div>
        </div>
        <div id="navigation-capsule" class="navigation-capsule" hidden>
            <span class="navigation-capsule-spinner"></span>
            <span class="navigation-capsule-text">Loading…</span>
        </div>
        <Routes />
        <ReconnectModal />
        <script src="@Assets["_framework/blazor.web.js"]"></script>
        <!-- Application Scripts (Modular Architecture - Non-blocking Deferred Execution) -->
        <script src="@Assets["js/modules/navigation.js"]" defer></script>
        <script src="@Assets["js/modules/device-orders.js"]" defer></script>
        <script src="@Assets["js/modules/carousel.js"]" defer></script>
        <script src="@Assets["js/modules/meta-tracking.js"]" defer></script>
        <script src="@Assets["js/modules/analytics.js"]" defer></script>
        <script type="module" src="@Assets["js/jas-app.js"]"></script>
    </body>
</html>
