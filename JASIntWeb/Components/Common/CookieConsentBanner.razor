@* Cookie Consent Banner - Non-blocking Static SSR compliant with vanilla JS *@
<div id="jas-cookie-consent" class="hidden fixed bottom-4 left-4 right-4 sm:left-auto sm:right-6 sm:max-w-md z-50 rounded-2xl border border-slate-200/90 bg-white/95 p-4 sm:p-5 shadow-2xl backdrop-blur-md transition-all duration-300">
    <div class="flex items-start gap-3">
        <div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
        </div>
        <div class="flex-1">
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Cookie &amp; Privacy Preferences</h3>
            <p class="mt-1 text-xs leading-relaxed text-slate-600">
                We use cookies and first-party identifiers to personalize your gadget shopping experience, measure ad performance, and secure your transactions.
                <a href="/privacy" class="font-semibold text-blue-600 underline hover:text-blue-700">Read Privacy Policy</a>.
            </p>
            <div class="mt-3.5 flex items-center gap-2">
                <button type="button" id="jas-consent-accept" class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-blue-700 transition">
                    Accept All
                </button>
                <button type="button" id="jas-consent-decline" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50 transition">
                    Essential Only
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function() {
        function checkConsent() {
            var banner = document.getElementById("jas-cookie-consent");
            if (!banner) return;
            var hasConsent = document.cookie.indexOf("jas_cookie_consent=") !== -1;
            if (!hasConsent) {
                banner.classList.remove("hidden");
            }
            var btnAccept = document.getElementById("jas-consent-accept");
            var btnDecline = document.getElementById("jas-consent-decline");
            if (btnAccept && !btnAccept._bound) {
                btnAccept._bound = true;
                btnAccept.addEventListener("click", function() {
                    document.cookie = "jas_cookie_consent=accepted; max-age=31536000; path=/; SameSite=Lax";
                    banner.classList.add("hidden");
                    if (window.JAS && window.JAS.MetaTracking) {
                        window.JAS.MetaTracking.init();
                    }
                });
            }
            if (btnDecline && !btnDecline._bound) {
                btnDecline._bound = true;
                btnDecline.addEventListener("click", function() {
                    document.cookie = "jas_cookie_consent=essential; max-age=31536000; path=/; SameSite=Lax";
                    banner.classList.add("hidden");
                });
            }
        }
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", checkConsent);
        } else {
            checkConsent();
        }
        document.addEventListener("blazor:enhancedload", checkConsent);
    })();
</script>
