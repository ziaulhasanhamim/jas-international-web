@using JASIntWeb.Services.Meta
@inject IMetaConversionsApiService MetaApi
@if (config is not null && config.Enabled && !string.IsNullOrWhiteSpace(config.PixelId))
{
    <meta name="jas-meta-pixel" content="@config.PixelId" />
}
@code {
    private MetaAdsConfig? config;
    protected override async Task OnInitializedAsync() => config = await MetaApi.GetEffectiveConfigAsync();
}
