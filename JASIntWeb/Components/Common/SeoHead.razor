@using JASIntWeb.Services
@using JASIntWeb.Services.Seo
@inject ISeoService Seo
@inject DeliverySettingsService DeliverySettingsSvc
@inject IConfiguration Config

@{
    var cleanTitle = string.IsNullOrWhiteSpace(Title) ? "JAS International - One Stop Tech Shop" : Title.Trim();
    var cleanDesc = Seo.SanitizeDescription(Description);
    var canonicalUrl = Seo.BuildCanonicalUrl(CanonicalPath ?? "/");
    var hasCustomImage = !string.IsNullOrWhiteSpace(OgImage);
    var ogImageUrl = Seo.BuildAbsoluteUrl(hasCustomImage ? OgImage! : "/jas-og-card.png");
    var imageAlt = !string.IsNullOrWhiteSpace(OgImageAlt) ? OgImageAlt.Trim() : $"JAS International — {cleanTitle}";
    var robotsDirective = string.IsNullOrWhiteSpace(Robots) ? "index,follow" : Robots.Trim();
    var imageWidth = OgImageWidth ?? (hasCustomImage ? (OgType == "product" ? 1000 : 1200) : 1200);
    var imageHeight = OgImageHeight ?? (hasCustomImage ? (OgType == "product" ? 1000 : 630) : 630);


    var gscVerification = !string.IsNullOrWhiteSpace(Config["Seo:GoogleSiteVerification"]) ? Config["Seo:GoogleSiteVerification"] : settings.GoogleSearchConsoleVerification;
    var metaDomainVerification = !string.IsNullOrWhiteSpace(Config["Seo:FacebookDomainVerification"]) ? Config["Seo:FacebookDomainVerification"] : settings.FacebookDomainVerification;
    var fbAppId = Config["Seo:FbAppId"];
}

<PageTitle>@cleanTitle</PageTitle>

<HeadContent>
    <meta name="description" content="@cleanDesc" />
    <meta name="robots" content="@robotsDirective" />
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph Metadata -->
    <meta property="og:site_name" content="JAS International" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:type" content="@(string.IsNullOrWhiteSpace(OgType) ? "website" : OgType)" />
    <meta property="og:title" content="@cleanTitle" />
    <meta property="og:description" content="@cleanDesc" />
    <meta property="og:image" content="@ogImageUrl" />
    <meta property="og:image:secure_url" content="@ogImageUrl" />
    <meta property="og:image:alt" content="@imageAlt" />
    <meta property="og:image:width" content="@imageWidth" />
    <meta property="og:image:height" content="@imageHeight" />
    @if (ogImageUrl.EndsWith(".webp", StringComparison.OrdinalIgnoreCase))
    {
        <meta property="og:image:type" content="image/webp" />
    }
    else if (ogImageUrl.EndsWith(".png", StringComparison.OrdinalIgnoreCase))
    {
        <meta property="og:image:type" content="image/png" />
    }
    else if (ogImageUrl.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || ogImageUrl.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase))
    {
        <meta property="og:image:type" content="image/jpeg" />
    }
    <meta property="og:locale" content="@(string.IsNullOrWhiteSpace(OgLocale) ? "en_US" : OgLocale)" />
    @if (!string.IsNullOrWhiteSpace(OgLocaleAlternate))
    {
        <meta property="og:locale:alternate" content="@OgLocaleAlternate" />
    }

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@@jasinternational" />
    <meta name="twitter:title" content="@cleanTitle" />
    <meta name="twitter:description" content="@cleanDesc" />
    <meta name="twitter:image" content="@ogImageUrl" />
    <meta name="twitter:image:alt" content="@imageAlt" />

    <!-- Product Open Graph & Twitter Product Data (iMessage, WhatsApp, Facebook, Slack, Telegram) -->
    @if (ProductPrice.HasValue)
    {
        <meta property="product:price:amount" content="@ProductPrice.Value.ToString("F2")" />
        <meta property="product:price:currency" content="@(ProductCurrency ?? "BDT")" />
        <meta property="og:price:amount" content="@ProductPrice.Value.ToString("F2")" />
        <meta property="og:price:currency" content="@(ProductCurrency ?? "BDT")" />
        <meta name="twitter:label1" content="Price" />
        <meta name="twitter:data1" content="৳@ProductPrice.Value.ToString("N0") BDT" />
    }
    @if (!string.IsNullOrWhiteSpace(ProductAvailability))
    {
        <meta property="product:availability" content="@ProductAvailability" />
        <meta name="twitter:label2" content="Availability" />
        <meta name="twitter:data2" content="@(ProductAvailability.Equals("in stock", StringComparison.OrdinalIgnoreCase) ? "In Stock" : "Out of Stock")" />
    }
    @if (!string.IsNullOrWhiteSpace(ProductBrand))
    {
        <meta property="product:brand" content="@ProductBrand" />
    }
    @if (!string.IsNullOrWhiteSpace(ProductRetailerItemId))
    {
        <meta property="product:retailer_item_id" content="@ProductRetailerItemId" />
    }

    <!-- Verification Meta Tags -->
    @if (!string.IsNullOrWhiteSpace(gscVerification))
    {
        <meta name="google-site-verification" content="@gscVerification" />
    }
    @if (!string.IsNullOrWhiteSpace(metaDomainVerification))
    {
        <meta name="facebook-domain-verification" content="@metaDomainVerification" />
    }
    @if (!string.IsNullOrWhiteSpace(fbAppId))
    {
        <meta property="fb:app_id" content="@fbAppId" />
    }

    <!-- Structured Data (JSON-LD) -->
    @if (JsonLd != null)
    {
        @foreach (var snippet in JsonLd)
        {
            if (!string.IsNullOrWhiteSpace(snippet))
            {
                <script type="application/ld+json">
                    @((MarkupString)snippet)
                </script>
            }
        }
    }
</HeadContent>

@code {
    private JASIntWeb.Persistence.Entities.DeliverySettings settings = new();
    protected override async Task OnInitializedAsync() => settings = await DeliverySettingsSvc.GetSettingsAsync();

    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? CanonicalPath { get; set; }
    [Parameter] public string? OgImage { get; set; }
    [Parameter] public string? OgImageAlt { get; set; }
    [Parameter] public int? OgImageWidth { get; set; }
    [Parameter] public int? OgImageHeight { get; set; }
    [Parameter] public string? OgType { get; set; } = "website";
    [Parameter] public string? OgLocale { get; set; } = "en_US";
    [Parameter] public string? OgLocaleAlternate { get; set; }
    [Parameter] public string? Robots { get; set; }
    [Parameter] public string? PrevUrl { get; set; }
    [Parameter] public string? NextUrl { get; set; }
    [Parameter] public IEnumerable<string>? JsonLd { get; set; }

    [Parameter] public decimal? ProductPrice { get; set; }
    [Parameter] public string? ProductCurrency { get; set; } = "BDT";
    [Parameter] public string? ProductAvailability { get; set; }
    [Parameter] public string? ProductBrand { get; set; }
    [Parameter] public string? ProductRetailerItemId { get; set; }
}
