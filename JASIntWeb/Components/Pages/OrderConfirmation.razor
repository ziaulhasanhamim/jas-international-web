@page "/order/{Token:guid}"
@rendermode InteractiveServer
@implements IDisposable
@using JASIntWeb.Persistence
@using JASIntWeb.Persistence.Entities
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Nav

<PageTitle>Order Confirmation · JAS International</PageTitle>

<div class="shop-container py-12 max-w-3xl mx-auto">
    @if (order is null)
    {
        <div class="rounded-3xl border border-slate-200/90 bg-white p-12 text-center shadow-xs">
            <Icon Name="alert" Class="size-12 text-slate-300 mx-auto mb-3" />
            <h1 class="text-2xl font-bold text-slate-900">Order Not Found</h1>
            <p class="text-xs text-slate-500 mt-2 mb-6">The requested order reference could not be located.</p>
            <a href="/products" class="btn-primary">Return to Catalog</a>
        </div>
    }
    else
    {
        <CheckoutCompleted CheckoutToken="order.CheckoutToken" OrderId="order.Id" OrderPublicToken="order.PublicToken" Total="order.Total" />

        var isPaymentVerified = order.PaidAmount > 0 && order.Payments.Any(p => p.Status == PaymentStatus.Completed);
        var hasSubmittedTrx = !string.IsNullOrEmpty(order.TransactionId);

        <div class="rounded-3xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
            <!-- Header Banner -->
            <div class="bg-gradient-to-r @(isPaymentVerified ? "from-emerald-600 to-teal-700" : "from-blue-600 to-indigo-800") p-8 text-white text-center">
                <span class="flex size-14 items-center justify-center rounded-full bg-white @(isPaymentVerified ? "text-emerald-600" : "text-blue-600") mx-auto mb-4 shadow-md">
                    @if (isPaymentVerified)
                    {
                        <Icon Name="check" Class="size-8" />
                    }
                    else
                    {
                        <svg class="size-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    }
                </span>

                <span class="text-xs font-bold uppercase tracking-widest text-emerald-100 block mb-1">
                    @if (isPaymentVerified)
                    {
                        <span>PAYMENT VERIFIED · PENDING ADMIN CONFIRMATION</span>
                    }
                    else if (hasSubmittedTrx)
                    {
                        <span>ORDER PLACED · AWAITING PAYMENT VERIFICATION</span>
                    }
                    else
                    {
                        <span>ORDER PLACED · PAYMENT REQUIRED</span>
                    }
                </span>

                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
                    @if (isPaymentVerified)
                    {
                        <span>Payment Verified!</span>
                    }
                    else
                    {
                        <span>Thank You! Order #@order.Id Placed</span>
                    }
                </h1>

                <p class="text-xs text-blue-100 mt-2 max-w-lg mx-auto">
                    @if (isPaymentVerified)
                    {
                        <span>Your bKash payment of ৳@order.PaidAmount.ToString("N0") has been verified. Order #@order.Id is reserved and queued for admin dispatch confirmation.</span>
                    }
                    else if (hasSubmittedTrx)
                    {
                        <span>We have recorded your bKash transaction (TrxID: <strong>@order.TransactionId</strong>). Verification is in progress. <strong>You can safely close this page or browse other products.</strong></span>
                    }
                    else
                    {
                        <span>Order #@order.Id has been registered. Please complete your bKash payment to initiate shipping.</span>
                    }
                </p>
            </div>

            <!-- Receipt Body -->
            <div class="p-6 sm:p-8 space-y-6">
                @if (newlyVerified)
                {
                    <div class="rounded-2xl border border-emerald-300 bg-emerald-50 p-4 text-xs text-emerald-900 flex items-start gap-3 shadow-xs animate-pulse" role="alert">
                        <span class="flex size-8 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white font-bold">
                            <Icon Name="check" Class="size-5" />
                        </span>
                        <div>
                            <strong class="font-bold text-emerald-950 block text-sm">Payment Verified Successfully!</strong>
                            <span class="text-emerald-800">Your bKash transaction has been verified. Your order is confirmed and queued for fulfillment.</span>
                        </div>
                    </div>
                }

                <!-- Delivery Info Card -->
                <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-xs">
                    <div>
                        <span class="text-slate-400 block font-medium">Deliver To:</span>
                        <strong class="text-slate-900 text-sm">@order.DeliveryAddress?.CustomerName</strong>
                        <p class="text-slate-600 mt-0.5 font-mono">@order.DeliveryAddress?.PhoneNumber</p>
                        @if (!string.IsNullOrEmpty(order.DeliveryAddress?.Email))
                        {
                            <p class="text-slate-500 font-sans">@order.DeliveryAddress?.Email</p>
                        }
                        <p class="text-slate-600 mt-1">@order.DeliveryAddress?.FullAddress</p>
                        <p class="text-slate-500 text-[11px]">@order.DeliveryAddress?.Thana, @order.DeliveryAddress?.District (@order.DeliveryAddress?.Division)</p>
                    </div>

                    <div class="sm:text-right border-t sm:border-t-0 pt-3 sm:pt-0 border-slate-200">
                        <span class="text-slate-400 block font-medium">Payment Mode:</span>
                        <strong class="text-slate-900 text-sm">
                            @(order.PaidAmount > 0 ? "Advance Paid (bKash)" : (hasSubmittedTrx ? "bKash Verification Pending" : "Cash on Delivery / Pending"))
                        </strong>
                        @if (!string.IsNullOrEmpty(order.PaymentReferenceCode))
                        {
                            <span class="block text-[11px] font-mono text-blue-600 mt-0.5">Ref: @order.PaymentReferenceCode</span>
                        }
                        @if (!string.IsNullOrEmpty(order.TransactionId))
                        {
                            <span class="block text-[11px] font-mono text-slate-500">TrxID: @order.TransactionId</span>
                        }
                        <div class="mt-2">
                            @if (isPaymentVerified)
                            {
                                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-700 ring-1 ring-emerald-600/20">
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span> Payment Verified (৳@order.PaidAmount.ToString("N0"))
                                </span>
                            }
                            else if (hasSubmittedTrx)
                            {
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-bold text-amber-700 ring-1 ring-amber-600/20 animate-pulse">
                                    <span class="size-1.5 rounded-full bg-amber-500"></span> Awaiting Payment Verification
                                </span>
                            }
                            else
                            {
                                <a href="/checkout/payment/@order.PublicToken" class="inline-flex items-center gap-1.5 rounded-full bg-blue-600 px-3 py-1.5 text-xs font-bold text-white shadow-xs hover:bg-blue-700 transition">
                                    <span>Complete bKash Payment →</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>

                @if (!isPaymentVerified && hasSubmittedTrx)
                {
                    <!-- Reassuring Information Notice -->
                    <div class="rounded-2xl border border-blue-200 bg-blue-50/70 p-4 text-xs text-blue-900 space-y-1.5">
                        <div class="flex items-center gap-2 font-bold text-blue-950 text-sm">
                            <span class="flex size-5 items-center justify-center rounded-full bg-blue-200 text-blue-800 text-xs font-bold">i</span>
                            <span>Payment Verification in Progress</span>
                        </div>
                        <p class="text-blue-900 text-xs">
                            Your transaction ID <strong class="font-mono text-slate-900">@order.TransactionId</strong> from sender <strong class="font-mono text-slate-900">@order.SenderPhoneNumber</strong> is recorded.
                            Our automated bKash SMS system or admin will verify your payment shortly.
                        </p>
                        <p class="text-blue-800 text-[11px] pt-1 border-t border-blue-200/60">
                            ✓ <strong>You can safely close this tab or browse other pages.</strong> Your item stock is secured.
                            @if (!string.IsNullOrEmpty(order.DeliveryAddress?.Email))
                            {
                                <span> An email confirmation will be sent to <strong>@order.DeliveryAddress?.Email</strong> once payment is verified.</span>
                            }
                        </p>
                        <div class="mt-2 pt-2 border-t border-blue-200/60 flex items-center gap-2 text-[11px] font-semibold text-blue-800">
                            <span class="relative flex size-2 shrink-0">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full size-2 bg-blue-600"></span>
                            </span>
                            <span>Auto-checking live verification… Leaving this page open will automatically update to your final verified receipt upon confirmation.</span>
                        </div>
                    </div>
                }

                <!-- Line Items Table -->
                <div class="border-t border-slate-100 pt-5">
                    <h3 class="font-bold text-slate-900 text-sm mb-3">Order Details</h3>
                    <div class="divide-y divide-slate-100">
                        @foreach (var item in order.Items)
                        {
                            <div class="py-3 flex items-center justify-between text-xs">
                                <div>
                                    <strong class="text-slate-900 block font-semibold">@item.ProductName</strong>
                                    <span class="text-slate-400">@item.VariantName · Qty: @item.Quantity</span>
                                </div>
                                <span class="font-semibold text-slate-900 tabular-nums">৳@item.LineTotal.ToString("N0")</span>
                            </div>
                        }
                    </div>

                    <!-- Totals -->
                    <div class="border-t border-slate-200 mt-4 pt-4 space-y-2 text-xs">
                        <div class="flex justify-between text-slate-600">
                            <span>Subtotal</span>
                            <span class="font-semibold text-slate-900 tabular-nums">৳@order.Subtotal.ToString("N0")</span>
                        </div>
                        <div class="flex justify-between text-slate-600">
                            <span>Delivery Fee</span>
                            <span class="font-semibold text-slate-900 tabular-nums">৳@order.DeliveryCharge.ToString("N0")</span>
                        </div>
                        @if (order.DiscountAmount > 0)
                        {
                            <div class="flex justify-between text-emerald-600 font-semibold">
                                <span>Coupon Discount (@order.CouponCode)</span>
                                <span class="tabular-nums">-৳@order.DiscountAmount.ToString("N0")</span>
                            </div>
                        }
                        <div class="border-t border-slate-200 pt-3 flex items-center justify-between text-base">
                            <span class="font-bold text-slate-900">Total Order Amount</span>
                            <span class="font-extrabold text-blue-600 text-xl tabular-nums">৳@order.Total.ToString("N0")</span>
                        </div>

                        <div class="rounded-xl bg-slate-50 border p-3 mt-2 text-[11px] space-y-1">
                            @if (isPaymentVerified)
                            {
                                <div class="flex justify-between text-slate-700">
                                    <span>Verified Paid Amount:</span>
                                    <strong class="text-emerald-600">৳@order.PaidAmount.ToString("N0")</strong>
                                </div>
                                <div class="flex justify-between text-slate-700">
                                    <span>Due on Delivery (Courier):</span>
                                    <strong class="text-slate-900">৳@Math.Max(0, order.Total - order.PaidAmount).ToString("N0")</strong>
                                </div>
                            }
                            else if (hasSubmittedTrx)
                            {
                                <div class="flex justify-between text-slate-700">
                                    <span>Payment Status:</span>
                                    <strong class="text-amber-600">Awaiting Verification</strong>
                                </div>
                                <div class="flex justify-between text-slate-500">
                                    <span>Claimed TrxID:</span>
                                    <span class="font-mono font-bold">@order.TransactionId</span>
                                </div>
                            }
                            else
                            {
                                <div class="flex justify-between text-slate-700">
                                    <span>Payment Status:</span>
                                    <strong class="text-rose-600">Unpaid</strong>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3">
                    <a href="/orders" class="btn-primary w-full sm:w-auto text-xs">
                        <Icon Name="receipt" Class="size-4" />
                        View Your Orders
                    </a>
                    <a href="/products" class="btn-secondary w-full sm:w-auto text-xs">
                        Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (order != null && !(order.PaidAmount > 0 && order.Payments.Any(p => p.Status == PaymentStatus.Completed)))
{
    <script>
        (function() {
            const token = "@Token";
            const pollId = setInterval(async () => {
                try {
                    const res = await fetch(`/api/orders/${token}/status`);
                    if (res.ok) {
                        const data = await res.json();
                        if (data && data.isPaymentVerified) {
                            clearInterval(pollId);
                            window.location.reload();
                        }
                    }
                } catch (e) {}
            }, 2500);
            window.addEventListener('beforeunload', () => clearInterval(pollId));
        })();
    </script>
}

@code
{
    [Parameter]
    public Guid Token { get; set; }
    private Order? order;
    private bool newlyVerified;
    private CancellationTokenSource? pollCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrderAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && order != null)
        {
            var isVerified = order.PaidAmount > 0 && order.Payments.Any(p => p.Status == PaymentStatus.Completed);
            if (!isVerified)
            {
                StartPolling();
            }
        }
    }

    private async Task LoadOrderAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        order = await db.Orders.AsNoTracking()
            .Include(o => o.Items)
            .Include(o => o.DeliveryAddress)
            .Include(o => o.Payments)
            .SingleOrDefaultAsync(o => o.PublicToken == Token);
    }

    private void StartPolling()
    {
        pollCts = new CancellationTokenSource();
        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2.5));
            while (!pollCts.IsCancellationRequested && await timer.WaitForNextTickAsync(pollCts.Token))
            {
                try
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
                    var status = await db.Orders.AsNoTracking()
                        .Where(o => o.PublicToken == Token)
                        .Select(o => new
                        {
                            o.PaidAmount,
                            o.Status,
                            IsVerified = o.PaidAmount > 0 && o.Payments.Any(p => p.Status == PaymentStatus.Completed)
                        })
                        .FirstOrDefaultAsync(pollCts.Token);

                    if (status != null && (status.IsVerified || status.PaidAmount > 0 || status.Status is OrderStatus.Processing or OrderStatus.InTransit or OrderStatus.Delivered))
                    {
                        pollCts.Cancel();
                        await InvokeAsync(async () =>
                        {
                            await LoadOrderAsync();
                            newlyVerified = true;
                            StateHasChanged();
                        });
                        break;
                    }
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch
                {
                    // Retry on next tick
                }
            }
        }, pollCts.Token);
    }

    public void Dispose()
    {
        pollCts?.Cancel();
        pollCts?.Dispose();
    }
}
