@page "/about"
@attribute [Microsoft.AspNetCore.OutputCaching.OutputCache(PolicyName = "StaticPages")]

<PageTitle>About Us · JAS International</PageTitle>

<div class="shop-container py-10 max-w-5xl mx-auto">
    <!-- Hero Section -->
    <div class="text-center mb-12">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700 ring-1 ring-blue-600/20 mb-3">
            SINCE ESTABLISHMENT
        </span>
        <h1 class="font-display text-3xl sm:text-5xl font-bold tracking-tight text-slate-900 mb-4">
            About JAS International
        </h1>
        <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto">
            Khulna's premier destination for genuine smartwatches, wireless audio, fast chargers, power banks, and premium gadget accessories.
        </p>
    </div>

    <!-- Story Card -->
    <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-10 shadow-xs mb-10">
        <div class="grid gap-8 lg:grid-cols-2 items-center">
            <div>
                <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-2">Our Story &amp; Commitment</span>
                <h2 class="text-2xl font-bold text-slate-900 mb-4">Delivering Authentic Tech With Local Support</h2>
                <p class="text-sm text-slate-600 leading-relaxed mb-4">
                    Founded with a passion for authentic consumer technology, <strong>JAS International</strong> is headquartered at the vibrant <strong>Khulna Shopping Complex (3rd Floor)</strong> in Khulna, Bangladesh. We recognized the need for a tech store that customers could trust implicitly—providing only 100% genuine products with manufacturer-backed warranties and dependable local post-sale service.
                </p>
                <p class="text-sm text-slate-600 leading-relaxed">
                    Whether you are shopping online for fast home delivery across Bangladesh or visiting our physical showroom in Khulna for hands-on device trials, our team is dedicated to providing honest advice, competitive pricing, and swift customer care.
                </p>
            </div>
            <div class="rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-950 to-blue-950 p-8 text-white flex flex-col justify-between aspect-video sm:aspect-auto sm:min-h-[300px]">
                <div>
                    <span class="inline-block px-2.5 py-1 rounded-full bg-blue-500/20 text-blue-300 text-xs font-semibold mb-4">
                        Khulna Flagship Showroom
                    </span>
                    <h3 class="text-xl font-bold mb-2">Visit Us In Person</h3>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        Shop #3xx, 3rd Floor, Khulna Shopping Complex, Dakbangla, Khulna, Bangladesh.
                    </p>
                </div>
                <div class="pt-6 border-t border-white/10 flex items-center justify-between">
                    <div>
                        <span class="text-[11px] text-slate-400 block">Customer Hotline &amp; Support</span>
                        <a href="tel:01711465078" class="text-base font-bold text-emerald-400 hover:underline">01711465078</a>
                        <a href="mailto:info@jasinternational.com.bd" class="block text-xs text-slate-300 hover:underline mt-0.5">info@jasinternational.com.bd</a>
                    </div>
                    <a href="/contact" class="btn-primary !bg-white !text-slate-950 hover:!bg-slate-100 !px-4 !py-2 text-xs">
                        Find Location
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Value Pillars -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 mb-12">
        <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
            <span class="flex size-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600 mb-4">
                <Icon Name="shield" Class="size-6" />
            </span>
            <h3 class="font-bold text-slate-900 text-sm mb-1.5">100% Genuine Products</h3>
            <p class="text-xs text-slate-500 leading-relaxed">Every item in our store is original, brand new, and sourced from authorized global distributors.</p>
        </div>

        <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
            <span class="flex size-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 mb-4">
                <Icon Name="check" Class="size-6" />
            </span>
            <h3 class="font-bold text-slate-900 text-sm mb-1.5">7-Day Replacement</h3>
            <p class="text-xs text-slate-500 leading-relaxed">Peace of mind guaranteed. If your item has an out-of-box hardware defect, we replace it hassle-free.</p>
        </div>

        <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
            <span class="flex size-11 items-center justify-center rounded-xl bg-purple-50 text-purple-600 mb-4">
                <Icon Name="truck" Class="size-6" />
            </span>
            <h3 class="font-bold text-slate-900 text-sm mb-1.5">Fast Nationwide Delivery</h3>
            <p class="text-xs text-slate-500 leading-relaxed">Same-day/next-day delivery in Khulna city and 2-4 days express delivery nationwide with Cash on Delivery.</p>
        </div>

        <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
            <span class="flex size-11 items-center justify-center rounded-xl bg-amber-50 text-amber-600 mb-4">
                <Icon Name="phone" Class="size-6" />
            </span>
            <h3 class="font-bold text-slate-900 text-sm mb-1.5">Dedicated Support</h3>
            <p class="text-xs text-slate-500 leading-relaxed">Have questions about compatibility or warranty? Reach out directly via phone or WhatsApp.</p>
        </div>
    </div>
</div>
