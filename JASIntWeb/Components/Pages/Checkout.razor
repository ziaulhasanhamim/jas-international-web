@page "/checkout"
@rendermode InteractiveServer
@using JASIntWeb.Services
@using JASIntWeb.Client.Services
@using JASIntWeb.Client.Contracts
@using JASIntWeb.Persistence
@using JASIntWeb.Persistence.Entities
@using Microsoft.EntityFrameworkCore
@implements IDisposable
@inject ShoppingService Shop
@inject DeliverySettingsService DeliverySettingsSvc
@inject CouponService CouponSvc
@inject CartService Cart
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Secure Checkout · JAS International</PageTitle>

<div class="shop-container checkout-journey py-8 max-w-6xl mx-auto">
    <!-- Breadcrumb / Step Indicator -->
    <div class="mb-8">
        @if (currentStep == 1)
        {
            <div class="flex items-center gap-2 text-xs text-slate-400 font-semibold mb-2">
                <a href="/cart" class="hover:text-blue-600">Cart</a>
                <span>/</span>
                <span class="text-blue-600 font-bold">1. Delivery Location</span>
                <span>/</span>
                <span class="text-slate-400">2. Payment</span>
                <span>/</span>
                <span class="text-slate-400">3. Confirmation</span>
            </div>
            <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-1">STEP 1 OF 2 · DELIVERY DETAILS</span>
            <h1 class="font-display text-2xl sm:text-4xl font-bold tracking-tight text-slate-900">Where Should We Deliver?</h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">Direct shipping across all 64 districts of Bangladesh. Genuine gadgets with official warranty.</p>
        }
        else
        {
            <div class="flex items-center gap-2 text-xs text-slate-400 font-semibold mb-2">
                <a href="/cart" class="hover:text-blue-600">Cart</a>
                <span>/</span>
                <button type="button" class="text-emerald-600 hover:text-emerald-700 font-bold flex items-center gap-1 transition" @onclick="BackToDelivery">
                    <svg class="size-3.5 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    1. Delivery Location (Edit)
                </button>
                <span>/</span>
                <span class="text-blue-600 font-bold">2. Payment</span>
                <span>/</span>
                <span class="text-slate-400">3. Confirmation</span>
            </div>
            <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-1">STEP 2 OF 2 · PAYMENT DETAILS</span>
            <h1 class="font-display text-2xl sm:text-4xl font-bold tracking-tight text-slate-900">Complete Your Payment</h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">Select your preferred bKash payment option to place your order.</p>
        }
    </div>

    @if (!cartReady || deliverySettings is null)
    {
        <div class="py-16 text-center text-slate-500 text-xs flex items-center justify-center gap-2">
            <span class="size-2 rounded-full bg-blue-600 animate-ping"></span>
            <span>Loading your cart and delivery rates…</span>
        </div>
    }
    else if (!Cart.HasCart && Cart.Error is not null)
    {
        <div role="alert" class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
            @Cart.Error
            <button type="button" class="ml-3 underline" disabled="@Cart.IsBusy" @onclick="Cart.RefreshAsync">Retry</button>
        </div>
    }
    else if (Cart.Items.Count == 0)
    {
        <div class="rounded-3xl border border-slate-200 bg-white p-12 text-center shadow-xs">
            <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-blue-50 text-blue-600 mb-3">
                <svg class="size-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
            </div>
            <h2 class="text-xl font-bold text-slate-900">Your cart is empty</h2>
            <p class="text-xs text-slate-500 mt-1 mb-6">Add products to your cart before proceeding to checkout.</p>
            <a href="/products" class="btn-primary">Browse Catalog</a>
        </div>
    }
    else
    {
        <div data-meta-event="InitiateCheckout"
             data-value="@total"
             data-currency="BDT"
             data-num-items="@Cart.Items.Sum(i => i.Quantity)"
             hidden></div>

        <div class="grid gap-8 lg:grid-cols-12 items-start">
            <!-- Left Column: Form (lg:col-span-7) -->
            <section class="lg:col-span-7 space-y-6">
                @if (currentStep == 1)
                {
                    <!-- STEP 1: Delivery Information Form -->
                    <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs">
                        <div class="flex items-center gap-3 mb-6 pb-3 border-b border-slate-100">
                            <span class="flex size-9 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                                <Icon Name="map-pin" Class="size-5" />
                            </span>
                            <div>
                                <h2 class="font-bold text-slate-900 text-lg">Delivery Information</h2>
                                <span class="text-xs text-slate-500">Provide your shipping address details</span>
                            </div>
                        </div>

                        <div class="space-y-4">
                            <div class="grid gap-4 sm:grid-cols-2">
                                <div>
                                    <label class="field-label">Recipient Full Name *</label>
                                    <input
                                        type="text"
                                        class="field @(hasValidated && !IsCustomerNameValid ? "!border-rose-500 !ring-rose-200 bg-rose-50/20" : "")"
                                        @bind="customerName"
                                        @bind:event="oninput"
                                        placeholder="e.g. Tanvir Ahmed"
                                    />
                                    @if (hasValidated && !IsCustomerNameValid)
                                    {
                                        <span class="text-rose-600 text-[11px] font-semibold mt-1 block">Full recipient name is required (min 2 characters).</span>
                                    }
                                </div>
                                <div>
                                    <label class="field-label">Contact Mobile Number *</label>
                                    <input
                                        type="tel"
                                        class="field @(hasValidated && !IsPhoneValid ? "!border-rose-500 !ring-rose-200 bg-rose-50/20" : "")"
                                        @bind="phoneNumber"
                                        @bind:event="oninput"
                                        @bind:after="OnPhoneInputAfter"
                                        placeholder="017xxxxxxxx (11 digits)"
                                    />
                                    @if (hasValidated && !IsPhoneValid)
                                    {
                                        <span class="text-rose-600 text-[11px] font-semibold mt-1 block">Valid 11-digit mobile number required (01xxxxxxxxx).</span>
                                    }
                                </div>
                            </div>

                            <div>
                                <label class="field-label flex items-center justify-between">
                                    <span>Email Address</span>
                                    <span class="text-slate-400 font-normal text-[11px]">(Optional — for order receipt &amp; status updates)</span>
                                </label>
                                <input
                                    type="email"
                                    class="field @(hasValidated && !IsEmailValid ? "!border-rose-500 !ring-rose-200 bg-rose-50/20" : "")"
                                    @bind="email"
                                    @bind:event="oninput"
                                    placeholder="name@example.com"
                                />
                                @if (hasValidated && !IsEmailValid)
                                {
                                    <span class="text-rose-600 text-[11px] font-semibold mt-1 block">Please enter a valid email address (or leave empty).</span>
                                }
                            </div>

                            <!-- 3-Tier Bangladesh Location Cascading Selects -->
                            <div class="grid gap-4 sm:grid-cols-3">
                                <div>
                                    <label class="field-label">Division *</label>
                                    <select
                                        class="field @(hasValidated && !IsDivisionValid ? "!border-rose-500 !ring-rose-200" : "")"
                                        @bind="selectedDivision"
                                        @bind:after="OnDivisionChanged"
                                    >
                                        @foreach (var div in BangladeshLocationService.Divisions)
                                        {
                                            <option value="@div">@div</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="field-label">District *</label>
                                    <select
                                        class="field @(hasValidated && !IsDistrictValid ? "!border-rose-500 !ring-rose-200" : "")"
                                        @bind="selectedDistrict"
                                        @bind:after="OnDistrictChanged"
                                    >
                                        @foreach (var dist in availableDistricts)
                                        {
                                            <option value="@dist">@dist</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="field-label">Thana / Upazila *</label>
                                    <select
                                        class="field @(hasValidated && !IsThanaValid ? "!border-rose-500 !ring-rose-200" : "")"
                                        @bind="selectedThana"
                                        @bind:after="OnThanaChanged"
                                    >
                                        @foreach (var thana in availableThanas)
                                        {
                                            <option value="@thana">@thana</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div>
                                <label class="field-label">Detailed Street Address / House / Flat / Landmark *</label>
                                <textarea
                                    class="field min-h-[85px] @(hasValidated && !IsAddressValid ? "!border-rose-500 !ring-rose-200 bg-rose-50/20" : "")"
                                    @bind="streetAddress"
                                    @bind:event="oninput"
                                    placeholder="e.g. House 14, Road 3, Sector 9, or local landmark / market name"
                                ></textarea>
                                @if (hasValidated && !IsAddressValid)
                                {
                                    <span class="text-rose-600 text-[11px] font-semibold mt-1 block">Detailed delivery address is required (min 5 characters).</span>
                                }
                            </div>
                        </div>

                        <!-- Payment Step Explainer Box -->
                        <div class="mt-6 rounded-2xl border border-blue-100 bg-blue-50/50 p-4 text-xs text-slate-600 flex items-start gap-3">
                            <span class="flex size-7 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-700 font-bold text-xs mt-0.5">
                                2
                            </span>
                            <div>
                                <strong class="font-bold text-slate-900 block mb-0.5">Next: Payment Details</strong>
                                <p class="text-slate-600 text-[11px]">
                                    On the next step, you will choose between <strong>Advance Delivery Fee (৳@deliverySettings.AdvanceAmount:N0)</strong> or <strong>Full Payment</strong> via bKash, and enter your bKash Transaction ID.
                                </p>
                            </div>
                        </div>

                        <!-- Submission Error Alert (Above Button) -->
                        @if (!string.IsNullOrEmpty(error))
                        {
                            <div class="mt-5 rounded-2xl border border-rose-300 bg-rose-50 p-4 text-xs text-rose-700 flex items-start gap-2.5 shadow-xs" role="alert">
                                <Icon Name="alert" Class="size-4 shrink-0 mt-0.5 text-rose-600" />
                                <div>
                                    <strong class="font-bold text-rose-900 block">Please Complete Required Information</strong>
                                    <span>@error</span>
                                </div>
                            </div>
                        }

                        <!-- Proceed to Payment Button -->
                        <div class="mt-6 pt-4 border-t border-slate-100">
                            <button
                                type="button"
                                class="btn-primary w-full py-4 text-sm sm:text-base font-bold shadow-md flex items-center justify-center gap-2"
                                @onclick="ProceedToPayment"
                            >
                                <span>Proceed to Payment · ৳@total.ToString("N0") →</span>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <!-- STEP 2: Payment Details Form -->
                    <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs">
                        <!-- Delivery Address Preview Card with Edit Action -->
                        <div class="rounded-2xl border border-slate-200 bg-slate-50/80 p-4 mb-6 flex items-start justify-between gap-3 text-xs">
                            <div>
                                <span class="text-slate-400 font-semibold uppercase tracking-wider text-[10px] block mb-1">Deliver To:</span>
                                <strong class="text-slate-900 text-sm block">@customerName</strong>
                                <p class="text-slate-600 mt-0.5 font-mono">@phoneNumber</p>
                                <p class="text-slate-700 mt-1">@streetAddress</p>
                                <p class="text-slate-500 text-[11px]">@selectedThana, @selectedDistrict (@selectedDivision)</p>
                            </div>
                            <button
                                type="button"
                                class="text-xs font-semibold text-blue-600 hover:text-blue-800 bg-blue-50 px-3 py-1.5 rounded-lg border border-blue-200 transition shrink-0"
                                @onclick="BackToDelivery"
                            >
                                Edit Address
                            </button>
                        </div>

                        <div class="flex items-center gap-3 mb-6 pb-3 border-b border-slate-100">
                            <span class="flex size-9 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                                <Icon Name="cash" Class="size-5" />
                            </span>
                            <div>
                                <h2 class="font-bold text-slate-900 text-lg">Choose Payment Option</h2>
                                <span class="text-xs text-slate-500">Advance delivery fee or 100% full prepayment</span>
                            </div>
                        </div>

                        <div class="space-y-3">
                            <!-- Option A: Advance Delivery Fee -->
                            <label class="block cursor-pointer">
                                <div class="rounded-2xl border-2 p-4 transition @(selectedPaymentMode == PaymentModeOption.AdvanceDeliveryFee ? "border-blue-600 bg-blue-50/30" : "border-slate-200 hover:border-slate-300 bg-white")">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-3">
                                            <input
                                                type="radio"
                                                name="checkoutPaymentMode"
                                                checked="@(selectedPaymentMode == PaymentModeOption.AdvanceDeliveryFee)"
                                                @onchange="() => SetPaymentMode(PaymentModeOption.AdvanceDeliveryFee)"
                                                class="size-4 text-blue-600"
                                            />
                                            <div>
                                                <strong class="text-sm font-bold text-slate-900 block">Pay Advance Delivery Fee (৳@deliverySettings.AdvanceAmount.ToString("N0"))</strong>
                                                <span class="text-xs text-slate-500">Remaining product price (৳@Math.Max(0, total - deliverySettings.AdvanceAmount).ToString("N0")) will be paid on delivery to courier.</span>
                                            </div>
                                        </div>
                                        <span class="font-extrabold text-blue-600 text-sm">৳@deliverySettings.AdvanceAmount.ToString("N0")</span>
                                    </div>
                                </div>
                            </label>

                            <!-- Option B: Pay Full Amount via bKash -->
                            <label class="block cursor-pointer">
                                <div class="rounded-2xl border-2 p-4 transition @(selectedPaymentMode == PaymentModeOption.FullPayment ? "border-emerald-600 bg-emerald-50/30" : "border-slate-200 hover:border-slate-300 bg-white")">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-3">
                                            <input
                                                type="radio"
                                                name="checkoutPaymentMode"
                                                checked="@(selectedPaymentMode == PaymentModeOption.FullPayment)"
                                                @onchange="() => SetPaymentMode(PaymentModeOption.FullPayment)"
                                                class="size-4 text-emerald-600"
                                            />
                                            <div>
                                                <strong class="text-sm font-bold text-slate-900 block">Pay Full Amount (৳@total.ToString("N0"))</strong>
                                                <span class="text-xs text-slate-500">100% prepaid order. Zero cash collection hassle when parcel arrives at your door.</span>
                                            </div>
                                        </div>
                                        <span class="font-extrabold text-emerald-600 text-sm">৳@total.ToString("N0")</span>
                                    </div>
                                </div>
                            </label>

                            @if (!deliverySettings.RequireAdvanceForCOD)
                            {
                                <!-- Option C: 100% Cash on Delivery -->
                                <label class="block cursor-pointer">
                                    <div class="rounded-2xl border-2 p-4 transition @(selectedPaymentMode == PaymentModeOption.CashOnDelivery ? "border-slate-800 bg-slate-50" : "border-slate-200 hover:border-slate-300 bg-white")">
                                        <div class="flex items-center gap-3">
                                            <input
                                                type="radio"
                                                name="checkoutPaymentMode"
                                                checked="@(selectedPaymentMode == PaymentModeOption.CashOnDelivery)"
                                                @onchange="() => SetPaymentMode(PaymentModeOption.CashOnDelivery)"
                                                class="size-4 text-slate-800"
                                            />
                                            <div>
                                                <strong class="text-sm font-bold text-slate-900 block">Full Cash on Delivery (COD)</strong>
                                                <span class="text-xs text-slate-500">Pay entire ৳@total.ToString("N0") when courier delivers to your address.</span>
                                            </div>
                                        </div>
                                    </div>
                                </label>
                            }
                        </div>

                        @if (selectedPaymentMode != PaymentModeOption.CashOnDelivery)
                        {
                            <!-- bKash Instructions & Credentials Card -->
                            <div class="mt-6 rounded-2xl border border-pink-200 bg-gradient-to-br from-pink-50/50 to-rose-50/30 p-5 space-y-4">
                                <div class="flex items-center justify-between border-b border-pink-100 pb-3">
                                    <div class="flex items-center gap-2">
                                        <span class="inline-flex items-center justify-center size-6 rounded bg-[#E2136E] text-white font-bold text-xs">
                                            ৳
                                        </span>
                                        <span class="font-bold text-slate-900 text-sm">bKash Send Money Details</span>
                                    </div>
                                    <span class="text-xs font-mono font-bold text-[#E2136E] bg-white px-2.5 py-1 rounded-lg border border-pink-200 shadow-2xs">
                                        Amount to send: ৳@PayableAmount.ToString("N0")
                                    </span>
                                </div>

                                <!-- Copyable Number & Reference -->
                                <div class="grid gap-3 sm:grid-cols-2 text-xs">
                                    <div class="rounded-xl bg-white border border-pink-200/80 p-3 shadow-2xs">
                                        <span class="text-slate-400 block text-[11px] mb-1">bKash Number (Personal/Merchant):</span>
                                        <div class="flex items-center justify-between gap-2">
                                            <strong class="font-mono text-sm font-bold text-slate-900">@deliverySettings.BkashNumber</strong>
                                            <button
                                                type="button"
                                                class="text-[11px] font-semibold text-blue-600 hover:text-blue-800 bg-blue-50 px-2 py-1 rounded transition"
                                                @onclick="CopyBkashNumber"
                                            >
                                                @(copiedNumber ? "✓ Copied!" : "Copy")
                                            </button>
                                        </div>
                                    </div>

                                    <div class="rounded-xl bg-white border border-pink-200/80 p-3 shadow-2xs">
                                        <span class="text-slate-400 block text-[11px] mb-1">Order Reference (Must enter in bKash):</span>
                                        <div class="flex items-center justify-between gap-2">
                                            <strong class="font-mono text-sm font-bold text-blue-700">@paymentReferenceCode</strong>
                                            <button
                                                type="button"
                                                class="text-[11px] font-semibold text-blue-600 hover:text-blue-800 bg-blue-50 px-2 py-1 rounded transition"
                                                @onclick="CopyReferenceCode"
                                            >
                                                @(copiedRef ? "✓ Copied!" : "Copy")
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Step-by-step Guide -->
                                <div class="rounded-xl bg-white/80 border border-pink-100 p-3.5 space-y-1.5 text-xs text-slate-700">
                                    <div class="font-semibold text-slate-900 mb-1 flex items-center gap-1.5">
                                        <span class="size-1.5 rounded-full bg-[#E2136E]"></span>
                                        <span>How to pay via bKash App:</span>
                                    </div>
                                    <ol class="list-decimal list-inside space-y-1 text-[11px] text-slate-600 leading-relaxed">
                                        <li>Open your bKash app and tap <strong>Send Money</strong>.</li>
                                        <li>Enter receiver number: <strong class="font-mono text-slate-900">@deliverySettings.BkashNumber</strong>.</li>
                                        <li>Enter amount: <strong class="font-bold text-[#E2136E]">৳@PayableAmount.ToString("N0")</strong>.</li>
                                        <li>In the <strong>Reference</strong> field, enter: <strong class="font-mono text-blue-700">@paymentReferenceCode</strong>.</li>
                                        <li>Enter your bKash PIN to complete the transaction.</li>
                                        <li>Copy the <strong>Transaction ID (TrxID)</strong> and paste it below.</li>
                                    </ol>
                                </div>

                                <!-- Customer Input Fields -->
                                <div class="grid gap-3 sm:grid-cols-2 pt-2 border-t border-pink-100">
                                    <div>
                                        <label class="field-label text-xs font-semibold">Sender bKash Mobile Number *</label>
                                        <input
                                            type="tel"
                                            class="field text-xs @(hasPaymentValidated && !IsSenderPhoneValid ? "!border-rose-500 !ring-rose-200 bg-rose-50/20" : "")"
                                            @bind="senderPhoneNumber"
                                            @bind:event="oninput"
                                            placeholder="01xxxxxxxxx (11 digits)"
                                        />
                                        @if (hasPaymentValidated && !IsSenderPhoneValid)
                                        {
                                            <span class="text-rose-600 text-[11px] font-semibold mt-1 block">Valid 11-digit sender bKash number is required.</span>
                                        }
                                    </div>
                                    <div>
                                        <label class="field-label text-xs font-semibold">bKash Transaction ID (TrxID) *</label>
                                        <input
                                            type="text"
                                            class="field text-xs font-mono uppercase @(hasPaymentValidated && !IsTrxIdValid ? "!border-rose-500 !ring-rose-200 bg-rose-50/20" : "")"
                                            @bind="transactionId"
                                            @bind:event="oninput"
                                            placeholder="e.g. 9K48X7Q2"
                                        />
                                        @if (hasPaymentValidated && !IsTrxIdValid)
                                        {
                                            <span class="text-rose-600 text-[11px] font-semibold mt-1 block">Valid bKash TrxID required (at least 6 characters).</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Submission Error Alert (Above Button) -->
                        @if (!string.IsNullOrEmpty(error))
                        {
                            <div class="mt-5 rounded-2xl border border-rose-300 bg-rose-50 p-4 text-xs text-rose-700 flex items-start gap-2.5 shadow-xs" role="alert">
                                <Icon Name="alert" Class="size-4 shrink-0 mt-0.5 text-rose-600" />
                                <div>
                                    <strong class="font-bold text-rose-900 block">Please Check Payment Information</strong>
                                    <span>@error</span>
                                </div>
                            </div>
                        }

                        <!-- Confirm Payment & Place Order Button -->
                        <div class="mt-6 pt-4 border-t border-slate-100">
                            <button
                                type="button"
                                class="btn-primary w-full py-4 text-sm sm:text-base font-bold shadow-md flex items-center justify-center gap-2"
                                @onclick="ConfirmAndPlaceOrder"
                                disabled="@isSubmitting"
                            >
                                @if (isSubmitting)
                                {
                                    <span class="inline-block size-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                    <span>Placing Order &amp; Reserving Stock...</span>
                                }
                                else if (selectedPaymentMode != PaymentModeOption.CashOnDelivery)
                                {
                                    <span>Confirm Payment &amp; Place Order · ৳@PayableAmount.ToString("N0")</span>
                                }
                                else
                                {
                                    <span>Place Order (Cash on Delivery) · ৳@total.ToString("N0")</span>
                                }
                            </button>
                        </div>

                        <div class="mt-3 text-center">
                            <button
                                type="button"
                                class="text-xs text-slate-500 hover:text-slate-800 transition"
                                @onclick="BackToDelivery"
                            >
                                ← Need to edit delivery address? Return to Step 1
                            </button>
                        </div>
                    </div>
                }
            </section>

            <!-- Right Column: Order Summary (lg:col-span-5) -->
            <aside class="lg:col-span-5 space-y-6">
                <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs sticky top-24">
                    <h2 class="font-bold text-slate-900 text-lg mb-4 pb-3 border-b border-slate-100 flex items-center justify-between">
                        <span>Order Summary</span>
                        <span class="text-xs text-slate-400 font-normal">@Cart.ItemCount items</span>
                    </h2>

                    <!-- Items List -->
                    <div class="divide-y divide-slate-100 max-h-72 overflow-y-auto mb-4 scrollbar-none pr-1">
                        @foreach (var item in Cart.Items)
                        {
                            <div @key="item.VariantId" class="py-3 flex items-center justify-between gap-3 text-xs">
                                <div class="flex items-center gap-3 min-w-0">
                                    <PictureImage Src="@item.Image" Alt="@item.Name" Class="size-12 shrink-0 rounded-lg object-contain bg-slate-50 border p-1" Width="48" Height="48" Loading="lazy" />
                                    <div class="min-w-0">
                                        <strong class="text-slate-900 block font-semibold truncate">@item.Name</strong>
                                        <span class="text-slate-400 block mt-0.5">@item.Variant · Qty: @item.Quantity</span>
                                    </div>
                                </div>
                                <span class="font-bold text-slate-900 tabular-nums shrink-0">৳@item.LineTotal.ToString("N0")</span>
                            </div>
                        }
                    </div>

                    <!-- Coupon Promo Box -->
                    <div class="border-t border-slate-100 pt-4 mb-4">
                        <label class="field-label flex items-center justify-between text-xs">
                            <span>Promo / Discount Coupon</span>
                            @if (!string.IsNullOrEmpty(appliedCouponCode))
                            {
                                <span class="text-emerald-600 font-bold text-[11px]">Applied: @appliedCouponCode</span>
                            }
                        </label>
                        <div class="flex items-center gap-2 mt-1">
                            <input
                                type="text"
                                class="field uppercase font-mono text-xs !py-2"
                                placeholder="e.g. WELCOME200"
                                @bind="couponInput"
                                disabled="@isSubmitting"
                            />
                            <button
                                type="button"
                                class="btn-secondary text-xs px-3.5 py-2 shrink-0 font-bold"
                                @onclick="ApplyCoupon"
                                disabled="@(isSubmitting || string.IsNullOrWhiteSpace(couponInput))"
                            >
                                Apply
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(couponMessage))
                        {
                            <p class="text-[11px] font-semibold @(couponDiscount > 0 ? "text-emerald-600" : "text-rose-600") mt-1.5 flex items-center gap-1">
                                <span>@couponMessage</span>
                            </p>
                        }
                    </div>

                    <!-- Totals Breakdown -->
                    <div class="border-t border-slate-200 pt-4 space-y-2 text-xs">
                        <div class="flex items-center justify-between text-slate-600">
                            <span>Cart Subtotal</span>
                            <span class="font-semibold text-slate-900 tabular-nums">৳@Cart.Total.ToString("N0")</span>
                        </div>

                        <div class="flex items-center justify-between text-slate-600">
                            <span>
                                Delivery Fee
                                <strong class="text-slate-800 font-semibold ml-1">
                                    (@(deliveryFee == 0 ? "FREE" : (isHubDistrict ? $"{deliverySettings.HubDistrict} Hub" : "Nationwide")))
                                </strong>
                            </span>
                            <span class="font-semibold text-slate-900 tabular-nums">
                                @(deliveryFee == 0 ? "FREE" : $"৳{deliveryFee:N0}")
                            </span>
                        </div>

                        @if (couponDiscount > 0)
                        {
                            <div class="flex items-center justify-between text-emerald-600 font-semibold">
                                <span>Coupon Discount (@appliedCouponCode)</span>
                                <span class="tabular-nums">-৳@couponDiscount.ToString("N0")</span>
                            </div>
                        }

                        <div class="border-t border-slate-200 pt-3 flex items-center justify-between text-sm">
                            <span class="font-bold text-slate-900">Total Order Amount</span>
                            <span class="font-extrabold text-blue-600 text-xl tabular-nums">৳@total.ToString("N0")</span>
                        </div>

                        @if (currentStep == 2)
                        {
                            <!-- Live Payment Breakdown Box -->
                            <div class="rounded-xl bg-blue-50/60 border border-blue-200 p-3 mt-3 text-[11px] space-y-1">
                                @if (selectedPaymentMode == PaymentModeOption.AdvanceDeliveryFee)
                                {
                                    <div class="flex justify-between font-bold text-slate-900">
                                        <span>Pay Now via bKash:</span>
                                        <span class="text-blue-600 text-xs">৳@PayableAmount.ToString("N0")</span>
                                    </div>
                                    <div class="flex justify-between text-slate-600">
                                        <span>Due on Delivery (Courier COD):</span>
                                        <span class="font-semibold">৳@Math.Max(0, total - PayableAmount).ToString("N0")</span>
                                    </div>
                                }
                                else if (selectedPaymentMode == PaymentModeOption.FullPayment)
                                {
                                    <div class="flex justify-between font-bold text-slate-900">
                                        <span>Pay Full Amount via bKash:</span>
                                        <span class="text-emerald-700 text-xs">৳@total.ToString("N0")</span>
                                    </div>
                                    <div class="flex justify-between text-slate-600">
                                        <span>Due on Delivery:</span>
                                        <span class="font-semibold text-emerald-600">৳0 (100% Prepaid)</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex justify-between font-bold text-slate-900">
                                        <span>Pay on Delivery (COD):</span>
                                        <span class="text-slate-900 text-xs">৳@total.ToString("N0")</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <!-- Hub Fee Explainer Tag -->
                            <div class="rounded-xl bg-slate-50 border border-slate-200 p-2.5 mt-2 text-[11px] text-slate-500 space-y-1">
                                <div class="flex items-center justify-between">
                                    <span>Khulna City (Hub):</span>
                                    <strong class="text-slate-700">৳@deliverySettings.HubCityFee:N0</strong>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span>All Other 63 Districts:</span>
                                    <strong class="text-slate-700">৳@deliverySettings.OutsideFee:N0</strong>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </aside>
        </div>
    }
</div>

@code
{
    private enum PaymentModeOption
    {
        AdvanceDeliveryFee,
        FullPayment,
        CashOnDelivery
    }

    private int currentStep = 1;
    private DeliverySettings? deliverySettings;
    private bool cartReady;
    private bool isSubmitting;
    private string? error;
    private bool hasValidated;
    private bool hasPaymentValidated;

    // Delivery fields
    private string customerName = "";
    private string phoneNumber = "";
    private string email = "";
    private string selectedDivision = "Dhaka";
    private string selectedDistrict = "Dhaka";
    private string selectedThana = "Dhanmondi";
    private string streetAddress = "";

    // Payment fields
    private PaymentModeOption selectedPaymentMode = PaymentModeOption.AdvanceDeliveryFee;
    private string paymentReferenceCode = "";
    private string senderPhoneNumber = "";
    private string transactionId = "";
    private bool copiedNumber;
    private bool copiedRef;

    // Lists
    private IReadOnlyList<string> availableDistricts = [];
    private IReadOnlyList<string> availableThanas = [];

    // Coupon fields
    private string couponInput = "";
    private string? appliedCouponCode;
    private decimal couponDiscount;
    private string? couponMessage;

    // Totals
    private decimal deliveryFee;
    private decimal total;
    private bool isHubDistrict;

    private static readonly System.Text.RegularExpressions.Regex PhoneRegex = new(@"^(?:\+?88)?01[3-9]\d{8}$", System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex TrxIdRegex = new(@"^[A-Za-z0-9]{6,20}$", System.Text.RegularExpressions.RegexOptions.Compiled);

    private bool IsCustomerNameValid => !string.IsNullOrWhiteSpace(customerName) && customerName.Trim().Length >= 2;
    private bool IsPhoneValid => !string.IsNullOrWhiteSpace(phoneNumber) && PhoneRegex.IsMatch(phoneNumber.Trim());
    private bool IsEmailValid => string.IsNullOrWhiteSpace(email) || new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(email.Trim());
    private bool IsAddressValid => !string.IsNullOrWhiteSpace(streetAddress) && streetAddress.Trim().Length >= 5;
    private bool IsDivisionValid => !string.IsNullOrWhiteSpace(selectedDivision);
    private bool IsDistrictValid => !string.IsNullOrWhiteSpace(selectedDistrict);
    private bool IsThanaValid => !string.IsNullOrWhiteSpace(selectedThana);

    private bool IsSenderPhoneValid => !string.IsNullOrWhiteSpace(senderPhoneNumber) && PhoneRegex.IsMatch(senderPhoneNumber.Trim());
    private bool IsTrxIdValid => !string.IsNullOrWhiteSpace(transactionId) && TrxIdRegex.IsMatch(transactionId.Trim());

    private decimal PayableAmount
    {
        get
        {
            if (selectedPaymentMode == PaymentModeOption.FullPayment) return total;
            if (selectedPaymentMode == PaymentModeOption.AdvanceDeliveryFee) return deliverySettings?.AdvanceAmount ?? 150m;
            return 0m;
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        deliverySettings = await DeliverySettingsSvc.GetSettingsAsync();

        availableDistricts = BangladeshLocationService.GetDistricts(selectedDivision);
        availableThanas = BangladeshLocationService.GetThanas(selectedDistrict);

        paymentReferenceCode = $"JAS{Random.Shared.Next(1000, 9999)}";

        Cart.OnChange += OnCartChanged;

        try
        {
            await Cart.InitializeAsync();

            // Pre-fill user address if authenticated
            if (AuthStateTask != null)
            {
                var auth = await AuthStateTask;
                var userId = auth?.User != null ? ShoppingService.UserId(auth.User) : null;
                if (userId.HasValue)
                {
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
                    var addr = await db.DeliveryAddresses.AsNoTracking().FirstOrDefaultAsync(d => d.CustomerId == userId.Value);
                    if (addr != null)
                    {
                        customerName = addr.CustomerName;
                        phoneNumber = addr.PhoneNumber;
                        if (!string.IsNullOrWhiteSpace(addr.Email)) email = addr.Email;
                        streetAddress = addr.FullAddress;
                        if (!string.IsNullOrWhiteSpace(addr.Division)) selectedDivision = addr.Division;
                        availableDistricts = BangladeshLocationService.GetDistricts(selectedDivision);
                        if (!string.IsNullOrWhiteSpace(addr.District)) selectedDistrict = addr.District;
                        availableThanas = BangladeshLocationService.GetThanas(selectedDistrict);
                        if (!string.IsNullOrWhiteSpace(addr.Thana)) selectedThana = addr.Thana;
                    }
                    var userName = auth?.User?.Identity?.Name;
                    if (string.IsNullOrWhiteSpace(email) && !string.IsNullOrWhiteSpace(userName) && userName.Contains('@'))
                    {
                        email = userName;
                    }
                }
            }

            // Auto-apply deep-linked coupon from URL
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("coupon", out var couponParam) && !string.IsNullOrWhiteSpace(couponParam))
            {
                couponInput = couponParam.ToString().Trim().ToUpperInvariant();
                await ApplyCoupon();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Checkout] Init warning: {ex.Message}");
        }
        finally
        {
            cartReady = true;
            UpdateDeliveryAndTotal();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Cart.SynchronizeBadgeAsync();
        if (firstRender && string.IsNullOrWhiteSpace(couponInput))
        {
            try
            {
                var savedCoupon = await JS.InvokeAsync<string?>("localStorage.getItem", "jas_coupon");
                if (!string.IsNullOrWhiteSpace(savedCoupon))
                {
                    couponInput = savedCoupon.Trim().ToUpperInvariant();
                    await ApplyCoupon();
                    StateHasChanged();
                }
            }
            catch
            {
                // Ignore localStorage errors
            }
        }
    }

    private async Task OnPhoneInputAfter()
    {
        if (IsPhoneValid && Cart.Items.Count > 0)
        {
            try
            {
                var auth = AuthStateTask != null ? await AuthStateTask : null;
                var uid = auth?.User != null ? ShoppingService.UserId(auth.User) : null;
                var attr = await JS.InvokeAsync<MetaAttributionDto>("window.jasGetAttribution");
                await Shop.RecordLeadCartAsync(uid, phoneNumber, customerName, email, Cart.Items.ToList(), attr);
            }
            catch
            {
                // Non-blocking lead capture
            }
        }
    }

    private void OnCartChanged()
    {
        UpdateDeliveryAndTotal();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnDivisionChanged()
    {
        availableDistricts = BangladeshLocationService.GetDistricts(selectedDivision);
        selectedDistrict = availableDistricts.FirstOrDefault() ?? "";
        availableThanas = BangladeshLocationService.GetThanas(selectedDistrict);
        selectedThana = availableThanas.FirstOrDefault() ?? "";
        UpdateDeliveryAndTotal();
    }

    private void OnDistrictChanged()
    {
        availableThanas = BangladeshLocationService.GetThanas(selectedDistrict);
        selectedThana = availableThanas.FirstOrDefault() ?? "";
        UpdateDeliveryAndTotal();
    }

    private void OnThanaChanged()
    {
        // Thana updated
    }

    private void SetPaymentMode(PaymentModeOption mode)
    {
        selectedPaymentMode = mode;
        StateHasChanged();
    }

    private void UpdateDeliveryAndTotal()
    {
        if (deliverySettings == null) return;

        isHubDistrict = string.Equals(selectedDistrict.Trim(), deliverySettings.HubDistrict.Trim(), StringComparison.OrdinalIgnoreCase);

        if (deliverySettings.FreeDeliveryThreshold.HasValue && deliverySettings.FreeDeliveryThreshold.Value > 0 && Cart.Total >= deliverySettings.FreeDeliveryThreshold.Value)
        {
            deliveryFee = 0m;
        }
        else if (isHubDistrict)
        {
            deliveryFee = deliverySettings.HubCityFee;
        }
        else
        {
            deliveryFee = deliverySettings.OutsideFee;
        }

        total = Math.Max(0, Cart.Total + deliveryFee - couponDiscount);
    }

    private async Task ApplyCoupon()
    {
        if (string.IsNullOrWhiteSpace(couponInput)) return;
        var res = await CouponSvc.ValidateCouponAsync(couponInput, Cart.Total, deliveryFee);
        if (res.IsValid)
        {
            appliedCouponCode = res.Code;
            couponDiscount = res.DiscountAmount;
            couponMessage = $"✓ {res.Message}";
            UpdateDeliveryAndTotal();
        }
        else
        {
            couponMessage = res.Message;
            couponDiscount = 0;
            appliedCouponCode = null;
            UpdateDeliveryAndTotal();
        }
    }

    private void ProceedToPayment()
    {
        error = null;
        hasValidated = true;

        if (!IsCustomerNameValid)
        {
            error = "Please enter the recipient full name (at least 2 characters).";
            return;
        }
        if (!IsPhoneValid)
        {
            error = "Please enter a valid 11-digit Bangladesh phone number (01xxxxxxxxx).";
            return;
        }
        if (!IsEmailValid)
        {
            error = "Please enter a valid email address (e.g. name@example.com) or leave it empty.";
            return;
        }
        if (!IsDivisionValid || !IsDistrictValid || !IsThanaValid)
        {
            error = "Please select your delivery Division, District, and Thana.";
            return;
        }
        if (!IsAddressValid)
        {
            error = "Please enter your detailed street and house address (at least 5 characters).";
            return;
        }

        if (string.IsNullOrWhiteSpace(paymentReferenceCode))
        {
            paymentReferenceCode = $"JAS{Random.Shared.Next(1000, 9999)}";
        }

        // Advance to Step 2 WITHOUT touching database, reserving stock, or recording guest order
        currentStep = 2;
        hasPaymentValidated = false;
        error = null;
    }

    private void BackToDelivery()
    {
        currentStep = 1;
        error = null;
    }

    private async Task CopyBkashNumber()
    {
        if (deliverySettings?.BkashNumber is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", deliverySettings.BkashNumber);
                copiedNumber = true;
                StateHasChanged();
                await Task.Delay(2000);
                copiedNumber = false;
            }
            catch
            {
                // Clipboard write fallback
            }
        }
    }

    private async Task CopyReferenceCode()
    {
        if (!string.IsNullOrWhiteSpace(paymentReferenceCode))
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", paymentReferenceCode);
                copiedRef = true;
                StateHasChanged();
                await Task.Delay(2000);
                copiedRef = false;
            }
            catch
            {
                // Clipboard write fallback
            }
        }
    }

    private async Task ConfirmAndPlaceOrder()
    {
        error = null;
        hasPaymentValidated = true;

        if (selectedPaymentMode != PaymentModeOption.CashOnDelivery)
        {
            if (!IsSenderPhoneValid)
            {
                error = "Please enter a valid 11-digit sender bKash number (01xxxxxxxxx).";
                return;
            }
            if (!IsTrxIdValid)
            {
                error = "Please enter a valid bKash Transaction ID (TrxID, at least 6 alphanumeric characters).";
                return;
            }
        }
        else
        {
            if (deliverySettings?.RequireAdvanceForCOD == true)
            {
                error = "Advance delivery fee via bKash is required to confirm Cash on Delivery orders.";
                return;
            }
        }

        isSubmitting = true;

        try
        {
            int? userId = null;
            if (AuthStateTask != null)
            {
                var auth = await AuthStateTask;
                if (auth?.User != null)
                {
                    userId = ShoppingService.UserId(auth.User);
                }
            }

            var pMethod = selectedPaymentMode == PaymentModeOption.FullPayment ? "FullPayment"
                        : (selectedPaymentMode == PaymentModeOption.AdvanceDeliveryFee ? "BkashAdvance" : "COD");

            var checkoutToken = await Cart.CheckoutTokenAsync();
            var checkoutRequest = new CheckoutRequest
            {
                RequestId = checkoutToken,
                CartToken = Cart.State?.Cart?.Token,
                CustomerName = customerName.Trim(),
                PhoneNumber = phoneNumber.Trim(),
                Email = string.IsNullOrWhiteSpace(email) ? null : email.Trim(),
                Division = selectedDivision,
                District = selectedDistrict,
                Thana = selectedThana,
                City = selectedThana,
                Address = streetAddress.Trim(),
                CouponCode = appliedCouponCode,
                PaymentMethod = pMethod,
                ReferenceCode = paymentReferenceCode,
                SenderPhoneNumber = selectedPaymentMode != PaymentModeOption.CashOnDelivery ? senderPhoneNumber.Trim() : null,
                TransactionId = selectedPaymentMode != PaymentModeOption.CashOnDelivery ? transactionId.Trim().ToUpperInvariant() : null,
                Items = Cart.Items.Select(i => new CartLineRequest(i.VariantId, i.Quantity)).ToList(),
                ExpectedTotal = total
            };

            // Retrieve client-side Meta Ads attribution if available
            try
            {
                var attr = await JS.InvokeAsync<MetaAttributionDto>("window.jasGetAttribution");
                if (attr != null)
                {
                    checkoutRequest.Fbclid = attr.Fbclid;
                    checkoutRequest.Fbp = attr.Fbp;
                    checkoutRequest.Fbc = attr.Fbc;
                    checkoutRequest.UtmSource = attr.UtmSource;
                    checkoutRequest.UtmMedium = attr.UtmMedium;
                    checkoutRequest.UtmCampaign = attr.UtmCampaign;
                    checkoutRequest.UtmContent = attr.UtmContent;
                    checkoutRequest.UtmTerm = attr.UtmTerm;
                }
            }
            catch
            {
                // In SSR or restricted environments, server middleware provides attribution
            }

            // ONLY submit to DB when user confirms payment details
            var result = await Shop.CheckoutAsync(userId, checkoutRequest);
            await Cart.CompleteCheckoutAsync(checkoutToken);

            try
            {
                await JS.InvokeVoidAsync("window.jasClearCartCookie");
            }
            catch
            {
                // ignore
            }

            try
            {
                await JS.InvokeVoidAsync("window.jasRecordGuestOrder", result.OrderId, result.PublicToken.ToString(), result.Total);
            }
            catch
            {
                // ignore
            }

            if (selectedPaymentMode != PaymentModeOption.CashOnDelivery)
            {
                Nav.NavigateTo($"/payment-verification?token={result.PublicToken}");
            }
            else
            {
                Nav.NavigateTo($"/order/{result.PublicToken}");
            }
        }
        catch (ShopException ex)
        {
            error = ex.Message;
            isSubmitting = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Checkout] Unexpected error during checkout: {ex}");
            error = "An unexpected error occurred while placing your order. Please try again.";
            isSubmitting = false;
        }
    }

    public void Dispose()
    {
        Cart.OnChange -= OnCartChanged;
    }
}
