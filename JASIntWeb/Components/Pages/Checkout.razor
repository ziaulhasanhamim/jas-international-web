@page "/checkout"
@rendermode InteractiveServer
@using JASIntWeb.Services
@using JASIntWeb.Client.Services
@using JASIntWeb.Client.Contracts
@using JASIntWeb.Persistence
@using JASIntWeb.Persistence.Entities
@using Microsoft.EntityFrameworkCore
@implements IDisposable
@inject ShoppingService Shop
@inject DeliverySettingsService DeliverySettingsSvc
@inject CouponService CouponSvc
@inject CartService Cart
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Secure Checkout · JAS International</PageTitle>

<div class="shop-container py-8 max-w-6xl mx-auto">
    <!-- Breadcrumb / Step Indicator -->
    <div class="mb-8">
        <div class="flex items-center gap-2 text-xs text-slate-400 font-semibold mb-2">
            <a href="/cart" class="hover:text-blue-600">Cart</a>
            <span>/</span>
            <span class="text-blue-600 font-bold">1. Delivery Location</span>
            <span>/</span>
            <span class="text-slate-400">2. Payment</span>
            <span>/</span>
            <span class="text-slate-400">3. Confirmation</span>
        </div>
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-1">STEP 1 OF 2 · DELIVERY DETAILS</span>
        <h1 class="font-display text-2xl sm:text-4xl font-bold tracking-tight text-slate-900">Where Should We Deliver?</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Direct shipping across all 64 districts of Bangladesh. Genuine gadgets with official warranty.</p>
    </div>

    @if (!cartReady || deliverySettings is null)
    {
        <div class="py-16 text-center text-slate-500 text-xs flex items-center justify-center gap-2">
            <span class="size-2 rounded-full bg-blue-600 animate-ping"></span>
            <span>Loading your cart and delivery rates…</span>
        </div>
    }
    else if (Cart.Items.Count == 0)
    {
        <div class="rounded-3xl border border-slate-200 bg-white p-12 text-center shadow-xs">
            <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-blue-50 text-blue-600 mb-3">
                <svg class="size-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
            </div>
            <h2 class="text-xl font-bold text-slate-900">Your cart is empty</h2>
            <p class="text-xs text-slate-500 mt-1 mb-6">Add products to your cart before proceeding to checkout.</p>
            <a href="/products" class="btn-primary">Browse Catalog</a>
        </div>
    }
    else
    {
        <div class="grid gap-8 lg:grid-cols-12 items-start">
            <!-- Left Column: Delivery Information Form (lg:col-span-7) -->
            <section class="lg:col-span-7 space-y-6">
                <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs">
                    <div class="flex items-center gap-3 mb-6 pb-3 border-b border-slate-100">
                        <span class="flex size-9 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                            <Icon Name="map-pin" Class="size-5" />
                        </span>
                        <div>
                            <h2 class="font-bold text-slate-900 text-lg">Delivery Information</h2>
                            <span class="text-xs text-slate-500">Provide your shipping address details</span>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="grid gap-4 sm:grid-cols-2">
                            <div>
                                <label class="field-label">Recipient Full Name *</label>
                                <input
                                    type="text"
                                    class="field @(hasValidated && !IsCustomerNameValid ? "!border-rose-500 !ring-rose-200 bg-rose-50/20" : "")"
                                    @bind="customerName"
                                    @bind:event="oninput"
                                    placeholder="e.g. Tanvir Ahmed"
                                />
                                @if (hasValidated && !IsCustomerNameValid)
                                {
                                    <span class="text-rose-600 text-[11px] font-semibold mt-1 block">Full recipient name is required (min 2 characters).</span>
                                }
                            </div>
                            <div>
                                <label class="field-label">Contact Mobile Number *</label>
                                <input
                                    type="tel"
                                    class="field @(hasValidated && !IsPhoneValid ? "!border-rose-500 !ring-rose-200 bg-rose-50/20" : "")"
                                    @bind="phoneNumber"
                                    @bind:event="oninput"
                                    placeholder="017xxxxxxxx (11 digits)"
                                />
                                @if (hasValidated && !IsPhoneValid)
                                {
                                    <span class="text-rose-600 text-[11px] font-semibold mt-1 block">Valid 11-digit mobile number required (01xxxxxxxxx).</span>
                                }
                            </div>
                        </div>

                        <div>
                            <label class="field-label flex items-center justify-between">
                                <span>Email Address</span>
                                <span class="text-slate-400 font-normal text-[11px]">(Optional — for order receipt &amp; status updates)</span>
                            </label>
                            <input
                                type="email"
                                class="field @(hasValidated && !IsEmailValid ? "!border-rose-500 !ring-rose-200 bg-rose-50/20" : "")"
                                @bind="email"
                                @bind:event="oninput"
                                placeholder="name@example.com"
                            />
                            @if (hasValidated && !IsEmailValid)
                            {
                                <span class="text-rose-600 text-[11px] font-semibold mt-1 block">Please enter a valid email address (or leave empty).</span>
                            }
                        </div>

                        <!-- 3-Tier Bangladesh Location Cascading Selects -->
                        <div class="grid gap-4 sm:grid-cols-3">
                            <div>
                                <label class="field-label">Division *</label>
                                <select
                                    class="field @(hasValidated && !IsDivisionValid ? "!border-rose-500 !ring-rose-200" : "")"
                                    @bind="selectedDivision"
                                    @bind:after="OnDivisionChanged"
                                >
                                    @foreach (var div in BangladeshLocationService.Divisions)
                                    {
                                        <option value="@div">@div</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="field-label">District *</label>
                                <select
                                    class="field @(hasValidated && !IsDistrictValid ? "!border-rose-500 !ring-rose-200" : "")"
                                    @bind="selectedDistrict"
                                    @bind:after="OnDistrictChanged"
                                >
                                    @foreach (var dist in availableDistricts)
                                    {
                                        <option value="@dist">@dist</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="field-label">Thana / Upazila *</label>
                                <select
                                    class="field @(hasValidated && !IsThanaValid ? "!border-rose-500 !ring-rose-200" : "")"
                                    @bind="selectedThana"
                                    @bind:after="OnThanaChanged"
                                >
                                    @foreach (var thana in availableThanas)
                                    {
                                        <option value="@thana">@thana</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="field-label">Detailed Street Address / House / Flat / Landmark *</label>
                            <textarea
                                class="field min-h-[85px] @(hasValidated && !IsAddressValid ? "!border-rose-500 !ring-rose-200 bg-rose-50/20" : "")"
                                @bind="streetAddress"
                                @bind:event="oninput"
                                placeholder="e.g. House 14, Road 3, Sector 9, or local landmark / market name"
                            ></textarea>
                            @if (hasValidated && !IsAddressValid)
                            {
                                <span class="text-rose-600 text-[11px] font-semibold mt-1 block">Detailed delivery address is required (min 5 characters).</span>
                            }
                        </div>
                    </div>

                    <!-- Payment Step Explainer Box -->
                    <div class="mt-6 rounded-2xl border border-blue-100 bg-blue-50/50 p-4 text-xs text-slate-600 flex items-start gap-3">
                        <span class="flex size-7 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-700 font-bold text-xs mt-0.5">
                            2
                        </span>
                        <div>
                            <strong class="font-bold text-slate-900 block mb-0.5">Next: Payment Details</strong>
                            <p class="text-slate-600 text-[11px]">
                                On the next page, you will choose between <strong>Advance Delivery Fee (৳@deliverySettings.AdvanceAmount:N0)</strong> or <strong>Full Payment</strong> via bKash, and enter your bKash Transaction ID.
                            </p>
                        </div>
                    </div>

                    <!-- Submission Error Alert (Above Button) -->
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="mt-5 rounded-2xl border border-rose-300 bg-rose-50 p-4 text-xs text-rose-700 flex items-start gap-2.5 shadow-xs" role="alert">
                            <Icon Name="alert" Class="size-4 shrink-0 mt-0.5 text-rose-600" />
                            <div>
                                <strong class="font-bold text-rose-900 block">Please Complete Required Information</strong>
                                <span>@error</span>
                            </div>
                        </div>
                    }

                    <!-- Proceed to Payment Button -->
                    <div class="mt-6 pt-4 border-t border-slate-100">
                        <button
                            type="button"
                            class="btn-primary w-full py-4 text-sm sm:text-base font-bold shadow-md flex items-center justify-center gap-2"
                            @onclick="ProceedToPayment"
                            disabled="@isSubmitting"
                        >
                            @if (isSubmitting)
                            {
                                <span class="inline-block size-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                <span>Saving Delivery Address...</span>
                            }
                            else
                            {
                                <span>Proceed to Payment · ৳@total.ToString("N0") →</span>
                            }
                        </button>
                    </div>
                </div>
            </section>

            <!-- Right Column: Order Summary (lg:col-span-5) -->
            <aside class="lg:col-span-5 space-y-6">
                <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs sticky top-24">
                    <h2 class="font-bold text-slate-900 text-lg mb-4 pb-3 border-b border-slate-100 flex items-center justify-between">
                        <span>Order Summary</span>
                        <span class="text-xs text-slate-400 font-normal">@Cart.ItemCount items</span>
                    </h2>

                    <!-- Items List -->
                    <div class="divide-y divide-slate-100 max-h-72 overflow-y-auto mb-4 scrollbar-none pr-1">
                        @foreach (var item in Cart.Items)
                        {
                            <div @key="item.VariantId" class="py-3 flex items-center justify-between gap-3 text-xs">
                                <div class="flex items-center gap-3 min-w-0">
                                    <img src="@item.Image" alt="@item.Name" class="size-12 shrink-0 rounded-lg object-contain bg-slate-50 border p-1" />
                                    <div class="min-w-0">
                                        <strong class="text-slate-900 block font-semibold truncate">@item.Name</strong>
                                        <span class="text-slate-400 block mt-0.5">@item.Variant · Qty: @item.Quantity</span>
                                    </div>
                                </div>
                                <span class="font-bold text-slate-900 tabular-nums shrink-0">৳@item.LineTotal.ToString("N0")</span>
                            </div>
                        }
                    </div>

                    <!-- Coupon Promo Box -->
                    <div class="border-t border-slate-100 pt-4 mb-4">
                        <label class="field-label flex items-center justify-between text-xs">
                            <span>Promo / Discount Coupon</span>
                            @if (!string.IsNullOrEmpty(appliedCouponCode))
                            {
                                <span class="text-emerald-600 font-bold text-[11px]">Applied: @appliedCouponCode</span>
                            }
                        </label>
                        <div class="flex items-center gap-2 mt-1">
                            <input
                                type="text"
                                class="field uppercase font-mono text-xs !py-2"
                                placeholder="e.g. WELCOME200"
                                @bind="couponInput"
                                disabled="@isSubmitting"
                            />
                            <button
                                type="button"
                                class="btn-secondary text-xs px-3.5 py-2 shrink-0 font-bold"
                                @onclick="ApplyCoupon"
                                disabled="@(isSubmitting || string.IsNullOrWhiteSpace(couponInput))"
                            >
                                Apply
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(couponMessage))
                        {
                            <p class="text-[11px] font-semibold @(couponDiscount > 0 ? "text-emerald-600" : "text-rose-600") mt-1.5 flex items-center gap-1">
                                <span>@couponMessage</span>
                            </p>
                        }
                    </div>

                    <!-- Totals Breakdown -->
                    <div class="border-t border-slate-200 pt-4 space-y-2 text-xs">
                        <div class="flex items-center justify-between text-slate-600">
                            <span>Cart Subtotal</span>
                            <span class="font-semibold text-slate-900 tabular-nums">৳@Cart.Total.ToString("N0")</span>
                        </div>

                        <div class="flex items-center justify-between text-slate-600">
                            <span>
                                Delivery Fee
                                <strong class="text-slate-800 font-semibold ml-1">
                                    (@(deliveryFee == 0 ? "FREE" : (isHubDistrict ? $"{deliverySettings.HubDistrict} Hub" : "Nationwide")))
                                </strong>
                            </span>
                            <span class="font-semibold text-slate-900 tabular-nums">
                                @(deliveryFee == 0 ? "FREE" : $"৳{deliveryFee:N0}")
                            </span>
                        </div>

                        @if (couponDiscount > 0)
                        {
                            <div class="flex items-center justify-between text-emerald-600 font-semibold">
                                <span>Coupon Discount (@appliedCouponCode)</span>
                                <span class="tabular-nums">-৳@couponDiscount.ToString("N0")</span>
                            </div>
                        }

                        <div class="border-t border-slate-200 pt-3 flex items-center justify-between text-sm">
                            <span class="font-bold text-slate-900">Total Order Amount</span>
                            <span class="font-extrabold text-blue-600 text-xl tabular-nums">৳@total.ToString("N0")</span>
                        </div>

                        <!-- Hub Fee Explainer Tag -->
                        <div class="rounded-xl bg-slate-50 border border-slate-200 p-2.5 mt-2 text-[11px] text-slate-500 space-y-1">
                            <div class="flex items-center justify-between">
                                <span>Khulna City (Hub):</span>
                                <strong class="text-slate-700">৳@deliverySettings.HubCityFee:N0</strong>
                            </div>
                            <div class="flex items-center justify-between">
                                <span>All Other 63 Districts:</span>
                                <strong class="text-slate-700">৳@deliverySettings.OutsideFee:N0</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    }
</div>

@code
{
    private DeliverySettings? deliverySettings;
    private bool cartReady;
    private bool isSubmitting;
    private string? error;
    private bool hasValidated;

    // Delivery fields
    private string customerName = "";
    private string phoneNumber = "";
    private string email = "";
    private string selectedDivision = "Dhaka";
    private string selectedDistrict = "Dhaka";
    private string selectedThana = "Dhanmondi";
    private string streetAddress = "";

    // Lists
    private IReadOnlyList<string> availableDistricts = [];
    private IReadOnlyList<string> availableThanas = [];

    // Coupon fields
    private string couponInput = "";
    private string? appliedCouponCode;
    private decimal couponDiscount;
    private string? couponMessage;

    // Totals
    private decimal deliveryFee;
    private decimal total;
    private bool isHubDistrict;

    private static readonly System.Text.RegularExpressions.Regex PhoneRegex = new(@"^(?:\+?88)?01[3-9]\d{8}$", System.Text.RegularExpressions.RegexOptions.Compiled);

    private bool IsCustomerNameValid => !string.IsNullOrWhiteSpace(customerName) && customerName.Trim().Length >= 2;
    private bool IsPhoneValid => !string.IsNullOrWhiteSpace(phoneNumber) && PhoneRegex.IsMatch(phoneNumber.Trim());
    private bool IsEmailValid => string.IsNullOrWhiteSpace(email) || new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(email.Trim());
    private bool IsAddressValid => !string.IsNullOrWhiteSpace(streetAddress) && streetAddress.Trim().Length >= 5;
    private bool IsDivisionValid => !string.IsNullOrWhiteSpace(selectedDivision);
    private bool IsDistrictValid => !string.IsNullOrWhiteSpace(selectedDistrict);
    private bool IsThanaValid => !string.IsNullOrWhiteSpace(selectedThana);

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        deliverySettings = await DeliverySettingsSvc.GetSettingsAsync();

        availableDistricts = BangladeshLocationService.GetDistricts(selectedDivision);
        availableThanas = BangladeshLocationService.GetThanas(selectedDistrict);

        Cart.OnChange += OnCartChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Cart.InitializeAsync();

                // Try pre-filling user address if authenticated
                if (AuthStateTask != null)
                {
                    var auth = await AuthStateTask;
                    var userId = auth?.User != null ? ShoppingService.UserId(auth.User) : null;
                    if (userId.HasValue)
                    {
                        await using var scope = ScopeFactory.CreateAsyncScope();
                        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
                        var addr = await db.DeliveryAddresses.AsNoTracking().FirstOrDefaultAsync(d => d.CustomerId == userId.Value);
                        if (addr != null)
                        {
                            customerName = addr.CustomerName;
                            phoneNumber = addr.PhoneNumber;
                            if (!string.IsNullOrWhiteSpace(addr.Email)) email = addr.Email;
                            streetAddress = addr.FullAddress;
                            if (!string.IsNullOrWhiteSpace(addr.Division)) selectedDivision = addr.Division;
                            availableDistricts = BangladeshLocationService.GetDistricts(selectedDivision);
                            if (!string.IsNullOrWhiteSpace(addr.District)) selectedDistrict = addr.District;
                            availableThanas = BangladeshLocationService.GetThanas(selectedDistrict);
                            if (!string.IsNullOrWhiteSpace(addr.Thana)) selectedThana = addr.Thana;
                        }
                        var userName = auth?.User?.Identity?.Name;
                        if (string.IsNullOrWhiteSpace(email) && !string.IsNullOrWhiteSpace(userName) && userName.Contains('@'))
                        {
                            email = userName;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Checkout] Load address warning: {ex.Message}");
            }
            finally
            {
                cartReady = true;
                UpdateDeliveryAndTotal();
                StateHasChanged();
            }
        }
    }

    private void OnCartChanged()
    {
        UpdateDeliveryAndTotal();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnDivisionChanged()
    {
        availableDistricts = BangladeshLocationService.GetDistricts(selectedDivision);
        selectedDistrict = availableDistricts.FirstOrDefault() ?? "";
        availableThanas = BangladeshLocationService.GetThanas(selectedDistrict);
        selectedThana = availableThanas.FirstOrDefault() ?? "";
        UpdateDeliveryAndTotal();
    }

    private void OnDistrictChanged()
    {
        availableThanas = BangladeshLocationService.GetThanas(selectedDistrict);
        selectedThana = availableThanas.FirstOrDefault() ?? "";
        UpdateDeliveryAndTotal();
    }

    private void OnThanaChanged()
    {
        // Thana updated
    }

    private void UpdateDeliveryAndTotal()
    {
        if (deliverySettings == null) return;

        isHubDistrict = string.Equals(selectedDistrict.Trim(), deliverySettings.HubDistrict.Trim(), StringComparison.OrdinalIgnoreCase);

        if (deliverySettings.FreeDeliveryThreshold.HasValue && deliverySettings.FreeDeliveryThreshold.Value > 0 && Cart.Total >= deliverySettings.FreeDeliveryThreshold.Value)
        {
            deliveryFee = 0m;
        }
        else if (isHubDistrict)
        {
            deliveryFee = deliverySettings.HubCityFee;
        }
        else
        {
            deliveryFee = deliverySettings.OutsideFee;
        }

        total = Math.Max(0, Cart.Total + deliveryFee - couponDiscount);
    }

    private async Task ApplyCoupon()
    {
        if (string.IsNullOrWhiteSpace(couponInput)) return;
        var res = await CouponSvc.ValidateCouponAsync(couponInput, Cart.Total, deliveryFee);
        if (res.IsValid)
        {
            appliedCouponCode = res.Code;
            couponDiscount = res.DiscountAmount;
            couponMessage = $"✓ {res.Message}";
            UpdateDeliveryAndTotal();
        }
        else
        {
            couponMessage = res.Message;
            couponDiscount = 0;
            appliedCouponCode = null;
            UpdateDeliveryAndTotal();
        }
    }

    private async Task ProceedToPayment()
    {
        error = null;
        hasValidated = true;

        if (!IsCustomerNameValid)
        {
            error = "Please enter the recipient full name (at least 2 characters).";
            return;
        }
        if (!IsPhoneValid)
        {
            error = "Please enter a valid 11-digit Bangladesh phone number (01xxxxxxxxx).";
            return;
        }
        if (!IsEmailValid)
        {
            error = "Please enter a valid email address (e.g. name@example.com) or leave it empty.";
            return;
        }
        if (!IsDivisionValid || !IsDistrictValid || !IsThanaValid)
        {
            error = "Please select your delivery Division, District, and Thana.";
            return;
        }
        if (!IsAddressValid)
        {
            error = "Please enter your detailed street and house address (at least 5 characters).";
            return;
        }

        isSubmitting = true;

        try
        {
            int? userId = null;
            if (AuthStateTask != null)
            {
                var auth = await AuthStateTask;
                if (auth?.User != null)
                {
                    userId = ShoppingService.UserId(auth.User);
                }
            }

            var checkoutToken = await Cart.CheckoutTokenAsync();
            var checkoutRequest = new CheckoutRequest
            {
                RequestId = checkoutToken,
                CustomerName = customerName.Trim(),
                PhoneNumber = phoneNumber.Trim(),
                Email = string.IsNullOrWhiteSpace(email) ? null : email.Trim(),
                Division = selectedDivision,
                District = selectedDistrict,
                Thana = selectedThana,
                City = selectedThana,
                Address = streetAddress.Trim(),
                CouponCode = appliedCouponCode,
                PaymentMethod = "Pending",
                Items = Cart.Items.Select(i => new CartLineRequest(i.VariantId, i.Quantity)).ToList(),
                ExpectedTotal = total
            };

            var result = await Shop.CheckoutAsync(userId, checkoutRequest);
            await Cart.CompleteCheckoutAsync(checkoutToken);

            try
            {
                await JS.InvokeVoidAsync("window.jasRecordGuestOrder", result.OrderId, result.PublicToken.ToString(), result.Total);
            }
            catch
            {
                // ignore
            }

            Nav.NavigateTo($"/checkout/payment/{result.PublicToken}");
        }
        catch (ShopException ex)
        {
            error = ex.Message;
            isSubmitting = false;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            isSubmitting = false;
        }
    }

    public void Dispose()
    {
        Cart.OnChange -= OnCartChanged;
    }
}
