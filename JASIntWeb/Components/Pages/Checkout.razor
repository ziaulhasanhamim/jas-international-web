@page "/checkout"
@rendermode InteractiveServer
@using JASIntWeb.Services
@using JASIntWeb.Client.Services
@using JASIntWeb.Client.Contracts
@using JASIntWeb.Persistence.Entities
@implements IDisposable
@inject ShoppingService Shop
@inject DeliverySettingsService DeliverySettingsSvc
@inject CouponService CouponSvc
@inject CartService Cart
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AppDbContext Db

<PageTitle>Secure Checkout · JAS International</PageTitle>

<div class="shop-container py-8 max-w-6xl mx-auto">
    <div class="mb-8">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-1">SECURE CHECKOUT</span>
        <h1 class="font-display text-2xl sm:text-4xl font-bold tracking-tight text-slate-900">Delivery &amp; Payment</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">bKash &amp; Cash on Delivery across Bangladesh. Genuine tech gadgets with official warranty.</p>
    </div>

    @if (error is not null)
    {
        <div class="mb-6 rounded-2xl border border-rose-200 bg-rose-50 p-4 text-xs text-rose-700 flex items-start gap-2.5 shadow-xs" role="alert">
            <Icon Name="alert" Class="size-4 shrink-0 mt-0.5" />
            <div>
                <strong class="font-semibold block">Notice</strong>
                <span>@error</span>
            </div>
        </div>
    }

    @if (!cartReady || deliverySettings is null)
    {
        <div class="py-16 text-center text-slate-500 text-xs flex items-center justify-center gap-2">
            <span class="size-2 rounded-full bg-blue-600 animate-ping"></span>
            <span>Loading your cart and delivery rates…</span>
        </div>
    }
    else if (Cart.Items.Count == 0)
    {
        <div class="rounded-3xl border border-slate-200 bg-white p-12 text-center shadow-xs">
            <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-blue-50 text-blue-600 mb-3">
                <svg class="size-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
            </div>
            <h2 class="text-xl font-bold text-slate-900">Your cart is empty</h2>
            <p class="text-xs text-slate-500 mt-1 mb-6">Add products to your cart before proceeding to checkout.</p>
            <a href="/products" class="btn-primary">Browse Catalog</a>
        </div>
    }
    else
    {
        <div class="grid gap-8 lg:grid-cols-12 items-start">
            <!-- Left Column: Order Summary (Items, Subtotal, Delivery Fee, Coupon, Total) -->
            <aside class="lg:col-span-5 space-y-6">
                <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs">
                    <h2 class="font-bold text-slate-900 text-lg mb-4 pb-3 border-b border-slate-100 flex items-center justify-between">
                        <span>Order Summary</span>
                        <span class="text-xs text-slate-400 font-normal">@Cart.ItemCount items</span>
                    </h2>

                    <!-- Items List -->
                    <div class="divide-y divide-slate-100 max-h-80 overflow-y-auto mb-4 scrollbar-none pr-1">
                        @foreach (var item in Cart.Items)
                        {
                            <div @key="item.VariantId" class="py-3 flex items-center justify-between gap-3 text-xs">
                                <div class="flex items-center gap-3 min-w-0">
                                    <img src="@item.Image" alt="@item.Name" class="size-12 shrink-0 rounded-lg object-contain bg-slate-50 border p-1" />
                                    <div class="min-w-0">
                                        <strong class="text-slate-900 block font-semibold truncate">@item.Name</strong>
                                        <span class="text-slate-400 block mt-0.5">@item.Variant · Qty: @item.Quantity</span>
                                    </div>
                                </div>
                                <span class="font-bold text-slate-900 tabular-nums shrink-0">৳@item.LineTotal.ToString("N0")</span>
                            </div>
                        }
                    </div>

                    <!-- Coupon Promo Box -->
                    <div class="border-t border-slate-100 pt-4 mb-4">
                        <label class="field-label flex items-center justify-between text-xs">
                            <span>Promo / Discount Coupon</span>
                            @if (!string.IsNullOrEmpty(appliedCouponCode))
                            {
                                <span class="text-emerald-600 font-bold text-[11px]">Applied: @appliedCouponCode</span>
                            }
                        </label>
                        <div class="flex items-center gap-2 mt-1">
                            <input
                                type="text"
                                class="field uppercase font-mono text-xs !py-2"
                                placeholder="e.g. WELCOME200"
                                @bind="couponInput"
                                disabled="@isSubmitting"
                            />
                            <button
                                type="button"
                                class="btn-secondary text-xs px-3.5 py-2 shrink-0 font-bold"
                                @onclick="ApplyCoupon"
                                disabled="@(isSubmitting || string.IsNullOrWhiteSpace(couponInput))"
                            >
                                Apply
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(couponMessage))
                        {
                            <p class="text-[11px] font-semibold @(couponDiscount > 0 ? "text-emerald-600" : "text-rose-600") mt-1.5 flex items-center gap-1">
                                <span>@couponMessage</span>
                            </p>
                        }
                    </div>

                    <!-- Totals Breakdown -->
                    <div class="border-t border-slate-200 pt-4 space-y-2 text-xs">
                        <div class="flex items-center justify-between text-slate-600">
                            <span>Cart Subtotal</span>
                            <span class="font-semibold text-slate-900 tabular-nums">৳@Cart.Total.ToString("N0")</span>
                        </div>

                        <div class="flex items-center justify-between text-slate-600">
                            <span>
                                Delivery Fee
                                <strong class="text-slate-800 font-semibold ml-1">
                                    (@(deliveryFee == 0 ? "FREE" : (isHubDistrict ? $"{deliverySettings.HubDistrict} Hub" : "Outside Hub")))
                                </strong>
                            </span>
                            <span class="font-semibold text-slate-900 tabular-nums">
                                @(deliveryFee == 0 ? "FREE" : $"৳{deliveryFee:N0}")
                            </span>
                        </div>

                        @if (couponDiscount > 0)
                        {
                            <div class="flex items-center justify-between text-emerald-600 font-semibold">
                                <span>Coupon Discount (@appliedCouponCode)</span>
                                <span class="tabular-nums">-৳@couponDiscount.ToString("N0")</span>
                            </div>
                        }

                        <div class="border-t border-slate-200 pt-3 flex items-center justify-between text-sm">
                            <span class="font-bold text-slate-900">Total Order Amount</span>
                            <span class="font-extrabold text-blue-600 text-xl tabular-nums">৳@total.ToString("N0")</span>
                        </div>

                        <!-- Payment Breakdown -->
                        <div class="rounded-xl bg-slate-50 border border-slate-200 p-3 mt-3 text-[11px] space-y-1">
                            @if (selectedPaymentMode == PaymentModeOption.AdvanceDeliveryFee)
                            {
                                <div class="flex justify-between font-bold text-slate-800">
                                    <span>Pay Now via bKash:</span>
                                    <span class="text-blue-600">৳@deliverySettings.AdvanceAmount.ToString("N0")</span>
                                </div>
                                <div class="flex justify-between text-slate-600">
                                    <span>Cash on Delivery (Courier):</span>
                                    <span class="font-semibold">৳@Math.Max(0, total - deliverySettings.AdvanceAmount).ToString("N0")</span>
                                </div>
                            }
                            else if (selectedPaymentMode == PaymentModeOption.FullPayment)
                            {
                                <div class="flex justify-between font-bold text-slate-800">
                                    <span>Pay Full Amount Now (bKash):</span>
                                    <span class="text-emerald-700">৳@total.ToString("N0")</span>
                                </div>
                                <div class="flex justify-between text-slate-600">
                                    <span>Due on Delivery:</span>
                                    <span class="font-semibold text-emerald-600">৳0 (Prepaid)</span>
                                </div>
                            }
                            else
                            {
                                <div class="flex justify-between font-bold text-slate-800">
                                    <span>Pay on Delivery (COD):</span>
                                    <span class="text-slate-900">৳@total.ToString("N0")</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Right Column: Delivery Information & Payment Method -->
            <section class="lg:col-span-7 space-y-6">
                <!-- 1. Delivery Details Card -->
                <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs">
                    <div class="flex items-center gap-3 mb-6 pb-3 border-b border-slate-100">
                        <span class="flex size-9 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                            <Icon Name="map-pin" Class="size-5" />
                        </span>
                        <div>
                            <h2 class="font-bold text-slate-900 text-lg">1. Delivery Location</h2>
                            <span class="text-xs text-slate-500">Select Division, District &amp; Thana</span>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="grid gap-4 sm:grid-cols-2">
                            <div>
                                <label class="field-label">Recipient Full Name *</label>
                                <input type="text" class="field" @bind="customerName" placeholder="Recipient Name" />
                            </div>
                            <div>
                                <label class="field-label">Contact Mobile Number *</label>
                                <input type="tel" class="field" @bind="phoneNumber" placeholder="017xxxxxxxx" />
                            </div>
                        </div>

                        <!-- 3-Tier Bangladesh Location Cascading Selects -->
                        <div class="grid gap-4 sm:grid-cols-3">
                            <div>
                                <label class="field-label">Division *</label>
                                <select class="field" value="@selectedDivision" @onchange="OnDivisionChanged">
                                    @foreach (var div in BangladeshLocationService.Divisions)
                                    {
                                        <option value="@div">@div</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="field-label">District *</label>
                                <select class="field" value="@selectedDistrict" @onchange="OnDistrictChanged">
                                    @foreach (var dist in availableDistricts)
                                    {
                                        <option value="@dist">@dist</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="field-label">Thana / Upazila *</label>
                                <select class="field" value="@selectedThana" @onchange="OnThanaChanged">
                                    @foreach (var thana in availableThanas)
                                    {
                                        <option value="@thana">@thana</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="field-label">Detailed Street Address / House / Flat *</label>
                            <textarea class="field min-h-[75px]" @bind="streetAddress" placeholder="e.g. House 14, Road 3, Sector 9, or area/market landmark"></textarea>
                        </div>
                    </div>
                </div>

                <!-- 2. Payment Method Card -->
                <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs">
                    <div class="flex items-center gap-3 mb-6 pb-3 border-b border-slate-100">
                        <span class="flex size-9 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                            <Icon Name="cash" Class="size-5" />
                        </span>
                        <div>
                            <h2 class="font-bold text-slate-900 text-lg">2. Payment Method</h2>
                            <span class="text-xs text-slate-500">Choose bKash advance or full prepayment</span>
                        </div>
                    </div>

                    <!-- Payment Mode Options -->
                    <div class="space-y-3">
                        <!-- Option A: Advance Delivery Fee (৳150) -->
                        <label class="block cursor-pointer">
                            <div class="rounded-2xl border-2 p-4 transition @(selectedPaymentMode == PaymentModeOption.AdvanceDeliveryFee ? "border-blue-600 bg-blue-50/30" : "border-slate-200 hover:border-slate-300 bg-white")">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-3">
                                        <input
                                            type="radio"
                                            name="paymentMode"
                                            checked="@(selectedPaymentMode == PaymentModeOption.AdvanceDeliveryFee)"
                                            @onchange="() => SetPaymentMode(PaymentModeOption.AdvanceDeliveryFee)"
                                            class="size-4 text-blue-600"
                                        />
                                        <div>
                                            <strong class="text-sm font-bold text-slate-900 block">Pay Advance Delivery Fee (৳@deliverySettings.AdvanceAmount.ToString("N0"))</strong>
                                            <span class="text-xs text-slate-500">Product price (৳@Math.Max(0, total - deliverySettings.AdvanceAmount).ToString("N0")) will be paid on delivery.</span>
                                        </div>
                                    </div>
                                    <span class="font-extrabold text-blue-600 text-sm">৳@deliverySettings.AdvanceAmount.ToString("N0")</span>
                                </div>
                            </div>
                        </label>

                        <!-- Option B: Pay Full Amount via bKash -->
                        <label class="block cursor-pointer">
                            <div class="rounded-2xl border-2 p-4 transition @(selectedPaymentMode == PaymentModeOption.FullPayment ? "border-emerald-600 bg-emerald-50/30" : "border-slate-200 hover:border-slate-300 bg-white")">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-3">
                                        <input
                                            type="radio"
                                            name="paymentMode"
                                            checked="@(selectedPaymentMode == PaymentModeOption.FullPayment)"
                                            @onchange="() => SetPaymentMode(PaymentModeOption.FullPayment)"
                                            class="size-4 text-emerald-600"
                                        />
                                        <div>
                                            <strong class="text-sm font-bold text-slate-900 block">Pay Full Amount (৳@total.ToString("N0"))</strong>
                                            <span class="text-xs text-slate-500">100% prepaid order. Receive parcel directly with zero cash collection hassle.</span>
                                        </div>
                                    </div>
                                    <span class="font-extrabold text-emerald-600 text-sm">৳@total.ToString("N0")</span>
                                </div>
                            </div>
                        </label>

                        @if (!deliverySettings.RequireAdvanceForCOD)
                        {
                            <!-- Option C: 100% Cash on Delivery -->
                            <label class="block cursor-pointer">
                                <div class="rounded-2xl border-2 p-4 transition @(selectedPaymentMode == PaymentModeOption.CashOnDelivery ? "border-slate-800 bg-slate-50" : "border-slate-200 hover:border-slate-300 bg-white")">
                                    <div class="flex items-center gap-3">
                                        <input
                                            type="radio"
                                            name="paymentMode"
                                            checked="@(selectedPaymentMode == PaymentModeOption.CashOnDelivery)"
                                            @onchange="() => SetPaymentMode(PaymentModeOption.CashOnDelivery)"
                                            class="size-4 text-slate-800"
                                        />
                                        <div>
                                            <strong class="text-sm font-bold text-slate-900 block">Full Cash on Delivery (COD)</strong>
                                            <span class="text-xs text-slate-500">Pay entire ৳@total.ToString("N0") when courier delivers to your address.</span>
                                        </div>
                                    </div>
                                </div>
                            </label>
                        }
                    </div>

                    @if (selectedPaymentMode != PaymentModeOption.CashOnDelivery)
                    {
                        <!-- bKash Instructions Box -->
                        <div class="mt-5 rounded-2xl border border-blue-200 bg-blue-50/50 p-5 space-y-4">
                            <div class="flex items-center justify-between border-b border-blue-100 pb-3">
                                <div class="flex items-center gap-2">
                                    <span class="font-bold text-slate-900 text-sm">bKash Payment Details</span>
                                </div>
                                <span class="text-xs font-mono font-bold text-blue-700 bg-white px-2 py-0.5 rounded border border-blue-200">
                                    Amount to send: ৳@(selectedPaymentMode == PaymentModeOption.FullPayment ? total.ToString("N0") : deliverySettings.AdvanceAmount.ToString("N0"))
                                </span>
                            </div>

                            <div class="space-y-1.5 text-xs text-slate-700">
                                <div class="flex items-center gap-2">
                                    <span class="text-slate-500">bKash Number:</span>
                                    <strong class="font-mono text-sm font-bold text-slate-900 bg-white px-2 py-0.5 rounded border">@deliverySettings.BkashNumber</strong>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-slate-500">Order Reference:</span>
                                    <strong class="font-mono font-bold text-blue-700 bg-white px-2 py-0.5 rounded border">@referenceCode</strong>
                                </div>
                                <p class="text-[11px] text-slate-500 pt-1">
                                    Go to bKash app → Send Money to <strong>@deliverySettings.BkashNumber</strong> → Enter Amount &amp; Reference <strong>@referenceCode</strong> → Paste the Transaction ID below.
                                </p>
                            </div>

                            <!-- Customer Input Fields -->
                            <div class="grid gap-3 sm:grid-cols-2 pt-2">
                                <div>
                                    <label class="field-label text-xs">Sender bKash Number *</label>
                                    <input type="tel" class="field text-xs" @bind="senderPhoneNumber" placeholder="01xxxxxxxxx" />
                                </div>
                                <div>
                                    <label class="field-label text-xs">Transaction ID (TrxID) *</label>
                                    <input type="text" class="field text-xs font-mono uppercase" @bind="transactionId" placeholder="e.g. 9K48X7Q2" />
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Single Place Order Button -->
                    <div class="mt-6 pt-4 border-t border-slate-100">
                        <button
                            type="button"
                            class="btn-primary w-full py-3.5 text-sm sm:text-base font-bold shadow-md flex items-center justify-center gap-2"
                            @onclick="PlaceOrder"
                            disabled="@isSubmitting"
                        >
                            @if (isSubmitting)
                            {
                                <span class="inline-block size-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                <span>Processing Your Order...</span>
                            }
                            else
                            {
                                <span>Confirm &amp; Place Order · ৳@total.ToString("N0")</span>
                            }
                        </button>
                    </div>
                </div>
            </section>
        </div>
    }
</div>

@code
{
    private enum PaymentModeOption
    {
        AdvanceDeliveryFee,
        FullPayment,
        CashOnDelivery
    }

    private DeliverySettings? deliverySettings;
    private bool cartReady;
    private bool isSubmitting;
    private string? error;

    // Delivery fields
    private string customerName = "";
    private string phoneNumber = "";
    private string selectedDivision = "Khulna";
    private string selectedDistrict = "Khulna";
    private string selectedThana = "Khulna Sadar";
    private string streetAddress = "";

    // Lists
    private IReadOnlyList<string> availableDistricts = [];
    private IReadOnlyList<string> availableThanas = [];

    // Payment fields
    private PaymentModeOption selectedPaymentMode = PaymentModeOption.AdvanceDeliveryFee;
    private string referenceCode = "";
    private string senderPhoneNumber = "";
    private string transactionId = "";

    // Coupon fields
    private string couponInput = "";
    private string? appliedCouponCode;
    private decimal couponDiscount;
    private string? couponMessage;

    // Totals
    private decimal deliveryFee;
    private decimal total;
    private bool isHubDistrict;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        deliverySettings = await DeliverySettingsSvc.GetSettingsAsync();
        referenceCode = $"JAS{Math.Abs(DateTime.UtcNow.Ticks % 9000 + 1000)}";

        availableDistricts = BangladeshLocationService.GetDistricts(selectedDivision);
        availableThanas = BangladeshLocationService.GetThanas(selectedDistrict);

        Cart.OnChange += OnCartChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Cart.InitializeAsync();

            // Try pre-filling user address if authenticated
            if (AuthStateTask != null)
            {
                var auth = await AuthStateTask;
                var userId = auth?.User != null ? ShoppingService.UserId(auth.User) : null;
                if (userId.HasValue)
                {
                    var addr = await Db.DeliveryAddresses.FirstOrDefaultAsync(d => d.CustomerId == userId.Value);
                    if (addr != null)
                    {
                        customerName = addr.CustomerName;
                        phoneNumber = addr.PhoneNumber;
                        streetAddress = addr.FullAddress;
                        if (!string.IsNullOrWhiteSpace(addr.Division)) selectedDivision = addr.Division;
                        availableDistricts = BangladeshLocationService.GetDistricts(selectedDivision);
                        if (!string.IsNullOrWhiteSpace(addr.District)) selectedDistrict = addr.District;
                        availableThanas = BangladeshLocationService.GetThanas(selectedDistrict);
                        if (!string.IsNullOrWhiteSpace(addr.Thana)) selectedThana = addr.Thana;
                    }
                }
            }

            cartReady = true;
            UpdateDeliveryAndTotal();
            StateHasChanged();
        }
    }

    private void OnCartChanged()
    {
        UpdateDeliveryAndTotal();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnDivisionChanged(ChangeEventArgs e)
    {
        selectedDivision = e.Value?.ToString() ?? "Khulna";
        availableDistricts = BangladeshLocationService.GetDistricts(selectedDivision);
        selectedDistrict = availableDistricts.FirstOrDefault() ?? "";
        availableThanas = BangladeshLocationService.GetThanas(selectedDistrict);
        selectedThana = availableThanas.FirstOrDefault() ?? "";
        UpdateDeliveryAndTotal();
    }

    private void OnDistrictChanged(ChangeEventArgs e)
    {
        selectedDistrict = e.Value?.ToString() ?? "";
        availableThanas = BangladeshLocationService.GetThanas(selectedDistrict);
        selectedThana = availableThanas.FirstOrDefault() ?? "";
        UpdateDeliveryAndTotal();
    }

    private void OnThanaChanged(ChangeEventArgs e)
    {
        selectedThana = e.Value?.ToString() ?? "";
    }

    private void SetPaymentMode(PaymentModeOption mode)
    {
        selectedPaymentMode = mode;
        StateHasChanged();
    }

    private void UpdateDeliveryAndTotal()
    {
        if (deliverySettings == null) return;

        isHubDistrict = string.Equals(selectedDistrict.Trim(), deliverySettings.HubDistrict.Trim(), StringComparison.OrdinalIgnoreCase);

        if (deliverySettings.FreeDeliveryThreshold.HasValue && deliverySettings.FreeDeliveryThreshold.Value > 0 && Cart.Total >= deliverySettings.FreeDeliveryThreshold.Value)
        {
            deliveryFee = 0m;
        }
        else if (isHubDistrict)
        {
            deliveryFee = deliverySettings.HubCityFee;
        }
        else
        {
            deliveryFee = deliverySettings.OutsideFee;
        }

        total = Math.Max(0, Cart.Total + deliveryFee - couponDiscount);
    }

    private async Task ApplyCoupon()
    {
        if (string.IsNullOrWhiteSpace(couponInput)) return;
        var res = await CouponSvc.ValidateCouponAsync(couponInput, Cart.Total, deliveryFee);
        if (res.IsValid)
        {
            appliedCouponCode = res.Code;
            couponDiscount = res.DiscountAmount;
            couponMessage = $"✓ {res.Message}";
            UpdateDeliveryAndTotal();
        }
        else
        {
            couponMessage = res.Message;
            couponDiscount = 0;
            appliedCouponCode = null;
            UpdateDeliveryAndTotal();
        }
    }

    private async Task PlaceOrder()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(customerName))
        {
            error = "Please enter the recipient full name.";
            return;
        }
        if (string.IsNullOrWhiteSpace(phoneNumber) || !System.Text.RegularExpressions.Regex.IsMatch(phoneNumber.Trim(), @"^(?:\+?88)?01[3-9]\d{8}$"))
        {
            error = "Please enter a valid 11-digit Bangladesh phone number (01xxxxxxxxx).";
            return;
        }
        if (string.IsNullOrWhiteSpace(streetAddress))
        {
            error = "Please enter your detailed street/house address.";
            return;
        }

        if (selectedPaymentMode != PaymentModeOption.CashOnDelivery)
        {
            if (string.IsNullOrWhiteSpace(senderPhoneNumber))
            {
                error = "Please enter the sender bKash number.";
                return;
            }
            if (string.IsNullOrWhiteSpace(transactionId))
            {
                error = "Please enter the bKash Transaction ID (TrxID).";
                return;
            }
        }

        isSubmitting = true;
        StateHasChanged();

        try
        {
            int? userId = null;
            if (AuthStateTask != null)
            {
                var auth = await AuthStateTask;
                if (auth?.User != null)
                {
                    userId = ShoppingService.UserId(auth.User);
                }
            }

            var checkoutToken = await Cart.CheckoutTokenAsync();
            var checkoutRequest = new CheckoutRequest
            {
                RequestId = checkoutToken,
                CustomerName = customerName.Trim(),
                PhoneNumber = phoneNumber.Trim(),
                Division = selectedDivision,
                District = selectedDistrict,
                Thana = selectedThana,
                City = selectedThana,
                Address = streetAddress.Trim(),
                CouponCode = appliedCouponCode,
                PaymentMethod = selectedPaymentMode == PaymentModeOption.FullPayment ? "FullPayment" : (selectedPaymentMode == PaymentModeOption.AdvanceDeliveryFee ? "BkashAdvance" : "COD"),
                SenderPhoneNumber = senderPhoneNumber?.Trim(),
                TransactionId = transactionId?.Trim().ToUpperInvariant(),
                Items = Cart.Items.Select(i => new CartLineRequest(i.VariantId, i.Quantity)).ToList(),
                ExpectedTotal = total
            };

            var result = await Shop.CheckoutAsync(userId, checkoutRequest);
            await Cart.CompleteCheckoutAsync(checkoutToken);

            try
            {
                await JS.InvokeVoidAsync("window.jasRecordGuestOrder", result.OrderId, result.PublicToken.ToString(), result.Total);
            }
            catch
            {
                // ignore
            }

            Nav.NavigateTo($"/order/{result.PublicToken}");
        }
        catch (ShopException ex)
        {
            error = ex.Message;
            isSubmitting = false;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            isSubmitting = false;
        }
    }

    public void Dispose()
    {
        Cart.OnChange -= OnCartChanged;
    }
}
