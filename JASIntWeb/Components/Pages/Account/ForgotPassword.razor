@page "/account/forgot-password"
@inject UserManager<User> Users
@inject AccountMailService Mail
@inject ILogger<ForgotPassword> Logger

<PageTitle>Reset password — JAS International</PageTitle>
<div class="shop-container">
    <div class="shop-panel mx-auto max-w-md">
        <h1 class="text-3xl font-semibold">Reset password</h1>
        <p class="mt-4 text-sm text-slate-500">Enter your email to request a password reset link.</p>
        @if (message is not null)
        {
            <p role="status" class="form-notice">@message</p>
        }
        @if (Input is null)
        {
            <p class="admin-help">Loading form…</p>
        }
        else
        {
            <EditForm Model="Input" OnValidSubmit="Submit" FormName="forgot-password" method="post" Enhance class="mt-6">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <label class="shop-label">
                    Email
                    <InputText @bind-Value="Input!.Email" type="email" autocomplete="email" class="shop-input" />
                </label>
                <button class="shop-button" type="submit">Send reset link</button>
            </EditForm>
        }
        <a href="/account/login" class="mt-5 inline-block text-sm text-volt">Back to sign in</a>
    </div>
</div>

@code
{
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "forgot-password")]
    private EmailForm? Input { get; set; }
    private string? message;

    protected override void OnInitialized() => Input ??= new();

    private async Task Submit()
    {
        if (!Mail.IsConfigured)
        {
            message = "Email delivery is not configured. Contact the shop for help.";
            return;
        }
        var user = await Users.FindByEmailAsync(Input!.Email.Trim());
        if (user is not null)
        {
            var code = Microsoft.AspNetCore.WebUtilities.WebEncoders.Base64UrlEncode(System.Text.Encoding.UTF8.GetBytes(await Users.GeneratePasswordResetTokenAsync(user)));
            var link = Mail.Link("/account/reset-password?email=" + Uri.EscapeDataString(user.Email!) + "&code=" + Uri.EscapeDataString(code), Http.Request);
            try
            {
                await Mail.SendAsync(user.Email!,
                    "Reset your JAS International password",
                    "Reset your password: " + link + "\nIf you did not request this, ignore this email.");
            }
            catch (System.Net.Mail.SmtpException ex)
            {
                Logger.LogError(ex, "Password reset email delivery failed");
            }
        }
        message = "If that account exists, a password reset email has been requested.";
    }
}
