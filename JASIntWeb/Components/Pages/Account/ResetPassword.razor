@page "/account/reset-password"
@inject UserManager<User> Users
@inject NavigationManager Navigation

<div class="shop-container">
    <div class="shop-panel mx-auto max-w-md">
        <h1 class="text-3xl font-semibold">Choose a new password</h1>
        @if (error is not null)
        {
            <p role="alert" class="form-error">@error</p>
        }
        @if (Input is null)
        {
            <p class="admin-help">Loading form…</p>
        }
        else
        {
            <EditForm Model="Input" OnValidSubmit="Submit" FormName="reset-password" method="post" Enhance class="mt-6">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <InputText @bind-Value="Input!.Email" type="hidden" />
                <InputText @bind-Value="Input!.Code" type="hidden" />
                <label class="shop-label">
                    Password
                    <InputText @bind-Value="Input!.Password" type="password" autocomplete="new-password" class="shop-input" />
                </label>
                <label class="shop-label">
                    Confirm password
                    <InputText @bind-Value="Input!.ConfirmPassword" type="password" autocomplete="new-password" class="shop-input" />
                </label>
                <button class="shop-button" type="submit">Reset password</button>
            </EditForm>
        }
    </div>
</div>

@code
{
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }
    [SupplyParameterFromForm(FormName = "reset-password")]
    private ResetPasswordForm? Input { get; set; }
    private string? error;

    protected override void OnInitialized() => Input ??= new()
    {
        Email = Email ?? "",
        Code = Code ?? ""
    };

    private async Task Submit()
    {
        var user = await Users.FindByEmailAsync(Input!.Email.Trim());
        try
        {
            var token = System.Text.Encoding.UTF8.GetString(Microsoft.AspNetCore.WebUtilities.WebEncoders.Base64UrlDecode(Input.Code));
            if (user is not null)
            {
                var result = await Users.ResetPasswordAsync(user, token, Input.Password);
                if (result.Succeeded)
                {
                    Navigation.NavigateTo("/account/login?notice=" + Uri.EscapeDataString("Password reset successfully. Sign in with your new password."), forceLoad: true);
                    return;
                }
                else
                {
                    error = string.Join(" ", result.Errors.Select(e => e.Description));
                }
            }
        }
        catch (FormatException)
        {
        }
        error ??= "This link is invalid or expired. Request another password reset.";
        Input.Password = Input.ConfirmPassword = "";
    }
}
