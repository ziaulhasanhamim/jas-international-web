@page "/account/signup"
@inject UserManager<User> Users
@inject SignInManager<User> SignIn

<PageTitle>Create Account · JAS International</PageTitle>

<div class="shop-container py-12 min-h-[75vh] flex items-center justify-center">
    <div class="w-full max-w-md">
        <!-- Logo and Heading -->
        <div class="text-center mb-8">
            <a href="/" class="inline-flex items-center gap-3 mb-4">
                <img src="/jas-logo.png" alt="JAS International" class="size-12 rounded-xl shadow-xs" />
                <div class="text-left leading-none">
                    <span class="font-display font-bold text-2xl text-blue-600 block">JAS</span>
                    <span class="text-[10px] font-bold uppercase tracking-widest text-slate-500">International</span>
                </div>
            </a>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Create an Account</h1>
            <p class="text-xs text-slate-500 mt-1">Join JAS International to track orders and save your delivery details.</p>
        </div>

        <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs">
            @if (completed)
            {
                <SessionRedirect Destination="/account" />
            }
            else
            {
                @if (error is not null)
                {
                    <div class="mb-5 rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs text-rose-700 flex items-start gap-2.5" role="alert">
                        <Icon Name="alert" Class="size-4 shrink-0 mt-0.5" />
                        <div>
                            <strong class="font-semibold block">Registration Error</strong>
                            <span>@error</span>
                        </div>
                    </div>
                }

                @if (Input is null)
                {
                    <p class="text-xs text-slate-400">Loading form…</p>
                }
                else
                {
                    <EditForm Model="Input" OnValidSubmit="Submit" FormName="signup" method="post" Enhance data-submit-indication="true" class="space-y-4">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-xs text-rose-600 mb-2" />

                        <div>
                            <label class="field-label">Full Name</label>
                            <InputText @bind-Value="Input!.FullName" class="field" placeholder="e.g. Tanvir Ahmed" />
                        </div>

                        <div>
                            <label class="field-label">Mobile Phone Number</label>
                            <InputText @bind-Value="Input!.PhoneNumber" type="tel" class="field" placeholder="017xxxxxxxx" />
                        </div>

                        <div>
                            <label class="field-label">Email Address</label>
                            <InputText @bind-Value="Input!.Email" type="email" autocomplete="username" class="field" placeholder="you@example.com" />
                        </div>

                        <div>
                            <label class="field-label">Password</label>
                            <InputText @bind-Value="Input!.Password" type="password" autocomplete="new-password" class="field" placeholder="At least 8 characters" />
                        </div>

                        <div>
                            <label class="field-label">Confirm Password</label>
                            <InputText @bind-Value="Input!.ConfirmPassword" type="password" autocomplete="new-password" class="field" placeholder="Re-type password" />
                        </div>

                        <button class="btn-primary w-full shadow-xs mt-2" type="submit" data-pending-text="Creating account...">
                            <span class="form-submit-spinner" hidden></span>
                            <span>Create Customer Account</span>
                        </button>
                    </EditForm>
                }

                <div class="my-5 flex items-center">
                    <div class="flex-1 border-t border-slate-200"></div>
                    <span class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">or</span>
                    <div class="flex-1 border-t border-slate-200"></div>
                </div>

                <a href="/account/external-login?provider=Google" class="flex w-full items-center justify-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 hover:bg-slate-50 transition shadow-2xs">
                    <svg class="size-4" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>Sign up with Google</span>
                </a>

                <div class="mt-6 pt-5 border-t border-slate-100 text-center text-xs text-slate-500">
                    Already have an account?
                    <a href="/account/login" class="text-blue-600 font-semibold hover:underline ml-1">Sign in here</a>
                </div>
            }
        </div>
    </div>
</div>

@code
{
    [SupplyParameterFromForm(FormName = "signup")]
    private SignupForm? Input { get; set; }
    private string? error;
    private bool completed;

    protected override void OnInitialized() => Input ??= new();

    private async Task Submit()
    {
        var email = Input!.Email.Trim();
        var user = new User
        {
            UserName = email,
            Email = email,
            PhoneNumber = Input.PhoneNumber.Trim()
        };
        var result = await Users.CreateAsync(user, Input.Password);
        if (result.Succeeded)
        {
            if (!string.IsNullOrWhiteSpace(Input.FullName))
            {
                await Users.AddClaimAsync(user, new System.Security.Claims.Claim("name", Input.FullName.Trim()));
            }
            await SignIn.SignInAsync(user, false);
            completed = true;
        }
        else
        {
            error = string.Join(" ", result.Errors.Select(e => e.Description));
        }
        Input.Password = Input.ConfirmPassword = "";
    }
}
