@page "/account/login"
@inject UserManager<User> Users
@inject SignInManager<User> SignIn
@inject EmailVerificationService Verification
@inject NavigationManager Navigation

<PageTitle>Sign In · JAS International</PageTitle>

<div class="shop-container py-12 min-h-[75vh] flex items-center justify-center">
    <div class="w-full max-w-md">
        <!-- Logo and Heading -->
        <div class="text-center mb-8">
            <a href="/" class="inline-flex items-center gap-3 mb-4">
                <img src="/jas-logo.png" alt="JAS International" class="size-11 object-contain" />
                <div class="text-left leading-none">
                    <span class="font-display font-bold text-2xl text-blue-600 block">JAS</span>
                    <span class="text-[10px] font-bold uppercase tracking-widest text-slate-500">International</span>
                </div>
            </a>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Welcome Back</h1>
            <p class="text-xs text-slate-500 mt-1">Sign in to manage your orders, saved addresses, and profile.</p>
        </div>

        <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs">
            @if (error is not null)
            {
                <div class="mb-5 rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs text-rose-700 flex items-start gap-2.5" role="alert">
                    <Icon Name="alert" Class="size-4 shrink-0 mt-0.5" />
                    <div>
                        <strong class="font-semibold block">Authentication Error</strong>
                        <span>@error</span>
                    </div>
                </div>
            }

                @if (Input is null)
                {
                    <p class="text-xs text-slate-400">Loading form…</p>
                }
                else
                {
                    <EditForm Model="Input" OnValidSubmit="Submit" FormName="login" method="post" Enhance data-submit-indication="true" class="space-y-4">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-xs text-rose-600 mb-2" />

                        <div>
                            <label class="field-label">Email Address</label>
                            <InputText @bind-Value="Input!.Email" type="email" autocomplete="username" class="field" placeholder="you@example.com" />
                        </div>

                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <label class="text-sm font-medium text-slate-700">Password</label>
                                <a href="/account/forgot-password" class="text-xs text-blue-600 hover:underline">Forgot password?</a>
                            </div>
                            <InputText @bind-Value="Input!.Password" type="password" autocomplete="current-password" class="field" placeholder="••••••••" />
                        </div>

                        <div class="flex items-center justify-between pt-1">
                            <label class="inline-flex items-center gap-2 text-xs text-slate-600 cursor-pointer">
                                <input type="checkbox" name="Input.Remember" checked="@(Input!.Remember)" value="true" class="size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                                <input type="hidden" name="Input.Remember" value="false" />
                                <span>Remember my login</span>
                            </label>
                        </div>

                        <button class="btn-primary w-full shadow-xs mt-2" type="submit" data-pending-text="Signing in...">
                            <span class="form-submit-spinner" hidden></span>
                            <span>Sign In to Account</span>
                        </button>
                    </EditForm>
                }

                <div class="my-5 flex items-center">
                    <div class="flex-1 border-t border-slate-200"></div>
                    <span class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">or</span>
                    <div class="flex-1 border-t border-slate-200"></div>
                </div>

                <a href="/account/external-login?provider=Google&returnUrl=@Uri.EscapeDataString(AccountNavigation.SafeReturn(ReturnUrl))" class="flex w-full items-center justify-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 hover:bg-slate-50 transition shadow-2xs">
                    <svg class="size-4" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>Continue with Google</span>
                </a>

                <div class="mt-6 pt-5 border-t border-slate-100 text-center text-xs text-slate-500">
                    Don't have an account yet?
                    <a href="/account/signup" class="text-blue-600 font-semibold hover:underline ml-1">Create an account</a>
                </div>
        </div>
    </div>
</div>

@code
{
    [SupplyParameterFromForm(FormName = "login")]
    private LoginForm? Input { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")]
    public string? ExternalError { get; set; }
    private string? error;

    protected override void OnInitialized()
    {
        Input ??= new();
        if (!string.IsNullOrWhiteSpace(ExternalError))
        {
            error = ExternalError;
        }
    }

    private async Task Submit()
    {
        error = null;
        var email = Input!.Email.Trim();
        var user = await Users.FindByEmailAsync(email);
        if (user is not null)
        {
            var passwordValid = await Users.CheckPasswordAsync(user, Input.Password);
            if (passwordValid)
            {
                if (!user.EmailConfirmed)
                {
                    await Verification.GenerateAndSendCodeAsync(user.Email!);
                    Navigation.NavigateTo($"/account/signup?step=verify&email={Uri.EscapeDataString(user.Email!)}&notice=unconfirmed&returnUrl={Uri.EscapeDataString(ReturnUrl ?? "")}");
                    return;
                }

                var result = await SignIn.PasswordSignInAsync(user, Input.Password, Input.Remember, lockoutOnFailure: true);
                if (result.Succeeded)
                {
                    Navigation.NavigateTo(AccountNavigation.SafeReturn(ReturnUrl), forceLoad: true);
                    return;
                }
                if (result.IsLockedOut)
                {
                    error = "Your account is temporarily locked due to multiple failed login attempts. Please try again later.";
                    return;
                }
            }
        }

        error = "Email or password is incorrect.";
        Input.Password = "";
    }
}
