@page "/product/{Slug}"
@inject JASIntWeb.Services.CatalogService Catalog
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities

@if (product is null)
{
    <PageTitle>Product not found — JAS International</PageTitle>
    <div class="shop-container">
        <h1 class="text-3xl font-semibold">Product not found</h1>
        <a href="/products" class="text-volt">Browse products</a>
    </div>
}
else
{
    <PageTitle>@product.Name — JAS International</PageTitle>
    <div class="shop-container">
        <nav aria-label="Breadcrumb" class="shop-breadcrumb mb-6">
            <a href="/products">Products</a>
            @foreach (var category in product.Breadcrumbs)
            {
                <span aria-hidden="true">/</span>
                <a href="/category/@category.Slug">@category.Name</a>
            }
            <span aria-hidden="true">/</span>
            <span aria-current="page">@product.Name</span>
        </nav>
        <div class="grid gap-10 lg:grid-cols-2">
            <div>
                <div class="product-gallery aspect-square overflow-hidden rounded-2xl">
                    <img
                        src="@image"
                        alt="@product.Name"
                        fetchpriority="high"
                        decoding="async"
                        width="640"
                        height="640"
                        class="h-full w-full object-contain"
                    />
                </div>
                <div class="mt-4 flex gap-3 overflow-x-auto">
                    @for (var i = 0; i < product.Images.Count; i++)
                    {
                        var index = i;
                        <a
                            href="@Nav.GetUriWithQueryParameter("image", index)"
                            aria-label="View image @(index + 1)"
                            class="h-20 w-20 shrink-0 rounded-xl border bg-white"
                        >
                            <img
                                src="@product.Images[index]"
                                alt="@product.Name"
                                loading="lazy"
                                decoding="async"
                                width="80"
                                height="80"
                                class="h-full w-full object-contain"
                            />
                        </a>
                    }
                </div>
            </div>
            <div>
                <p class="text-sm uppercase tracking-widest text-volt">@product.Category</p>
                <h1 class="font-display mt-2 text-4xl font-semibold">@product.Name</h1>
                <p class="mt-4 text-sm text-slate-600">@product.Description</p>
                <p class="mt-6 text-3xl font-semibold text-volt">@(selected is { Stock: > 0 } ? "৳" + selected.Price.ToString("N0") : "N/A")</p>
                @if (selected is not null)
                {
                    <p class="mt-2 text-xs text-slate-500">SKU: @selected.Sku</p>
                }
                @foreach (var definition in product.Attributes)
                {
                    <div class="mt-6">
                        <h2 class="mb-3 text-sm font-semibold">@definition.Name</h2>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var option in definition.Values)
                            {
                                var active = choices.GetValueOrDefault(definition.Code) == option.Code;
                                <a
                                    href="@ProductOptions.OptionUrl(product, choices, definition.Code, option.Code)"
                                    aria-current="@(active ? "true" : "false")"
                                    class="product-option @(active ? "is-selected" : "")"
                                >
                                    @option.Value
                                </a>
                            }
                            @if (!definition.IsRequired)
                            {
                                <a
                                    href="@ProductOptions.OptionUrl(product, choices, definition.Code, "")"
                                    aria-current="@(!choices.ContainsKey(definition.Code) ? "true" : "false")"
                                    class="product-option @(!choices.ContainsKey(definition.Code) ? "is-selected" : "")"
                                >
                                    Not applicable
                                </a>
                            }
                        </div>
                    </div>
                }
                @if (selected is null || selected.Stock <= 0)
                {
                    <div role="status" class="availability-note mt-6">
                        <strong>Unavailable</strong>
                        <p>@(selected is null ? "This combination is not offered. Your choices are kept — change any option to try another combination." : "This combination is currently out of stock.")</p>
                    </div>
                    <button type="button" disabled class="shop-button mt-5 w-full">Add to cart</button>
                }
                else
                {
                    <p class="mt-6 text-sm @(selected.Stock > 0 ? "text-green-700" : "text-red-600")">@(selected.Stock > 0 ? $"In stock — {selected.Stock} available" : "Out of stock")</p>
                    <AddToCart @key="selected.Id" VariantId="selected.Id" Stock="selected.Stock" />
                }
                <div class="mt-6 grid grid-cols-2 gap-3 border-y border-slate-200 py-5 text-center text-sm">
                    <p>Nationwide delivery</p>
                    <p>Cash on delivery</p>
                </div>
            </div>
        </div>
        <section class="mt-12 border-t border-slate-200 pt-8">
            <h2 class="text-xl font-semibold">Product details</h2>
            <p class="mt-4 whitespace-pre-line leading-7 text-slate-600">@product.Details</p>
        </section>
    </div>
}

@code
{
    [Parameter]
    public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "image")]
    public int? ImageIndex { get; set; }
    private ProductDetailsDto? product;
    private ProductVariantDto? selected;
    private Dictionary<string, string> choices = [];
    private string image = "";

    protected override async Task OnInitializedAsync()
    {
        product = await Catalog.DetailsAsync(Slug);
        if (product is null)
        {
            return;
        }
        var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        var requested = new Dictionary<string, string>();
        foreach (var definition in product.Attributes)
        {
            if (query.TryGetValue("attribute-" + definition.Code, out var value) || query.TryGetValue(definition.Code, out value))
            {
                requested[definition.Code] = value.ToString();
            }
        }
        choices = ProductOptions.Selection(product, requested);
        selected = ProductOptions.Match(product, choices);
        image = product.Images.ElementAtOrDefault(ImageIndex ?? 0) ?? product.MainImage;
    }
}
