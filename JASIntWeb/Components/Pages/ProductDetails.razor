@page "/product/{Slug}"
@inject NavigationManager NavManager

<PageTitle>@Product.Name — JAS International</PageTitle>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm text-slate-500">
        <a href="/products" class="hover:text-ink">Products</a>
        <span class="mx-2">/</span>
        <a href="/products/@Product.CategorySlug" class="hover:text-ink">
            @Product.Category
        </a>
        <span class="mx-2">/</span>
        <span class="text-slate-700">@Product.Name</span>
    </nav>


    <!-- Product -->
    <div class="grid gap-10 lg:grid-cols-2">

        <!-- ===================== -->
        <!-- IMAGE GALLERY -->
        <!-- ===================== -->

        <div>

            <!-- Main image -->
            <div class="aspect-square overflow-hidden rounded-2xl
                bg-slate-50">

                <img src="@SelectedImage" alt="@Product.Name" class="h-full w-full object-contain" />

            </div>


            <!-- Thumbnails -->
            <div class="mt-4 flex gap-3 overflow-x-auto pb-1">

                @foreach (var image in Product.Images)
                {
                    <button type="button" @onclick="() => SelectImage(image)" class="h-20 w-20 shrink-0 overflow-hidden
                        rounded-xl border-2 bg-slate-50
                        @(SelectedImage == image
                                        ? "border-ink"
                                        : "border-transparent")">

                        <img src="@image" alt="@Product.Name" class="h-full w-full object-contain" />

                    </button>
                }

            </div>

        </div>


        <!-- ===================== -->
        <!-- PRODUCT INFORMATION -->
        <!-- ===================== -->

        <div>

            <!-- Brand -->
            <p class="text-xs font-semibold uppercase
                tracking-[0.2em] text-volt">
                @Product.Brand
            </p>

            <!-- Name -->
            <h1 class="font-display mt-2 text-3xl font-semibold
                tracking-tight sm:text-4xl">
                @Product.Name
            </h1>


            <!-- Rating -->
            <div class="mt-3 flex items-center gap-3">

                <div class="flex items-center gap-1 text-amber-500">
                    ★★★★★
                </div>

                <span class="text-sm text-slate-500">
                    4.8 (124 reviews)
                </span>

            </div>


            <!-- Price -->
            <div class="mt-6">

                <span class="text-3xl font-semibold text-ink">
                    ৳@CurrentPrice.ToString("N0")
                </span>

                @if (Product.OldPrice.HasValue)
                {
                    <span class="ml-3 text-lg text-slate-400 line-through">
                        ৳@Product.OldPrice.Value.ToString("N0")
                    </span>
                }

            </div>


            <!-- Short description -->
            <p class="mt-4 text-sm leading-6 text-slate-600">
                @Product.ShortDescription
            </p>


            <div class="my-6 border-t border-slate-200"></div>


            <!-- ===================== -->
            <!-- COLOR -->
            <!-- ===================== -->

            @if (Product.Colors.Count > 0)
            {
                <div>

                    <div class="mb-3 flex items-center justify-between">
                        <span class="text-sm font-semibold">
                            Color
                        </span>

                        <span class="text-sm text-slate-500">
                            @SelectedColor
                        </span>
                    </div>


                    <div class="flex flex-wrap gap-2">

                        @foreach (var color in Product.Colors)
                        {
                            <a href="@NavManager.GetUriWithQueryParameter("color", color)" class="rounded-lg border px-4 py-2
                                text-sm
                                @(SelectedColor == color
                                 ? "border-ink bg-ink text-white"
                                 : "border-slate-200 hover:border-slate-400")">

                                @color

                            </a>
                        }

                    </div>

                </div>
            }


            <!-- ===================== -->
            <!-- WARRANTY -->
            <!-- ===================== -->

            @if (Product.Warranties.Count > 0)
            {
                <div class="mt-6">

                    <div class="mb-3">
                        <span class="text-sm font-semibold">
                            Warranty
                        </span>
                    </div>


                    <div class="grid grid-cols-2 gap-3">

                        @foreach (var warranty in Product.Warranties)
                        {
                            <a href="@NavManager.GetUriWithQueryParameter("warranty-id", warranty.Id)" class="rounded-xl border p-4 text-left
                                @(SelectedWarranty?.Id == warranty.Id
                                                ? "border-ink bg-slate-50"
                                                : "border-slate-200 hover:border-slate-400")">

                                <div class="text-sm font-semibold">
                                    @warranty.Months Months
                                </div>

                                <div class="mt-1 text-xs text-slate-500">
                                    +৳@warranty.AdditionalPrice.ToString("N0")
                                </div>

                            </a>
                        }

                    </div>

                </div>
            }


            <!-- ===================== -->
            <!-- REGION / VARIANT -->
            <!-- ===================== -->

            @if (Product.Regions.Count > 0)
            {
                <div class="mt-6">

                    <div class="mb-3">
                        <span class="text-sm font-semibold">
                            Variant
                        </span>
                    </div>


                    <div class="grid grid-cols-2 gap-3">

                        @foreach (var region in Product.Regions)
                        {
                            <button type="button" @onclick="() => SelectRegion(region)" class="rounded-xl border p-4 text-left
                                @(SelectedRegion == region.Name
                                                ? "border-ink bg-slate-50"
                                                : "border-slate-200 hover:border-slate-400")">

                                <div class="text-sm font-semibold">
                                    @region.Name
                                </div>

                                <div class="mt-1 text-xs text-slate-500">
                                    @region.Description
                                </div>

                            </button>
                        }

                    </div>

                </div>
            }


            <!-- ===================== -->
            <!-- STOCK -->
            <!-- ===================== -->

            <div class="mt-6 flex items-center gap-2 text-sm">

                <span class="h-2 w-2 rounded-full bg-green-500"></span>

                <span class="font-medium text-green-700">
                    In stock
                </span>

                <span class="text-slate-400">
                    •
                </span>

                <span class="text-slate-500">
                    Ready to ship
                </span>

            </div>


            <!-- ===================== -->
            <!-- QUANTITY + CART -->
            <!-- ===================== -->

            <div class="mt-5 flex gap-3">

                <div class="flex h-12 items-center rounded-xl
                    border border-slate-200">

                    <button type="button" @onclick="DecreaseQuantity" class="h-full w-10 text-slate-500 hover:text-ink">
                        −
                    </button>

                    <span class="w-8 text-center text-sm font-medium">
                        @Quantity
                    </span>

                    <button type="button" @onclick="IncreaseQuantity" class="h-full w-10 text-slate-500 hover:text-ink">
                        +
                    </button>

                </div>


                <button type="button" class="flex h-12 flex-1 items-center
                    justify-center rounded-xl
                    bg-ink px-6 text-sm font-semibold
                    text-white hover:opacity-90">

                    Add to Cart

                </button>

            </div>


            <!-- Buy now -->
            <button type="button" class="mt-3 flex h-12 w-full items-center
                justify-center rounded-xl
                border border-ink text-sm font-semibold
                text-ink hover:bg-slate-50">

                Buy Now

            </button>


            <!-- ===================== -->
            <!-- TRUST INFO -->
            <!-- ===================== -->

            <div class="mt-6 grid grid-cols-3 border-y
                border-slate-200 py-5">

                <div class="text-center">
                    <div class="text-sm font-semibold">
                        Authentic
                    </div>
                    <div class="mt-1 text-xs text-slate-500">
                        100% genuine
                    </div>
                </div>

                <div class="border-x border-slate-200 text-center">
                    <div class="text-sm font-semibold">
                        Delivery
                    </div>
                    <div class="mt-1 text-xs text-slate-500">
                        Nationwide
                    </div>
                </div>

                <div class="text-center">
                    <div class="text-sm font-semibold">
                        Warranty
                    </div>
                    <div class="mt-1 text-xs text-slate-500">
                        Available
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- ===================== -->
    <!-- PRODUCT DETAILS -->
    <!-- ===================== -->

    <div class="mt-16 border-t border-slate-200 pt-10">

        <div class="grid gap-10 lg:grid-cols-[1fr_320px]">

            <!-- Description -->
            <div>

                <h2 class="text-xl font-semibold">
                    Product Details
                </h2>

                <div class="mt-5 text-sm leading-7 text-slate-600">
                    @Product.Description
                </div>

            </div>


            <!-- Specifications -->
            <div>

                <h2 class="text-xl font-semibold">
                    Specifications
                </h2>

                <dl class="mt-5 divide-y divide-slate-100">

                    @foreach (var specification in Product.Specifications)
                    {
                        <div class="flex justify-between gap-4 py-3 text-sm">

                            <dt class="text-slate-500">
                                @specification.Key
                            </dt>

                            <dd class="text-right font-medium text-ink">
                                @specification.Value
                            </dd>

                        </div>
                    }

                </dl>

            </div>

        </div>

    </div>

</div>


@code {

    [Parameter]
    public string Slug { get; set; } = "";

    [Parameter]
    [SupplyParameterFromQuery(Name = "color")]
    public string? SelectedColor { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "warranty-id")]
    public int? SelectedWarrantyId
    {
        get => field;
        set
        {
            field = value;
            SelectedWarranty = Product.Warranties.FirstOrDefault(w => w.Id == value);
        }
    }



    private ProductDetailsModel Product = new(
        Name: "Realme Buds Air 7",
        Brand: "Realme",
        Category: "Earbuds",
        CategorySlug: "earbuds",
        ShortDescription:
            "Premium wireless earbuds with active noise cancellation and long battery life.",

        Description:
            "Realme Buds Air 7 delivers powerful sound, active noise cancellation and a comfortable fit for everyday listening.",

        Images:
        [
            "https://images.unsplash.com/photo-1606220945770-b5b6c2c55bf1?auto=format&fit=crop&w=1000&q=80",
            "https://images.unsplash.com/photo-1590658268037-6bf12165a8df?auto=format&fit=crop&w=1000&q=80",
            "https://images.unsplash.com/photo-1588423771070-4b7f7c8b7a0c?auto=format&fit=crop&w=1000&q=80"
        ],

        Colors:
        [
            "Black",
            "White",
            "Blue"
        ],

        Warranties:
        [
            new WarrantyOption(1, 6, 0),
            new WarrantyOption(2, 12, 700)
        ],

        Regions:
        [
            new RegionOption("Chinese", Description: "China variant"),
            new RegionOption("Global", "Global variant")
        ],

        Specifications:
        new Dictionary<string, string>
        {
            ["Bluetooth"] = "5.4",
            ["Noise Cancellation"] = "Up to 52dB",
            ["Battery"] = "40 hours",
            ["Water Resistance"] = "IP55"
        },

        Price: 3990,
        OldPrice: 4490
    );


    private string SelectedImage = "";

    private WarrantyOption? SelectedWarranty;

    private string SelectedRegion = "";

    private int Quantity = 1;

    private decimal CurrentPrice =>
        Product.Price
        + (SelectedWarranty?.AdditionalPrice ?? 0);


    protected override void OnInitialized()
    {
        SelectedImage = Product.Images.First();
        SelectedRegion = Product.Regions.First().Name;
        if (SelectedColor == null)
        {
            SelectedColor = Product.Colors.FirstOrDefault();
        }
        if (SelectedWarrantyId == null)
        {
            SelectedWarrantyId = Product.Warranties.FirstOrDefault()?.Id;
        }
    }


    private void SelectImage(string image)
    {
        SelectedImage = image;
    }


    private void SelectColor(string color)
    {
        SelectedColor = color;

        // Later:
        // change image gallery based on selected color
    }


    private void SelectWarranty(WarrantyOption warranty)
    {
        SelectedWarranty = warranty;
    }


    private void SelectRegion(RegionOption region)
    {
        SelectedRegion = region.Name;
    }


    private void IncreaseQuantity()
    {
        Quantity++;
    }


    private void DecreaseQuantity()
    {
        if (Quantity > 1)
            Quantity--;
    }


    private record WarrantyOption(
        int Id,
        int Months,
        decimal AdditionalPrice);


    private record RegionOption(
        string Name,
        string Description);


    private record ProductDetailsModel(
        string Name,
        string Brand,
        string Category,
        string CategorySlug,
        string ShortDescription,
        string Description,
        IReadOnlyList<string> Images,
        IReadOnlyList<string> Colors,
        IReadOnlyList<WarrantyOption> Warranties,
        IReadOnlyList<RegionOption> Regions,
        IReadOnlyDictionary<string, string> Specifications,
        decimal Price,
        decimal? OldPrice);
}