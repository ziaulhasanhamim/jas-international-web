@page "/product/{Slug}"
@inject JASIntWeb.Services.CatalogService Catalog
@inject JASIntWeb.Services.ShoppingService Shop
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject JASIntWeb.Services.Seo.ISeoService Seo
@inject IConfiguration Config
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using JASIntWeb.Services
@using JASIntWeb.Services.Seo
@using JASIntWeb.Endpoints

@if (product is null)
{
    <SeoHead Title="Product Not Found | JAS International" Robots="noindex,follow" />
    <div class="shop-container product-journey py-12 text-center">
        <Icon Name="alert" Class="size-12 text-slate-300 mx-auto mb-3" />
        <h1 class="text-3xl font-bold text-slate-900">Product Not Found</h1>
        <p class="text-sm text-slate-500 mt-2 mb-6">The requested product could not be located in our catalog.</p>
        <a href="/products" class="btn-primary">Browse All Products</a>
    </div>
}
else
{
    var pageTitle = string.IsNullOrWhiteSpace(product.MetaTitle) ? Seo.BuildProductTitle(product.Name, product.BrandName) : product.MetaTitle;
    var pageDesc = Seo.SanitizeDescription(string.IsNullOrWhiteSpace(product.MetaDescription) ? AdminSeoText.ProductDescription(product.Name, product.Description) : product.MetaDescription);
    var canonical = $"/product/{product.Slug}";
    var selectedSku = selected?.Sku ?? product.Variants.FirstOrDefault()?.Sku ?? $"JAS-{product.Id}";
    var price = selected?.Price ?? 0m;
    var inStock = selected is { Stock: > 0 };

    var crumbs = new List<(string Name, string Url)>
    {
        ("Home", Seo.PublicBaseUrl),
        ("Products", $"{Seo.PublicBaseUrl}/products")
    };
    foreach (var b in product.Breadcrumbs)
    {
        crumbs.Add((b.Name, $"{Seo.PublicBaseUrl}/category/{b.Slug}"));
    }
    crumbs.Add((product.Name, $"{Seo.PublicBaseUrl}{canonical}"));

    var productImages = new List<string> { Seo.BuildAbsoluteUrl(product.MainImage) };
    productImages.AddRange(product.Images.Select(img => Seo.BuildAbsoluteUrl(img)));

    var avgRating = reviews.Count > 0 ? (decimal?)Math.Round((decimal)reviews.Average(r => r.Rating), 1) : null;
    var reviewItems = reviews.Select(r => (r.CustomerName, r.Rating, r.Comment, r.CreatedAt));

    var productFaqs = new (string Q, string A)[]
    {
        ($"What is the price of {product.Name} in Bangladesh?", $"{product.Name} is currently available at JAS International for ৳{price:N0} with official brand warranty."),
        ($"Is {product.Name} authentic with official warranty?", "Yes, 100% genuine and authentic product directly sourced, backed by our official brand warranty and 7-day replacement guarantee."),
        ("What are the delivery charges and delivery times?", "Delivery fee is ৳80 within Khulna (1-2 days) and ৳130 for outside Khulna across all 64 districts of Bangladesh (2-4 days)."),
        ("Is Cash on Delivery (COD) available?", "Yes, Cash on Delivery is available across Bangladesh. You can inspect your package upon delivery.")
    };

    var jsonLdList = new List<string>
    {
        JsonLdBuilder.BuildBreadcrumbs(crumbs),
        JsonLdBuilder.BuildProduct(
            name: product.Name,
            description: pageDesc,
            productUrl: Seo.BuildAbsoluteUrl(canonical),
            imageUrls: productImages.Distinct(),
            brandName: product.BrandName,
            sku: selectedSku,
            gtin: null,
            mpn: selectedSku,
            price: price,
            compareAtPrice: null,
            inStock: inStock,
            shippingKhulna: 80m,
            shippingOutside: 130m,
            ratingValue: avgRating,
            reviewCount: reviews.Count > 0 ? reviews.Count : null,
            reviews: reviewItems
        ),
        JsonLdBuilder.BuildFaq(productFaqs)
    };

    <SeoHead Title="@pageTitle"
             Description="@pageDesc"
             CanonicalPath="@canonical"
             OgImage="@(string.IsNullOrWhiteSpace(product.OgImageUrl) ? product.MainImage : product.OgImageUrl)"
             OgType="product"
             ProductPrice="@price"
             ProductCurrency="BDT"
             ProductAvailability="@(inStock ? "in stock" : "out of stock")"
             ProductBrand="@product.BrandName"
             ProductRetailerItemId="@selectedSku"
             JsonLd="jsonLdList" />

    <HeadContent>
        <link rel="preload" as="image" href="@Seo.BuildAbsoluteUrl(product.MainImage)" fetchpriority="high" />
    </HeadContent>

    <div data-meta-event="ViewContent"
         data-content-id="@selectedSku"
         data-content-name="@product.Name"
         data-content-category="@product.Category"
         data-value="@price"
         data-currency="BDT"
         hidden></div>
    <div class="shop-container py-6">
        <!-- Breadcrumb Navigation -->
        <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-2 text-xs text-slate-500">
            <a href="/" class="hover:text-blue-600 transition">Home</a>
            <span aria-hidden="true" class="text-slate-300">/</span>
            <a href="/products" class="hover:text-blue-600 transition">Products</a>
            @foreach (var category in product.Breadcrumbs)
            {
                <span aria-hidden="true" class="text-slate-300">/</span>
                <a href="/category/@category.Slug" class="hover:text-blue-600 transition">@category.Name</a>
            }
            <span aria-hidden="true" class="text-slate-300">/</span>
            <span aria-current="page" class="font-semibold text-slate-900 truncate max-w-[200px] sm:max-w-none">@product.Name</span>
        </nav>

        <div class="grid gap-10 lg:grid-cols-2">
            <!-- Left: Gallery Section -->
            <div>
                <div class="relative aspect-square overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-6 shadow-xs flex items-center justify-center">
                    <PictureImage
                        Id="main-product-img"
                        PictureId="main-product-picture"
                        PictureClass="flex items-center justify-center h-full w-full"
                        Src="@image"
                        Alt="@product.Name"
                        FetchPriority="high"
                        Loading="eager"
                        Decoding="async"
                        Class="h-full w-full object-contain transition-transform duration-300 hover:scale-105"
                    />
                    @if (selected is { Stock: > 0 })
                    {
                        <span class="absolute top-4 left-4 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-600/20">
                            In Stock
                        </span>
                    }
                    else
                    {
                        <span class="absolute top-4 left-4 rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-700 ring-1 ring-red-600/20">
                            Out of Stock
                        </span>
                    }
                </div>

                @if (product.Images.Count > 1)
                {
                    <div class="mt-4 flex gap-3 overflow-x-auto pb-2 scrollbar-none">
                        @for (var i = 0; i < product.Images.Count; i++)
                        {
                            var index = i;
                            var imgUrl = product.Images[index];
                            var isSelected = image == imgUrl;
                            <button
                                type="button"
                                data-src="@imgUrl"
                                data-avif="@ImageUrlHelper.GetAvifUrl(imgUrl)"
                                data-webp="@ImageUrlHelper.GetWebpUrl(imgUrl)"
                                aria-label="View image @(index + 1)"
                                class="thumb-btn size-20 shrink-0 rounded-2xl border-2 @(isSelected ? "border-blue-600 shadow-xs ring-2 ring-blue-500/20" : "border-slate-200 hover:border-slate-300") bg-white p-1.5 transition overflow-hidden cursor-pointer"
                            >
                                <PictureImage
                                    Src="@imgUrl"
                                    Alt="@($"{product.Name} view {index + 1}")"
                                    Loading="lazy"
                                    Decoding="async"
                                    Class="h-full w-full object-contain"
                                />
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- Right: Product Information & Purchase -->
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="text-xs font-bold uppercase tracking-widest text-blue-600">@product.Category</span>
                    @if (!string.IsNullOrEmpty(product.BrandName))
                    {
                        <span class="text-slate-300">•</span>
                        <a href="/products?brand=@product.BrandSlug" class="text-xs font-semibold text-slate-500 hover:text-blue-600 transition">
                            @product.BrandName
                        </a>
                    }
                </div>
                <h1 class="font-display text-2xl sm:text-4xl font-bold tracking-tight text-slate-900 leading-snug">@product.Name</h1>

                <!-- Price and SKU -->
                <div class="mt-4 flex items-baseline gap-4">
                    <p class="font-display text-3xl font-extrabold text-blue-600">
                        @(selected is not null ? "৳" + selected.Price.ToString("N0") : "N/A")
                    </p>
                    @if (selected?.OriginalPrice > selected?.Price)
                    {
                        <span class="text-sm text-slate-400 line-through">৳@selected.OriginalPrice.Value.ToString("N0")</span>
                    }
                    @if (selected is not null)
                    {
                        <span class="text-xs text-slate-400 font-mono">SKU: @selected.Sku</span>
                    }
                </div>

                <p class="mt-4 text-sm text-slate-600 leading-relaxed">@product.Description</p>

                <!-- Attribute Options Selector -->
                @foreach (var definition in product.Attributes)
                {
                    <div class="mt-6 border-t border-slate-100 pt-5">
                        <h2 class="mb-2.5 text-xs font-bold uppercase tracking-wider text-slate-700">@definition.Name</h2>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var option in definition.Values)
                            {
                                var active = choices.GetValueOrDefault(definition.Code) == option.Code;
                                <a
                                    href="@ProductOptions.OptionUrl(product, choices, definition.Code, option.Code)"
                                    data-enhance
                                    aria-current="@(active ? "true" : "false")"
                                    class="rounded-xl border px-3.5 py-2 text-xs font-semibold transition select-none cursor-pointer @(active ? "border-blue-600 bg-blue-600 text-white shadow-xs ring-2 ring-blue-500/20" : "border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-50")"
                                >
                                    @option.Value
                                </a>
                            }
                            @if (!definition.IsRequired)
                            {
                                var notApplicableActive = !choices.ContainsKey(definition.Code);
                                <a
                                    href="@ProductOptions.OptionUrl(product, choices, definition.Code, "")"
                                    data-enhance
                                    aria-current="@(notApplicableActive ? "true" : "false")"
                                    class="rounded-xl border px-3.5 py-2 text-xs font-medium transition select-none cursor-pointer @(notApplicableActive ? "border-blue-600 bg-blue-600 text-white shadow-xs" : "border-slate-200 bg-white text-slate-700 hover:border-slate-300")"
                                >
                                    Not applicable
                                </a>
                            }
                        </div>
                    </div>
                }

                <!-- Add to Cart & Buy Now Section -->
                <div class="mt-6 border-t border-slate-100 pt-5">
                    @if (selected is null || selected.Stock <= 0)
                    {
                        <div role="status" class="rounded-2xl border border-red-200 bg-red-50 p-4 text-xs text-red-700 leading-relaxed mb-4">
                            <strong>Combination Unavailable:</strong>
                            @(selected is null ? "This specific option combination is not in stock. Please select another variant above." : "This item is currently sold out. Check back soon or contact our showroom.")
                        </div>
                        <button type="button" disabled class="btn-primary w-full opacity-50 cursor-not-allowed">
                            Currently Unavailable
                        </button>
                    }
                    else
                    {
                        var waNumber = Config["Contact:WhatsAppNumber"] ?? "8801711465078";
                        var canonicalUrl = $"{Seo.PublicBaseUrl}/product/{product.Slug}?variant={selected.Id}";
                        var waText = Uri.EscapeDataString($"Hi JAS International, I want to order {product.Name} (৳{selected.Price:N0}). Link: {canonicalUrl}");
                        var waUrl = $"https://wa.me/{waNumber}?text={waText}";

                        @if (selected.Stock <= 5)
                        {
                            <div class="flex items-center gap-2 mb-3">
                                <span class="size-2 rounded-full bg-rose-500 animate-pulse"></span>
                                <span class="text-xs font-bold text-rose-700">🔥 Hurry, only @selected.Stock left in stock!</span>
                            </div>
                        }
                        else
                        {
                            <div class="flex items-center gap-2 mb-3">
                                <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span class="text-xs font-semibold text-emerald-700">✓ In Stock — Ready to ship from Khulna showroom</span>
                            </div>
                        }
                        <div class="space-y-3">
                            <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
                                <!-- Stepper -->
                                <div class="flex items-center rounded-2xl border border-slate-200 bg-slate-50/80 p-1 shadow-2xs">
                                    <button type="button" onclick="const q = document.getElementById('product-qty-input'); if (q && parseInt(q.value) > 1) { q.value = parseInt(q.value) - 1; }" class="size-9 rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 flex items-center justify-center font-bold text-sm transition active:scale-95 cursor-pointer" aria-label="Decrease quantity">−</button>
                                    <input type="number" id="product-qty-input" name="Quantity" value="1" min="1" max="@selected.Stock" class="w-12 text-center text-sm font-bold text-slate-800 bg-transparent outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" />
                                    <button type="button" onclick="const q = document.getElementById('product-qty-input'); if (q && parseInt(q.value) < @selected.Stock) { q.value = parseInt(q.value) + 1; }" class="size-9 rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 flex items-center justify-center font-bold text-sm transition active:scale-95 cursor-pointer" aria-label="Increase quantity">+</button>
                                </div>

                                <!-- Add to Cart Button (Pure JS, zero page reloads) -->
                                <button type="button"
                                        data-add-to-cart
                                        data-variant-id="@selected.Id"
                                        data-product-id="@product.Id"
                                        data-quantity-target="#product-qty-input"
                                        class="flex-1 btn-secondary !py-2.5 text-xs font-bold flex items-center justify-center gap-2 shadow-2xs hover:bg-blue-50 hover:text-blue-700 hover:border-blue-300 transition cursor-pointer">
                                    <Icon Name="cart" Class="size-4 text-blue-600" />
                                    <span>Add to Cart</span>
                                </button>

                                <!-- Buy Now Button (Pure JS, adds to cart then navigates to /cart at top) -->
                                <button type="button"
                                        data-buy-now
                                        data-variant-id="@selected.Id"
                                        data-product-id="@product.Id"
                                        data-quantity-target="#product-qty-input"
                                        class="flex-1 btn-primary !py-2.5 text-xs font-bold flex items-center justify-center gap-2 shadow-xs bg-blue-600 hover:bg-blue-700 transition cursor-pointer">
                                    <span>⚡ Buy Now</span>
                                </button>

                                <!-- Wishlist Button -->
                                <button type="button"
                                        data-wishlist-toggle="@product.Id"
                                        data-product-name="@product.Name"
                                        data-product-slug="@product.Slug"
                                        data-product-image="@product.MainImage"
                                        data-product-price="@selected.Price"
                                        class="size-10 rounded-2xl border border-slate-200 bg-white hover:bg-slate-50 flex items-center justify-center text-slate-400 hover:text-rose-500 transition shadow-2xs shrink-0 cursor-pointer"
                                        aria-label="Save to Wishlist">
                                    <Icon Name="heart" Class="size-5" />
                                </button>
                            </div>
                        </div>

                        <a href="@waUrl" target="_blank" rel="noopener" class="mt-3 flex w-full items-center justify-center gap-2 rounded-2xl border border-emerald-600/30 bg-emerald-50/80 px-4 py-2.5 text-xs font-bold text-emerald-800 hover:bg-emerald-100 transition shadow-2xs">
                            <span class="text-base">💬</span>
                            <span>Order via WhatsApp (Instant Confirmation)</span>
                        </a>
                    }
                </div>

                <!-- Delivery Urgency & Dispatch Guarantee Banner -->
                <div class="mt-6 rounded-2xl border border-orange-200 bg-orange-50/70 p-4 flex items-center gap-3 text-xs text-orange-950">
                    <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-orange-600 text-white font-bold shadow-xs">
                        <Icon Name="truck" Class="size-4" />
                    </span>
                    <div>
                        <p class="font-bold">Fast Dispatch Guarantee</p>
                        <p class="text-orange-900/80 mt-0.5">Orders confirmed before 4:00 PM are dispatched on the same business day with live Steadfast tracking.</p>
                    </div>
                </div>

                <!-- Delivery & Warranty Guarantee Box -->
                <div class="mt-8 rounded-2xl border border-slate-200/90 bg-slate-50/60 p-5 space-y-3 text-xs">
                    <div class="flex items-start gap-3">
                        <Icon Name="truck" Class="size-4 text-blue-600 shrink-0 mt-0.5" />
                        <div>
                            <strong class="text-slate-900 block font-semibold">Delivery Rates &amp; Time</strong>
                            <p class="text-slate-600">Khulna City: ৳80 (24h delivery) · Nationwide: ৳130 (2-4 days express)</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3">
                        <Icon Name="cash" Class="size-4 text-emerald-600 shrink-0 mt-0.5" />
                        <div>
                            <strong class="text-slate-900 block font-semibold">Cash on Delivery (COD)</strong>
                            <p class="text-slate-600">Pay cash directly when you receive and inspect your package.</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3">
                        <Icon Name="shield" Class="size-4 text-indigo-600 shrink-0 mt-0.5" />
                        <div>
                            <strong class="text-slate-900 block font-semibold">7-Day Replacement Warranty</strong>
                            <p class="text-slate-600">Instant exchange guarantee for any manufacturer hardware defect.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Specifications & Details -->
        <section class="mt-16 border-t border-slate-200 pt-10">
            <div class="@(relatedProducts.Count > 0 ? "grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_300px]" : "")">
            <div class="min-w-0">
                <h2 class="text-xl font-bold text-slate-900 mb-4">Detailed Specifications &amp; Features</h2>
                <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs">
                    <div class="product-rich-specs text-slate-700">
                        @((MarkupString)product.Details)
                    </div>
                </div>
            </div>
            <RelatedProducts Products="relatedProducts" CategorySlug="product.CategorySlug" />
            </div>
        </section>

        <!-- Customer Reviews Section -->
        <section class="mt-16 border-t border-slate-200 pt-10">
            <div class="max-w-4xl">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-xl font-bold text-slate-900">Customer Ratings &amp; Reviews</h2>
                        <div class="flex items-center gap-2 mt-1">
                            <div class="flex text-amber-400 text-sm">
                                ★★★★★
                            </div>
                            <span class="text-xs text-slate-500 font-medium">
                                @(reviews.Count > 0 ? $"{reviews.Count} verified ratings" : "Be the first to review this gadget")
                            </span>
                        </div>
                    </div>
                    <button type="button" data-open-modal="write-review-modal" class="btn-secondary !px-4 !py-2 text-xs font-semibold inline-flex items-center gap-1.5 shadow-2xs cursor-pointer">
                        <span>✍️ Write a Review</span>
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(reviewSuccessMessage))
                {
                    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3.5 text-xs text-emerald-800 font-semibold flex items-center justify-between">
                        <span>✓ @reviewSuccessMessage</span>
                        <button type="button" onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-950 font-bold p-1 cursor-pointer">✕</button>
                    </div>
                }

                @if (reviews.Count > 0)
                {
                    <div class="space-y-4">
                        @foreach (var rev in reviews)
                        {
                            <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
                                <div class="flex items-center justify-between gap-4 mb-2">
                                    <div class="flex items-center gap-2">
                                        <div class="flex text-amber-400 text-xs">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span>@(i <= rev.Rating ? "★" : "☆")</span>
                                            }
                                        </div>
                                        <strong class="text-xs font-bold text-slate-900">@(rev.Title ?? "Customer Review")</strong>
                                    </div>
                                    <span class="text-[11px] text-slate-400">@rev.CreatedAt.ToString("dd MMM yyyy")</span>
                                </div>
                                <p class="text-xs text-slate-700 leading-relaxed">@rev.Comment</p>
                                <div class="mt-2 flex items-center gap-2 text-[11px] text-slate-500">
                                    <span class="font-semibold text-slate-800">@rev.CustomerName</span>
                                    @if (rev.IsVerifiedPurchase)
                                    {
                                        <span>•</span>
                                        <span class="text-emerald-700 font-semibold">✓ Verified Buyer</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(rev.StaffReply))
                                {
                                    <div class="mt-3 rounded-xl bg-slate-50 border border-slate-200/70 p-3 text-xs">
                                        <span class="font-bold text-slate-800 block mb-0.5">Response from JAS International:</span>
                                        <p class="text-slate-600">@rev.StaffReply</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="rounded-2xl border border-slate-200/90 bg-slate-50 p-8 text-center text-xs text-slate-500">
                        <p class="font-medium text-slate-700">No reviews yet for this product.</p>
                        <p class="mt-1">Have you purchased this gadget? Share your genuine experience to help fellow buyers!</p>
                    </div>
                }
            </div>
        </section>

        @if (selected is not null && selected.Stock <= 0)
        {
            <StockNotificationForm VariantId="selected.Id" />
        }

        <!-- Write Review Modal -->
        <div id="write-review-modal" class="review-dialog fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-xs animate-fadeIn hidden">
            <div role="dialog" aria-modal="true" aria-labelledby="review-dialog-title" class="w-full max-w-lg rounded-2xl bg-white p-6 shadow-2xl space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <h3 id="review-dialog-title" class="text-base font-bold text-slate-900">Write a Review for @product.Name</h3>
                    <button type="button" data-close-modal="write-review-modal" class="text-slate-400 hover:text-slate-600 font-bold p-1 cursor-pointer">✕</button>
                </div>
                <form method="post" action="@($"/products/{product.Id}/reviews")" data-enhance="false" class="space-y-3">
                    <AntiforgeryToken />
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Your Rating</label>
                        <div class="flex items-center gap-2">
                            <input type="hidden" id="review-rating-input" name="Rating" value="5" />
                            @for (int star = 1; star <= 5; star++)
                            {
                                var s = star;
                                <button
                                    type="button"
                                    data-star-rating="@s"
                                    class="star-btn text-xl text-amber-400 hover:scale-110 transition cursor-pointer"
                                    aria-label="@s stars"
                                >
                                    ★
                                </button>
                            }
                            <span id="review-rating-text" class="text-xs text-slate-500 ml-2 font-medium">5 / 5 Stars</span>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label for="review-name" class="block text-xs font-semibold text-slate-700 mb-1">Your Name *</label>
                            <input type="text" id="review-name" name="Name" maxlength="100" required placeholder="e.g. Tanvir Ahmed" class="field text-xs" />
                        </div>
                        <div>
                            <label for="review-email" class="block text-xs font-semibold text-slate-700 mb-1">Email Address</label>
                            <input type="email" id="review-email" name="Email" maxlength="254" placeholder="tanvir@example.com" class="field text-xs" />
                        </div>
                    </div>
                    <div>
                        <label for="review-title" class="block text-xs font-semibold text-slate-700 mb-1">Headline / Review Title</label>
                        <input type="text" id="review-title" name="Title" maxlength="150" placeholder="e.g. Excellent battery life and authentic product" class="field text-xs" />
                    </div>
                    <div>
                        <label for="review-comment" class="block text-xs font-semibold text-slate-700 mb-1">Your Detailed Experience *</label>
                        <textarea id="review-comment" name="Comment" rows="3" minlength="10" maxlength="3000" required placeholder="Share details about performance, build quality, and delivery speed..." class="field text-xs"></textarea>
                    </div>
                    <div class="flex items-center justify-end gap-2 pt-2">
                        <button type="button" data-close-modal="write-review-modal" class="btn-secondary text-xs cursor-pointer">Cancel</button>
                        <button type="submit" class="btn-primary text-xs !bg-blue-600 hover:!bg-blue-700 cursor-pointer">Submit Review</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Mobile Sticky Bottom Buy Bar (visible only on mobile md:hidden, above the 5-tab mobile bottom nav) -->
        @if (selected is { Stock: > 0 })
        {
            var waNumber = Config["Contact:WhatsAppNumber"] ?? "8801711465078";
            var canonicalUrl = $"{Seo.PublicBaseUrl}/product/{product.Slug}?variant={selected.Id}";
            var waText = Uri.EscapeDataString($"Hi JAS International, I want to order {product.Name} (৳{selected.Price:N0}). Link: {canonicalUrl}");
            var waUrl = $"https://wa.me/{waNumber}?text={waText}";

            <div class="md:hidden fixed bottom-14 inset-x-0 z-30 bg-white/95 backdrop-blur-md border-t border-slate-200/90 px-4 py-2.5 shadow-lg flex items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <span class="text-[11px] text-slate-500 truncate block font-medium">@product.Name</span>
                    <strong class="text-sm font-extrabold text-blue-600 tabular-nums block">৳@selected.Price.ToString("N0")</strong>
                </div>
                <div class="shrink-0 flex items-center gap-2">
                    <a href="@waUrl" target="_blank" rel="noopener" class="flex size-9 items-center justify-center rounded-xl bg-emerald-600 text-white shadow-xs" title="Order via WhatsApp">
                        <span class="text-base">💬</span>
                    </a>
                    <div class="flex items-center gap-1.5">
                        <button type="button"
                                data-add-to-cart
                                data-variant-id="@selected.Id"
                                data-product-id="@product.Id"
                                class="btn-secondary !py-2 !px-3 text-xs font-bold cursor-pointer">
                            Add
                        </button>
                        <button type="button"
                                data-buy-now
                                data-variant-id="@selected.Id"
                                data-product-id="@product.Id"
                                class="btn-primary !py-2 !px-3.5 text-xs font-bold !bg-blue-600 hover:!bg-blue-700 cursor-pointer">
                            Buy Now
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code
{
    [Parameter]
    public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "image")]
    public int? ImageIndex { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private ProductDetailsDto? product;
    private ProductVariantDto? selected;
    private Dictionary<string, string> choices = [];
    private string image = "";
    private List<ProductSummaryDto> relatedProducts = [];
    private List<ProductReview> reviews = [];
    private string? reviewSuccessMessage;

    private ProductSummaryDto CurrentSummary => new(
        product!.Id,
        product.Name,
        product.Slug,
        selected?.Price ?? 0,
        product.Category,
        product.MainImage,
        selected?.Id,
        selected?.Stock ?? 0,
        product.BrandName,
        product.BrandSlug
    );

    protected override async Task OnInitializedAsync()
    {
        product = await Catalog.DetailsAsync(Slug);
        if (product is null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var isDeleted = await db.Products.AnyAsync(p => p.Slug == Slug && p.IsDeleted);
            if (HttpContext != null)
            {
                HttpContext.Response.StatusCode = isDeleted ? StatusCodes.Status410Gone : StatusCodes.Status404NotFound;
            }
            return;
        }

        var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        var requested = new Dictionary<string, string>();
        foreach (var definition in product.Attributes)
        {
            if (query.TryGetValue("attribute-" + definition.Code, out var value) || query.TryGetValue(definition.Code, out value))
            {
                requested[definition.Code] = value.ToString();
            }
        }
        if (query.TryGetValue("variant", out var variantValue) && int.TryParse(variantValue, out var variantId))
        {
            var requestedVariant = product.Variants.FirstOrDefault(v => v.Id == variantId);
            if (requestedVariant is not null) requested = new Dictionary<string, string>(requestedVariant.Options);
        }
        choices = ProductOptions.Selection(product, requested);
        selected = ProductOptions.Match(product, choices);
        image = product.Images.ElementAtOrDefault(ImageIndex ?? 0) ?? product.MainImage;

        relatedProducts = await Catalog.LatestAsync(product.CategorySlug, 4, product.Id);

        if (QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query).ContainsKey("review"))
            reviewSuccessMessage = "Thank you. Your review is awaiting moderation.";

        await LoadReviewsAsync();
    }

    private async Task LoadReviewsAsync()
    {
        if (product is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        reviews = await db.ProductReviews.AsNoTracking()
            .Where(r => r.ProductId == product.Id && r.IsApproved)
            .OrderByDescending(r => r.CreatedAt)
            .ToListAsync();
    }
}
