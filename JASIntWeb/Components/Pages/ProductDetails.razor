@page "/product/{Slug}"
@inject JASIntWeb.Services.CatalogService Catalog
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities

@if (product is null)
{
    <PageTitle>Product not found — JAS International</PageTitle>
    <div class="shop-container py-12 text-center">
        <Icon Name="alert" Class="size-12 text-slate-300 mx-auto mb-3" />
        <h1 class="text-3xl font-bold text-slate-900">Product Not Found</h1>
        <p class="text-sm text-slate-500 mt-2 mb-6">The requested product could not be located in our catalog.</p>
        <a href="/products" class="btn-primary">Browse All Products</a>
    </div>
}
else
{
    <PageTitle>@product.Name — JAS International</PageTitle>
    <HeadContent>
        <meta name="description" content="@(string.IsNullOrWhiteSpace(product.Description) ? $"{product.Name} available at JAS International. Authentic tech gadgets with official warranty and nationwide delivery." : product.Description)" />
        <meta property="og:title" content="@product.Name | JAS International" />
        <meta property="og:description" content="@product.Description" />
        <meta property="og:image" content="@product.MainImage" />
        <meta property="og:type" content="product" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@product.Name | JAS International" />
        <meta name="twitter:description" content="@product.Description" />
        <meta name="twitter:image" content="@product.MainImage" />
        <link rel="canonical" href="@Nav.Uri" />
        <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "Product",
            "name": "@product.Name",
            "image": "@product.MainImage",
            "description": "@(product.Description ?? product.Name)",
            "brand": {
                "@@type": "Brand",
                "name": "@(product.BrandName ?? "JAS International")"
            },
            "offers": {
                "@@type": "Offer",
                "priceCurrency": "BDT",
                "price": "@(selected?.Price ?? 0)",
                "availability": "@(selected is { Stock: > 0 } ? "https://schema.org/InStock" : "https://schema.org/OutOfStock")",
                "seller": {
                    "@@type": "Organization",
                    "name": "JAS International"
                }
            }
        }
        </script>
    </HeadContent>
    <div class="shop-container py-6">
        <!-- Breadcrumb Navigation -->
        <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-2 text-xs text-slate-500">
            <a href="/" class="hover:text-blue-600 transition">Home</a>
            <span aria-hidden="true" class="text-slate-300">/</span>
            <a href="/products" class="hover:text-blue-600 transition">Products</a>
            @foreach (var category in product.Breadcrumbs)
            {
                <span aria-hidden="true" class="text-slate-300">/</span>
                <a href="/category/@category.Slug" class="hover:text-blue-600 transition">@category.Name</a>
            }
            <span aria-hidden="true" class="text-slate-300">/</span>
            <span aria-current="page" class="font-semibold text-slate-900 truncate max-w-[200px] sm:max-w-none">@product.Name</span>
        </nav>

        <div class="grid gap-10 lg:grid-cols-2">
            <!-- Left: Gallery Section -->
            <div>
                <div class="relative aspect-square overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-6 shadow-xs flex items-center justify-center">
                    <img
                        src="@image"
                        alt="@product.Name"
                        fetchpriority="high"
                        decoding="async"
                        class="h-full w-full object-contain transition-transform duration-300 hover:scale-105"
                    />
                    @if (selected is { Stock: > 0 })
                    {
                        <span class="absolute top-4 left-4 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-600/20">
                            In Stock
                        </span>
                    }
                    else
                    {
                        <span class="absolute top-4 left-4 rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-700 ring-1 ring-red-600/20">
                            Out of Stock
                        </span>
                    }
                </div>

                @if (product.Images.Count > 1)
                {
                    <div class="mt-4 flex gap-3 overflow-x-auto pb-2 scrollbar-none">
                        @for (var i = 0; i < product.Images.Count; i++)
                        {
                            var index = i;
                            var isSelected = image == product.Images[index];
                            <a
                                href="@Nav.GetUriWithQueryParameter("image", index)"
                                aria-label="View image @(index + 1)"
                                class="size-20 shrink-0 rounded-2xl border-2 @(isSelected ? "border-blue-600 shadow-xs" : "border-slate-200 hover:border-slate-300") bg-white p-1.5 transition overflow-hidden"
                            >
                                <img
                                    src="@product.Images[index]"
                                    alt="@product.Name view @(index + 1)"
                                    loading="lazy"
                                    decoding="async"
                                    class="h-full w-full object-contain"
                                />
                            </a>
                        }
                    </div>
                }
            </div>

            <!-- Right: Product Information & Purchase -->
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="text-xs font-bold uppercase tracking-widest text-blue-600">@product.Category</span>
                    @if (!string.IsNullOrEmpty(product.BrandName))
                    {
                        <span class="text-slate-300">•</span>
                        <a href="/products?brand=@product.BrandSlug" class="text-xs font-semibold text-slate-500 hover:text-blue-600 transition">
                            @product.BrandName
                        </a>
                    }
                </div>
                <h1 class="font-display text-2xl sm:text-4xl font-bold tracking-tight text-slate-900 leading-snug">@product.Name</h1>

                <!-- Price and SKU -->
                <div class="mt-4 flex items-baseline gap-4">
                    <p class="font-display text-3xl font-extrabold text-blue-600">
                        @(selected is { Stock: > 0 } ? "৳" + selected.Price.ToString("N0") : "N/A")
                    </p>
                    @if (selected is not null)
                    {
                        <span class="text-xs text-slate-400 font-mono">SKU: @selected.Sku</span>
                    }
                </div>

                <p class="mt-4 text-sm text-slate-600 leading-relaxed">@product.Description</p>

                <!-- Attribute Options Selector -->
                @foreach (var definition in product.Attributes)
                {
                    <div class="mt-6 border-t border-slate-100 pt-5">
                        <h2 class="mb-2.5 text-xs font-bold uppercase tracking-wider text-slate-700">@definition.Name</h2>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var option in definition.Values)
                            {
                                var active = choices.GetValueOrDefault(definition.Code) == option.Code;
                                <a
                                    href="@ProductOptions.OptionUrl(product, choices, definition.Code, option.Code)"
                                    aria-current="@(active ? "true" : "false")"
                                    class="rounded-xl border px-3.5 py-2 text-xs font-medium transition select-none @(active ? "border-blue-600 bg-blue-600 text-white shadow-xs" : "border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-50")"
                                >
                                    @option.Value
                                </a>
                            }
                            @if (!definition.IsRequired)
                            {
                                <a
                                    href="@ProductOptions.OptionUrl(product, choices, definition.Code, "")"
                                    aria-current="@(!choices.ContainsKey(definition.Code) ? "true" : "false")"
                                    class="rounded-xl border px-3.5 py-2 text-xs font-medium transition select-none @(!choices.ContainsKey(definition.Code) ? "border-blue-600 bg-blue-600 text-white shadow-xs" : "border-slate-200 bg-white text-slate-700 hover:border-slate-300")"
                                >
                                    Not applicable
                                </a>
                            }
                        </div>
                    </div>
                }

                <!-- Add to Cart & Buy Now Section -->
                <div class="mt-6 border-t border-slate-100 pt-5">
                    @if (selected is null || selected.Stock <= 0)
                    {
                        <div role="status" class="rounded-2xl border border-red-200 bg-red-50 p-4 text-xs text-red-700 leading-relaxed mb-4">
                            <strong>Combination Unavailable:</strong>
                            @(selected is null ? "This specific option combination is not in stock. Please select another variant above." : "This item is currently sold out. Check back soon or contact our showroom.")
                        </div>
                        <button type="button" disabled class="btn-primary w-full opacity-50 cursor-not-allowed">
                            Currently Unavailable
                        </button>
                    }
                    else
                    {
                        <div class="flex items-center gap-2 mb-3">
                            <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            <span class="text-xs font-semibold text-emerald-700">In Stock — @selected.Stock units ready for shipment</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="flex-1">
                                <AddToCart @key="selected.Id" VariantId="selected.Id" Stock="selected.Stock" />
                            </div>
                            <WishlistButton Product="CurrentSummary" />
                        </div>
                    }
                </div>

                <!-- Delivery Urgency & Dispatch Guarantee Banner -->
                <div class="mt-6 rounded-2xl border border-orange-200 bg-orange-50/70 p-4 flex items-center gap-3 text-xs text-orange-950">
                    <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-orange-600 text-white font-bold shadow-xs">
                        <Icon Name="truck" Class="size-4" />
                    </span>
                    <div>
                        <p class="font-bold">Fast Dispatch Guarantee</p>
                        <p class="text-orange-900/80 mt-0.5">Orders confirmed before 4:00 PM are dispatched on the same business day with live Steadfast tracking.</p>
                    </div>
                </div>

                <!-- Delivery & Warranty Guarantee Box -->
                <div class="mt-8 rounded-2xl border border-slate-200/90 bg-slate-50/60 p-5 space-y-3 text-xs">
                    <div class="flex items-start gap-3">
                        <Icon Name="truck" Class="size-4 text-blue-600 shrink-0 mt-0.5" />
                        <div>
                            <strong class="text-slate-900 block font-semibold">Delivery Rates &amp; Time</strong>
                            <p class="text-slate-600">Khulna City: ৳80 (24h delivery) · Nationwide: ৳130 (2-4 days express)</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3">
                        <Icon Name="cash" Class="size-4 text-emerald-600 shrink-0 mt-0.5" />
                        <div>
                            <strong class="text-slate-900 block font-semibold">Cash on Delivery (COD)</strong>
                            <p class="text-slate-600">Pay cash directly when you receive and inspect your package.</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3">
                        <Icon Name="shield" Class="size-4 text-indigo-600 shrink-0 mt-0.5" />
                        <div>
                            <strong class="text-slate-900 block font-semibold">7-Day Replacement Warranty</strong>
                            <p class="text-slate-600">Instant exchange guarantee for any manufacturer hardware defect.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Specifications & Details -->
        <section class="mt-16 border-t border-slate-200 pt-10">
            <div class="max-w-4xl">
                <h2 class="text-xl font-bold text-slate-900 mb-4">Detailed Specifications &amp; Features</h2>
                <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs">
                    <div class="product-rich-specs text-slate-700">
                        @((MarkupString)product.Details)
                    </div>
                </div>
            </div>
        </section>

        <!-- Related Products Section (Gadget & Gear style slider) -->
        @if (relatedProducts.Count > 0)
        {
            <div class="mt-16 border-t border-slate-200 pt-10">
                <ProductSection
                    Title="Similar &amp; Recommended Gadgets"
                    Eyebrow="Explore more"
                    Products="relatedProducts"
                    ViewAllHref="@($"/category/{product.CategorySlug}")"
                />
            </div>
        }

        <!-- Mobile Sticky Bottom Buy Bar (visible only on mobile md:hidden, above the 5-tab mobile bottom nav) -->
        @if (selected is { Stock: > 0 })
        {
            <div class="md:hidden fixed bottom-14 inset-x-0 z-30 bg-white/95 backdrop-blur-md border-t border-slate-200/90 px-4 py-2.5 shadow-lg flex items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <span class="text-[11px] text-slate-500 truncate block font-medium">@product.Name</span>
                    <strong class="text-sm font-extrabold text-blue-600 tabular-nums block">৳@selected.Price.ToString("N0")</strong>
                </div>
                <div class="shrink-0">
                    <AddToCart @key="@($"sticky-{selected.Id}")" VariantId="selected.Id" Stock="selected.Stock" />
                </div>
            </div>
        }
    </div>
}

@code
{
    [Parameter]
    public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "image")]
    public int? ImageIndex { get; set; }
    private ProductDetailsDto? product;
    private ProductVariantDto? selected;
    private Dictionary<string, string> choices = [];
    private string image = "";
    private List<ProductSummaryDto> relatedProducts = [];

    private ProductSummaryDto CurrentSummary => new(
        product!.Id,
        product.Name,
        product.Slug,
        selected?.Price ?? 0,
        product.Category,
        product.MainImage,
        selected?.Id,
        selected?.Stock ?? 0,
        product.BrandName,
        product.BrandSlug
    );

    protected override async Task OnInitializedAsync()
    {
        product = await Catalog.DetailsAsync(Slug);
        if (product is null)
        {
            return;
        }
        var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        var requested = new Dictionary<string, string>();
        foreach (var definition in product.Attributes)
        {
            if (query.TryGetValue("attribute-" + definition.Code, out var value) || query.TryGetValue(definition.Code, out value))
            {
                requested[definition.Code] = value.ToString();
            }
        }
        choices = ProductOptions.Selection(product, requested);
        selected = ProductOptions.Match(product, choices);
        image = product.Images.ElementAtOrDefault(ImageIndex ?? 0) ?? product.MainImage;

        var related = await Catalog.LatestAsync(product.CategorySlug, 8);
        relatedProducts = related.Where(p => p.Id != product.Id).ToList();
    }
}
