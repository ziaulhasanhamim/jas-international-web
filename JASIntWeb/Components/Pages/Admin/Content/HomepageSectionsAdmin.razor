@page "/admin/homepage-sections"
@rendermode InteractiveServer
@inject AppDbContext Db
@inject AdminSession Session

<PageTitle>Homepage Sections · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">STOREFRONT MERCHANDISING</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Homepage Category Sections</h1>
        <p class="text-sm text-slate-500 mt-1">
            Customize which category sections appear on the homepage (e.g. Sound Surround, Flagship Phones), customize their titles, eyebrows, display limits, and ordering.
        </p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/" target="_blank" class="btn-secondary text-xs shadow-xs">
            <Icon Name="eye" Class="size-3.5" />
            <span>View Storefront</span>
        </a>
        <button type="button" @onclick="OpenCreate" class="btn-primary shadow-xs">
            <Icon Name="plus" Class="size-4" />
            <span>Add Section</span>
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800 flex items-center justify-between">
        <span class="flex items-center gap-2">
            <Icon Name="check" Class="size-4 text-emerald-600" />
            @_toast
        </span>
        <button type="button" @onclick="() => _toast = null" class="text-emerald-600 hover:text-emerald-950">
            <Icon Name="close" Class="size-3.5" />
        </button>
    </div>
}

<!-- Sections Table -->
<div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden mb-8">
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th class="w-16 text-center">Order</th>
                    <th>Section Title &amp; Eyebrow</th>
                    <th>Target Category</th>
                    <th class="text-center">Items</th>
                    <th class="text-center">Live Status</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _sections)
                {
                    <tr>
                        <td class="text-center">
                            <div class="flex items-center justify-center gap-1 font-mono font-bold text-slate-700">
                                <span>#@s.SortOrder</span>
                                <div class="flex flex-col">
                                    <button type="button" @onclick="() => MoveOrder(s, -1)" class="p-0.5 text-slate-400 hover:text-slate-800" title="Move Up">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m18 15-6-6-6 6"/></svg>
                                    </button>
                                    <button type="button" @onclick="() => MoveOrder(s, 1)" class="p-0.5 text-slate-400 hover:text-slate-800" title="Move Down">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg>
                                    </button>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div>
                                @if (!string.IsNullOrWhiteSpace(s.Eyebrow))
                                {
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-orange-600 bg-orange-50 px-1.5 py-0.5 rounded border border-orange-200/60 block w-fit mb-1">
                                        @s.Eyebrow
                                    </span>
                                }
                                <strong class="text-slate-900 text-sm font-bold block">@s.Title</strong>
                                <span class="text-xs text-slate-400 font-mono">@s.ViewAllHref</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge badge-indigo">
                                @(string.IsNullOrWhiteSpace(s.CategorySlug) ? "All / Newest" : s.CategorySlug)
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="font-mono text-xs font-semibold text-slate-600">
                                @s.ItemLimit items
                            </span>
                        </td>
                        <td class="text-center">
                            <button
                                type="button"
                                @onclick="() => ToggleActive(s)"
                                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold transition @(s.IsActive ? "bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100" : "bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200")"
                            >
                                <span class="size-1.5 rounded-full @(s.IsActive ? "bg-emerald-500" : "bg-slate-400")"></span>
                                @(s.IsActive ? "Active" : "Disabled")
                            </button>
                        </td>
                        <td class="text-right">
                            <div class="inline-flex items-center gap-2">
                                <button type="button" @onclick="() => EditSection(s)" class="btn-secondary !px-2.5 !py-1 text-xs">
                                    Edit
                                </button>
                                <button type="button" @onclick="() => DeleteSection(s)" class="btn-danger !px-2 !py-1 text-xs" title="Delete section">
                                    <Icon Name="trash" Class="size-3.5" />
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_sections.Count == 0)
    {
        <div class="empty-state py-12">
            <Icon Name="box" Class="size-10 text-slate-300" />
            <p>No homepage category sections configured yet.</p>
        </div>
    }
</div>

<!-- Editor Modal / Drawer -->
@if (_editorOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 backdrop-blur-xs p-4 animate-in fade-in">
        <div class="w-full max-w-lg rounded-2xl bg-white p-6 shadow-2xl border border-slate-200">
            <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-5">
                <h3 class="text-lg font-bold text-slate-900">
                    @(_model.Id == 0 ? "Add Homepage Category Section" : "Edit Section")
                </h3>
                <button type="button" @onclick="() => _editorOpen = false" class="text-slate-400 hover:text-slate-600">
                    <Icon Name="close" Class="size-5" />
                </button>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="shop-label mb-1">
                        Section Title
                    </label>
                    <input @bind="_model.Title" class="shop-input" placeholder="e.g. Sound Surround, Flagship Phones" />
                    <small class="text-slate-400 text-[11px]">The prominent heading shown above the carousel slider.</small>
                </div>

                <div>
                    <label class="shop-label mb-1">
                        Eyebrow Label (optional)
                    </label>
                    <input @bind="_model.Eyebrow" class="shop-input" placeholder="e.g. Hear More, Just Landed, Wearable Tech" />
                    <small class="text-slate-400 text-[11px]">Small uppercase tag displayed right above the title.</small>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="shop-label mb-1">
                            Category Filter
                        </label>
                        <select @bind="_model.CategorySlug" class="shop-input">
                            <option value="">All Categories (Latest)</option>
                            @foreach (var c in _categories)
                            {
                                <option value="@c.Slug">@c.Name (@c.Slug)</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="shop-label mb-1">
                            Products to Display
                        </label>
                        <input type="number" @bind="_model.ItemLimit" min="2" max="24" class="shop-input" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="shop-label mb-1">
                            Sort Order
                        </label>
                        <input type="number" @bind="_model.SortOrder" class="shop-input" />
                    </div>

                    <div class="flex items-center pt-6">
                        <label class="flex items-center gap-2 cursor-pointer text-sm font-semibold text-slate-700">
                            <input type="checkbox" @bind="_model.IsActive" class="size-4 rounded text-blue-600" />
                            <span>Section is Active</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="mt-6 flex items-center justify-end gap-3 border-t border-slate-100 pt-4">
                <button type="button" @onclick="() => _editorOpen = false" class="shop-button-secondary !py-2">
                    Cancel
                </button>
                <button type="button" @onclick="SaveSection" class="shop-button !py-2">
                    Save Section
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<HomepageSection> _sections = [];
    private List<Category> _categories = [];
    private bool _editorOpen;
    private HomepageSection _model = new();
    private string? _toast;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _sections = await Db.HomepageSections
            .OrderBy(s => s.SortOrder)
            .ToListAsync();

        _categories = await Db.Categories
            .Where(c => !c.IsDeleted)
            .OrderBy(c => c.Name)
            .ToListAsync();
    }

    private void OpenCreate()
    {
        _model = new HomepageSection
        {
            Title = "New Product Section",
            Eyebrow = "Featured",
            SortOrder = (_sections.MaxBy(s => s.SortOrder)?.SortOrder ?? 0) + 10,
            IsActive = true,
            ItemLimit = 8
        };
        _editorOpen = true;
    }

    private void EditSection(HomepageSection section)
    {
        _model = new HomepageSection
        {
            Id = section.Id,
            Title = section.Title,
            Eyebrow = section.Eyebrow,
            CategorySlug = section.CategorySlug,
            ViewAllHref = section.ViewAllHref,
            SortOrder = section.SortOrder,
            IsActive = section.IsActive,
            ItemLimit = section.ItemLimit
        };
        _editorOpen = true;
    }

    private async Task SaveSection()
    {
        if (string.IsNullOrWhiteSpace(_model.Title))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.ViewAllHref) || _model.ViewAllHref == "/products")
        {
            _model.ViewAllHref = string.IsNullOrWhiteSpace(_model.CategorySlug)
                ? "/products"
                : $"/category/{_model.CategorySlug}";
        }

        if (_model.Id == 0)
        {
            Db.HomepageSections.Add(_model);
        }
        else
        {
            var existing = await Db.HomepageSections.FindAsync(_model.Id);
            if (existing != null)
            {
                existing.Title = _model.Title;
                existing.Eyebrow = _model.Eyebrow;
                existing.CategorySlug = _model.CategorySlug;
                existing.ViewAllHref = _model.ViewAllHref;
                existing.SortOrder = _model.SortOrder;
                existing.IsActive = _model.IsActive;
                existing.ItemLimit = _model.ItemLimit;
            }
        }
        await Db.SaveChangesAsync();

        _editorOpen = false;
        _toast = "Section saved successfully.";
        await LoadData();
    }

    private async Task ToggleActive(HomepageSection section)
    {
        var item = await Db.HomepageSections.FindAsync(section.Id);
        if (item != null)
        {
            item.IsActive = !item.IsActive;
            await Db.SaveChangesAsync();
        }
        await LoadData();
    }

    private async Task MoveOrder(HomepageSection section, int delta)
    {
        var item = await Db.HomepageSections.FindAsync(section.Id);
        if (item != null)
        {
            item.SortOrder += delta * 10;
            await Db.SaveChangesAsync();
        }
        await LoadData();
    }

    private async Task DeleteSection(HomepageSection section)
    {
        var item = await Db.HomepageSections.FindAsync(section.Id);
        if (item != null)
        {
            Db.HomepageSections.Remove(item);
            await Db.SaveChangesAsync();
        }
        _toast = "Section removed from homepage.";
        await LoadData();
    }
}
