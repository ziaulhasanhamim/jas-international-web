@page "/admin/homepage-sections"
@attribute [StreamRendering]
@inject AppDbContext Db
@inject AdminSession Session
@inject NavigationManager Nav

<PageTitle>Homepage Sections · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">STOREFRONT MERCHANDISING</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Homepage Category Sections</h1>
        <p class="text-sm text-slate-500 mt-1">
            Customize which category sections appear on the homepage (e.g. Sound Surround, Flagship Phones), customize their titles, eyebrows, display limits, and ordering.
        </p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/" target="_blank" class="btn-secondary text-xs shadow-xs">
            <Icon Name="eye" Class="size-3.5" />
            <span>View Storefront</span>
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800 flex items-center justify-between">
        <span class="flex items-center gap-2">
            <Icon Name="check" Class="size-4 text-emerald-600" />
            @_toast
        </span>
        <a href="/admin/homepage-sections" class="text-emerald-600 hover:text-emerald-950 font-bold">✕</a>
    </div>
}

<!-- Single container form for all table actions (replaces duplicate nested forms) -->
<form method="post" @formname="sections-table-action" data-enhance>
    <AntiforgeryToken />
    <!-- Sections Table -->
    <div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden mb-8">
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="w-20 text-center">Order</th>
                        <th>Section Title &amp; Eyebrow</th>
                        <th>Target Category</th>
                        <th class="text-center">Items</th>
                        <th class="text-center">Live Status</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _sections)
                    {
                        <tr>
                            <td class="text-center">
                                <div class="flex items-center justify-center gap-1 font-mono font-bold text-slate-700">
                                    <span>#@s.SortOrder</span>
                                    <div class="flex flex-col">
                                        <button type="submit" name="Action" value="@($"up:{s.Id}")" class="p-0.5 text-slate-400 hover:text-slate-800 cursor-pointer" title="Move Up">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m18 15-6-6-6 6"/></svg>
                                        </button>
                                        <button type="submit" name="Action" value="@($"down:{s.Id}")" class="p-0.5 text-slate-400 hover:text-slate-800 cursor-pointer" title="Move Down">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg>
                                        </button>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div>
                                    @if (!string.IsNullOrWhiteSpace(s.Eyebrow))
                                    {
                                        <span class="text-[10px] font-bold uppercase tracking-wider text-orange-600 bg-orange-50 px-1.5 py-0.5 rounded border border-orange-200/60 block w-fit mb-1">
                                            @s.Eyebrow
                                        </span>
                                    }
                                    <strong class="text-slate-900 text-sm font-bold block">@s.Title</strong>
                                    <span class="text-xs text-slate-400 font-mono">@s.ViewAllHref</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-indigo">
                                    @(string.IsNullOrWhiteSpace(s.CategorySlug) ? "All / Newest" : s.CategorySlug)
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="font-mono text-xs font-semibold text-slate-600">
                                    @s.ItemLimit items
                                </span>
                            </td>
                            <td class="text-center">
                                <button
                                    type="submit"
                                    name="Action"
                                    value="@($"toggle:{s.Id}")"
                                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold transition cursor-pointer @(s.IsActive ? "bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100" : "bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200")"
                                >
                                    <span class="size-1.5 rounded-full @(s.IsActive ? "bg-emerald-500" : "bg-slate-400")"></span>
                                    @(s.IsActive ? "Active" : "Disabled")
                                </button>
                            </td>
                            <td class="text-right">
                                <div class="inline-flex items-center gap-2">
                                    <a href="/admin/homepage-sections?edit=@s.Id" class="btn-secondary !px-2.5 !py-1 text-xs">
                                        Edit
                                    </a>
                                    <button type="submit" name="Action" value="@($"delete:{s.Id}")" class="btn-danger !px-2 !py-1 text-xs cursor-pointer" title="Delete section" onclick="return confirm('Delete this section?');">
                                        <Icon Name="trash" Class="size-3.5" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_sections.Count == 0)
        {
            <div class="empty-state py-12">
                <Icon Name="box" Class="size-10 text-slate-300" />
                <p>No homepage category sections configured yet.</p>
            </div>
        }
    </div>
</form>

<!-- Editor Panel for Section -->
<div class="rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs">
    <div class="mb-4">
        <h3 class="text-base font-bold text-slate-900">
            @(EditId > 0 ? "Edit Homepage Category Section" : "Add New Homepage Category Section")
        </h3>
        <p class="text-xs text-slate-500">Configure section title, category filter, and display limit.</p>
    </div>

    <form method="post" @formname="save-section" data-enhance class="space-y-4">
        <AntiforgeryToken />
        <input type="hidden" name="SaveAction" value="save" />
        <input type="hidden" name="FormId" value="@(editSection?.Id ?? 0)" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="shop-label mb-1">Section Title *</label>
                <input name="FormTitle" value="@(editSection?.Title ?? "")" required class="shop-input" placeholder="e.g. Sound Surround, Flagship Phones" />
                <small class="text-slate-400 text-[11px]">The prominent heading shown above the carousel slider.</small>
            </div>

            <div>
                <label class="shop-label mb-1">Eyebrow Label (optional)</label>
                <input name="FormEyebrow" value="@(editSection?.Eyebrow ?? "")" class="shop-input" placeholder="e.g. Hear More, Just Landed, Wearable Tech" />
                <small class="text-slate-400 text-[11px]">Small uppercase badge displayed right above the title.</small>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label class="shop-label mb-1">Category Filter</label>
                <select name="FormCategorySlug" class="shop-input">
                    <option value="">All Categories (Latest)</option>
                    @foreach (var c in _categories)
                    {
                        <option value="@c.Slug" selected="@(editSection?.CategorySlug == c.Slug)">@c.Name (@c.Slug)</option>
                    }
                </select>
            </div>

            <div>
                <label class="shop-label mb-1">Products to Display</label>
                <input type="number" name="FormItemLimit" value="@(editSection?.ItemLimit ?? 8)" min="2" max="24" class="shop-input" />
            </div>

            <div>
                <label class="shop-label mb-1">Display Sort Order</label>
                <input type="number" name="FormSortOrder" value="@(editSection?.SortOrder ?? ((_sections.MaxBy(s => s.SortOrder)?.SortOrder ?? 0) + 10))" class="shop-input" />
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
            @if (EditId > 0)
            {
                <a href="/admin/homepage-sections" class="btn-secondary text-xs">Cancel Editing</a>
            }
            <button type="submit" class="btn-primary text-xs">
                <span>@(EditId > 0 ? "Save Changes" : "Create Section")</span>
            </button>
        </div>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "edit")]
    public int EditId { get; set; }

    [SupplyParameterFromQuery(Name = "notice")]
    public string? NoticeQuery { get; set; }

    [SupplyParameterFromForm(FormName = "sections-table-action")]
    public string? Action { get; set; }

    [SupplyParameterFromForm(FormName = "save-section")]
    public string? SaveAction { get; set; }

    [SupplyParameterFromForm(FormName = "save-section")]
    public int FormId { get; set; }

    [SupplyParameterFromForm(FormName = "save-section")]
    public string? FormTitle { get; set; }

    [SupplyParameterFromForm(FormName = "save-section")]
    public string? FormEyebrow { get; set; }

    [SupplyParameterFromForm(FormName = "save-section")]
    public string? FormCategorySlug { get; set; }

    [SupplyParameterFromForm(FormName = "save-section")]
    public int FormItemLimit { get; set; }

    [SupplyParameterFromForm(FormName = "save-section")]
    public int FormSortOrder { get; set; }

    private List<HomepageSection> _sections = [];
    private List<Category> _categories = [];
    private HomepageSection? editSection;
    private string? _toast;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(NoticeQuery))
        {
            _toast = NoticeQuery;
        }

        if (!string.IsNullOrEmpty(Action))
        {
            var parts = Action.Split(':');
            if (parts.Length == 2 && int.TryParse(parts[1], out var targetId))
            {
                var act = parts[0];
                var item = await Db.HomepageSections.FindAsync(targetId);
                if (item != null)
                {
                    if (act == "toggle")
                    {
                        item.IsActive = !item.IsActive;
                        await Db.SaveChangesAsync();
                        Nav.NavigateTo("/admin/homepage-sections?notice=" + Uri.EscapeDataString(item.IsActive ? "Section enabled." : "Section disabled."));
                        return;
                    }
                    else if (act == "up")
                    {
                        item.SortOrder -= 10;
                        await Db.SaveChangesAsync();
                        Nav.NavigateTo("/admin/homepage-sections");
                        return;
                    }
                    else if (act == "down")
                    {
                        item.SortOrder += 10;
                        await Db.SaveChangesAsync();
                        Nav.NavigateTo("/admin/homepage-sections");
                        return;
                    }
                    else if (act == "delete")
                    {
                        Db.HomepageSections.Remove(item);
                        await Db.SaveChangesAsync();
                        Nav.NavigateTo("/admin/homepage-sections?notice=" + Uri.EscapeDataString("Deleted section."));
                        return;
                    }
                }
            }
        }
        else if (SaveAction == "save" && !string.IsNullOrWhiteSpace(FormTitle))
        {
            var viewHref = string.IsNullOrWhiteSpace(FormCategorySlug) ? "/products" : $"/category/{FormCategorySlug}";
            string noticeText;
            if (FormId == 0)
            {
                Db.HomepageSections.Add(new HomepageSection
                {
                    Title = FormTitle.Trim(),
                    Eyebrow = FormEyebrow?.Trim(),
                    CategorySlug = FormCategorySlug,
                    ViewAllHref = viewHref,
                    ItemLimit = FormItemLimit <= 0 ? 8 : FormItemLimit,
                    SortOrder = FormSortOrder,
                    IsActive = true
                });
                noticeText = "Created new homepage section.";
            }
            else
            {
                var existing = await Db.HomepageSections.FindAsync(FormId);
                if (existing != null)
                {
                    existing.Title = FormTitle.Trim();
                    existing.Eyebrow = FormEyebrow?.Trim();
                    existing.CategorySlug = FormCategorySlug;
                    existing.ViewAllHref = viewHref;
                    existing.ItemLimit = FormItemLimit <= 0 ? 8 : FormItemLimit;
                    existing.SortOrder = FormSortOrder;
                }
                noticeText = "Updated homepage section.";
            }
            await Db.SaveChangesAsync();
            Nav.NavigateTo("/admin/homepage-sections?notice=" + Uri.EscapeDataString(noticeText));
            return;
        }

        await LoadData();
        if (EditId > 0)
        {
            editSection = _sections.FirstOrDefault(s => s.Id == EditId);
        }
    }

    private async Task LoadData()
    {
        _sections = await Db.HomepageSections
            .OrderBy(s => s.SortOrder)
            .ToListAsync();

        _categories = await Db.Categories
            .Where(c => !c.IsDeleted)
            .OrderBy(c => c.Name)
            .ToListAsync();
    }
}
