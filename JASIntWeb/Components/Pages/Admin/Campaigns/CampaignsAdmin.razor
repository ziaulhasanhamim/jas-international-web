@page "/admin/campaigns"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using JASIntWeb.Persistence.Entities
@using JASIntWeb.Client.Dtos
@inject AppDbContext Db
@inject NavigationManager Nav
@inject CampaignService CampaignSvc
@inject CampaignPricingService PricingSvc
@inject CatalogService CatalogSvc

<PageTitle>Mega Campaigns &amp; Special Offers · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">STOREFRONT PROMOTIONS</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Campaigns &amp; Special Offers</h1>
        <p class="text-sm text-slate-500 mt-1">Manage festival sales, mega campaigns, countdown timers, hero banners, and curated promotional deal pages.</p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/offers" target="_blank" class="btn-secondary shadow-xs flex items-center gap-1.5 text-xs">
            <span>View Offers Hub ↗</span>
        </a>
        <a href="/admin/campaigns/new" class="btn-primary shadow-xs flex items-center gap-1.5">
            <Icon Name="plus" Class="size-4" />
            Create Campaign
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800 flex items-center justify-between">
        <span class="flex items-center gap-2">
            <Icon Name="check" Class="size-4 text-emerald-600" />
            @_toast
        </span>
        <button type="button" @onclick="() => _toast = null" class="text-emerald-600 hover:text-emerald-950 cursor-pointer">
            <Icon Name="close" Class="size-3.5" />
        </button>
    </div>
}

<!-- Search Bar with Debounce -->
<div class="mb-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="relative w-full max-w-xs">
        <input @bind="searchQuery" @bind:event="oninput" @bind:after="OnSearchInput"
               placeholder="Search campaigns by name, coupon..."
               class="shop-input !mt-0 text-xs pl-9 pr-9" />
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
            <Icon Name="search" Class="size-3.5" />
        </span>
        @if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            <button type="button" @onclick="ClearSearch" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 font-bold text-xs cursor-pointer">✕</button>
        }
    </div>
</div>

<div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
    <div class="table-scroll">
        <QuickGrid Items="@campaignsQuery" class="data-table">
            <PropertyColumn Property="@(c => c.Id)" Title="#ID" Class="col-id font-mono text-xs text-slate-500 w-16 text-center" Align="Align.Center" />

            <TemplateColumn Title="Campaign">
                <div class="flex items-center gap-3">
                    @if (!string.IsNullOrWhiteSpace(context.BannerImageUrl))
                    {
                        <img src="@context.BannerImageUrl" alt="@context.Name" class="size-12 rounded-lg object-cover border border-slate-200 flex-shrink-0" />
                    }
                    else
                    {
                        <div class="size-12 rounded-lg bg-slate-100 flex items-center justify-center text-xl flex-shrink-0">
                            🎉
                        </div>
                    }
                    <div>
                        <div class="flex items-center gap-2">
                            <strong class="font-bold text-slate-900 text-sm">@context.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(context.BanglaName))
                            {
                                <span class="text-xs text-indigo-600 font-semibold">@context.BanglaName</span>
                            }
                        </div>
                        <span class="text-xs text-slate-400 font-mono block mt-0.5">/campaigns/@context.Slug</span>
                        @if (context.Collection != null)
                        {
                            <a href="/admin/collections/@context.Collection.Id/edit" class="inline-flex items-center gap-1 mt-1 px-2 py-0.5 rounded bg-indigo-50 text-indigo-800 border border-indigo-200 text-[10px] font-bold hover:bg-indigo-100">
                                📦 @context.Collection.Name
                            </a>
                        }
                    </div>
                </div>
            </TemplateColumn>

            <TemplateColumn Title="Offer / Scenario">
                <div class="space-y-1">
                    @switch (context.DiscountScenario)
                    {
                        case CampaignDiscountScenario.DirectDiscount:
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-rose-50 text-rose-800 border border-rose-200">
                                ⚡ Direct Sale @(context.DefaultDiscountValue > 0 ? $"({context.DefaultDiscountValue:0.##}{(context.DefaultDiscountType == CampaignProductDiscountType.Percentage ? "%" : "৳")})" : "")
                            </span>
                            break;
                        case CampaignDiscountScenario.DirectAndCoupon:
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-purple-50 text-purple-800 border border-purple-200">
                                🔥 Direct + Coupon
                            </span>
                            break;
                        case CampaignDiscountScenario.CouponOnly:
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-amber-50 text-amber-800 border border-amber-200">
                                🎟️ Coupon Only
                            </span>
                            break;
                        default:
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-100 text-slate-700">
                                ✨ Showcase
                            </span>
                            break;
                    }
                    @if (context.CampaignProducts.Count > 0)
                    {
                        <span class="block text-[10px] font-semibold text-slate-500">@context.CampaignProducts.Count product deal override(s)</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(context.HighlightCouponCode))
                    {
                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-50 text-amber-800 border border-amber-200">
                            🎟️ @context.HighlightCouponCode
                        </span>
                    }
                </div>
            </TemplateColumn>

            <TemplateColumn Title="Schedule / Countdown">
                @{
                    var now = DateTimeOffset.UtcNow;
                    var isEnded = context.EndDate.HasValue && context.EndDate.Value < now;
                    var isUpcoming = context.StartDate.HasValue && context.StartDate.Value > now;
                }
                @if (isEnded)
                {
                    <span class="text-xs text-slate-400">Ended @context.EndDate?.ToString("MMM dd, yyyy")</span>
                }
                else if (isUpcoming)
                {
                    <span class="text-xs text-blue-600 font-semibold">Starts @context.StartDate?.ToString("MMM dd, yyyy")</span>
                }
                else if (context.EndDate.HasValue)
                {
                    <span class="text-xs text-emerald-700 font-bold">Ends @context.EndDate?.ToString("MMM dd, yyyy")</span>
                }
                else
                {
                    <span class="text-xs text-slate-500 font-medium">Ongoing (No end date)</span>
                }
            </TemplateColumn>

            <TemplateColumn Title="Status">
                @{
                    var nowTime = DateTimeOffset.UtcNow;
                    var isExpired = context.EndDate.HasValue && context.EndDate.Value < nowTime;
                }
                @if (!context.IsActive)
                {
                    <span class="badge badge-rose">Disabled</span>
                }
                else if (isExpired)
                {
                    <span class="badge badge-amber">Expired</span>
                }
                else
                {
                    <span class="badge badge-emerald">Live</span>
                }
            </TemplateColumn>

            <TemplateColumn Title="Sort" Class="w-20 text-center">
                <span class="text-xs font-mono text-slate-600">@context.SortOrder</span>
            </TemplateColumn>

            <TemplateColumn Title="Actions" Class="w-36 text-right">
                <div class="flex items-center justify-end gap-1.5">
                    <a href="/campaigns/@context.Slug" target="_blank" class="p-1.5 text-slate-400 hover:text-blue-600 transition" title="Preview on Storefront">
                        <Icon Name="external-link" Class="size-4" />
                    </a>
                    <a href="/admin/campaigns/@context.Id/edit" class="p-1.5 text-slate-400 hover:text-slate-800 transition" title="Edit Campaign">
                        <Icon Name="edit" Class="size-4" />
                    </a>
                    <button type="button" @onclick="() => ToggleActive(context)" class="p-1.5 text-slate-400 hover:text-amber-600 transition cursor-pointer" title="@(context.IsActive ? "Disable" : "Enable")">
                        <span>@(context.IsActive ? "⏸" : "▶")</span>
                    </button>
                    <button type="button" @onclick="() => DeleteCampaign(context)" class="p-1.5 text-slate-400 hover:text-rose-600 transition cursor-pointer" title="Delete">
                        <Icon Name="trash" Class="size-4" />
                    </button>
                </div>
            </TemplateColumn>
        </QuickGrid>
    </div>
</div>

@code {
    private string searchQuery = "";
    private System.Threading.Timer? _debounceTimer;
    private string? _toast;

    private IQueryable<Campaign> campaignsQuery
    {
        get
        {
            var q = Db.Campaigns.AsNoTracking()
                .Include(c => c.Collection)
                .Include(c => c.CampaignProducts)
                .AsQueryable();
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var term = searchQuery.Trim().ToLower();
                q = q.Where(c => c.Name.ToLower().Contains(term) ||
                                 c.Slug.ToLower().Contains(term) ||
                                 (c.HighlightCouponCode != null && c.HighlightCouponCode.ToLower().Contains(term)) ||
                                 (c.BanglaName != null && c.BanglaName.ToLower().Contains(term)));
            }
            return q.OrderBy(c => c.SortOrder).ThenByDescending(c => c.CreatedAt);
        }
    }

    private void OnSearchInput()
    {
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(StateHasChanged);
        }, null, 300, Timeout.Infinite);
    }

    private void ClearSearch()
    {
        searchQuery = "";
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).ContainsKey("saved"))
        {
            _toast = "Campaign saved successfully!";
        }
    }

    private async Task ToggleActive(Campaign campaign)
    {
        var target = await Db.Campaigns.FindAsync(campaign.Id);
        if (target != null)
        {
            target.IsActive = !target.IsActive;
            await Db.SaveChangesAsync();
            await PricingSvc.InvalidateCacheAsync();
            await CampaignSvc.InvalidateCacheAsync(target.Slug);
            await CatalogSvc.InvalidateAllAsync();
            _toast = $"Campaign '{target.Name}' is now {(target.IsActive ? "Active" : "Disabled")}.";
        }
    }

    private async Task DeleteCampaign(Campaign campaign)
    {
        var target = await Db.Campaigns.FindAsync(campaign.Id);
        if (target != null)
        {
            Db.Campaigns.Remove(target);
            await Db.SaveChangesAsync();
            await PricingSvc.InvalidateCacheAsync();
            await CampaignSvc.InvalidateCacheAsync(target.Slug);
            await CatalogSvc.InvalidateAllAsync();
            _toast = $"Campaign '{target.Name}' deleted.";
        }
    }
}
