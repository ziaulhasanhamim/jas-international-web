@page "/admin/attributes"
@inject AppDbContext Db

<PageTitle>Attribute Library · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">PRODUCT SPECIFICATIONS</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Attribute Library</h1>
        <p class="text-sm text-slate-500 mt-1">Reusable attributes (e.g. Color, Storage, Warranty) and allowable values across products.</p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/admin/attributes/new" class="btn-primary shadow-xs">
            <Icon Name="plus" Class="size-4" />
            Add Attribute
        </a>
    </div>
</div>

<!-- Attributes Table -->
<div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
    <div class="table-scroll">
        <QuickGrid Items="@attributesQuery" Pagination="@pagination" class="data-table">
            <TemplateColumn Title="Attribute Name" Sortable="true" SortBy="@(GridSort<AttributeDefinition>.ByAscending(a => a.Name))">
                <strong class="text-slate-900 block font-semibold">@context.Name</strong>
            </TemplateColumn>
            <TemplateColumn Title="Identifier Code" Sortable="true" SortBy="@(GridSort<AttributeDefinition>.ByAscending(a => a.Code))">
                <span class="font-mono text-xs text-slate-600">@context.Code</span>
            </TemplateColumn>
            <TemplateColumn Title="Measurement Unit" Sortable="true" SortBy="@(GridSort<AttributeDefinition>.ByAscending(a => a.Unit))">
                <span class="text-slate-600 text-xs">@(context.Unit ?? "—")</span>
            </TemplateColumn>
            <TemplateColumn Title="Actions" Class="text-right whitespace-nowrap">
                <div class="flex items-center justify-end gap-2">
                    <a href="/admin/attributes/@context.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                        Edit
                    </a>
                    <a href="/admin/attributes/@context.Id/options" class="btn-secondary !px-2.5 !py-1 text-xs">
                        Manage Options
                    </a>
                </div>
            </TemplateColumn>
        </QuickGrid>
    </div>
</div>

<div class="mt-4 flex items-center justify-between">
    <Paginator State="@pagination" />
</div>

@code
{
    private PaginationState pagination = new() { ItemsPerPage = 25 };
    private IQueryable<AttributeDefinition>? attributesQuery;

    protected override void OnInitialized()
    {
        attributesQuery = Db.AttributeDefinitions.AsNoTracking().AsQueryable();
    }
}
