@inject NavigationManager Nav
@page "/admin/attributes"
@inject AppDbContext Db

<PageTitle>Attribute Library · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">PRODUCT SPECIFICATIONS</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Attribute Library</h1>
        <p class="text-sm text-slate-500 mt-1">Reusable attributes (e.g. Color, Storage, Warranty) and allowable values across products.</p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/admin/attributes/new" class="btn-primary shadow-xs">
            <Icon Name="plus" Class="size-4" />
            Add Attribute
        </a>
    </div>
</div>

<!-- Attributes Table -->
<div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
    <div class="table-scroll">
        <QuickGrid Items="@attributesQuery" class="data-table">
            <PropertyColumn Property="@(a => a.Id)" Title="#ID" Class="col-id font-mono text-xs text-slate-500 w-16 text-center" Align="Align.Center" />
            <TemplateColumn Title="Attribute Name" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Attribute Name" SortKey="Name" /></HeaderTemplate><ChildContent>
                <strong class="text-slate-900 block font-semibold">@context.Name</strong>
            </ChildContent></TemplateColumn>
            <TemplateColumn Title="Identifier Code" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Identifier Code" SortKey="Code" /></HeaderTemplate><ChildContent>
                <span class="font-mono text-xs text-slate-600">@context.Code</span>
            </ChildContent></TemplateColumn>
            <TemplateColumn Title="Measurement Unit" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Measurement Unit" SortKey="Unit" /></HeaderTemplate><ChildContent>
                <span class="text-slate-600 text-xs">@(context.Unit ?? "—")</span>
            </ChildContent></TemplateColumn>
            <TemplateColumn Title="Actions" Class="text-right whitespace-nowrap">
                <div class="flex items-center justify-end gap-2">
                    <a href="/admin/attributes/@context.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                        Edit
                    </a>
                    <a href="/admin/attributes/@context.Id/options" class="btn-secondary !px-2.5 !py-1 text-xs">
                        Manage Options
                    </a>
                </div>
            </TemplateColumn>
        </QuickGrid>
    </div>

    <div class="p-4 border-t border-slate-200/90 flex items-center justify-between">
        <AdminPagination Total="totalFiltered" Page="Page" Size="PageSize" />
    </div>
</div>

@code
{
    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    private const int PageSize = 25;
    private int totalFiltered;
    private IQueryable<AttributeDefinition>? attributesQuery;

    protected override async Task OnInitializedAsync()
    {
        Page = Math.Max(1, Page);
        var q = Db.AttributeDefinitions.AsNoTracking().OrderBy(a => a.Name);
        totalFiltered = await q.CountAsync();
        var list = await AdminSorting.Apply(q, Nav, ("Name", a => a.Name), ("Code", a => a.Code), ("Unit", a => a.Unit!))
            .Skip((Page - 1) * PageSize).Take(PageSize).ToListAsync();
        attributesQuery = list.AsQueryable();
    }
}
