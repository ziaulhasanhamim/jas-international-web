@page "/admin/attributes"
@inject AppDbContext Db

<PageTitle>Attribute Library · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">PRODUCT SPECIFICATIONS</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Attribute Library</h1>
        <p class="text-sm text-slate-500 mt-1">Reusable attributes (e.g. Color, Storage, Warranty) and allowable values across products.</p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/admin/attributes/new" class="btn-primary shadow-xs">
            <Icon Name="plus" Class="size-4" />
            Add Attribute
        </a>
    </div>
</div>

<!-- Attributes Table -->
<div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Attribute Name</th>
                    <th>Identifier Code</th>
                    <th>Measurement Unit</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in attributes)
                {
                    <tr>
                        <td>
                            <strong class="text-slate-900 block font-semibold">@a.Name</strong>
                        </td>
                        <td class="font-mono text-xs text-slate-600">
                            @a.Code
                        </td>
                        <td class="text-slate-600 text-xs">
                            @(a.Unit ?? "—")
                        </td>
                        <td class="text-right whitespace-nowrap space-x-2">
                            <a href="/admin/attributes/@a.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                                Edit
                            </a>
                            <a href="/admin/attributes/@a.Id/options" class="btn-secondary !px-2.5 !py-1 text-xs">
                                Manage Options
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (attributes.Count == 0)
    {
        <div class="empty-state py-12">
            <Icon Name="tag" Class="size-10 text-slate-300" />
            <p>No attributes configured yet. Add Color, Storage, or Warranty.</p>
        </div>
    }
</div>

<div class="mt-4">
    <AdminPagination Total="total" Page="Page" />
</div>

@code
{
    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;
    private List<AttributeDefinition> attributes = [];
    private int total;

    protected override async Task OnInitializedAsync()
    {
        Page = Math.Clamp(Page, 1, 10000);
        total = await Db.AttributeDefinitions.CountAsync();
        attributes = await Db.AttributeDefinitions.AsNoTracking()
            .OrderBy(a => a.Name)
            .ThenBy(a => a.Id)
            .Skip((Page - 1) * 25)
            .Take(25)
            .ToListAsync();
    }
}
