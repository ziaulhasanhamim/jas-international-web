@page "/admin/attributes/{AttributeId:int}/options"
@inject AppDbContext Db

<AdminPageHeader
    Title="@($"{name} values")"
    Description="Values are reusable across products. Product pages control which values are allowed and their order."
    ActionHref="@($"/admin/attributes/{AttributeId}/options/new")"
    ActionText="+ Add value"
/>
<a href="/admin/attributes" class="admin-back-link">← Attribute library</a>
<div class="shop-panel admin-table-wrap">
    <QuickGrid Items="@optionsQuery" Pagination="@pagination" class="shop-table">
        <TemplateColumn Title="Display value" Sortable="true" SortBy="@(GridSort<AttributeOption>.ByAscending(o => o.Value))">
            <strong>@context.Value</strong>
        </TemplateColumn>
        <PropertyColumn Property="@(o => o.Code)" Title="Code" Sortable="true" />
        <TemplateColumn Title="Actions">
            <a href="/admin/attributes/@AttributeId/options/@context.Id/edit">Edit value</a>
        </TemplateColumn>
    </QuickGrid>
</div>
<div class="mt-4 flex items-center justify-between">
    <Paginator State="@pagination" />
</div>

@code
{
    [Parameter]
    public int AttributeId { get; set; }
    private PaginationState pagination = new() { ItemsPerPage = 25 };
    private IQueryable<AttributeOption>? optionsQuery;
    private string? name;

    protected override async Task OnInitializedAsync()
    {
        name = await Db.AttributeDefinitions.Where(a => a.Id == AttributeId).Select(a => a.Name).SingleOrDefaultAsync();
        optionsQuery = Db.AttributeOptions.AsNoTracking().Where(o => o.AttributeDefinitionId == AttributeId);
    }
}
