@inject NavigationManager Nav
@page "/admin/attributes/{AttributeId:int}/options"
@using Microsoft.AspNetCore.Components.QuickGrid
@inject AppDbContext Db

<PageTitle>@(name ?? "Attribute") Values · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">PRODUCT SPECIFICATIONS</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">@(name ?? "Attribute") Values</h1>
        <p class="text-sm text-slate-500 mt-1">Values are reusable across products. Product pages control which values are allowed and their order.</p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/admin/attributes" class="btn-secondary shadow-xs">
            ← Attribute Library
        </a>
        <a href="@($"/admin/attributes/{AttributeId}/options/new")" class="btn-primary shadow-xs">
            <Icon Name="plus" Class="size-4" />
            Add Value
        </a>
    </div>
</div>

<div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
    <div class="table-scroll">
        <QuickGrid Items="@optionsQuery" class="data-table">
            <TemplateColumn Title="Display Value" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Display Value" SortKey="Value" /></HeaderTemplate><ChildContent>
                <strong class="text-slate-900 block font-semibold text-xs">@context.Value</strong>
            </ChildContent></TemplateColumn>

            <PropertyColumn Property="@(o => o.Code)" Title="Code" Sortable="false" Class="font-mono text-xs text-slate-600" ><HeaderTemplate><AdminSortHeader Label="Code" SortKey="Code" /></HeaderTemplate></PropertyColumn>

            <TemplateColumn Title="Actions" Align="Align.End">
                <a href="/admin/attributes/@AttributeId/options/@context.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                    Edit Value
                </a>
            </TemplateColumn>
        </QuickGrid>
    </div>

    <div class="p-4 border-t border-slate-200/90 flex items-center justify-between">
        <AdminPagination Total="totalFiltered" Page="Page" Size="PageSize" />
    </div>
</div>

@code
{
    [Parameter]
    public int AttributeId { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    private const int PageSize = 25;
    private int totalFiltered;
    private IQueryable<AttributeOption>? optionsQuery;
    private string? name;

    protected override async Task OnInitializedAsync()
    {
        name = await Db.AttributeDefinitions.Where(a => a.Id == AttributeId).Select(a => a.Name).SingleOrDefaultAsync();
        Page = Math.Max(1, Page);
        var q = Db.AttributeOptions.AsNoTracking().Where(o => o.AttributeDefinitionId == AttributeId).OrderBy(o => o.Value);
        totalFiltered = await q.CountAsync();
        var list = await AdminSorting.Apply(q, Nav, ("Value", o => o.Value), ("Code", o => o.Code))
            .Skip((Page - 1) * PageSize).Take(PageSize).ToListAsync();
        optionsQuery = list.AsQueryable();
    }
}
