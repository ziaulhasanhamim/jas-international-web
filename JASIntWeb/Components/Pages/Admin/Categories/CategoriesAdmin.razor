@page "/admin/categories"
@layout AdminLayout
@using Microsoft.AspNetCore.Components.QuickGrid
@inject AppDbContext Db
@inject AdminService Admin
@inject CatalogService Catalog
@inject NavigationManager Nav

<PageTitle>Categories · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">CATALOG TAXONOMY</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Categories</h1>
        <p class="text-sm text-slate-500 mt-1">Organize the catalog hierarchy into parent categories and subcategories using database-powered QuickGrid.</p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/admin/categories/new" class="btn-primary shadow-xs">
            <Icon Name="plus" Class="size-4" />
            Add Category
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800 flex items-center justify-between">
        <span class="flex items-center gap-2">
            <Icon Name="check" Class="size-4 text-emerald-600" />
            @_toast
        </span>
        <button type="button" @onclick="() => _toast = null" class="text-emerald-600 hover:text-emerald-950">
            <Icon Name="close" Class="size-3.5" />
        </button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800 flex items-center justify-between">
        <span class="flex items-center gap-2">
            <Icon Name="close" Class="size-4 text-rose-600" />
            @_error
        </span>
        <button type="button" @onclick="() => _error = null" class="text-rose-600 hover:text-rose-950">
            <Icon Name="close" Class="size-3.5" />
        </button>
    </div>
}

<!-- Filters Bar -->
<div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
    <div class="flex flex-wrap items-center gap-2">
        <a
            href="@FilterUrl("all")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Filter == "all" ? "bg-slate-900 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            All Categories (@totalAll)
        </a>
        <a
            href="@FilterUrl("active")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Filter == "active" ? "bg-emerald-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            Active (@totalActive)
        </a>
        <a
            href="@FilterUrl("featured")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Filter == "featured" ? "bg-indigo-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            ⭐ Homepage Featured (@totalFeatured)
        </a>
        <a
            href="@FilterUrl("hidden")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Filter == "hidden" ? "bg-rose-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            Hidden / Archived (@totalHidden)
        </a>
    </div>

    <form method="get" data-enhance class="relative w-64">
        <input type="hidden" name="status" value="@Filter" />
        <input
            name="q"
            value="@Query"
            class="field pr-9 !py-1.5 text-xs"
            placeholder="Search categories..."
        />
        <button type="submit" class="absolute right-2 top-2 text-slate-400 hover:text-slate-700">
            <Icon Name="search" Class="size-3.5" />
        </button>
    </form>
</div>

<!-- Categories QuickGrid (Direct DB Query via EntityFrameworkAdapter) -->
<form method="post" @formname="categories-table-action" data-enhance>
    <AntiforgeryToken />

    <!-- Bulk Actions Toolbar (POS App Pattern) -->
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200/90 bg-slate-50 p-3 shadow-2xs">
        <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-slate-700">Bulk Actions:</span>
            <button type="submit" name="BulkAction" value="hide" class="btn-secondary !py-1 !px-3 text-xs font-bold hover:bg-slate-200 cursor-pointer">
                Hide Selected
            </button>
            <button type="submit" name="BulkAction" value="restore" class="btn-secondary !py-1 !px-3 text-xs font-bold text-emerald-700 hover:bg-emerald-50 cursor-pointer">
                Restore Selected
            </button>
            <button type="submit" name="BulkAction" value="delete" class="btn-secondary !py-1 !px-3 text-xs font-bold text-rose-600 hover:bg-rose-50 cursor-pointer" onclick="return confirm('Are you sure you want to delete selected categories? Categories with active products will be safely hidden.')">
                Delete Selected
            </button>
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
        <div class="table-scroll">
            <QuickGrid Items="@categoriesQuery" class="data-table">
                <TemplateColumn Class="w-10 text-center">
                    <HeaderTemplate Context="_">
                        <input type="checkbox" id="select-all-categories"
                               class="rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer"
                               onclick="document.querySelectorAll('.cat-select-cb').forEach(cb => cb.checked = this.checked)"
                               title="Select all" />
                    </HeaderTemplate>
                    <ChildContent Context="c">
                        <input type="checkbox" name="SelectedCategoryIds" value="@c.Id"
                               class="cat-select-cb rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" />
                    </ChildContent>
                </TemplateColumn>

                <TemplateColumn Title="Category Name" Sortable="true" SortBy="@sortByName">
                    <div class="flex items-center gap-2.5">
                        @if (!string.IsNullOrWhiteSpace(context.Icon))
                        {
                            <span class="flex size-7 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-sm">
                                @context.Icon
                            </span>
                        }
                        <strong class="text-slate-900 block font-semibold">@context.Name</strong>
                    </div>
                </TemplateColumn>

                <PropertyColumn Property="@(c => c.Slug)" Title="URL Slug" Sortable="true" Class="font-mono text-xs text-slate-600" />

                <TemplateColumn Title="Hierarchy Level">
                    @if (string.IsNullOrEmpty(context.ParentCategoryName))
                    {
                        <span class="inline-flex items-center gap-1 rounded-md bg-slate-100 px-2 py-0.5 font-medium text-slate-700 text-xs">
                            Top level (Root)
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1 rounded-md bg-indigo-50 px-2 py-0.5 font-medium text-indigo-700 text-xs">
                            ↳ Subcategory of @context.ParentCategoryName
                        </span>
                    }
                </TemplateColumn>

                <PropertyColumn Property="@(c => c.ProductCount)" Title="Products" Sortable="true" />

                <TemplateColumn Title="Homepage Featured" Align="Align.Center">
                    <button
                        type="submit"
                        name="ToggleFeaturedId"
                        value="@context.Id"
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold transition cursor-pointer @(context.IsFeatured ? "bg-indigo-50 text-indigo-700 border border-indigo-200 hover:bg-indigo-100" : "bg-slate-100 text-slate-400 border border-slate-200 hover:bg-slate-200")"
                        title="Click to toggle homepage featured status"
                    >
                        <span class="size-1.5 rounded-full @(context.IsFeatured ? "bg-indigo-600" : "bg-slate-400")"></span>
                        @(context.IsFeatured ? "⭐ Featured" : "Standard")
                    </button>
                </TemplateColumn>

                <TemplateColumn Title="Status" Sortable="true" SortBy="@sortByDeleted">
                    <span class="badge @(context.IsDeleted ? "badge-rose" : "badge-emerald")">
                        @(context.IsDeleted ? "Hidden" : "Active")
                    </span>
                </TemplateColumn>

                <TemplateColumn Title="Actions" Align="Align.End">
                    <div class="flex items-center justify-end gap-1.5">
                        <a href="/admin/categories/@context.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                            Edit
                        </a>
                        @if (!context.IsDeleted)
                        {
                            <button
                                type="submit"
                                name="ToggleVisibilityId"
                                value="@context.Id"
                                class="btn-secondary !px-2.5 !py-1 text-xs text-amber-700 hover:text-amber-800 hover:bg-amber-50 cursor-pointer"
                                onclick="return confirm('Hide this category from the storefront? Its products will also be hidden from search and catalog.')"
                                title="Hide category from storefront"
                            >
                                Hide
                            </button>
                            @if (context.ProductCount == 0)
                            {
                                <button
                                    type="submit"
                                    name="HardDeleteCategoryId"
                                    value="@context.Id"
                                    class="btn-secondary !px-2.5 !py-1 text-xs text-rose-600 hover:text-rose-700 hover:bg-rose-50 cursor-pointer"
                                    onclick="return confirm('Permanently delete this empty category? This cannot be undone.')"
                                    title="Permanently delete category"
                                >
                                    Delete
                                </button>
                            }
                            else
                            {
                                <button
                                    type="button"
                                    class="btn-secondary !px-2.5 !py-1 text-xs text-slate-300 cursor-not-allowed select-none"
                                    title="Cannot permanently delete: Contains @context.ProductCount products. Reassign or delete its products first, or click 'Hide' to remove from storefront."
                                    disabled
                                >
                                    Delete
                                </button>
                            }
                        }
                        else
                        {
                            <button
                                type="submit"
                                name="ToggleVisibilityId"
                                value="@context.Id"
                                class="btn-secondary !px-2.5 !py-1 text-xs text-emerald-600 hover:text-emerald-700 hover:bg-emerald-50 cursor-pointer"
                                title="Restore this category to active catalog"
                            >
                                Restore
                            </button>
                            @if (context.ProductCount == 0)
                            {
                                <button
                                    type="submit"
                                    name="HardDeleteCategoryId"
                                    value="@context.Id"
                                    class="btn-secondary !px-2.5 !py-1 text-xs text-rose-600 hover:text-rose-700 hover:bg-rose-50 cursor-pointer"
                                    onclick="return confirm('Permanently remove this archived category? This cannot be undone.')"
                                    title="Permanently delete category"
                                >
                                    Delete Permanently
                                </button>
                            }
                            else
                            {
                                <button
                                    type="button"
                                    class="btn-secondary !px-2.5 !py-1 text-xs text-slate-300 cursor-not-allowed select-none"
                                    title="Cannot permanently delete: Contains @context.ProductCount products. Reassign or delete its products first."
                                    disabled
                                >
                                    Delete Permanently
                                </button>
                            }
                        }
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="p-4 border-t border-slate-200/90 flex items-center justify-between">
            <AdminPagination Total="totalFiltered" Page="Page" Size="PageSize" />
        </div>
    </div>
</form>

@if (featured.Count > 0)
{
    <div class="mt-8 rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-xs">
        <OrderEditor Kind="OrderableKind.FeaturedCategories" Items="featured" Title="Homepage Featured Category Order" />
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string Filter { get; set; } = "all";

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromForm(FormName = "categories-table-action")]
    public int ToggleFeaturedId { get; set; }

    [SupplyParameterFromForm(FormName = "categories-table-action")]
    public int ToggleVisibilityId { get; set; }

    [SupplyParameterFromForm(FormName = "categories-table-action")]
    public int DeleteCategoryId { get; set; }

    [SupplyParameterFromForm(FormName = "categories-table-action")]
    public int HardDeleteCategoryId { get; set; }

    [SupplyParameterFromForm(FormName = "categories-table-action")]
    public List<int>? SelectedCategoryIds { get; set; }

    [SupplyParameterFromForm(FormName = "categories-table-action")]
    public string? BulkAction { get; set; }

    public record AdminCategoryRow(
        int Id,
        string Name,
        string Slug,
        string? Icon,
        string? ParentCategoryName,
        int ProductCount,
        bool IsFeatured,
        bool IsDeleted
    );

    private IQueryable<AdminCategoryRow>? categoriesQuery;
    private GridSort<AdminCategoryRow> sortByName = GridSort<AdminCategoryRow>.ByAscending(c => c.Name);
    private GridSort<AdminCategoryRow> sortByDeleted = GridSort<AdminCategoryRow>.ByAscending(c => c.IsDeleted);

    private const int PageSize = 15;
    private int totalFiltered;
    private List<OrderableItemDto> featured = [];
    private string? _toast;
    private string? _error;
    private int totalAll;
    private int totalActive;
    private int totalFeatured;
    private int totalHidden;

    private string FilterUrl(string status)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(status) && status != "all") parts.Add($"status={Uri.EscapeDataString(status)}");
        if (!string.IsNullOrWhiteSpace(Query)) parts.Add($"q={Uri.EscapeDataString(Query)}");
        return parts.Count > 0 ? $"/admin/categories?{string.Join("&", parts)}" : "/admin/categories";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(BulkAction) && SelectedCategoryIds != null && SelectedCategoryIds.Count > 0)
            {
                await Admin.BulkCategoryActionAsync(SelectedCategoryIds, BulkAction);
                _toast = $"Bulk action '{BulkAction}' successfully applied to {SelectedCategoryIds.Count} categories.";
                ResetActionFields();
            }
            else if (ToggleFeaturedId > 0)
            {
                await Admin.ToggleCategoryFeaturedAsync(ToggleFeaturedId);
                _toast = "Homepage featured status updated successfully.";
                ResetActionFields();
            }
            else if (ToggleVisibilityId > 0)
            {
                await Admin.ToggleCategoryVisibilityAsync(ToggleVisibilityId);
                _toast = "Category visibility updated.";
                ResetActionFields();
            }
            else if (DeleteCategoryId > 0)
            {
                await Admin.DeleteCategoryAsync(DeleteCategoryId, permanent: true);
                _toast = "Category permanently deleted. Any assigned products were safely moved to Uncategorized.";
                ResetActionFields();
            }
            else if (HardDeleteCategoryId > 0)
            {
                await Admin.HardDeleteCategoryAsync(HardDeleteCategoryId);
                _toast = "Category permanently deleted. Any assigned products were safely moved to Uncategorized.";
                ResetActionFields();
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _error = $"Unable to process request: {ex.Message}";
            await LoadDataAsync();
        }
    }

    private void ResetActionFields()
    {
        BulkAction = null;
        SelectedCategoryIds = null;
        ToggleFeaturedId = 0;
        ToggleVisibilityId = 0;
        DeleteCategoryId = 0;
        HardDeleteCategoryId = 0;
    }

    private async Task LoadDataAsync()
    {
        Page = Math.Max(1, Page);

        totalAll = await Db.Categories.CountAsync();
        totalActive = await Db.Categories.CountAsync(c => !c.IsDeleted);
        var featuredIds = await Db.CategoryPlacements.AsNoTracking()
            .Where(p => p.PlacementType == CategoryPlacementType.HomepageFeatured && p.IsActive)
            .Select(p => p.CategoryId)
            .ToListAsync();
        totalFeatured = featuredIds.Count;
        totalHidden = await Db.Categories.CountAsync(c => c.IsDeleted);

        featured = await Db.CategoryPlacements.AsNoTracking()
            .Where(p => p.IsActive && p.PlacementType == CategoryPlacementType.HomepageFeatured && !p.Category!.IsDeleted)
            .OrderBy(p => p.SortOrder)
            .ThenBy(p => p.Id)
            .Select(p => new OrderableItemDto(p.Id, p.Category!.Name))
            .ToListAsync();

        var q = Db.Categories.AsNoTracking();

        if (Filter == "active")
        {
            q = q.Where(c => !c.IsDeleted);
        }
        else if (Filter == "featured")
        {
            q = q.Where(c => featuredIds.Contains(c.Id) && !c.IsDeleted);
        }
        else if (Filter == "hidden")
        {
            q = q.Where(c => c.IsDeleted);
        }

        if (!string.IsNullOrWhiteSpace(Query))
        {
            var term = Query.Trim().ToLower();
            q = q.Where(c => c.Name.ToLower().Contains(term) || c.Slug.ToLower().Contains(term));
        }

        totalFiltered = await q.CountAsync();

        var list = await q.OrderBy(c => c.ParentCategoryId == null ? 0 : 1)
            .ThenBy(c => c.Name)
            .Skip((Page - 1) * PageSize)
            .Take(PageSize)
            .Select(c => new AdminCategoryRow(
                c.Id,
                c.Name,
                c.Slug,
                c.Icon,
                c.ParentCategory != null ? c.ParentCategory.Name : null,
                c.Products.Count(p => !p.IsDeleted),
                featuredIds.Contains(c.Id),
                c.IsDeleted
            ))
            .ToListAsync();

        categoriesQuery = list.AsQueryable();
    }
}
