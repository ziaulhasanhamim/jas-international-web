@page "/admin/categories"
@inject AppDbContext Db

<PageTitle>Categories · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">CATALOG TAXONOMY</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Categories</h1>
        <p class="text-sm text-slate-500 mt-1">Organize the catalog hierarchy into parent categories and subcategories.</p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/admin/categories/new" class="btn-primary shadow-xs">
            <Icon Name="plus" Class="size-4" />
            Add Category
        </a>
    </div>
</div>

<!-- Search Bar -->
<div class="mb-6 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
    <form method="get" data-enhance class="flex flex-wrap items-center gap-3">
        <div class="relative flex-1 min-w-[220px]">
            <input name="q" value="@Query" class="field pr-9" placeholder="Search categories..." />
            <span class="absolute right-3 top-3 text-slate-400">
                <Icon Name="search" Class="size-4" />
            </span>
        </div>
        <button type="submit" class="btn-primary">Search</button>
        @if (!string.IsNullOrWhiteSpace(Query))
        {
            <a href="/admin/categories" class="btn-secondary">Clear</a>
        }
    </form>
</div>

<!-- Categories QuickGrid -->
<div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
    <div class="table-scroll">
        <QuickGrid Items="@categoriesQuery" Pagination="@pagination" class="data-table">
            <TemplateColumn Title="Category Name" Sortable="true" SortBy="@(GridSort<Category>.ByAscending(c => c.Name))">
                <strong class="text-slate-900 block font-semibold">@context.Name</strong>
            </TemplateColumn>
            <TemplateColumn Title="URL Slug" Sortable="true" SortBy="@(GridSort<Category>.ByAscending(c => c.Slug))">
                <span class="font-mono text-xs text-slate-600">/@context.Slug</span>
            </TemplateColumn>
            <TemplateColumn Title="Parent Level">
                <span class="inline-flex items-center gap-1 rounded-md bg-slate-100 px-2 py-0.5 font-medium text-slate-700 text-xs">
                    @(context.ParentCategory?.Name ?? "Top level (Root)")
                </span>
            </TemplateColumn>
            <TemplateColumn Title="Visibility" Sortable="true" SortBy="@(GridSort<Category>.ByAscending(c => c.IsDeleted))">
                <span class="badge @(context.IsDeleted ? "badge-rose" : "badge-emerald")">
                    @(context.IsDeleted ? "Hidden" : "Active")
                </span>
            </TemplateColumn>
            <TemplateColumn Title="Actions" Class="text-right">
                <a href="/admin/categories/@context.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                    Edit Category
                </a>
            </TemplateColumn>
        </QuickGrid>
    </div>
</div>

<div class="mt-4 flex items-center justify-between">
    <Paginator State="@pagination" />
</div>

@if (featured.Count > 0)
{
    <div class="mt-8 rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-xs">
        <OrderEditor Kind="OrderableKind.FeaturedCategories" Items="featured" Title="Homepage Featured Category Order" />
    </div>
}

@code
{
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private PaginationState pagination = new() { ItemsPerPage = 25 };
    private IQueryable<Category>? categoriesQuery;
    private List<OrderableItemDto> featured = [];

    protected override async Task OnInitializedAsync()
    {
        var q = Db.Categories.AsNoTracking().Include(c => c.ParentCategory).AsQueryable();
        if (!string.IsNullOrWhiteSpace(Query))
        {
            var filter = Query.Trim().ToLower();
            q = q.Where(c => c.Name.ToLower().Contains(filter));
        }
        categoriesQuery = q;

        featured = await Db.CategoryPlacements.AsNoTracking()
            .Where(p => p.IsActive
            && p.PlacementType == CategoryPlacementType.HomepageFeatured
            && !p.Category!.IsDeleted)
            .OrderBy(p => p.SortOrder)
            .ThenBy(p => p.Id)
            .Select(p => new OrderableItemDto(p.Id, p.Category!.Name))
            .ToListAsync();
    }
}
