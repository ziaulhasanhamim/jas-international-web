@page "/admin/categories/new"
@page "/admin/categories/{Id:int}/edit"
@inject AppDbContext Db
@inject AdminSession Session
@inject NavigationManager Nav

<AdminPageHeader
    Title="@(Id == 0 ? "Add category" : "Edit category")"
    ActionHref="/admin/categories"
    ActionText="Back to list"
/>
@if (notFound)
{
    <p class="admin-empty">Record not found.</p>
}
else
{
    @if (error is not null)
    {
        <p role="alert" class="form-error">@error</p>
    }
    @if (Input is null)
    {
        <p class="admin-help">Loading form…</p>
    }
    else
    {
        <EditForm
            Model="Input"
            OnValidSubmit="Save"
            FormName="CategoryEditor"
            method="post"
            data-submit-indication="true"
            class="shop-panel admin-form"
        >
            <DataAnnotationsValidator />
            <ValidationSummary />
            <label class="shop-label">
                Category name
                <InputText @bind-Value="Input!.Name" class="shop-input" />
            </label>
            <label class="shop-label">
                URL slug
                <InputText @bind-Value="Input!.Slug" class="shop-input" />
            </label>
            <label class="shop-label">
                Icon / image URL
                <InputText @bind-Value="Input!.Icon" class="shop-input" />
                <small>Use an emoji or an HTTPS / site-relative image URL.</small>
            </label>
            <label class="shop-label">
                Parent category
                <InputSelect @bind-Value="Input!.ParentId" class="shop-input">
                    <option value="">Top-level category</option>
                    @foreach (var p in parents)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </InputSelect>
                <small>Two levels: parent → subcategory → product.</small>
            </label>
            <label class="check-label">
                <input type="checkbox" name="Input.Hidden" checked="@(Input!.Hidden)" value="true" />
                <input type="hidden" name="Input.Hidden" value="false" />
                Hide category and its products
            </label>
            <label class="check-label">
                <input type="checkbox" name="Input.Featured" checked="@(Input!.Featured)" value="true" />
                <input type="hidden" name="Input.Featured" value="false" />
                Feature on homepage
            </label>

            <!-- SEO & Google SERP Preview -->
            <div class="mt-6 rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <h3 class="text-sm font-bold text-slate-900">🔍 Category Search Engine Optimization (Google SERP)</h3>
                </div>

                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 font-sans space-y-1">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">GOOGLE SNIPPET PREVIEW</span>
                    <div class="flex items-center gap-2 text-xs text-slate-700">
                        <span class="flex size-4 items-center justify-center rounded-full bg-blue-600 text-[10px] text-white font-bold">J</span>
                        <span class="truncate">https://www.jasinternational.com.bd › category › @(string.IsNullOrWhiteSpace(Input!.Slug) ? "category-slug" : Input!.Slug.Trim().ToLowerInvariant())</span>
                    </div>
                    <h4 class="text-base font-medium text-blue-800 leading-tight">
                        @(string.IsNullOrWhiteSpace(Input!.MetaTitle)
                            ? (string.IsNullOrWhiteSpace(Input!.Name) ? "Category Name Price in Bangladesh | JAS International" : $"{Input!.Name.Trim()} Price in Bangladesh | JAS International")
                            : Input!.MetaTitle.Trim())
                    </h4>
                    <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                        @(string.IsNullOrWhiteSpace(Input!.MetaDescription)
                            ? $"Browse 100% authentic {Input!.Name} gadgets with official brand warranty, nationwide cash on delivery, and showroom support in Khulna from JAS International."
                            : Input!.MetaDescription.Trim())
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <label class="shop-label">
                        <div class="flex items-center justify-between">
                            <span>Custom Meta Title</span>
                            <span class="text-[11px] @((Input!.MetaTitle?.Length ?? 0) > 60 ? "text-amber-600 font-bold" : "text-slate-400")">
                                @(Input!.MetaTitle?.Length ?? 0) / 60 chars
                            </span>
                        </div>
                        <InputText @bind-Value="Input!.MetaTitle" class="shop-input" placeholder="e.g. Smartwatches Price in Bangladesh | JAS International" />
                    </label>

                    <label class="shop-label">
                        <div class="flex items-center justify-between">
                            <span>Custom Meta Description</span>
                            <span class="text-[11px] @((Input!.MetaDescription?.Length ?? 0) > 155 ? "text-amber-600 font-bold" : "text-slate-400")">
                                @(Input!.MetaDescription?.Length ?? 0) / 155 chars
                            </span>
                        </div>
                        <InputText @bind-Value="Input!.MetaDescription" class="shop-input" placeholder="e.g. Shop the latest authentic smartwatches in Bangladesh with warranty..." />
                    </label>
                </div>

                <label class="shop-label">
                    <span>Intro Category Overview (Top of Category Page)</span>
                    <InputTextArea @bind-Value="Input!.IntroText" class="shop-input" rows="2" placeholder="Brief 1-2 sentence overview of this category for shoppers." />
                </label>

                <label class="shop-label">
                    <span>Bottom Rich SEO Text / Buyer Guide (HTML / Markdown supported)</span>
                    <InputTextArea @bind-Value="Input!.BottomSeoCopy" class="shop-input font-mono text-xs" rows="4" placeholder="Comprehensive buying guide, brand options, price ranges in BD, warranty and delivery details." />
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="shop-button" data-pending-text="Saving category...">
                    <span class="form-submit-spinner" hidden></span>
                    <span>Save category</span>
                </button>
                <a href="/admin/categories" class="shop-button-secondary">Cancel</a>
            </div>
        </EditForm>
    }
}

@code
{
    [Parameter]
    public int Id { get; set; }
    [SupplyParameterFromForm(FormName = "CategoryEditor")]
    private CategoryEditForm? Input { get; set; }
    private string? error;
    private bool notFound;
    private List<Category> parents = [];

    protected override async Task OnInitializedAsync()
    {
        var hasChildren = Id != 0 && await Db.Categories.AnyAsync(c => c.ParentCategoryId == Id);
        parents = hasChildren ? [] : await Db.Categories.AsNoTracking()
            .Where(c => c.Id != Id
            && !c.IsDeleted
            && c.ParentCategoryId == null)
            .OrderBy(c => c.Name)
            .ToListAsync();
        if (Input is not null)
        {
            return;
        }
        if (Id == 0)
        {
            Input = new();
            return;
        }
        var c = await Db.Categories.AsNoTracking().SingleOrDefaultAsync(c => c.Id == Id);
        if (c is null)
        {
            notFound = true;
            return;
        }
        Input = new()
        {
            Id = c.Id,
            Name = c.Name,
            Slug = c.Slug,
            Icon = c.Icon ?? "",
            ParentId = c.ParentCategoryId,
            Hidden = c.IsDeleted,
            MetaTitle = c.MetaTitle,
            MetaDescription = c.MetaDescription,
            OgImageUrl = c.OgImageUrl,
            IntroText = c.IntroText,
            BottomSeoCopy = c.BottomSeoCopy,
            Featured = await Db.CategoryPlacements.AnyAsync(p => p.CategoryId == Id
                && p.IsActive
                && p.PlacementType == CategoryPlacementType.HomepageFeatured)
        };
    }

    private async Task Save()
    {
        try
        {
            Input!.Id = Id;
            await Session.RunAsync(s => s.SaveCategoryAsync(Input));
            Nav.NavigateTo("/admin/categories");
        }
        catch (ShopException ex)
        {
            error = ex.Message;
        }
    }
}
