@page "/admin/products/{ProductId:int}/variants/{Id:int}/edit"
@page "/admin/products/{ProductId:int}/variants/new"
@inject NavigationManager Nav
@code {
    [Parameter] public int ProductId { get; set; }
    [Parameter] public int Id { get; set; }
    protected override void OnInitialized() => Nav.NavigateTo($"/admin/products/{ProductId}/variants?variant={Id}", replace: true);
}
