@page "/admin/products/{ProductId:int}/variants"
@inject AppDbContext Db

<AdminPageHeader
    Title="Variants & stock"
    Description="Each combination has its own SKU, price and inventory."
    ActionHref="@($"/admin/products/{ProductId}/variants/new")"
    ActionText="+ Add variant"
/>
<ProductAdminTabs ProductId="ProductId" />
<h2 class="admin-record-title">@name</h2>
@if (Created > 0)
{
    <p class="form-notice" role="status">Created @Created variants with zero stock. Set actual stock before selling.</p>
}
<div class="admin-toolbar">
    <form method="get" data-enhance>
        <input name="q" value="@Query" class="shop-input" placeholder="Search SKU" />
        <button class="shop-button-secondary">Search</button>
    </form>
    <a href="/admin/products/@ProductId/variants/generate" class="shop-button-secondary">Generate combinations</a>
</div>

<div class="shop-panel admin-table-wrap">
    @if (variantsQuery is not null)
    {
        <QuickGrid Items="@variantsQuery" Pagination="@pagination" class="shop-table">
            <TemplateColumn Title="Variant / SKU" Sortable="true" SortBy="@(GridSort<AdminVariantRow>.ByAscending(r => r.Label))">
                <strong>@context.Label</strong>
                <small class="cell-secondary">@context.Sku</small>
            </TemplateColumn>
            <TemplateColumn Title="Price" Sortable="true" SortBy="@(GridSort<AdminVariantRow>.ByAscending(r => r.Price))">
                ৳@context.Price.ToString("N0")
            </TemplateColumn>
            <PropertyColumn Property="@(r => r.OnHand)" Title="On hand" Sortable="true" />
            <PropertyColumn Property="@(r => r.Reserved)" Title="Reserved" Sortable="true" />
            <TemplateColumn Title="Available" Sortable="true" SortBy="@(GridSort<AdminVariantRow>.ByAscending(r => r.OnHand - r.Reserved))">
                <span class="status-badge @(context.OnHand - context.Reserved <= 5 ? "status-warning" : "")">@(context.OnHand - context.Reserved)</span>
            </TemplateColumn>
            <TemplateColumn Title="Status" Sortable="true" SortBy="@(GridSort<AdminVariantRow>.ByAscending(r => r.Active))">
                @(context.Active ? "Active" : "Inactive")
                @if (context.Default)
                {
                    <span class="status-badge">Default</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="Actions" Class="row-actions">
                <a href="/admin/products/@ProductId/variants/@context.Id/edit">Edit</a>
                <a href="/admin/inventory/@context.Id/edit">Adjust stock</a>
            </TemplateColumn>
        </QuickGrid>
    }
</div>

<div class="mt-4 flex items-center justify-between">
    <Paginator State="@pagination" />
</div>

@code
{
    [Parameter]
    public int ProductId { get; set; }
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "created")]
    public int Created { get; set; }
    private string? name;
    private PaginationState pagination = new() { ItemsPerPage = 25 };
    private IQueryable<AdminVariantRow>? variantsQuery;

    protected override async Task OnInitializedAsync()
    {
        name = await Db.Products.Where(p => p.Id == ProductId).Select(p => p.Name).SingleOrDefaultAsync();
        var q = Db.ProductVariants.AsNoTracking().Where(v => v.ProductId == ProductId && !v.IsDeleted);
        if (!string.IsNullOrWhiteSpace(Query))
        {
            var filter = Query.Trim().ToLower();
            q = q.Where(v => v.SKU.ToLower().Contains(filter));
        }
        var data = await q.OrderByDescending(v => v.IsDefault)
            .ThenBy(v => v.Id)
            .Select(v => new
            {
                v.Id,
                v.SKU,
                v.SellingPrice,
                v.IsActive,
                v.IsDefault,
                OnHand = Db.InventoryItems.Where(i => i.ProductVariantId == v.Id)
                .Select(i => i.QuantityOnHand)
                .FirstOrDefault(),
                Reserved = Db.InventoryItems.Where(i => i.ProductVariantId == v.Id)
                .Select(i => i.QuantityReserved)
                .FirstOrDefault(),
                Options = v.Options.OrderBy(o => o.ProductAttributeOption!.ProductAttributeDefinition!.SortOrder)
                .Select(o => o.ProductAttributeOption!.AttributeOption!.Value)
                .ToList()
            })
            .ToListAsync();
        var rows = data.Select(v => new AdminVariantRow(v.Id,
                ProductId,
                name ?? "",
                v.SKU,
                v.Options.Count == 0 ? "Standard" : string.Join(" / ", v.Options),
                v.SellingPrice,
                v.OnHand,
                v.Reserved,
                v.IsActive,
                v.IsDefault))
            .ToList();
        variantsQuery = rows.AsQueryable();
    }
}
