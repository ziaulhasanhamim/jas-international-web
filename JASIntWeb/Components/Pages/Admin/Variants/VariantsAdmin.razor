@inject NavigationManager Nav
@page "/admin/products/{ProductId:int}/variants"
@inject AppDbContext Db

<AdminPageHeader
    Title="Variants & stock"
    Description="Each combination has its own SKU, price and inventory."
    ActionHref="@($"/admin/products/{ProductId}/variants/new")"
    ActionText="+ Add variant"
/>
<ProductAdminTabs ProductId="ProductId" />
<h2 class="admin-record-title">@name</h2>
@if (Created > 0)
{
    <p class="form-notice" role="status">Created @Created variants with zero stock. Set actual stock before selling.</p>
}
<div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <form method="get" data-enhance class="flex items-center gap-2">
        <input name="q" value="@Query" class="field !py-1.5 text-xs w-64" placeholder="Search SKU..." />
        <button class="btn-primary !py-1.5 !px-3 text-xs">Search</button>
        @if (!string.IsNullOrWhiteSpace(Query))
        {
            <a href="/admin/products/@ProductId/variants" class="btn-secondary !py-1.5 !px-3 text-xs">Reset</a>
        }
    </form>
    <a href="/admin/products/@ProductId/variants/generate" class="btn-secondary !py-1.5 !px-3 text-xs font-semibold">
        <Icon Name="settings" Class="size-3.5" />
        Generate combinations
    </a>
</div>

<div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
    <div class="table-scroll">
        @if (variantsQuery is not null)
        {
            <QuickGrid Items="@variantsQuery" class="data-table">
                <TemplateColumn Title="Variant / SKU" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Variant / SKU" SortKey="Label" /></HeaderTemplate><ChildContent>
                    <strong class="text-slate-900 block font-semibold text-xs">@context.Label</strong>
                    <span class="font-mono text-[11px] text-slate-500 block">@context.Sku</span>
                </ChildContent></TemplateColumn>
                <TemplateColumn Title="Selling Price" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Selling Price" SortKey="Price" /></HeaderTemplate><ChildContent>
                    <span class="font-bold text-slate-900 text-xs">৳@context.Price.ToString("N0")</span>
                </ChildContent></TemplateColumn>
                <PropertyColumn Property="@(r => r.OnHand)" Title="On hand" Sortable="false" ><HeaderTemplate><AdminSortHeader Label="On hand" SortKey="OnHand" /></HeaderTemplate></PropertyColumn>
                <PropertyColumn Property="@(r => r.Reserved)" Title="Reserved" Sortable="false" ><HeaderTemplate><AdminSortHeader Label="Reserved" SortKey="Reserved" /></HeaderTemplate></PropertyColumn>
                <TemplateColumn Title="Available" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Available" SortKey="Available" /></HeaderTemplate><ChildContent>
                    @{
                        var avail = context.OnHand - context.Reserved;
                    }
                    @if (avail <= 0)
                    {
                        <span class="badge badge-rose">0 (Out of stock)</span>
                    }
                    else if (avail <= 5)
                    {
                        <span class="badge badge-amber">@avail (Low)</span>
                    }
                    else
                    {
                        <span class="badge badge-emerald">@avail in stock</span>
                    }
                </ChildContent></TemplateColumn>
                <TemplateColumn Title="Status" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Status" SortKey="Active" /></HeaderTemplate><ChildContent>
                    <div class="flex items-center gap-1.5">
                        <span class="badge @(context.Active ? "badge-emerald" : "badge-slate")">
                            @(context.Active ? "Active" : "Inactive")
                        </span>
                        @if (context.Default)
                        {
                            <span class="badge badge-blue">Default</span>
                        }
                    </div>
                </ChildContent></TemplateColumn>
                <TemplateColumn Title="Actions" Align="Align.End">
                    <div class="flex items-center justify-end gap-1.5">
                        <a href="/admin/products/@ProductId/variants/@context.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                            Edit
                        </a>
                        <a href="/admin/inventory/@context.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs text-blue-600 hover:text-blue-700">
                            Adjust Stock
                        </a>
                    </div>
                </TemplateColumn>
            </QuickGrid>
        }
    </div>

    <div class="p-4 border-t border-slate-200/90 flex items-center justify-between">
        <AdminPagination Total="totalFiltered" Page="Page" Size="PageSize" />
    </div>
</div>

@code
{
    [Parameter]
    public int ProductId { get; set; }
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "created")]
    public int Created { get; set; }
    private string? name;
    private const int PageSize = 25;
    private int totalFiltered;
    private IQueryable<AdminVariantRow>? variantsQuery;

    protected override async Task OnInitializedAsync()
    {
        name = await Db.Products.Where(p => p.Id == ProductId).Select(p => p.Name).SingleOrDefaultAsync();
        var q = Db.ProductVariants.AsNoTracking().Where(v => v.ProductId == ProductId && !v.IsDeleted);
        if (!string.IsNullOrWhiteSpace(Query))
        {
            var filter = Query.Trim().ToLower();
            q = q.Where(v => v.SKU.ToLower().Contains(filter));
        }
        var data = await q.OrderByDescending(v => v.IsDefault)
            .ThenBy(v => v.Id)
            .Select(v => new
            {
                v.Id,
                v.SKU,
                v.SellingPrice,
                v.IsActive,
                v.IsDefault,
                OnHand = Db.InventoryItems.Where(i => i.ProductVariantId == v.Id)
                .Select(i => i.QuantityOnHand)
                .FirstOrDefault(),
                Reserved = Db.InventoryItems.Where(i => i.ProductVariantId == v.Id)
                .Select(i => i.QuantityReserved)
                .FirstOrDefault(),
                Options = v.Options.OrderBy(o => o.ProductAttributeOption!.ProductAttributeDefinition!.SortOrder)
                .Select(o => o.ProductAttributeOption!.AttributeOption!.Value)
                .ToList()
            })
            .ToListAsync();
        var rows = data.Select(v => new AdminVariantRow(v.Id,
                ProductId,
                name ?? "",
                v.SKU,
                v.Options.Count == 0 ? "Standard" : string.Join(" / ", v.Options),
                v.SellingPrice,
                v.OnHand,
                v.Reserved,
                v.IsActive,
                v.IsDefault))
            .ToList();
        totalFiltered = rows.Count;
        Page = Math.Max(1, Page);
        variantsQuery = AdminSorting.Apply(rows.AsQueryable(), Nav, ("Label", r => r.Label), ("Price", r => r.Price), ("OnHand", r => r.OnHand), ("Reserved", r => r.Reserved), ("Available", r => r.OnHand - r.Reserved), ("Active", r => r.Active)).Skip((Page - 1) * PageSize).Take(PageSize).AsQueryable();
    }
}
