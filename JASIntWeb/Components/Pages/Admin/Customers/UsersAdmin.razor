@page "/admin/users"
@inject AppDbContext Db

<PageTitle>Customer Accounts & Access · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">ACCESS & MEMBERSHIP</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Customers &amp; Access</h1>
        <p class="text-sm text-slate-500 mt-1">Manage registered customer accounts and administrator privileges.</p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/admin/users/new" class="btn-primary shadow-xs">
            <Icon Name="plus" Class="size-4" />
            Add Account
        </a>
    </div>
</div>

<!-- Search Bar -->
<div class="mb-6 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
    <form method="get" data-enhance class="flex flex-wrap items-center gap-3">
        <div class="relative flex-1 min-w-[220px]">
            <input name="q" value="@Query" class="field pr-9" placeholder="Search by email address..." />
            <span class="absolute right-3 top-3 text-slate-400">
                <Icon Name="search" Class="size-4" />
            </span>
        </div>
        <button type="submit" class="btn-primary">Search</button>
        @if (!string.IsNullOrWhiteSpace(Query))
        {
            <a href="/admin/users" class="btn-secondary">Clear</a>
        }
    </form>
</div>

<!-- Users Table -->
<div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Account Email</th>
                    <th>Mobile Phone</th>
                    <th>Account Role</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in users)
                {
                    var isAdmin = admins.Contains(u.Id);
                    <tr>
                        <td>
                            <strong class="text-slate-900 block font-semibold">@u.Email</strong>
                            <span class="text-xs text-slate-400">User ID #@u.Id</span>
                        </td>
                        <td class="font-mono text-xs text-slate-600">
                            @(u.PhoneNumber ?? "—")
                        </td>
                        <td>
                            <span class="badge @(isAdmin ? "badge-purple" : "badge-slate")">
                                <Icon Name="@(isAdmin ? "shield" : "user")" Class="size-3" />
                                @(isAdmin ? "Administrator" : "Store Customer")
                            </span>
                        </td>
                        <td class="text-right">
                            <a href="/admin/users/@u.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                                Manage Privileges
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (users.Count == 0)
    {
        <div class="empty-state py-12">
            <Icon Name="users" Class="size-10 text-slate-300" />
            <p>No customer accounts found.</p>
        </div>
    }
</div>

<div class="mt-4">
    <AdminPagination Total="total" Page="Page" />
</div>

@code
{
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;
    private List<User> users = [];
    private HashSet<int> admins = [];
    private int total;

    protected override async Task OnInitializedAsync()
    {
        Page = Math.Clamp(Page, 1, 10000);
        var q = Db.Users.AsNoTracking();
        if (!string.IsNullOrWhiteSpace(Query))
        {
            q = q.Where(u => u.Email!.ToLower().Contains(Query.ToLower()));
        }
        total = await q.CountAsync();
        users = await q.OrderBy(u => u.Email).ThenBy(u => u.Id).Skip((Page - 1) * 25).Take(25).ToListAsync();
        var ids = users.Select(u => u.Id).ToList();
        admins = (await Db.UserRoles.Where(r => ids.Contains(r.UserId)
                && Db.Roles.Any(role => role.Id == r.RoleId
                    && role.Name == "Admin"))
            .Select(r => r.UserId)
            .ToListAsync()).ToHashSet();
    }
}
