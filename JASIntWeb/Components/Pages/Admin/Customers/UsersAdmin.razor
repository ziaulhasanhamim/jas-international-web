@page "/admin/users"
@layout AdminLayout
@using Microsoft.AspNetCore.Components.QuickGrid
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>User Management · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">USER MANAGEMENT &amp; ACCESS</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">User Accounts</h1>
        <p class="text-sm text-slate-500 mt-1">Manage customer profiles, administrator privileges, account lockouts, and email verification with database QuickGrid.</p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/admin/users/create" class="btn-primary shadow-xs">
            <Icon Name="plus" Class="size-4" />
            Add New User
        </a>
    </div>
</div>

<!-- Metrics Cards -->
<div class="mb-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
        <div class="flex items-center gap-3">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                <Icon Name="users" Class="size-5" />
            </div>
            <div>
                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Total Users</p>
                <p class="text-xl font-bold tracking-tight text-slate-900">@statsTotal</p>
            </div>
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
        <div class="flex items-center gap-3">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-purple-50 text-purple-600">
                <Icon Name="shield" Class="size-5" />
            </div>
            <div>
                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Admins</p>
                <p class="text-xl font-bold tracking-tight text-purple-700">@statsAdmins</p>
            </div>
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
        <div class="flex items-center gap-3">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                <Icon Name="check" Class="size-5" />
            </div>
            <div>
                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Verified</p>
                <p class="text-xl font-bold tracking-tight text-emerald-700">@statsVerified</p>
            </div>
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
        <div class="flex items-center gap-3">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                <Icon Name="cart" Class="size-5" />
            </div>
            <div>
                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">With Orders</p>
                <p class="text-xl font-bold tracking-tight text-slate-900">@statsWithOrders</p>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter Controls -->
<div class="mb-6 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs space-y-3">
    <!-- Filter Tabs -->
    <div class="flex flex-wrap items-center gap-1.5 border-b border-slate-100 pb-3">
        <a href="@(FilterUrl(null))" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition @(string.IsNullOrEmpty(Filter) ? "bg-blue-600 text-white shadow-2xs" : "text-slate-600 hover:bg-slate-100")">
            All Users
        </a>
        <a href="@(FilterUrl("admins"))" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition @(Filter == "admins" ? "bg-purple-600 text-white shadow-2xs" : "text-slate-600 hover:bg-slate-100")">
            Admins
        </a>
        <a href="@(FilterUrl("customers"))" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition @(Filter == "customers" ? "bg-blue-600 text-white shadow-2xs" : "text-slate-600 hover:bg-slate-100")">
            Customers
        </a>
        <a href="@(FilterUrl("verified"))" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition @(Filter == "verified" ? "bg-emerald-600 text-white shadow-2xs" : "text-slate-600 hover:bg-slate-100")">
            Verified
        </a>
        <a href="@(FilterUrl("unverified"))" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition @(Filter == "unverified" ? "bg-amber-600 text-white shadow-2xs" : "text-slate-600 hover:bg-slate-100")">
            Unverified
        </a>
        <a href="@(FilterUrl("locked"))" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition @(Filter == "locked" ? "bg-rose-600 text-white shadow-2xs" : "text-slate-600 hover:bg-slate-100")">
            Locked Out
        </a>
    </div>

    <!-- Search Form -->
    <form method="get" data-enhance class="flex flex-wrap items-center gap-3">
        @if (!string.IsNullOrEmpty(Filter))
        {
            <input type="hidden" name="filter" value="@Filter" />
        }
        <div class="relative flex-1 min-w-[240px]">
            <input name="q" value="@Query" class="field pr-9" placeholder="Search by email, name, or phone number..." />
            <span class="absolute right-3 top-3 text-slate-400">
                <Icon Name="search" Class="size-4" />
            </span>
        </div>
        <button type="submit" class="btn-primary">Search</button>
        @if (!string.IsNullOrWhiteSpace(Query) || !string.IsNullOrWhiteSpace(Filter))
        {
            <a href="/admin/users" class="btn-secondary">Reset Filters</a>
        }
    </form>
</div>

<!-- Users QuickGrid (Direct DB Query via EntityFrameworkAdapter) -->
<div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
    <div class="table-scroll">
        <QuickGrid Items="@usersQuery" class="data-table">
            <TemplateColumn Title="User / Account" Sortable="false"><HeaderTemplate><AdminSortHeader Label="User / Account" SortKey="Email" /></HeaderTemplate><ChildContent>
                <div class="flex items-center gap-3">
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600 font-bold text-xs">
                        @(context.Email?.FirstOrDefault().ToString().ToUpperInvariant() ?? "U")
                    </div>
                    <div class="min-w-0">
                        @if (!string.IsNullOrWhiteSpace(context.FullName))
                        {
                            <strong class="text-slate-900 block font-semibold text-xs">@context.FullName</strong>
                        }
                        <span class="text-xs text-slate-600 block">@context.Email</span>
                        @if (!string.IsNullOrWhiteSpace(context.PhoneNumber))
                        {
                            <span class="text-2xs text-slate-400 font-mono block">@context.PhoneNumber</span>
                        }
                    </div>
                </div>
            </ChildContent></TemplateColumn>

            <TemplateColumn Title="System Role" Align="Align.Center">
                @if (context.IsAdmin)
                {
                    <span class="inline-flex items-center gap-1 rounded-md bg-purple-50 px-2 py-0.5 text-xs font-semibold text-purple-700 ring-1 ring-purple-600/20">
                        <Icon Name="shield" Class="size-3" />
                        Admin
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1 rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">
                        Customer
                    </span>
                }
            </TemplateColumn>

            <TemplateColumn Title="Email Status" Align="Align.Center">
                @if (context.EmailConfirmed)
                {
                    <span class="inline-flex items-center gap-1 rounded-md bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        Verified
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1 rounded-md bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        Pending
                    </span>
                }
            </TemplateColumn>

            <TemplateColumn Title="Account Status" Align="Align.Center">
                @if (context.IsLocked)
                {
                    <span class="inline-flex items-center gap-1 rounded-md bg-rose-50 px-2 py-0.5 text-xs font-semibold text-rose-700">
                        <span class="size-1.5 rounded-full bg-rose-500"></span>
                        Locked Out
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1 rounded-md bg-slate-50 px-2 py-0.5 text-xs font-medium text-slate-600">
                        Active
                    </span>
                }
            </TemplateColumn>

            <TemplateColumn Title="Orders &amp; Spend">
                <div class="text-xs">
                    <span class="font-semibold text-slate-900 block">@context.OrderCount orders</span>
                    <span class="text-slate-400 text-2xs block">৳@context.TotalSpent.ToString("N0") spent</span>
                </div>
            </TemplateColumn>

            <TemplateColumn Title="Actions" Align="Align.End">
                <a href="/admin/users/@context.Id" class="btn-secondary !px-2.5 !py-1 text-xs">
                    View &amp; Edit
                </a>
            </TemplateColumn>
        </QuickGrid>
    </div>

    <div class="p-4 border-t border-slate-200/90 flex items-center justify-between">
        <AdminPagination Total="totalFiltered" Page="Page" Size="PageSize" />
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "filter")]
    public string? Filter { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    public record AdminUserRow(
        int Id,
        string? Email,
        string? PhoneNumber,
        bool EmailConfirmed,
        bool IsLocked,
        bool IsAdmin,
        string? FullName,
        int OrderCount,
        decimal TotalSpent
    );

    private IQueryable<AdminUserRow>? usersQuery;
    private const int PageSize = 20;
    private int totalFiltered;

    private int statsTotal;
    private int statsAdmins;
    private int statsVerified;
    private int statsWithOrders;

    private string FilterUrl(string? filter)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(filter)) parts.Add($"filter={Uri.EscapeDataString(filter)}");
        if (!string.IsNullOrEmpty(Query)) parts.Add($"q={Uri.EscapeDataString(Query)}");
        return parts.Count > 0 ? $"/admin/users?{string.Join("&", parts)}" : "/admin/users";
    }

    protected override async Task OnInitializedAsync()
    {
        statsTotal = await Db.Users.CountAsync();
        statsAdmins = await Db.UserRoles.CountAsync(r => Db.Roles.Any(role => role.Id == r.RoleId && role.Name == "Admin"));
        statsVerified = await Db.Users.CountAsync(u => u.EmailConfirmed);
        statsWithOrders = await Db.Orders.Where(o => o.UserId.HasValue).Select(o => o.UserId!.Value).Distinct().CountAsync();

        var adminRoleId = await Db.Roles.Where(r => r.Name == "Admin").Select(r => r.Id).FirstOrDefaultAsync();

        var q = Db.Users.AsNoTracking();

        if (!string.IsNullOrWhiteSpace(Filter))
        {
            switch (Filter.ToLowerInvariant())
            {
                case "admins":
                    if (adminRoleId > 0)
                    {
                        var adminUserIds = Db.UserRoles.Where(r => r.RoleId == adminRoleId).Select(r => r.UserId);
                        q = q.Where(u => adminUserIds.Contains(u.Id));
                    }
                    break;
                case "customers":
                    if (adminRoleId > 0)
                    {
                        var adminUserIds = Db.UserRoles.Where(r => r.RoleId == adminRoleId).Select(r => r.UserId);
                        q = q.Where(u => !adminUserIds.Contains(u.Id));
                    }
                    break;
                case "verified":
                    q = q.Where(u => u.EmailConfirmed);
                    break;
                case "unverified":
                    q = q.Where(u => !u.EmailConfirmed);
                    break;
                case "locked":
                    var now = DateTimeOffset.UtcNow;
                    q = q.Where(u => u.LockoutEnd.HasValue && u.LockoutEnd.Value > now);
                    break;
            }
        }

        if (!string.IsNullOrWhiteSpace(Query))
        {
            var search = Query.Trim().ToLower();
            q = q.Where(u => (u.Email != null && u.Email.ToLower().Contains(search))
                          || (u.PhoneNumber != null && u.PhoneNumber.Contains(search))
                          || Db.UserClaims.Any(c => c.UserId == u.Id && c.ClaimType == "name" && c.ClaimValue != null && c.ClaimValue.ToLower().Contains(search)));
        }

        Page = Math.Max(1, Page);
        totalFiltered = await q.CountAsync();

        var utcNow = DateTimeOffset.UtcNow;
        var list = await AdminSorting.Apply(q.OrderBy(u => u.Email)
            .ThenBy(u => u.Id), Nav, ("Email", u => u.Email ?? ""))
            .Skip((Page - 1) * PageSize)
            .Take(PageSize)
            .Select(u => new AdminUserRow(
                u.Id,
                u.Email,
                u.PhoneNumber,
                u.EmailConfirmed,
                u.LockoutEnd.HasValue && u.LockoutEnd.Value > utcNow,
                Db.UserRoles.Any(r => r.UserId == u.Id && Db.Roles.Any(role => role.Id == r.RoleId && role.Name == "Admin")),
                Db.UserClaims.Where(c => c.UserId == u.Id && c.ClaimType == "name").Select(c => c.ClaimValue).FirstOrDefault(),
                Db.Orders.Count(o => o.UserId == u.Id),
                Db.Orders.Where(o => o.UserId == u.Id).Sum(o => (decimal?)o.Total) ?? 0m
            ))
            .ToListAsync();

        usersQuery = list.AsQueryable();
    }
}
