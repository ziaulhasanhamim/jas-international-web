@page "/admin/featured-products"
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components.QuickGrid
@inject AppDbContext Db
@inject AdminSession Session
@inject CatalogService Catalog
@inject NavigationManager Nav

<PageTitle>Featured Products &amp; Merchandising · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">MERCHANDISING &amp; BADGES</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Featured &amp; New Arrivals</h1>
        <p class="text-sm text-slate-500 mt-1">
            Toggle which products appear as Homepage Featured or carry the "NEW ARRIVAL" badge using QuickGrid.
        </p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/admin/products" class="btn-secondary text-xs shadow-xs">
            <Icon Name="box" Class="size-3.5" />
            <span>All Products</span>
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800 flex items-center justify-between">
        <span class="flex items-center gap-2">
            <Icon Name="check" Class="size-4 text-emerald-600" />
            @_toast
        </span>
        <button type="button" data-admin-dismiss aria-label="Dismiss notification" class="text-emerald-600 hover:text-emerald-950">
            <Icon Name="close" Class="size-3.5" />
        </button>
    </div>
}

<!-- Filters Bar -->
<div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
    <div class="flex flex-wrap items-center gap-2">
        <a
            href="@FilterUrl("all")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Tab == "all" ? "bg-slate-900 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            All Active Products (@_totalAll)
        </a>
        <a
            href="@FilterUrl("featured")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Tab == "featured" ? "bg-indigo-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            ⭐ Featured Only (@_totalFeatured)
        </a>
        <a
            href="@FilterUrl("new")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Tab == "new" ? "bg-rose-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            🏷️ New Arrivals (@_totalNew)
        </a>
    </div>

    <!-- Search Input -->
    <form method="get" data-enhance class="relative w-64">
        <input type="hidden" name="tab" value="@Tab" />
        <input
            name="q"
            value="@Query"
            class="field pr-9 !py-1.5 text-xs"
            placeholder="Filter by product name..."
        />
        <button type="submit" class="absolute right-2 top-2 text-slate-400 hover:text-slate-700">
            <Icon Name="search" Class="size-3.5" />
        </button>
    </form>
</div>

<!-- Products Table -->
<form method="post" @formname="featured-table-action" data-enhance>
    <AntiforgeryToken />
    <div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
        <div class="table-scroll">
            <QuickGrid Items="@featuredProductsQuery" class="data-table">
                <PropertyColumn Property="@(p => p.Id)" Title="#ID" Class="col-id font-mono text-xs text-slate-500 w-16 text-center" Align="Align.Center" />
                <TemplateColumn Title="Product" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Product" SortKey="Name" /></HeaderTemplate><ChildContent>
                    <div class="flex items-center gap-3">
                        <PictureImage
                            Src="@context.MainImageUrl"
                            Alt="@context.Name"
                            Class="size-11 rounded-lg border border-slate-100 object-contain p-1 shrink-0 bg-white"
                            Loading="lazy"
                            Width="44"
                            Height="44"
                        />
                        <div>
                            <strong class="text-slate-900 block font-semibold text-xs sm:text-sm">@context.Name</strong>
                            <span class="font-mono text-[11px] text-slate-400">/@context.Slug</span>
                        </div>
                    </div>
                </ChildContent></TemplateColumn>

                <TemplateColumn Title="Category &amp; Brand">
                    <div class="space-y-0.5">
                        <span class="badge badge-slate text-[11px]">@context.CategoryName</span>
                        @if (!string.IsNullOrWhiteSpace(context.BrandName))
                        {
                            <span class="block text-[11px] font-bold text-slate-600">@context.BrandName</span>
                        }
                    </div>
                </TemplateColumn>

                <TemplateColumn Title="Pricing" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Pricing" SortKey="Price" /></HeaderTemplate><ChildContent>
                    <div>
                        <span class="font-bold text-xs sm:text-sm text-slate-900">
                            Tk. @context.Price.ToString("N0")
                        </span>
                        @if (context.CompareAtPrice.HasValue && context.CompareAtPrice.Value > context.Price)
                        {
                            <div class="flex items-center gap-1.5 mt-0.5">
                                <span class="text-[11px] text-slate-400 line-through">Tk. @context.CompareAtPrice.Value.ToString("N0")</span>
                                <span class="text-[10px] font-bold text-orange-600 bg-orange-50 px-1 rounded border border-orange-200">
                                    SAVE ৳ @((context.CompareAtPrice.Value - context.Price).ToString("N0"))
                                </span>
                            </div>
                        }
                    </div>
                </ChildContent></TemplateColumn>

                <TemplateColumn Title="⭐ Featured" Align="Align.Center">
                    <button
                        type="submit"
                        name="Action"
                        value="@($"featured:{context.Id}")"
                        class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold transition cursor-pointer @(context.IsFeatured ? "bg-indigo-50 text-indigo-700 border border-indigo-200 hover:bg-indigo-100" : "bg-slate-100 text-slate-400 border border-slate-200 hover:bg-slate-200")"
                    >
                        <span>@(context.IsFeatured ? "⭐ Featured" : "Standard")</span>
                    </button>
                </TemplateColumn>

                <TemplateColumn Title="🏷️ New Arrival" Align="Align.Center">
                    <button
                        type="submit"
                        name="Action"
                        value="@($"new:{context.Id}")"
                        class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold transition cursor-pointer @(context.IsNewArrival ? "bg-rose-50 text-rose-700 border border-rose-200 hover:bg-rose-100" : "bg-slate-100 text-slate-400 border border-slate-200 hover:bg-slate-200")"
                    >
                        <span>@(context.IsNewArrival ? "🏷️ New Arrival" : "Normal")</span>
                    </button>
                </TemplateColumn>

                <TemplateColumn Title="Actions" Align="Align.End">
                    <a href="/admin/products/@context.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                        Edit Product
                    </a>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="p-4 border-t border-slate-200/90 flex items-center justify-between">
            <AdminPagination Total="totalFiltered" Page="Page" Size="PageSize" />
        </div>
    </div>
</form>

@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string Tab { get; set; } = "all";

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromForm(FormName = "featured-table-action")]
    public string? Action { get; set; }

    public sealed record FeaturedProductItem(
        int Id,
        string Name,
        string Slug,
        string MainImageUrl,
        string CategoryName,
        string? BrandName,
        decimal Price,
        decimal? CompareAtPrice,
        bool IsFeatured,
        bool IsNewArrival
    );

    private IQueryable<FeaturedProductItem>? featuredProductsQuery;
    private const int PageSize = 20;
    private int totalFiltered;

    private int _totalAll;
    private int _totalFeatured;
    private int _totalNew;
    private string? _toast;

    private string FilterUrl(string tab)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(tab) && tab != "all") parts.Add($"tab={Uri.EscapeDataString(tab)}");
        if (!string.IsNullOrWhiteSpace(Query)) parts.Add($"q={Uri.EscapeDataString(Query)}");
        return parts.Count > 0 ? $"/admin/featured-products?{string.Join("&", parts)}" : "/admin/featured-products";
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Action))
        {
            var colonIdx = Action.IndexOf(':');
            if (colonIdx > 0 && int.TryParse(Action[(colonIdx + 1)..], out var productId))
            {
                var actionType = Action[..colonIdx];
                var p = await Db.Products.FindAsync(productId);
                if (p != null)
                {
                    if (actionType == "featured")
                    {
                        p.IsFeatured = !p.IsFeatured;
                        _toast = p.IsFeatured ? $"'{p.Name}' marked as Homepage Featured." : $"'{p.Name}' removed from Homepage Featured.";
                    }
                    else if (actionType == "new")
                    {
                        p.IsNewArrival = !p.IsNewArrival;
                        _toast = p.IsNewArrival ? $"'{p.Name}' marked as New Arrival." : $"'{p.Name}' marked as standard catalog item.";
                    }
                    p.UpdatedAt = DateTimeOffset.UtcNow;
                    await Db.SaveChangesAsync();
                    Catalog.InvalidateProductCache(p.Slug);
                }
                Action = null;
            }
        }

        await LoadCountsAsync();
        await LoadProductsAsync();
    }

    private async Task LoadCountsAsync()
    {
        _totalAll = await Db.Products.CountAsync(p => !p.IsDeleted);
        _totalFeatured = await Db.Products.CountAsync(p => !p.IsDeleted && p.IsFeatured);
        _totalNew = await Db.Products.CountAsync(p => !p.IsDeleted && p.IsNewArrival);
    }

    private async Task LoadProductsAsync()
    {
        var raw = await Db.Products
            .AsNoTracking()
            .Where(p => !p.IsDeleted)
            .Include(p => p.Category)
            .Include(p => p.Brand)
            .Include(p => p.ProductVariants)
            .OrderByDescending(p => p.CreatedAt)
            .ToListAsync();

        var list = raw.Select(p =>
        {
            var defaultVar = p.ProductVariants.FirstOrDefault(v => v.IsDefault && v.IsActive && !v.IsDeleted)
                ?? p.ProductVariants.FirstOrDefault(v => v.IsActive && !v.IsDeleted);
            var price = defaultVar?.SellingPrice ?? 0m;
            return new FeaturedProductItem(
                p.Id,
                p.Name,
                p.Slug,
                p.MainImageUrl,
                p.Category?.Name ?? "Uncategorized",
                p.Brand?.Name,
                price,
                p.CompareAtPrice,
                p.IsFeatured,
                p.IsNewArrival
            );
        });

        if (Tab == "featured") list = list.Where(p => p.IsFeatured);
        else if (Tab == "new") list = list.Where(p => p.IsNewArrival);

        if (!string.IsNullOrWhiteSpace(Query))
        {
            var term = Query.Trim().ToLowerInvariant();
            list = list.Where(p => p.Name.ToLowerInvariant().Contains(term)
                || (p.BrandName != null && p.BrandName.ToLowerInvariant().Contains(term))
                || p.CategoryName.ToLowerInvariant().Contains(term));
        }

        var materialized = list.ToList();
        totalFiltered = materialized.Count;
        Page = Math.Max(1, Page);

        featuredProductsQuery = AdminSorting.Apply(materialized.AsQueryable(), Nav, ("Name", p => p.Name), ("Price", p => p.Price))
            .Skip((Page - 1) * PageSize)
            .Take(PageSize)
            .AsQueryable();
    }
}
