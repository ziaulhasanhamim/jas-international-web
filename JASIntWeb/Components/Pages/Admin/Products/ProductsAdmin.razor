@page "/admin/products"
@layout AdminLayout
@using Microsoft.AspNetCore.Components.QuickGrid
@inject AppDbContext Db
@inject AdminService Admin
@inject CatalogService Catalog
@inject NavigationManager Nav

<PageTitle>Products Catalog · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">CATALOG MANAGEMENT</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Products Catalog</h1>
        <p class="text-sm text-slate-500 mt-1">Manage catalog listings, instant storefront publishing, pricing, and variants with database QuickGrid.</p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/admin/products/new" class="btn-primary shadow-xs">
            <Icon Name="plus" Class="size-4" />
            Add Product
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3.5 text-xs text-emerald-800 flex items-center justify-between shadow-xs animate-fadeIn">
        <span class="flex items-center gap-2.5">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white">
                <Icon Name="check" Class="size-3.5" />
            </span>
            <span class="font-medium">@_toast</span>
        </span>
        <button type="button" @onclick="() => _toast = null" class="text-emerald-600 hover:text-emerald-950 p-1">
            <Icon Name="close" Class="size-3.5" />
        </button>
    </div>
}

<!-- Filters Bar -->
<div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
    <div class="flex flex-wrap items-center gap-2">
        <a
            href="@FilterUrl("all")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Filter == "all" ? "bg-slate-900 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            All Products (@_totalAll)
        </a>
        <a
            href="@FilterUrl("published")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(Filter == "published" ? "bg-emerald-600 text-white shadow-xs" : "bg-emerald-50 text-emerald-800 border border-emerald-200 hover:bg-emerald-100")"
        >
            <span class="size-1.5 rounded-full @(Filter == "published" ? "bg-white" : "bg-emerald-600")"></span>
            Published Live (@_totalPublished)
        </a>
        <a
            href="@FilterUrl("archived")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(Filter == "archived" ? "bg-rose-600 text-white shadow-xs" : "bg-rose-50 text-rose-800 border border-rose-200 hover:bg-rose-100")"
        >
            <span class="size-1.5 rounded-full @(Filter == "archived" ? "bg-white" : "bg-rose-600")"></span>
            Archived / Hidden (@_totalArchived)
        </a>
    </div>

    <form method="get" data-enhance class="flex flex-wrap items-center gap-2.5">
        <input type="hidden" name="status" value="@Filter" />
        <select name="category" onchange="this.form.submit()" class="field !py-1.5 text-xs w-auto min-w-[150px]">
            <option value="0" selected="@(CategoryId == 0)">All Categories</option>
            @foreach (var c in _categories)
            {
                <option value="@c.Id" selected="@(CategoryId == c.Id)">@c.Name</option>
            }
        </select>

        <div class="relative w-64">
            <input
                name="q"
                value="@Query"
                class="field pr-9 !py-1.5 text-xs"
                placeholder="Search name, slug, SKU..."
            />
            <button type="submit" class="absolute right-2 top-2 text-slate-400 hover:text-slate-700">
                <Icon Name="search" Class="size-3.5" />
            </button>
        </div>
    </form>
</div>

<!-- Products QuickGrid (Direct DB Query via EntityFrameworkAdapter) -->
<form method="post" @formname="products-table-action">
    <AntiforgeryToken />

    <!-- Bulk Actions Toolbar (POS App Pattern) -->
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200/90 bg-slate-50 p-3 shadow-2xs">
        <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-semibold text-slate-700">Bulk Actions:</span>
            <button type="submit" name="BulkAction" value="publish" class="btn-secondary !py-1 !px-3 text-xs font-bold text-emerald-700 hover:bg-emerald-50 cursor-pointer">
                Publish Selected
            </button>
            <button type="submit" name="BulkAction" value="archive" class="btn-secondary !py-1 !px-3 text-xs font-bold text-rose-700 hover:bg-rose-50 cursor-pointer">
                Archive Selected
            </button>
            <button type="submit" name="BulkAction" value="delete" class="btn-secondary !py-1 !px-3 text-xs font-bold text-rose-600 hover:bg-rose-50 cursor-pointer" onclick="return confirm('Permanently archive/delete selected products?')">
                Delete Selected
            </button>
        </div>
        <div class="flex items-center gap-2">
            <select name="TargetCategoryId" class="field !py-1 text-xs w-auto min-w-[140px]">
                <option value="0">— Move to category —</option>
                @foreach (var c in _categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
            <button type="submit" name="BulkAction" value="category" class="btn-secondary !py-1 !px-3 text-xs font-bold hover:bg-slate-200 cursor-pointer">
                Apply Category
            </button>
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
        <div class="table-scroll">
            <QuickGrid Items="@productsQuery" class="data-table">
                <TemplateColumn Class="w-10 text-center">
                    <HeaderTemplate Context="_">
                        <input type="checkbox" id="select-all-products"
                               class="rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer"
                               onclick="document.querySelectorAll('.prod-select-cb').forEach(cb => cb.checked = this.checked)"
                               title="Select all" />
                    </HeaderTemplate>
                    <ChildContent Context="p">
                        <input type="checkbox" name="SelectedProductIds" value="@p.Id"
                               class="prod-select-cb rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" />
                    </ChildContent>
                </TemplateColumn>

                <TemplateColumn Title="Product Name & Slug" Sortable="true" SortBy="@sortByName">
                    <div class="flex items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(context.ImageUrl))
                        {
                            <PictureImage Src="@context.ImageUrl" Alt="@context.Name" Class="size-10 object-contain rounded-lg border border-slate-100 p-1 bg-white shrink-0" Loading="lazy" Width="40" Height="40" />
                        }
                        else
                        {
                            <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-400">
                                <Icon Name="box" Class="size-5" />
                            </span>
                        }
                        <div class="min-w-0">
                            <strong class="text-slate-900 block font-semibold truncate max-w-xs sm:max-w-md">@context.Name</strong>
                            <span class="text-xs text-slate-400 font-mono">/@context.Slug</span>
                        </div>
                    </div>
                </TemplateColumn>

                <PropertyColumn Property="@(p => p.Category)" Title="Category" Sortable="true" />
                <PropertyColumn Property="@(p => p.VariantCount)" Title="Variants" Sortable="true" Align="Align.Center" />

                <TemplateColumn Title="Storefront Status" Align="Align.Center">
                    <button
                        type="submit"
                        name="ToggleProductId"
                        value="@context.Id"
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold transition cursor-pointer @(context.Hidden ? "bg-rose-50 text-rose-700 border border-rose-200 hover:bg-rose-100" : "bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100")"
                        title="Click to @(context.Hidden ? "publish this product to storefront" : "archive this product")"
                    >
                        <span class="size-1.5 rounded-full @(context.Hidden ? "bg-rose-500" : "bg-emerald-500")"></span>
                        <span>@(context.Hidden ? "Archived" : "Published")</span>
                    </button>
                </TemplateColumn>

                <TemplateColumn Title="Actions" Align="Align.End">
                    <div class="flex items-center justify-end gap-1.5 whitespace-nowrap">
                        @if (context.Hidden)
                        {
                            <button type="submit" name="ToggleProductId" value="@context.Id" class="btn-primary !px-2.5 !py-1 text-xs !bg-emerald-600 hover:!bg-emerald-700 inline-flex items-center gap-1 cursor-pointer" title="Publish product to storefront immediately">
                                <Icon Name="check" Class="size-3" />
                                Publish
                            </button>
                        }
                        else
                        {
                            <a href="/product/@context.Slug" target="_blank" class="btn-secondary !px-2.5 !py-1 text-xs" title="Preview on live storefront">
                                Preview ↗
                            </a>
                        }

                        <a href="/admin/products/@context.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                            Edit
                        </a>
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="p-4 border-t border-slate-200/90 flex items-center justify-between">
            <AdminPagination Total="totalFiltered" Page="Page" Size="PageSize" />
        </div>
    </div>
</form>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string Filter { get; set; } = "all";

    [SupplyParameterFromQuery(Name = "category")]
    public int CategoryId { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "toast")]
    public string? ToastNotice { get; set; }

    [SupplyParameterFromForm(FormName = "products-table-action")]
    public int ToggleProductId { get; set; }

    [SupplyParameterFromForm(FormName = "products-table-action")]
    public List<int>? SelectedProductIds { get; set; }

    [SupplyParameterFromForm(FormName = "products-table-action")]
    public string? BulkAction { get; set; }

    [SupplyParameterFromForm(FormName = "products-table-action")]
    public int TargetCategoryId { get; set; }

    public record AdminProductRow(
        int Id,
        string Name,
        string Slug,
        string Category,
        int VariantCount,
        bool Hidden,
        string? ImageUrl
    );

    public record CategoryOption(int Id, string Name);

    private IQueryable<AdminProductRow>? productsQuery;
    private const int PageSize = 20;
    private int totalFiltered;
    private GridSort<AdminProductRow> sortByName = GridSort<AdminProductRow>.ByAscending(p => p.Name);

    private List<CategoryOption> _categories = [];
    private string? _toast;
    private int _totalAll;
    private int _totalPublished;
    private int _totalArchived;

    private string FilterUrl(string status)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(status) && status != "all") parts.Add($"status={Uri.EscapeDataString(status)}");
        if (CategoryId > 0) parts.Add($"category={CategoryId}");
        if (!string.IsNullOrWhiteSpace(Query)) parts.Add($"q={Uri.EscapeDataString(Query)}");
        return parts.Count > 0 ? $"/admin/products?{string.Join("&", parts)}" : "/admin/products";
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(BulkAction) && SelectedProductIds != null && SelectedProductIds.Count > 0)
        {
            await Admin.BulkProductActionAsync(SelectedProductIds, BulkAction, TargetCategoryId);
            _toast = $"Bulk action '{BulkAction}' successfully applied to {SelectedProductIds.Count} products.";
            Nav.NavigateTo(FilterUrl(Filter));
            return;
        }

        _categories = await Db.Categories.AsNoTracking()
            .Where(c => !c.IsDeleted)
            .OrderBy(c => c.Name)
            .Select(c => new CategoryOption(c.Id, c.Name))
            .ToListAsync();

        if (ToggleProductId > 0)
        {
            var product = await Db.Products.FindAsync(ToggleProductId);
            if (product != null)
            {
                product.IsDeleted = !product.IsDeleted;
                product.UpdatedAt = DateTimeOffset.UtcNow;
                await Db.SaveChangesAsync();
                Catalog.InvalidateProductCache(product.Slug);

                var targetUrl = FilterUrl(Filter);
                var sep = targetUrl.Contains('?') ? "&" : "?";
                Nav.NavigateTo($"{targetUrl}{sep}toast={(product.IsDeleted ? "archived" : "restored")}");
                return;
            }
        }

        if (ToastNotice == "archived") _toast = "Product archived successfully.";
        else if (ToastNotice == "restored") _toast = "Product restored to live catalog.";
        else if (!string.IsNullOrWhiteSpace(ToastNotice)) _toast = ToastNotice;

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _totalAll = await Db.Products.CountAsync();
        _totalPublished = await Db.Products.CountAsync(p => !p.IsDeleted);
        _totalArchived = await Db.Products.CountAsync(p => p.IsDeleted);

        var q = Db.Products.AsNoTracking();

        if (Filter == "published")
        {
            q = q.Where(p => !p.IsDeleted);
        }
        else if (Filter == "archived")
        {
            q = q.Where(p => p.IsDeleted);
        }

        if (CategoryId > 0)
        {
            q = q.Where(p => p.CategoryId == CategoryId);
        }

        if (!string.IsNullOrWhiteSpace(Query))
        {
            var term = Query.Trim().ToLower();
            q = q.Where(p => p.Name.ToLower().Contains(term) ||
                             p.Slug.ToLower().Contains(term) ||
                             p.ProductVariants.Any(v => v.SKU.ToLower().Contains(term)));
        }

        Page = Math.Max(1, Page);
        totalFiltered = await q.CountAsync();

        var list = await q.OrderBy(p => p.Name)
            .ThenBy(p => p.Id)
            .Skip((Page - 1) * PageSize)
            .Take(PageSize)
            .Select(p => new AdminProductRow(
                p.Id,
                p.Name,
                p.Slug,
                p.Category != null ? p.Category.Name : "Uncategorized",
                p.ProductVariants.Count(v => !v.IsDeleted),
                p.IsDeleted,
                p.MainImageUrl
            ))
            .ToListAsync();

        productsQuery = list.AsQueryable();
    }
}
