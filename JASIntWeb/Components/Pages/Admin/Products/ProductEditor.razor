@page "/admin/products/new"
@page "/admin/products/{Id:int}/edit"
@page "/admin/products/{Id:int}"
@inject AppDbContext Db
@inject AdminSession Session
@inject NavigationManager Nav

<PageTitle>@(Id == 0 ? "Add product" : "Edit product") — JAS Admin</PageTitle>
<AdminPageHeader
    Title="@(Id == 0 ? "Add product" : "Edit product")"
    Description="Start with product information, then configure options, variants and stock."
    ActionHref="/admin/products"
    ActionText="Back to products"
/>
<ProductAdminTabs ProductId="Id" />
@if (notFound)
{
    <p class="admin-empty">Product not found.</p>
}
else
{
    @if (error is not null)
    {
        <p class="form-error" role="alert">@error</p>
    }
    @if (Input is null)
    {
        <p class="admin-help">Loading form…</p>
    }
    else
    {
        <EditForm
            Model="Input"
            OnValidSubmit="Save"
            FormName="product"
            method="post"
            Enhance
            data-submit-indication="true"
            class="shop-panel admin-form"
        >
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="admin-form-grid">
                <label class="shop-label">
                    Product name
                    <InputText @bind-Value="Input!.Name" class="shop-input" />
                </label>
                <label class="shop-label">
                    URL slug
                    <InputText @bind-Value="Input!.Slug" class="shop-input" />
                    <small>For example: samsung-galaxy-a56</small>
                </label>
            </div>
            <div class="admin-form-grid">
                <label class="shop-label">
                    Category
                    <InputSelect @bind-Value="Input!.CategoryId" class="shop-input">
                        <option value="0">Select category</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@CategoryName(c)</option>
                        }
                    </InputSelect>
                </label>
                <label class="shop-label">
                    Brand (optional)
                    <InputSelect @bind-Value="Input!.BrandId" class="shop-input">
                        <option value="">No brand / generic</option>
                        @foreach (var b in brands)
                        {
                            <option value="@b.Id">@b.Name</option>
                        }
                    </InputSelect>
                </label>
            </div>
            <label class="shop-label">
                Short overview / summary
                <InputTextArea @bind-Value="Input!.Description" class="shop-input" rows="2" placeholder="Brief one or two sentence summary shown on product card and search snippets" />
            </label>

            <!-- Product Media & Image Gallery -->
            <div class="mt-6 border-t border-slate-200/80 pt-6">
                <div class="flex items-center justify-between mb-2">
                    <div>
                        <h3 class="text-sm font-bold text-slate-900">Product Pictures &amp; Gallery</h3>
                        <p class="text-xs text-slate-500">Upload multiple images. The first image marked as Cover will be the primary storefront image.</p>
                    </div>
                </div>

                <div id="product-media-manager" class="space-y-4">
                    <input type="hidden" name="Input.Image" id="input-main-image" value="@Input!.Image" />
                    <input type="hidden" name="Input.Images" id="input-gallery-images" value="@Input!.Images" />

                    <!-- Drag & Drop Zone -->
                    <div id="media-dropzone" class="border-2 border-dashed border-slate-300 rounded-2xl p-6 text-center hover:border-blue-500 hover:bg-blue-50/30 transition-all cursor-pointer bg-slate-50/50">
                        <div class="mx-auto flex size-12 items-center justify-center rounded-2xl bg-blue-100 text-blue-600 mb-3">
                            <Icon Name="camera" Class="size-6" />
                        </div>
                        <p class="text-sm font-semibold text-slate-800">Drag &amp; drop product pictures here</p>
                        <p class="text-xs text-slate-500 mt-1">Supports PNG, JPG, WEBP, AVIF up to 10MB each</p>
                        <div class="mt-4 flex items-center justify-center gap-3">
                            <label class="btn-primary cursor-pointer text-xs py-2 px-4 shadow-sm">
                                <span>Browse from Device</span>
                                <input type="file" multiple accept="image/*" class="hidden" id="file-uploader-input" />
                            </label>
                            <button type="button" id="btn-add-url" class="btn-secondary text-xs py-2 px-4">
                                Add from URL
                            </button>
                        </div>
                        <div id="media-upload-progress" class="mt-4 flex items-center justify-center gap-2 text-xs font-semibold text-blue-600" hidden>
                            <span class="size-2 rounded-full bg-blue-600 animate-ping"></span>
                            Uploading images...
                        </div>
                    </div>

                    <!-- Images Cards Grid -->
                    <div>
                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Arrange Photos (First photo is Main Cover)</h4>
                        <div id="media-cards-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
                            <!-- Populated dynamically by JS -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Rich Description & Specification Tables -->
            <div class="mt-8 border-t border-slate-200/80 pt-6">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <h3 class="text-sm font-bold text-slate-900">Rich Description &amp; Specifications</h3>
                        <p class="text-xs text-slate-500">Add rich text, headings, bullet lists, and specification tables. You can also paste formatted specs from official brand pages or toggle code mode.</p>
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-white shadow-xs p-1">
                    <textarea name="Input.Details" id="input-details-html" class="w-full min-h-[380px] p-4 text-sm font-sans focus:outline-none border-0 text-slate-800 leading-relaxed">@Input!.Details</textarea>
                </div>
            </div>
            <label class="check-label">
                <input type="checkbox" name="Input.Hidden" checked="@(Input!.Hidden)" value="true" />
                <input type="hidden" name="Input.Hidden" value="false" />
                Keep product hidden from customers
            </label>
            <div class="form-actions">
                <button type="submit" class="shop-button" data-pending-text="Saving product...">
                    <span class="form-submit-spinner" hidden></span>
                    <span>Save product</span>
                </button>
                <a href="/admin/products" class="shop-button-secondary">Cancel</a>
            </div>
        </EditForm>
    }
}

@code
{
    [Parameter]
    public int Id { get; set; }
    [SupplyParameterFromForm(FormName = "product")]
    private ProductEditForm? Input { get; set; }
    private List<CategoryLinkDto> categories = [];
    private List<BrandLinkDto> brands = [];
    private bool notFound;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        categories = await Db.Categories.AsNoTracking()
            .Where(c => !c.IsDeleted
            && (c.ParentCategory == null
                || !c.ParentCategory.IsDeleted))
            .OrderBy(c => c.Name)
            .Select(c => new CategoryLinkDto(c.Id, c.Name, c.Slug, c.ParentCategoryId))
            .ToListAsync();

        brands = await Db.Brands.AsNoTracking()
            .Where(b => !b.IsDeleted)
            .OrderBy(b => b.SortOrder)
            .ThenBy(b => b.Name)
            .Select(b => new BrandLinkDto(b.Id, b.Name, b.Slug, b.LogoUrl, b.IsFeatured, b.SortOrder))
            .ToListAsync();

        if (Input is not null)
        {
            return;
        }
        if (Id == 0)
        {
            Input = new()
            {
                Hidden = true
            };
            return;
        }
        var p = await Db.Products.AsNoTracking().Include(p => p.ProductImages).SingleOrDefaultAsync(p => p.Id == Id);
        if (p is null)
        {
            notFound = true;
            return;
        }
        Input = new()
        {
            Id = p.Id,
            Name = p.Name,
            Slug = p.Slug,
            CategoryId = p.CategoryId,
            BrandId = p.BrandId,
            Description = p.Description ?? "",
            Details = p.Details,
            Image = p.MainImageUrl,
            Images = string.Join("\n", p.ProductImages.OrderBy(i => i.SortOrder).Select(i => i.ImageUrl)),
            Hidden = p.IsDeleted
        };
    }

    private string CategoryName(CategoryLinkDto c) => c.ParentId is int parent ? (categories.FirstOrDefault(p => p.Id == parent)?.Name + " / " + c.Name) : c.Name;

    private async Task Save()
    {
        try
        {
            Input!.Id = Id;
            var id = await Session.RunAsync((s, _) => s.SaveProductAsync(Input));
            Nav.NavigateTo($"/admin/products/{id}/attributes");
        }
        catch (ShopException ex)
        {
            error = ex.Message;
        }
    }
}
