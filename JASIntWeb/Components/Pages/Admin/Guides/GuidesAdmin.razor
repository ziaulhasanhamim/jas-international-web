@page "/admin/guides"
@using JASIntWeb.Persistence
@using JASIntWeb.Persistence.Entities
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>Buying Guides · JAS Admin</PageTitle>

<AdminPageHeader Title="Buying Guides" Eyebrow="Storefront Content & SEO" Description="Create and manage comprehensive tech buying guides, model comparisons and product recommendations using database QuickGrid." ActionHref="/admin/guides/new" ActionText="Write guide" ActionEnhance="false" />

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-5 flex items-center justify-between rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-xs font-semibold text-emerald-800 shadow-xs" role="status">
        <span>✓ @_toast</span>
        <button type="button" @onclick="() => _toast = null" class="cursor-pointer opacity-60 hover:opacity-100">✕</button>
    </div>
}

<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs space-y-5">
    <!-- Toolbar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
        <!-- Status Filter Tabs -->
        <nav class="flex items-center gap-1.5" aria-label="Guide filters">
            <a href="@FilterUrl("all")" class="px-3 py-1.5 rounded-lg text-xs font-bold transition @(Filter == "all" ? "bg-slate-900 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                All guides <span class="ml-1 opacity-75">@totalAll</span>
            </a>
            <a href="@FilterUrl("published")" class="px-3 py-1.5 rounded-lg text-xs font-bold transition @(Filter == "published" ? "bg-slate-900 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                Published <span class="ml-1 opacity-75">@totalPublished</span>
            </a>
            <a href="@FilterUrl("drafts")" class="px-3 py-1.5 rounded-lg text-xs font-bold transition @(Filter == "drafts" ? "bg-slate-900 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                Drafts <span class="ml-1 opacity-75">@totalDrafts</span>
            </a>
        </nav>

        <!-- Search Form -->
        <form method="get" data-enhance class="relative max-w-xs w-full">
            <input type="hidden" name="status" value="@Filter" />
            <input name="q" value="@Query" placeholder="Search guides…" data-debounce-submit="350" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 pl-9 pr-8 text-xs text-slate-800 placeholder-slate-400 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
            <span class="absolute left-3 top-2.5 text-slate-400">
                <Icon Name="search" Class="size-3.5" />
            </span>
            @if (!string.IsNullOrWhiteSpace(Query))
            {
                <a href="@FilterUrl(Filter)" class="absolute right-3 top-2 text-slate-400 hover:text-slate-600 font-bold text-xs">✕</a>
            }
        </form>
    </div>

    <!-- Guides QuickGrid Table -->
    @if (filteredGuides.Count == 0)
    {
        <div class="py-12 text-center">
            <Icon Name="box" Class="size-10 text-slate-300 mx-auto mb-2" />
            <h3 class="text-sm font-bold text-slate-800">@(string.IsNullOrWhiteSpace(Query) ? "No buying guides published yet" : "No guides match your search")</h3>
            <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
                @(string.IsNullOrWhiteSpace(Query) ? "Write informative guides to help customers compare audio, smartwatches, and chargers." : "Try adjusting your search query or clear the filter.")
            </p>
            <a href="@(string.IsNullOrWhiteSpace(Query) ? "/admin/guides/new" : "/admin/guides")" data-enhance-nav="@(string.IsNullOrWhiteSpace(Query) ? "false" : null)" data-enhance="@(string.IsNullOrWhiteSpace(Query) ? "false" : null)" class="btn-primary text-xs mt-4 inline-block">
                @(string.IsNullOrWhiteSpace(Query) ? "Write your first guide" : "Clear filters")
            </a>
        </div>
    }
    else
    {
        <div class="rounded-xl border border-slate-200/90 overflow-hidden">
            <div class="table-scroll">
                <QuickGrid Items="@guidesQuery" class="data-table">
                    <PropertyColumn Property="@(g => g.Id)" Title="#ID" Class="col-id font-mono text-xs text-slate-500 w-16 text-center" Align="Align.Center" />

                    <TemplateColumn Title="Guide">
                        <div class="flex items-center gap-3">
                            @if (!string.IsNullOrWhiteSpace(context.FeaturedImageUrl))
                            {
                                <img src="@context.FeaturedImageUrl" alt="@context.Title" class="size-12 rounded-lg object-cover bg-slate-100 shrink-0 border border-slate-200/80" loading="lazy" />
                            }
                            else
                            {
                                <div class="size-12 rounded-lg bg-slate-100 shrink-0 border border-slate-200/80 flex items-center justify-center text-slate-400 font-bold text-[10px]">
                                    No cover
                                </div>
                            }
                            <div class="min-w-0">
                                <div class="flex items-center gap-2 flex-wrap mb-0.5">
                                    <a href="/admin/guides/@context.Id/edit" data-enhance-nav="false" data-enhance="false" class="text-sm font-bold text-slate-900 hover:text-blue-600 transition truncate max-w-sm">
                                        @context.Title
                                    </a>
                                    @if (context.HasBangla)
                                    {
                                        <span class="inline-flex items-center px-1.5 py-0.2 rounded-md text-[9px] font-bold bg-blue-50 text-blue-700 border border-blue-200" title="Includes Bangla translation">
                                            বাংলা
                                        </span>
                                    }
                                </div>
                                <span class="font-mono text-xs text-slate-400 block truncate max-w-xs">/guides/@context.Slug</span>
                            </div>
                        </div>
                    </TemplateColumn>

                    <TemplateColumn Title="Status" Class="w-28 text-center">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold @(context.IsPublished ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-amber-50 text-amber-700 border border-amber-200")">
                            @(context.IsPublished ? "Published" : "Draft")
                        </span>
                    </TemplateColumn>

                    <PropertyColumn Property="@(g => g.Author)" Title="Author" Class="text-xs text-slate-600" />

                    <TemplateColumn Title="Published" Class="text-xs text-slate-500 w-32">
                        @context.PublishedAt.ToString("dd MMM yyyy")
                    </TemplateColumn>

                    <TemplateColumn Title="Actions" Class="text-right w-36">
                        <div class="flex items-center justify-end gap-1.5">
                            <a href="/guides/@context.Slug" target="_blank" class="p-1.5 rounded-lg text-slate-400 hover:text-blue-600 hover:bg-slate-100 transition" title="View live on storefront">
                                <span class="text-xs font-semibold">Live ↗</span>
                            </a>
                            <a href="/admin/guides/@context.Id/edit" data-enhance-nav="false" data-enhance="false" class="btn-secondary text-xs !px-2.5 !py-1">
                                Edit
                            </a>
                            <form method="post" @formname="@($"delete-guide-{context.Id}")" data-enhance class="inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="deleteId" value="@context.Id" />
                                <button type="submit" class="p-1 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer" data-confirm="Delete this guide?" title="Delete guide">
                                    <Icon Name="close" Class="size-3.5" />
                                </button>
                            </form>
                        </div>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string Filter { get; set; } = "all";

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromForm]
    public int? DeleteId { get; set; }

    private int totalAll;
    private int totalPublished;
    private int totalDrafts;
    private string? _toast;

    private List<GuideRow> filteredGuides = [];
    private IQueryable<GuideRow> guidesQuery => filteredGuides.AsQueryable();

    private record GuideRow(int Id, string Title, string Slug, string Author, DateTimeOffset PublishedAt, bool IsPublished, bool HasBangla, string? FeaturedImageUrl);

    protected override async Task OnInitializedAsync()
    {
        if (DeleteId.HasValue && DeleteId.Value > 0)
        {
            var target = await Db.Guides.SingleOrDefaultAsync(g => g.Id == DeleteId.Value);
            if (target != null)
            {
                target.IsDeleted = true;
                target.DeletedAt = DateTimeOffset.UtcNow;
                await Db.SaveChangesAsync();
                _toast = "Guide deleted successfully.";
            }
        }

        totalAll = await Db.Guides.CountAsync(g => !g.IsDeleted);
        totalPublished = await Db.Guides.CountAsync(g => !g.IsDeleted && g.IsPublished);
        totalDrafts = await Db.Guides.CountAsync(g => !g.IsDeleted && !g.IsPublished);

        var query = Db.Guides.AsNoTracking().Where(g => !g.IsDeleted);

        if (Filter == "published")
        {
            query = query.Where(g => g.IsPublished);
        }
        else if (Filter == "drafts")
        {
            query = query.Where(g => !g.IsPublished);
        }

        if (!string.IsNullOrWhiteSpace(Query))
        {
            var term = Query.Trim().ToLower();
            query = query.Where(g => g.Title.ToLower().Contains(term) || g.Slug.ToLower().Contains(term) || g.Author.ToLower().Contains(term));
        }

        var list = await query.OrderByDescending(g => g.PublishedAt).ToListAsync();

        filteredGuides = list.Select(g => new GuideRow(
            g.Id,
            g.Title,
            g.Slug,
            g.Author,
            g.PublishedAt,
            g.IsPublished,
            !string.IsNullOrWhiteSpace(g.BanglaTitle),
            g.FeaturedImageUrl
        )).ToList();
    }

    private string FilterUrl(string status) =>
        string.IsNullOrWhiteSpace(Query) ? $"/admin/guides?status={status}" : $"/admin/guides?status={status}&q={Uri.EscapeDataString(Query)}";
}
