@page "/admin/stock-notifications"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminOnly")]
@layout AdminLayout
@inject IDbContextFactory<AppDbContext> Database
@inject JASIntWeb.Services.StockNotificationService Notifications
@using JASIntWeb.Persistence
@using JASIntWeb.Persistence.Entities
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
<PageTitle>Stock alerts · JAS Admin</PageTitle>
<div class="space-y-6">
    <AdminPageHeader Title="Back-in-stock alerts" Description="Confirmed requests, delivery progress, and retryable failures with database QuickGrid." />
    @if (!Notifications.MailConfigured)
    {
        <div class="confidence-notice" role="alert">Email is not configured. Requests and delivery are paused. Configure your existing mail provider before enabling alerts.</div>
    }
    <nav class="confidence-tabs" aria-label="Filter stock alerts">
        <a href="/admin/stock-notifications" class="@(string.IsNullOrEmpty(Status) ? "font-bold text-slate-900" : "")">All</a>
        @foreach (var status in Enum.GetValues<StockNotificationStatus>())
        {
            <a href="@($"/admin/stock-notifications?status={status}")" class="@(Status == status.ToString() ? "font-bold text-slate-900" : "")">@status</a>
        }
    </nav>
    @if (rows.Count == 0)
    {
        <div class="confidence-panel"><h2>No requests yet</h2><p>Requests for sold-out variants will appear here.</p></div>
    }
    else
    {
        <div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
            <div class="table-scroll">
                <QuickGrid Items="@notificationsQuery" class="data-table">
                    <PropertyColumn Property="@(r => r.Id)" Title="#ID" Class="font-mono text-xs text-slate-500 w-16" />

                    <TemplateColumn Title="Product / Option">
                        <div>
                            <strong class="text-slate-900 text-sm block">@(context.ProductVariant?.Product?.Name ?? "Unknown Product")</strong>
                            <span class="font-mono text-xs text-slate-400">SKU: @(context.ProductVariant?.SKU ?? "—")</span>
                        </div>
                    </TemplateColumn>

                    <PropertyColumn Property="@(r => r.Email)" Title="Customer Email" Class="text-xs font-medium text-slate-800" />

                    <TemplateColumn Title="Status" Class="text-center w-28">
                        <span class="badge @(context.Status switch { StockNotificationStatus.Sent => "badge-emerald", StockNotificationStatus.Failed => "badge-rose", _ => "badge-slate" })">
                            @context.Status
                        </span>
                    </TemplateColumn>

                    <TemplateColumn Title="Delivery Info" Class="text-xs text-slate-500">
                        @(context.LastError ?? (context.NotificationSentAt?.ToString("dd MMM yyyy HH:mm") ?? "Awaiting restock"))
                    </TemplateColumn>

                    <TemplateColumn Title="Action" Class="text-right w-32">
                        @if (context.Status == StockNotificationStatus.Failed)
                        {
                            <form method="post" action="@($"/api/admin/stock-notifications/{context.Id}/retry")" data-enhance="false" class="inline">
                                <AntiforgeryToken />
                                <button class="btn-secondary !py-1 !px-2.5 text-xs font-bold text-rose-600 hover:bg-rose-50" type="submit">Retry email</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-slate-400 text-xs">—</span>
                        }
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
        <nav class="confidence-tabs" aria-label="Pagination">
            @if (page > 1) { <a href="@PageUrl(page - 1)">← Previous</a> }
            <span>Page @(page) · @total requests</span>
            @if (page * 50 < total) { <a href="@PageUrl(page + 1)">Next →</a> }
        </nav>
    }
</div>
@code {
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int Page { get; set; } = 1;
    private int page, total;
    private List<StockNotification> rows = [];
    private IQueryable<StockNotification> notificationsQuery => rows.AsQueryable();
    private string PageUrl(int target) => Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/admin/stock-notifications", new Dictionary<string, string?> { ["page"] = target.ToString(), ["status"] = Status });
    protected override async Task OnParametersSetAsync()
    {
        await using var db = await Database.CreateDbContextAsync();
        var query = db.StockNotifications.AsNoTracking();
        if (Enum.TryParse<StockNotificationStatus>(Status, out var status)) query = query.Where(x => x.Status == status);
        total = await query.CountAsync();
        page = Math.Clamp(Page, 1, Math.Max(1, (int)Math.Ceiling(total / 50d)));
        rows = await query.Include(x => x.ProductVariant).ThenInclude(v => v!.Product).OrderByDescending(x => x.CreatedAt).Skip((page - 1) * 50).Take(50).ToListAsync();
    }
}
