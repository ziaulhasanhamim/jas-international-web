@page "/admin/inventory"
@layout AdminLayout
@using Microsoft.AspNetCore.Components.QuickGrid
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>Inventory &amp; Stock Intelligence · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">STOCK &amp; WAREHOUSE OPERATIONS</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Inventory &amp; Stock Levels</h1>
        <p class="text-sm text-slate-500 mt-1">Real-time stock tracking across warehouse, customer order reservations, and automated restock alerts with database QuickGrid.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3.5 text-xs text-emerald-800 flex items-center justify-between shadow-xs animate-fadeIn">
        <span class="flex items-center gap-2.5">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white">
                <Icon Name="check" Class="size-3.5" />
            </span>
            <span class="font-medium">@_toast</span>
        </span>
        <button type="button" @onclick="() => _toast = null" class="text-emerald-600 hover:text-emerald-950 p-1">
            <Icon Name="close" Class="size-3.5" />
        </button>
    </div>
}

<!-- Filters Bar -->
<div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
    <div class="flex flex-wrap items-center gap-2">
        <a
            href="@FilterUrl("all")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Filter == "all" ? "bg-slate-900 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            All Stock Items (@_totalAll)
        </a>
        <a
            href="@FilterUrl("low")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(Filter == "low" ? "bg-amber-600 text-white shadow-xs" : "bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100")"
        >
            <span class="size-1.5 rounded-full @(Filter == "low" ? "bg-white" : "bg-amber-600")"></span>
            ⚠️ Low Stock (≤ 5 units) (@_totalLow)
        </a>
        <a
            href="@FilterUrl("out")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(Filter == "out" ? "bg-rose-600 text-white shadow-xs" : "bg-rose-50 text-rose-800 border border-rose-200 hover:bg-rose-100")"
        >
            <span class="size-1.5 rounded-full @(Filter == "out" ? "bg-white" : "bg-rose-600")"></span>
            🔴 Out of Stock (@_totalOut)
        </a>
    </div>

    <form method="get" data-enhance class="relative w-64">
        <input type="hidden" name="status" value="@Filter" />
        <input
            name="q"
            value="@Query"
            class="field pr-9 !py-1.5 text-xs"
            placeholder="Search product name or SKU..."
        />
        <button type="submit" class="absolute right-2 top-2 text-slate-400 hover:text-slate-700">
            <Icon Name="search" Class="size-3.5" />
        </button>
    </form>
</div>

<!-- Inventory QuickGrid (Direct DB Query via EntityFrameworkAdapter) -->
<form method="post" @formname="inventory-table-action">
    <AntiforgeryToken />
    <div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
        <div class="table-scroll">
            <QuickGrid Items="@inventoryQuery" class="data-table">
                <TemplateColumn Title="Product &amp; Variant SKU" Sortable="true" SortBy="@sortByProduct">
                    <div>
                        <strong class="text-slate-900 block font-semibold text-xs">@context.ProductName</strong>
                        <span class="font-mono text-2xs text-slate-400">SKU: @context.Sku</span>
                    </div>
                </TemplateColumn>

                <PropertyColumn Property="@(i => i.OnHand)" Title="Physical On Hand" Sortable="true" Align="Align.Center" />

                <TemplateColumn Title="Reserved for Orders" Align="Align.Center">
                    @if (context.Reserved > 0)
                    {
                        <span class="inline-flex items-center gap-1 rounded-md bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700 ring-1 ring-amber-600/20">
                            @context.Reserved units
                        </span>
                    }
                    else
                    {
                        <span class="text-slate-400 text-xs">—</span>
                    }
                </TemplateColumn>

                <TemplateColumn Title="Available to Sell" Sortable="true" SortBy="@sortByAvailable" Align="Align.Center">
                    @{
                        var avail = context.OnHand - context.Reserved;
                    }
                    @if (avail <= 0)
                    {
                        <span class="inline-flex items-center gap-1 rounded-md bg-rose-50 px-2.5 py-1 text-xs font-bold text-rose-700 ring-1 ring-rose-600/20">
                            <span class="size-1.5 rounded-full bg-rose-500"></span>
                            Out of Stock (0)
                        </span>
                    }
                    else if (avail <= 5)
                    {
                        <span class="inline-flex items-center gap-1 rounded-md bg-amber-50 px-2.5 py-1 text-xs font-bold text-amber-700 ring-1 ring-amber-600/20">
                            <span class="size-1.5 rounded-full bg-amber-500"></span>
                            Low Stock (@avail)
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1 rounded-md bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-700 ring-1 ring-emerald-600/20">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            @avail in stock
                        </span>
                    }
                </TemplateColumn>

                <PropertyColumn Property="@(i => i.Price)" Title="Selling Price" Format="N0" Sortable="true" Align="Align.End" />

                <TemplateColumn Title="Quick Operations" Align="Align.End">
                    <div class="flex items-center justify-end gap-1.5">
                        <button
                            type="submit"
                            name="QuickRestockId"
                            value="@context.VariantId"
                            class="btn-secondary !px-2.5 !py-1 text-xs text-blue-600 hover:text-blue-700 hover:bg-blue-50 cursor-pointer"
                            title="Instantly add +10 units to physical stock"
                        >
                            +10 Restock
                        </button>
                        <a href="/admin/inventory/@context.VariantId/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                            Adjust
                        </a>
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="p-4 border-t border-slate-200/90 flex items-center justify-between">
            <AdminPagination Total="totalFiltered" Page="Page" Size="PageSize" />
        </div>
    </div>
</form>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string Filter { get; set; } = "all";

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "toast")]
    public string? ToastNotice { get; set; }

    [SupplyParameterFromForm(FormName = "inventory-table-action")]
    public int QuickRestockId { get; set; }

    public record AdminVariantRow(
        int VariantId,
        int ProductId,
        string ProductName,
        string Sku,
        decimal Price,
        int OnHand,
        int Reserved,
        bool IsActive,
        bool IsDefault
    );

    private IQueryable<AdminVariantRow>? inventoryQuery;
    private const int PageSize = 20;
    private int totalFiltered;
    private GridSort<AdminVariantRow> sortByProduct = GridSort<AdminVariantRow>.ByAscending(i => i.ProductName);
    private GridSort<AdminVariantRow> sortByAvailable = GridSort<AdminVariantRow>.ByAscending(i => i.OnHand - i.Reserved);

    private string? _toast;
    private int _totalAll;
    private int _totalLow;
    private int _totalOut;

    private string FilterUrl(string filter)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(filter) && filter != "all") parts.Add($"status={Uri.EscapeDataString(filter)}");
        if (!string.IsNullOrWhiteSpace(Query)) parts.Add($"q={Uri.EscapeDataString(Query)}");
        return parts.Count > 0 ? $"/admin/inventory?{string.Join("&", parts)}" : "/admin/inventory";
    }

    protected override async Task OnInitializedAsync()
    {
        if (QuickRestockId > 0)
        {
            var inv = await Db.InventoryItems.SingleOrDefaultAsync(i => i.ProductVariantId == QuickRestockId);
            if (inv != null)
            {
                inv.QuantityOnHand += 10;
                Db.InventoryTransactions.Add(new()
                {
                    ProductVariantId = QuickRestockId,
                    QuantityChange = 10,
                    Type = InventoryTransactionType.Adjustment,
                    ReferenceType = "AdminRestock",
                    Note = "Restock via Admin Hub (+10)"
                });

                await Db.SaveChangesAsync();
                var targetUrl = FilterUrl(Filter);
                var sep = targetUrl.Contains('?') ? "&" : "?";
                Nav.NavigateTo($"{targetUrl}{sep}toast=restocked");
                return;
            }
        }

        if (ToastNotice == "restocked") _toast = "Inventory successfully adjusted (+10 units).";
        else if (!string.IsNullOrWhiteSpace(ToastNotice)) _toast = ToastNotice;

        await LoadCountsAsync();
        await LoadRowsAsync();
    }

    private async Task LoadCountsAsync()
    {
        _totalAll = await Db.InventoryItems.CountAsync(i => !i.ProductVariant!.IsDeleted);
        _totalLow = await Db.InventoryItems.CountAsync(i => !i.ProductVariant!.IsDeleted && i.QuantityOnHand - i.QuantityReserved <= 5 && i.QuantityOnHand - i.QuantityReserved > 0);
        _totalOut = await Db.InventoryItems.CountAsync(i => !i.ProductVariant!.IsDeleted && i.QuantityOnHand - i.QuantityReserved <= 0);
    }

    private async Task LoadRowsAsync()
    {
        var q = Db.InventoryItems.AsNoTracking().Where(i => !i.ProductVariant!.IsDeleted);

        if (Filter == "low")
        {
            q = q.Where(i => i.QuantityOnHand - i.QuantityReserved <= 5 && i.QuantityOnHand - i.QuantityReserved > 0);
        }
        else if (Filter == "out")
        {
            q = q.Where(i => i.QuantityOnHand - i.QuantityReserved <= 0);
        }

        if (!string.IsNullOrWhiteSpace(Query))
        {
            var term = Query.Trim().ToLower();
            q = q.Where(i => i.ProductVariant!.SKU.ToLower().Contains(term) ||
                             i.ProductVariant.Product!.Name.ToLower().Contains(term));
        }

        Page = Math.Max(1, Page);
        totalFiltered = await q.CountAsync();

        var list = await q.OrderBy(i => i.QuantityOnHand - i.QuantityReserved)
            .ThenBy(i => i.Id)
            .Skip((Page - 1) * PageSize)
            .Take(PageSize)
            .Select(i => new AdminVariantRow(
                i.ProductVariantId,
                i.ProductVariant!.ProductId,
                i.ProductVariant.Product != null ? i.ProductVariant.Product.Name : "Product",
                i.ProductVariant.SKU,
                i.ProductVariant.SellingPrice,
                i.QuantityOnHand,
                i.QuantityReserved,
                i.ProductVariant.IsActive,
                i.ProductVariant.IsDefault
            ))
            .ToListAsync();

        inventoryQuery = list.AsQueryable();
    }
}
