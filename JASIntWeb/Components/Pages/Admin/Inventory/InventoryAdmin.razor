@page "/admin/inventory"
@inject AppDbContext Db

<PageTitle>Inventory & Stock · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">STOCK & LOGISTICS</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Inventory Management</h1>
        <p class="text-sm text-slate-500 mt-1">Track physical stock on hand, customer reservations, and available units.</p>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="mb-6 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
    <form method="get" data-enhance class="flex flex-wrap items-center gap-3">
        <div class="relative flex-1 min-w-[220px]">
            <input name="q" value="@Query" class="field pr-9" placeholder="Search by SKU or product name..." />
            <span class="absolute right-3 top-3 text-slate-400">
                <Icon Name="search" Class="size-4" />
            </span>
        </div>
        <label class="inline-flex items-center gap-2 text-sm text-slate-700 font-medium cursor-pointer">
            <input type="checkbox" name="low" value="true" checked="@(Low)" class="size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
            <span>Low Stock (≤ 5 units)</span>
        </label>
        <button type="submit" class="btn-primary">Filter</button>
        @if (!string.IsNullOrWhiteSpace(Query) || Low)
        {
            <a href="/admin/inventory" class="btn-secondary">Clear</a>
        }
    </form>
</div>

<!-- Inventory Table -->
<div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Product / Description</th>
                    <th>SKU Code</th>
                    <th class="text-center">On Hand</th>
                    <th class="text-center">Reserved</th>
                    <th class="text-center">Available to Sell</th>
                    <th class="text-right">Selling Price</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    var available = row.OnHand - row.Reserved;
                    <tr>
                        <td>
                            <strong class="text-slate-900 block font-semibold">@row.ProductName</strong>
                        </td>
                        <td class="font-mono text-xs text-slate-600">
                            @row.Sku
                        </td>
                        <td class="text-center font-medium text-slate-700">
                            @row.OnHand
                        </td>
                        <td class="text-center text-xs font-semibold text-amber-700">
                            @(row.Reserved > 0 ? $"{row.Reserved}" : "-")
                        </td>
                        <td class="text-center">
                            <span class="badge @(available <= 2 ? "badge-rose" : available <= 5 ? "badge-amber" : "badge-emerald")">
                                @available units
                            </span>
                        </td>
                        <td class="text-right font-medium text-slate-900 tabular-nums">
                            ৳@row.Price.ToString("N0")
                        </td>
                        <td class="text-right whitespace-nowrap space-x-2">
                            <a href="/admin/inventory/@row.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                                Adjust Stock
                            </a>
                            <a href="/admin/products/@row.ProductId/variants/@row.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                                Edit Variant
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (rows.Count == 0)
    {
        <div class="empty-state py-12">
            <Icon Name="box" Class="size-10 text-slate-300" />
            <p>No inventory items match the current filters.</p>
        </div>
    }
</div>

<div class="mt-4">
    <AdminPagination Total="total" Page="Page" />
</div>

@code
{
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "low")]
    public bool Low { get; set; }
    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;
    private int total;
    private List<AdminVariantRow> rows = [];

    protected override async Task OnInitializedAsync()
    {
        Page = Math.Clamp(Page, 1, 10000);
        var q = Db.InventoryItems.AsNoTracking().Where(i => !i.ProductVariant!.IsDeleted);
        if (Low)
        {
            q = q.Where(i => i.QuantityOnHand - i.QuantityReserved <= 5 && i.ProductVariant!.IsActive);
        }
        if (!string.IsNullOrWhiteSpace(Query))
        {
            q = q.Where(i => i.ProductVariant!.SKU.ToLower()
                .Contains(Query.ToLower())
                || i.ProductVariant.Product!.Name.ToLower()
                .Contains(Query.ToLower()));
        }
        total = await q.CountAsync();
        rows = await q.OrderBy(i => i.QuantityOnHand - i.QuantityReserved).ThenBy(i => i.Id).Skip((Page - 1) * 25).Take(25)
            .Select(i => new AdminVariantRow(i.ProductVariantId,
                i.ProductVariant!.ProductId,
                i.ProductVariant.Product!.Name,
                i.ProductVariant.SKU,
                "",
                i.ProductVariant.SellingPrice,
                i.QuantityOnHand,
                i.QuantityReserved,
                i.ProductVariant.IsActive,
                i.ProductVariant.IsDefault))
            .ToListAsync();
    }
}
