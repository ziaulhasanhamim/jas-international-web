@page "/admin/inventory"
@rendermode InteractiveServer
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>Inventory &amp; Stock Intelligence · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">STOCK &amp; WAREHOUSE OPERATIONS</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Inventory &amp; Stock Levels</h1>
        <p class="text-sm text-slate-500 mt-1">Real-time stock tracking across warehouse, customer order reservations, and automated restock alerts.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3.5 text-xs text-emerald-800 flex items-center justify-between shadow-xs animate-fadeIn">
        <span class="flex items-center gap-2.5">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white">
                <Icon Name="check" Class="size-3.5" />
            </span>
            <span class="font-medium">@_toast</span>
        </span>
        <button type="button" @onclick="() => _toast = null" class="text-emerald-600 hover:text-emerald-950 p-1">
            <Icon Name="close" Class="size-3.5" />
        </button>
    </div>
}

<!-- Filters Bar -->
<div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
    <div class="flex flex-wrap items-center gap-2">
        <button
            type="button"
            @onclick='() => SetFilter("all")'
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(_filter == "all" ? "bg-slate-900 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            All Stock Items (@_totalAll)
        </button>
        <button
            type="button"
            @onclick='() => SetFilter("low")'
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(_filter == "low" ? "bg-amber-600 text-white shadow-xs" : "bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100")"
        >
            <span class="size-1.5 rounded-full @(_filter == "low" ? "bg-white" : "bg-amber-600")"></span>
            ⚠️ Low Stock (≤ 5 units) (@_totalLow)
        </button>
        <button
            type="button"
            @onclick='() => SetFilter("out")'
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(_filter == "out" ? "bg-rose-600 text-white shadow-xs" : "bg-rose-50 text-rose-800 border border-rose-200 hover:bg-rose-100")"
        >
            <span class="size-1.5 rounded-full @(_filter == "out" ? "bg-white" : "bg-rose-600")"></span>
            🔴 Out of Stock (@_totalOut)
        </button>
    </div>

    <div class="relative w-64">
        <input
            @bind="_searchTerm"
            @bind:event="oninput"
            @bind:after="OnSearchChanged"
            class="field pr-9 !py-1.5 text-xs"
            placeholder="Search product name or SKU..."
        />
        <span class="absolute right-3 top-2.5 text-slate-400">
            <Icon Name="search" Class="size-3.5" />
        </span>
    </div>
</div>

<!-- Inventory Table -->
<div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Product &amp; Variant SKU</th>
                    <th class="text-center">Physical On Hand</th>
                    <th class="text-center">Reserved for Orders</th>
                    <th class="text-center">Available to Sell</th>
                    <th class="text-right">Selling Price</th>
                    <th class="text-right">Quick Operations</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    var available = row.OnHand - row.Reserved;
                    <tr class="hover:bg-slate-50/70 transition-colors">
                        <td>
                            <strong class="text-slate-900 block font-semibold">@row.ProductName</strong>
                            <span class="font-mono text-xs text-slate-400">SKU: @row.Sku</span>
                        </td>
                        <td class="text-center font-bold text-slate-800 text-sm">
                            @row.OnHand
                        </td>
                        <td class="text-center text-xs font-semibold text-amber-700">
                            @(row.Reserved > 0 ? $"{row.Reserved} units" : "-")
                        </td>
                        <td class="text-center">
                            <span class="badge @(available <= 0 ? "badge-rose font-bold" : available <= 5 ? "badge-amber font-bold" : "badge-emerald font-semibold")">
                                @(available <= 0 ? "Out of Stock" : $"{available} units available")
                            </span>
                        </td>
                        <td class="text-right font-bold text-slate-900 tabular-nums">
                            ৳@row.Price.ToString("N0")
                        </td>
                        <td class="text-right whitespace-nowrap space-x-2">
                            <button type="button" @onclick="() => OpenRestockModal(row)" class="btn-primary !px-2.5 !py-1 text-xs !bg-indigo-600 hover:!bg-indigo-700 inline-flex items-center gap-1 cursor-pointer">
                                <span>+ Quick Restock</span>
                            </button>
                            <a href="/admin/products/@row.ProductId/variants/@row.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                                Edit Variant
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="empty-state py-12">
            <Icon Name="box" Class="size-10 text-slate-300" />
            <p>No inventory items match your search or filter.</p>
        </div>
    }
</div>

@if (_totalPages > 1)
{
    <div class="mt-4 flex items-center justify-between text-xs text-slate-600 px-2">
        <span>Showing @((_page - 1) * PageSize + 1)–@(Math.Min(_page * PageSize, _totalFiltered)) of @_totalFiltered items</span>
        <div class="flex items-center gap-1">
            <button type="button" disabled="@(_page <= 1)" @onclick="() => GoToPage(_page - 1)" class="btn-secondary !px-2.5 !py-1 text-xs disabled:opacity-40">Previous</button>
            <span class="px-2 font-semibold">@_page / @_totalPages</span>
            <button type="button" disabled="@(_page >= _totalPages)" @onclick="() => GoToPage(_page + 1)" class="btn-secondary !px-2.5 !py-1 text-xs disabled:opacity-40">Next</button>
        </div>
    </div>
}

<!-- Quick Restock Flyout / Modal -->
@if (_selectedRow is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-xs animate-fadeIn">
        <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div>
                    <h3 class="text-base font-bold text-slate-900">Restock Product Inventory</h3>
                    <p class="text-xs text-slate-500 font-mono">SKU: @_selectedRow.Sku</p>
                </div>
                <button type="button" @onclick="CloseRestockModal" class="text-slate-400 hover:text-slate-600 font-bold p-1">✕</button>
            </div>

            <div class="rounded-xl bg-slate-50 p-3.5 border border-slate-200 text-xs space-y-1">
                <p class="font-bold text-slate-800">@_selectedRow.ProductName</p>
                <div class="flex justify-between text-slate-600 pt-1">
                    <span>Current On-Hand: <strong>@_selectedRow.OnHand</strong></span>
                    <span>Reserved for Orders: <strong>@_selectedRow.Reserved</strong></span>
                    <span>Available: <strong>@(_selectedRow.OnHand - _selectedRow.Reserved)</strong></span>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-800 mb-1">New Total On-Hand Quantity</label>
                <input type="number" @bind="_restockQuantity" min="0" max="100000" class="field text-sm font-bold" />
                <p class="text-[11px] text-slate-500 mt-1">Enter total units currently in physical warehouse.</p>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Stock Adjustment Reason / Note</label>
                <input type="text" @bind="_restockNote" placeholder="e.g. Shipment received from Official Brand Distributor..." class="field text-xs" />
            </div>

            <div class="flex items-center justify-end gap-2 pt-2">
                <button type="button" @onclick="CloseRestockModal" class="btn-secondary text-xs">Cancel</button>
                <button type="button" @onclick="SaveRestock" class="btn-primary text-xs !bg-indigo-600 hover:!bg-indigo-700">Save Stock Level</button>
            </div>
        </div>
    </div>
}

@code
{
    private const int PageSize = 25;
    private int _page = 1;
    private string _filter = "all";
    private string _searchTerm = "";
    private string? _toast;

    private int _totalAll;
    private int _totalLow;
    private int _totalOut;
    private int _totalFiltered;
    private int _totalPages = 1;

    private List<AdminVariantRow> _rows = [];
    private AdminVariantRow? _selectedRow;
    private int _restockQuantity;
    private string _restockNote = "Restock from distributor";

    protected override async Task OnInitializedAsync()
    {
        await LoadCountsAsync();
        await LoadRowsAsync();
    }

    private async Task LoadCountsAsync()
    {
        _totalAll = await Db.InventoryItems.CountAsync(i => !i.ProductVariant!.IsDeleted);
        _totalLow = await Db.InventoryItems.CountAsync(i => !i.ProductVariant!.IsDeleted && i.QuantityOnHand - i.QuantityReserved <= 5 && i.QuantityOnHand - i.QuantityReserved > 0);
        _totalOut = await Db.InventoryItems.CountAsync(i => !i.ProductVariant!.IsDeleted && i.QuantityOnHand - i.QuantityReserved <= 0);
    }

    private async Task SetFilter(string filter)
    {
        _filter = filter;
        _page = 1;
        await LoadRowsAsync();
    }

    private async Task OnSearchChanged()
    {
        _page = 1;
        await LoadRowsAsync();
    }

    private async Task GoToPage(int page)
    {
        _page = page;
        await LoadRowsAsync();
    }

    private async Task LoadRowsAsync()
    {
        var q = Db.InventoryItems.AsNoTracking().Where(i => !i.ProductVariant!.IsDeleted);

        if (_filter == "low")
        {
            q = q.Where(i => i.QuantityOnHand - i.QuantityReserved <= 5 && i.QuantityOnHand - i.QuantityReserved > 0);
        }
        else if (_filter == "out")
        {
            q = q.Where(i => i.QuantityOnHand - i.QuantityReserved <= 0);
        }

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim().ToLower();
            q = q.Where(i => i.ProductVariant!.SKU.ToLower().Contains(term) ||
                             i.ProductVariant.Product!.Name.ToLower().Contains(term));
        }

        _totalFiltered = await q.CountAsync();
        _totalPages = Math.Max(1, (int)Math.Ceiling(_totalFiltered / (double)PageSize));
        _page = Math.Clamp(_page, 1, _totalPages);

        _rows = await q.OrderBy(i => i.QuantityOnHand - i.QuantityReserved)
            .ThenBy(i => i.Id)
            .Skip((_page - 1) * PageSize)
            .Take(PageSize)
            .Select(i => new AdminVariantRow(
                i.ProductVariantId,
                i.ProductVariant!.ProductId,
                i.ProductVariant.Product!.Name,
                i.ProductVariant.SKU,
                "",
                i.ProductVariant.SellingPrice,
                i.QuantityOnHand,
                i.QuantityReserved,
                i.ProductVariant.IsActive,
                i.ProductVariant.IsDefault
            ))
            .ToListAsync();
    }

    private void OpenRestockModal(AdminVariantRow row)
    {
        _selectedRow = row;
        _restockQuantity = row.OnHand;
        _restockNote = "Restock shipment received";
    }

    private void CloseRestockModal()
    {
        _selectedRow = null;
    }

    private async Task SaveRestock()
    {
        if (_selectedRow == null) return;

        var inv = await Db.InventoryItems.SingleOrDefaultAsync(i => i.ProductVariantId == _selectedRow.Id);
        if (inv != null)
        {
            var diff = _restockQuantity - inv.QuantityOnHand;
            inv.QuantityOnHand = _restockQuantity;

            Db.InventoryTransactions.Add(new()
            {
                ProductVariantId = _selectedRow.Id,
                QuantityChange = diff,
                Type = InventoryTransactionType.Adjustment,
                ReferenceType = "AdminRestock",
                Note = string.IsNullOrWhiteSpace(_restockNote) ? "Manual restock via Admin Hub" : _restockNote.Trim()
            });

            await Db.SaveChangesAsync();
            _toast = $"Stock for \"{_selectedRow.ProductName}\" updated to {_restockQuantity} units.";
        }

        CloseRestockModal();
        await LoadCountsAsync();
        await LoadRowsAsync();
    }
}
