@page "/admin/inventory"
@attribute [StreamRendering]
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>Inventory &amp; Stock Intelligence · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">STOCK &amp; WAREHOUSE OPERATIONS</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Inventory &amp; Stock Levels</h1>
        <p class="text-sm text-slate-500 mt-1">Real-time stock tracking across warehouse, customer order reservations, and automated restock alerts.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3.5 text-xs text-emerald-800 flex items-center justify-between shadow-xs animate-fadeIn">
        <span class="flex items-center gap-2.5">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white">
                <Icon Name="check" Class="size-3.5" />
            </span>
            <span class="font-medium">@_toast</span>
        </span>
        <button type="button" @onclick="() => _toast = null" class="text-emerald-600 hover:text-emerald-950 p-1">
            <Icon Name="close" Class="size-3.5" />
        </button>
    </div>
}

<!-- Filters Bar -->
<div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
    <div class="flex flex-wrap items-center gap-2">
        <a
            href="@FilterUrl("all", 1)"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Filter == "all" ? "bg-slate-900 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            All Stock Items (@_totalAll)
        </a>
        <a
            href="@FilterUrl("low", 1)"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(Filter == "low" ? "bg-amber-600 text-white shadow-xs" : "bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100")"
        >
            <span class="size-1.5 rounded-full @(Filter == "low" ? "bg-white" : "bg-amber-600")"></span>
            ⚠️ Low Stock (≤ 5 units) (@_totalLow)
        </a>
        <a
            href="@FilterUrl("out", 1)"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(Filter == "out" ? "bg-rose-600 text-white shadow-xs" : "bg-rose-50 text-rose-800 border border-rose-200 hover:bg-rose-100")"
        >
            <span class="size-1.5 rounded-full @(Filter == "out" ? "bg-white" : "bg-rose-600")"></span>
            🔴 Out of Stock (@_totalOut)
        </a>
    </div>

    <form method="get" data-enhance class="relative w-64">
        <input type="hidden" name="status" value="@Filter" />
        <input
            name="q"
            value="@Query"
            class="field pr-9 !py-1.5 text-xs"
            placeholder="Search product name or SKU..."
        />
        <button type="submit" class="absolute right-2 top-2 text-slate-400 hover:text-slate-700">
            <Icon Name="search" Class="size-3.5" />
        </button>
    </form>
</div>

<!-- Inventory Table -->
<form method="post" @formname="inventory-table-action">
    <AntiforgeryToken />
    <div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
        <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Product &amp; Variant SKU</th>
                    <th class="text-center">Physical On Hand</th>
                    <th class="text-center">Reserved for Orders</th>
                    <th class="text-center">Available to Sell</th>
                    <th class="text-right">Selling Price</th>
                    <th class="text-right">Quick Operations</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    var available = row.OnHand - row.Reserved;
                    <tr class="hover:bg-slate-50/70 transition-colors">
                        <td>
                            <strong class="text-slate-900 block font-semibold">@row.ProductName</strong>
                            <span class="font-mono text-xs text-slate-400">SKU: @row.Sku</span>
                        </td>
                        <td class="text-center font-bold text-slate-800 text-sm">
                            @row.OnHand
                        </td>
                        <td class="text-center text-xs font-semibold text-amber-700">
                            @(row.Reserved > 0 ? $"{row.Reserved} units" : "-")
                        </td>
                        <td class="text-center">
                            <span class="badge @(available <= 0 ? "badge-rose font-bold" : available <= 5 ? "badge-amber font-bold" : "badge-emerald font-semibold")">
                                @(available <= 0 ? "Out of Stock" : $"{available} units available")
                            </span>
                        </td>
                        <td class="text-right font-bold text-slate-900 tabular-nums">
                            ৳@row.Price.ToString("N0")
                        </td>
                        <td class="text-right whitespace-nowrap space-x-2">
                            <button type="submit" name="QuickRestockId" value="@row.Id" class="btn-primary !px-2.5 !py-1 text-xs !bg-indigo-600 hover:!bg-indigo-700 inline-flex items-center gap-1 cursor-pointer">
                                <span>+10 Restock</span>
                            </button>

                            <a href="/admin/inventory/@row.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                                Adjust Stock
                            </a>

                            <a href="/admin/products/@row.ProductId/variants/@row.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                                Edit Variant
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="empty-state py-12">
            <Icon Name="box" Class="size-10 text-slate-300" />
            <p>No inventory items match your search or filter.</p>
        </div>
    }
</div>
</form>

@if (_totalPages > 1)
{
    <div class="mt-4 flex items-center justify-between text-xs text-slate-600 px-2">
        <span>Showing @((Page - 1) * PageSize + 1)–@(Math.Min(Page * PageSize, _totalFiltered)) of @_totalFiltered items</span>
        <div class="flex items-center gap-1">
            @if (Page > 1)
            {
                <a href="@FilterUrl(Filter, Page - 1)" class="btn-secondary !px-2.5 !py-1 text-xs">Previous</a>
            }
            <span class="px-2 font-semibold">@Page / @_totalPages</span>
            @if (Page < _totalPages)
            {
                <a href="@FilterUrl(Filter, Page + 1)" class="btn-secondary !px-2.5 !py-1 text-xs">Next</a>
            }
        </div>
    </div>
}

@code
{
    private const int PageSize = 25;

    [SupplyParameterFromQuery(Name = "status")]
    public string Filter { get; set; } = "all";

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromForm(FormName = "inventory-table-action")]
    public int QuickRestockId { get; set; }

    private string? _toast;
    private int _totalAll;
    private int _totalLow;
    private int _totalOut;
    private int _totalFiltered;
    private int _totalPages = 1;

    private List<AdminVariantRow> _rows = [];

    private string FilterUrl(string filter, int page)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(filter) && filter != "all") parts.Add($"status={Uri.EscapeDataString(filter)}");
        if (!string.IsNullOrWhiteSpace(Query)) parts.Add($"q={Uri.EscapeDataString(Query)}");
        if (page > 1) parts.Add($"page={page}");
        return parts.Count > 0 ? $"/admin/inventory?{string.Join("&", parts)}" : "/admin/inventory";
    }

    protected override async Task OnInitializedAsync()
    {
        if (QuickRestockId > 0)
        {
            var inv = await Db.InventoryItems.SingleOrDefaultAsync(i => i.ProductVariantId == QuickRestockId);
            if (inv != null)
            {
                inv.QuantityOnHand += 10;
                Db.InventoryTransactions.Add(new()
                {
                    ProductVariantId = QuickRestockId,
                    QuantityChange = 10,
                    Type = InventoryTransactionType.Adjustment,
                    ReferenceType = "AdminRestock",
                    Note = "Restock via Admin Hub (+10)"
                });

                await Db.SaveChangesAsync();
                Nav.NavigateTo(FilterUrl(Filter, Page));
                return;
            }
        }

        await LoadCountsAsync();
        await LoadRowsAsync();
    }

    private async Task LoadCountsAsync()
    {
        _totalAll = await Db.InventoryItems.CountAsync(i => !i.ProductVariant!.IsDeleted);
        _totalLow = await Db.InventoryItems.CountAsync(i => !i.ProductVariant!.IsDeleted && i.QuantityOnHand - i.QuantityReserved <= 5 && i.QuantityOnHand - i.QuantityReserved > 0);
        _totalOut = await Db.InventoryItems.CountAsync(i => !i.ProductVariant!.IsDeleted && i.QuantityOnHand - i.QuantityReserved <= 0);
    }

    private async Task LoadRowsAsync()
    {
        var q = Db.InventoryItems.AsNoTracking().Where(i => !i.ProductVariant!.IsDeleted);

        if (Filter == "low")
        {
            q = q.Where(i => i.QuantityOnHand - i.QuantityReserved <= 5 && i.QuantityOnHand - i.QuantityReserved > 0);
        }
        else if (Filter == "out")
        {
            q = q.Where(i => i.QuantityOnHand - i.QuantityReserved <= 0);
        }

        if (!string.IsNullOrWhiteSpace(Query))
        {
            var term = Query.Trim().ToLower();
            q = q.Where(i => i.ProductVariant!.SKU.ToLower().Contains(term) ||
                             i.ProductVariant.Product!.Name.ToLower().Contains(term));
        }

        _totalFiltered = await q.CountAsync();
        _totalPages = Math.Max(1, (int)Math.Ceiling(_totalFiltered / (double)PageSize));
        Page = Math.Clamp(Page, 1, _totalPages);

        _rows = await q.OrderBy(i => i.QuantityOnHand - i.QuantityReserved)
            .ThenBy(i => i.Id)
            .Skip((Page - 1) * PageSize)
            .Take(PageSize)
            .Select(i => new AdminVariantRow(
                i.ProductVariantId,
                i.ProductVariant!.ProductId,
                i.ProductVariant.Product!.Name,
                i.ProductVariant.SKU,
                "",
                i.ProductVariant.SellingPrice,
                i.QuantityOnHand,
                i.QuantityReserved,
                i.ProductVariant.IsActive,
                i.ProductVariant.IsDefault
            ))
            .ToListAsync();
    }
}
