@page "/admin/analytics"
@using System.Text
@inject SalesMetricsService Metrics
@inject AppDbContext Db

<PageTitle>Sales &amp; profit — JAS Admin</PageTitle>
<AdminPageHeader Title="Sales &amp; profit" Description="Delivered sales, product performance and historical records. All dates use Bangladesh time." ActionHref="/admin" ActionText="Back to dashboard" />

@if (summary is not null && selected is not null && soldItems is not null)
{
    <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
        <nav class="sales-periods !mb-0" aria-label="Sales reporting period">
            @foreach (var option in summary.Periods)
            {
                <a href="@($"/admin/analytics?period={option.Period.Key}")" aria-current="@(option.Period.Key == selected.Period.Key ? "page" : null)">@option.Period.Label</a>
            }
        </nav>
        <a href="@GetCsvDataUrl()" download="jas_sales_report_@(selected.Period.Key).csv" class="btn-secondary !px-3.5 !py-1.5 text-xs inline-flex items-center gap-1.5 shadow-2xs font-semibold">
            <span>📥 Export Sales Report (CSV)</span>
        </a>
    </div>
    <div class="sales-context"><h2>@selected.Period.Label</h2><p>@selected.Period.DateLabel</p></div>
    <div class="dashboard-metrics sales-metrics">
        <div class="metric-card metric-highlight"><span>Product sales</span><strong>৳@selected.Totals.Sales.ToString("N2")</strong><small>Delivery fees excluded</small></div>
        <div class="metric-card"><span>Gross profit</span><strong class="@(selected.Totals.Profit < 0 ? "sales-loss" : null)">৳@selected.Totals.Profit.ToString("N2")</strong><small>@selected.Totals.Margin.ToString("N1")% gross margin</small></div>
        <div class="metric-card"><span>Delivered orders</span><strong>@selected.Totals.Orders.ToString("N0")</strong><small>৳@selected.Totals.AverageOrder.ToString("N2") average product sale</small></div>
        <div class="metric-card"><span>Units sold</span><strong>@selected.Totals.Units.ToString("N0")</strong><small>Across all delivered items</small></div>
    </div>
    <div class="sales-note">
        <p>Gross profit = product sales − purchase cost. It excludes delivery fees, delivery costs, taxes and operating expenses.</p>
        <p>Delivery fees: <strong>৳@selected.Totals.DeliveryFees.ToString("N2")</strong> · Revenue including delivery: <strong>৳@selected.Totals.Revenue.ToString("N2")</strong> · Product cost: <strong>৳@selected.Totals.Cost.ToString("N2")</strong></p>
        @if (summary.Select("all-time").Totals.EstimatedUnits > 0)
        {
            <p class="sales-estimate">Historical costs were unavailable for @summary.Select("all-time").Totals.EstimatedUnits.ToString("N0") sold units. Their costs were estimated from variant prices when reporting was added. Those estimates are fixed; affected profit totals and records are labelled. This period includes @selected.Totals.EstimatedUnits.ToString("N0") estimated units.</p>
        }
    </div>

    <SalesPeriodSummary Summary="summary" Selected="selected.Period.Key" />

    <!-- Omnichannel Payment & Operations Analytics -->
    <section class="shop-panel sales-section">
        <div class="admin-section-heading">
            <div>
                <h2>Payment Methods &amp; Fulfillment Operations</h2>
                <p>Breakdown of digital prepayments vs Cash on Delivery, order processing funnel, and basket statistics.</p>
            </div>
            <span class="admin-help">@allOrders.Count Total Store Orders</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <!-- AOV -->
            <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Average Order Value (AOV)</span>
                <p class="font-display text-2xl font-black text-slate-900 mt-2">৳@averageOrderValue.ToString("N0")</p>
                <p class="text-xs text-slate-500 mt-1">Gross basket size across confirmed orders</p>
            </div>

            <!-- bKash Prepayments -->
            <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">bKash Prepayments</span>
                    <span class="text-[10px] font-bold text-pink-700 bg-pink-50 border border-pink-200 px-1.5 py-0.5 rounded">Digital</span>
                </div>
                <p class="font-display text-2xl font-black text-pink-600 mt-2">৳@bkashRevenue.ToString("N0")</p>
                <p class="text-xs text-slate-500 mt-1">@bkashOrders.Count orders (@bkashVerified verified TrxIDs)</p>
            </div>

            <!-- Cash on Delivery -->
            <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Cash on Delivery</span>
                    <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded">COD</span>
                </div>
                <p class="font-display text-2xl font-black text-slate-900 mt-2">৳@codRevenue.ToString("N0")</p>
                <p class="text-xs text-slate-500 mt-1">@codOrders.Count orders collected via courier</p>
            </div>

            <!-- Customer Loyalty -->
            <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Registered Accounts</span>
                <p class="font-display text-2xl font-black text-blue-600 mt-2">@registeredAccounts</p>
                <p class="text-xs text-slate-500 mt-1">@guestAccounts guest checkout orders</p>
            </div>
        </div>

        <!-- Order Funnel Progress -->
        <div class="rounded-2xl border border-slate-200/80 bg-slate-50/50 p-5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-600 mb-4">Order Lifecycle Distribution</h3>
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 text-center">
                <div class="rounded-xl border border-amber-200 bg-amber-50/60 p-3">
                    <span class="text-xs font-semibold text-amber-700 block">Pending Review</span>
                    <strong class="text-xl font-black text-amber-900 block mt-1">@statusPending</strong>
                </div>
                <div class="rounded-xl border border-blue-200 bg-blue-50/60 p-3">
                    <span class="text-xs font-semibold text-blue-700 block">Confirmed</span>
                    <strong class="text-xl font-black text-blue-900 block mt-1">@statusConfirmed</strong>
                </div>
                <div class="rounded-xl border border-indigo-200 bg-indigo-50/60 p-3">
                    <span class="text-xs font-semibold text-indigo-700 block">In Delivery</span>
                    <strong class="text-xl font-black text-indigo-900 block mt-1">@statusShipped</strong>
                </div>
                <div class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-3">
                    <span class="text-xs font-semibold text-emerald-700 block">Delivered</span>
                    <strong class="text-xl font-black text-emerald-900 block mt-1">@statusDelivered</strong>
                </div>
                <div class="rounded-xl border border-rose-200 bg-rose-50/60 p-3">
                    <span class="text-xs font-semibold text-rose-700 block">Cancelled</span>
                    <strong class="text-xl font-black text-rose-900 block mt-1">@statusCancelled</strong>
                </div>
            </div>
        </div>
    </section>

    <section class="shop-panel sales-section">
        @if (selected.Totals.Orders == 0)
        {
            <h2 class="admin-section-title">Sales trend</h2>
            <p class="admin-empty">No delivered orders in this period. Choose another period to explore sales.</p>
        }
        else
        {
            <SalesTrend Rows="trend" Period="selected.Period" Monthly="monthlyTrend" />
            <details class="sales-trend-details">
                <summary>View exact @(monthlyTrend ? "monthly" : "daily") totals</summary>
                <div class="admin-table-wrap">
                    <table class="shop-table sales-table">
                        <thead><tr><th>@(monthlyTrend ? "Month" : "Day")</th><th>Orders</th><th>Units</th><th>Product sales</th><th>Gross profit</th></tr></thead>
                        <tbody>
                            @foreach (var row in trend.OrderByDescending(r => r.Date))
                            {
                                <tr><td>@row.Date.ToString(monthlyTrend ? "MMM yyyy" : "dd MMM yyyy")</td><td>@row.Totals.Orders</td><td>@row.Totals.Units</td><td>৳@row.Totals.Sales.ToString("N2")</td><td class="@(row.Totals.Profit < 0 ? "sales-loss" : null)">৳@row.Totals.Profit.ToString("N2") @if (row.Totals.EstimatedUnits > 0) { <span class="cell-secondary">Includes estimated costs</span> }</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    </section>

    <section class="shop-panel admin-table-wrap sales-section">
        <div class="admin-section-heading"><div><h2>Items sold</h2><p>All sold product variants in @selected.Period.Label.ToLowerInvariant(). Totals above include every item, regardless of search or page.</p></div><span class="admin-help">@soldItems.Total.ToString("N0") matching rows</span></div>
        <form method="get" action="/admin/analytics" data-enhance class="admin-toolbar">
            <input type="hidden" name="period" value="@selected.Period.Key" />
            <label class="sales-filter-label">Search items<input name="q" value="@Query" placeholder="Product, variant or SKU" class="shop-input" /></label>
            <label class="sales-filter-label">Sort by<select name="sort" class="shop-input">
                <option value="sales" selected="@(Sort == "sales")">Highest sales</option>
                <option value="profit" selected="@(Sort == "profit")">Highest profit</option>
                <option value="units" selected="@(Sort == "units")">Most units sold</option>
                <option value="name" selected="@(Sort == "name")">Product name</option>
            </select></label>
            <button class="shop-button-secondary">Apply</button>
            <a href="@($"/admin/analytics?period={selected.Period.Key}")">Clear</a>
        </form>
        <table class="shop-table sales-table">
            <thead><tr><th>Product / variant</th><th>Units sold</th><th>Product sales</th><th>Purchase cost</th><th>Gross profit</th><th>Margin</th></tr></thead>
            <tbody>
                @foreach (var item in soldItems.Items)
                {
                    <tr>
                        <td><strong>@item.Product</strong><span class="cell-secondary">@(string.IsNullOrWhiteSpace(item.Variant) ? "Base variant" : item.Variant) · Variant #@item.VariantId</span></td>
                        <td>@item.Units.ToString("N0")</td><td>৳@item.Sales.ToString("N2")</td>
                        <td>৳@item.Cost.ToString("N2") @if (item.EstimatedUnits > 0) { <span class="cell-secondary">@item.EstimatedUnits units with estimated costs</span> }</td>
                        <td class="@(item.Profit < 0 ? "sales-loss" : null)">৳@item.Profit.ToString("N2")</td><td>@item.Margin.ToString("N1")%</td>
                    </tr>
                }
            </tbody>
            @if (string.IsNullOrWhiteSpace(Query))
            {
                <tfoot><tr><th>Whole period · all pages</th><td>@selected.Totals.Units.ToString("N0")</td><td>৳@selected.Totals.Sales.ToString("N2")</td><td>৳@selected.Totals.Cost.ToString("N2")</td><td>৳@selected.Totals.Profit.ToString("N2")</td><td>@selected.Totals.Margin.ToString("N1")%</td></tr></tfoot>
            }
        </table>
        @if (soldItems.Items.Count == 0)
        {
            <p class="admin-empty">@(string.IsNullOrWhiteSpace(Query) ? "No items sold in this period." : "No sold items match your search.")</p>
        }
        <div class="admin-pagination">
            <span>Page @soldItems.Page of @soldItems.Pages · @SoldItemsPage.PageSize rows per page</span>
            <div>
                @if (soldItems.Page > 1) { <a class="shop-button-secondary" href="@ItemPage(soldItems.Page - 1)">← Previous</a> }
                @if (soldItems.Page < soldItems.Pages) { <a class="shop-button-secondary" href="@ItemPage(soldItems.Page + 1)">Next →</a> }
            </div>
        </div>
    </section>

    <section class="shop-panel sales-section">
        <div class="admin-section-heading"><div><h2>All-time records</h2><p>Highest product sales and gross profit across all delivered-order history. Earliest period wins ties. Current months and years are included.</p></div></div>
        <div class="sales-records">
            <SalesRecordCard Title="Best sales day" Record="summary.History.BestSalesDay" />
            <SalesRecordCard Title="Best profit day" Record="summary.History.BestProfitDay" Profit="true" />
            <SalesRecordCard Title="Best sales month" Record="summary.History.BestSalesMonth" />
            <SalesRecordCard Title="Best profit month" Record="summary.History.BestProfitMonth" Profit="true" />
            <SalesRecordCard Title="Best sales year" Record="summary.History.BestSalesYear" />
            <SalesRecordCard Title="Best profit year" Record="summary.History.BestProfitYear" Profit="true" />
        </div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "period")] public string? Period { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int Page { get; set; } = 1;
    private SalesSummary? summary;
    private PeriodSales? selected;
    private SoldItemsPage? soldItems;
    private IReadOnlyList<SalesBucket> trend = [];
    private bool monthlyTrend;

    private List<Order> allOrders = [];
    private List<Order> bkashOrders = [];
    private List<Order> codOrders = [];
    private decimal bkashRevenue;
    private decimal codRevenue;
    private int bkashVerified;
    private int statusPending;
    private int statusConfirmed;
    private int statusShipped;
    private int statusDelivered;
    private int statusCancelled;
    private decimal averageOrderValue;
    private int registeredAccounts;
    private int guestAccounts;

    protected override async Task OnInitializedAsync()
    {
        allOrders = await Db.Orders.AsNoTracking().Include(o => o.Payments).ToListAsync();
        bkashOrders = allOrders.Where(o => o.Payments.Any(p => p.Method == PaymentMethod.Bkash) || !string.IsNullOrEmpty(o.TransactionId) || !string.IsNullOrEmpty(o.PaymentReferenceCode)).ToList();
        codOrders = allOrders.Where(o => o.Payments.Any(p => p.Method == PaymentMethod.CashOnDelivery) || (string.IsNullOrEmpty(o.TransactionId) && string.IsNullOrEmpty(o.PaymentReferenceCode))).ToList();
        bkashRevenue = bkashOrders.Sum(o => o.Total);
        codRevenue = codOrders.Sum(o => o.Total);
        bkashVerified = bkashOrders.Count(o => o.PaidAmount > 0 || o.Payments.Any(p => p.Status == PaymentStatus.Completed));

        statusPending = allOrders.Count(o => o.Status == OrderStatus.Pending);
        statusConfirmed = allOrders.Count(o => o.Status == OrderStatus.Processing);
        statusShipped = allOrders.Count(o => o.Status == OrderStatus.InTransit);
        statusDelivered = allOrders.Count(o => o.Status == OrderStatus.Delivered);
        statusCancelled = allOrders.Count(o => o.Status == OrderStatus.Cancelled);

        averageOrderValue = allOrders.Count > 0 ? (allOrders.Where(o => o.Status != OrderStatus.Cancelled).Average(o => (decimal?)o.Total) ?? 0m) : 0m;
        registeredAccounts = allOrders.Count(o => o.UserId.HasValue);
        guestAccounts = allOrders.Count(o => !o.UserId.HasValue);

        summary = await Metrics.GetSummaryAsync();
        selected = summary.Select(Period);
        Sort = Sort is "profit" or "units" or "name" ? Sort : "sales";
        soldItems = await Metrics.GetItemsAsync(selected.Period, Query, Sort, Page);
        monthlyTrend = selected.Period.End.DayNumber - selected.Period.Start.DayNumber > 62;
        var days = summary.Days.Where(d => d.Date >= selected.Period.Start && d.Date <= selected.Period.End).ToDictionary(d => d.Date);
        var daily = Enumerable.Range(0, selected.Period.End.DayNumber - selected.Period.Start.DayNumber + 1)
            .Select(offset => selected.Period.Start.AddDays(offset))
            .Select(date => days.GetValueOrDefault(date) ?? new SalesBucket(date, SalesTotals.Empty));
        trend = monthlyTrend
            ? daily.GroupBy(d => new DateOnly(d.Date.Year, d.Date.Month, 1)).Select(g => new SalesBucket(g.Key, SalesTotals.Sum(g.Select(d => d.Totals)))).ToArray()
            : daily.ToArray();
    }

    private string ItemPage(int page) => $"/admin/analytics?period={selected!.Period.Key}&q={Uri.EscapeDataString(Query ?? "")}&sort={Sort}&page={page}";

    private string GetCsvDataUrl()
    {
        var sb = new StringBuilder();
        sb.AppendLine("Product,Variant,Units Sold,Sales (BDT),Gross Profit (BDT),Gross Margin (%)");
        if (soldItems != null)
        {
            foreach (var item in soldItems.Items)
            {
                sb.AppendLine($"\"{item.Product.Replace("\"", "\"\"")}\",\"{item.Variant.Replace("\"", "\"\"")}\",{item.Units},{item.Sales:F2},{item.Profit:F2},{item.Margin:F1}");
            }
        }
        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        return $"data:text/csv;charset=utf-8;base64,{Convert.ToBase64String(bytes)}";
    }
}
