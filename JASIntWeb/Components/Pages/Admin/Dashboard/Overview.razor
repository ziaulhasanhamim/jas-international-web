@page "/admin"
@inject AppDbContext Db
@inject SalesMetricsService Metrics

<PageTitle>Command Center · JAS International Admin</PageTitle>

<!-- Executive Command Center Header -->
<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">STORE MANAGEMENT HUB</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Executive Command Center</h1>
        <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-2.5 py-1 font-semibold text-blue-700">
                <Icon Name="receipt" Class="size-3.5" />
                @DateTime.UtcNow.AddHours(6).ToString("dddd, dd MMM yyyy")
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 font-medium text-slate-700">
                <Icon Name="dashboard" Class="size-3.5 text-slate-500" />
                Khulna Main Showroom
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full @(pending > 0 ? "bg-amber-50 text-amber-700 ring-1 ring-amber-600/20" : "bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20") px-2.5 py-1 font-medium">
                <span class="size-1.5 rounded-full @(pending > 0 ? "bg-amber-500 animate-pulse" : "bg-emerald-500")"></span>
                @(pending > 0 ? $"{pending} Pending Order{(pending == 1 ? "" : "s")}" : "All Orders Processed")
            </span>
            @if (unconfirmedPayments > 0)
            {
                <a href="/admin/orders?payment=unconfirmed" class="inline-flex items-center gap-1.5 rounded-full bg-rose-50 text-rose-700 ring-1 ring-rose-600/30 px-2.5 py-1 font-bold animate-pulse hover:bg-rose-100 transition">
                    <span class="size-1.5 rounded-full bg-rose-600"></span>
                    <span>@unconfirmedPayments Needs Payment Confirmation</span>
                </a>
            }
        </div>
    </div>

    <div class="flex flex-wrap items-center gap-2.5">
        <a href="/admin/products/new" class="btn-primary shadow-xs">
            <Icon Name="plus" Class="size-4" />
            Add Product
        </a>
        <a href="/admin/orders" class="btn-secondary">
            <Icon Name="cart" Class="size-4" />
            Manage Orders
        </a>
    </div>
</div>

<!-- Hero 4-Card KPI Grid -->
<div class="grid gap-4 grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 mb-7">
    <!-- Month Sales Card -->
    <a href="/admin/analytics" class="metric-sales group">
        <span class="metric-icon-emerald">
            <Icon Name="cash" />
        </span>
        <p>This Month Revenue</p>
        <strong class="tabular-nums">৳@(sales?.Select("this-month").Totals.Sales.ToString("N0") ?? "0")</strong>
        <div class="mt-2.5 flex flex-wrap items-center justify-between gap-1 text-[11px]">
            <span class="text-slate-500">Delivered store orders</span>
            <span class="rounded-full bg-emerald-100/90 px-2 py-0.5 font-semibold text-emerald-800 tabular-nums ring-1 ring-emerald-600/20">
                ৳@((sales?.Select("this-month").Totals.Sales - sales?.Select("this-month").Totals.Cost)?.ToString("N0") ?? "0") profit
            </span>
        </div>
    </a>

    <!-- Pending Fulfillment Card -->
    <a href="/admin/orders?status=Pending" class="metric-funds group">
        <span class="metric-icon-blue">
            <Icon Name="cart" />
        </span>
        <p>Pending Orders</p>
        <strong class="tabular-nums">@pending</strong>
        <div class="mt-2.5 flex items-center justify-between text-[11px] text-slate-500">
            <span>Awaiting confirmation & dispatch</span>
            <span class="text-blue-600 font-semibold group-hover:underline">Review →</span>
        </div>
    </a>

    <!-- Low Stock Card -->
    <a href="/admin/inventory?filter=low" class="metric-stock group">
        <span class="metric-icon-amber">
            <Icon Name="alert" />
        </span>
        <p>Low Stock Variants</p>
        <strong class="tabular-nums">@lowStock</strong>
        <div class="mt-2.5 flex items-center justify-between text-[11px] text-slate-500">
            <span>5 or fewer units remaining</span>
            <span class="text-amber-700 font-semibold group-hover:underline">Restock →</span>
        </div>
    </a>

    <!-- Active Catalog Card -->
    <a href="/admin/products" class="metric-valuation group">
        <span class="metric-icon-purple">
            <Icon Name="box" />
        </span>
        <p>Active Catalog</p>
        <strong class="tabular-nums">@productCount</strong>
        <div class="mt-2.5 flex items-center justify-between text-[11px] text-slate-500">
            <span>Live products published</span>
            <span class="text-purple-600 font-semibold group-hover:underline">Catalog →</span>
        </div>
    </a>
</div>

@if (sales is not null)
{
    <div class="mb-7">
        <SalesPeriodSummary Summary="sales" />
    </div>
}

<!-- Quick Operations Hub Cards -->
<div class="grid gap-4 grid-cols-1 md:grid-cols-2 xl:grid-cols-4 mb-7">
    <HubCard Href="/admin/orders?status=Pending" Title="Fulfill Orders" Hint="Verify COD & dispatch shipments" IconName="truck" Theme="blue" />
    <HubCard Href="/admin/inventory" Title="Inventory Health" Hint="Track stock quantities & reserved units" IconName="box" Theme="amber" />
    <HubCard Href="/admin/analytics" Title="Profit Margins" Hint="Period comparisons & best sales days" IconName="history" Theme="emerald" />
    <HubCard Href="/admin/carousel" Title="Marketing Slides" Hint="Update homepage promotional campaigns" IconName="camera" Theme="purple" />
</div>

<!-- Main Split: Recent Orders & Stock Alerts -->
<div class="grid gap-7 lg:grid-cols-3 mb-8">
    <div class="lg:col-span-2 rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-xs">
        <div class="flex items-center justify-between mb-5">
            <div>
                <h2 class="font-bold text-slate-900 text-lg">Recent Customer Orders</h2>
                <p class="text-xs text-slate-500 mt-0.5">Latest transactions from online storefront</p>
            </div>
            <a href="/admin/orders" class="text-xs font-semibold text-blue-600 hover:text-blue-800 transition">
                View all orders →
            </a>
        </div>

        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Date</th>
                        <th>Customer / Location</th>
                        <th>Status</th>
                        <th class="text-right">Total</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in orders)
                    {
                        <tr>
                            <td class="font-semibold text-slate-900">
                                <a href="/admin/orders/@o.Id" class="text-blue-600 hover:underline">#@o.Id</a>
                            </td>
                            <td class="text-xs text-slate-500">
                                @o.CreatedAt.ToOffset(TimeSpan.FromHours(6)).ToString("dd MMM, hh:mm tt")
                            </td>
                            <td>
                                <span class="font-medium text-slate-800 block text-xs">@(o.DeliveryAddress?.CustomerName ?? "Customer")</span>
                                <span class="text-[11px] text-slate-400">@(o.DeliveryAddress?.City ?? "Khulna")</span>
                            </td>
                            <td>
                                @switch (o.Status)
                                {
                                    case OrderStatus.Pending:
                                        <span class="badge badge-amber">Pending</span>
                                        break;
                                    case OrderStatus.Processing:
                                        <span class="badge badge-blue">Processing</span>
                                        break;
                                    case OrderStatus.InTransit:
                                        <span class="badge badge-purple">In Transit</span>
                                        break;
                                    case OrderStatus.Delivered:
                                        <span class="badge badge-emerald">Delivered</span>
                                        break;
                                    case OrderStatus.Cancelled:
                                        <span class="badge badge-rose">Cancelled</span>
                                        break;
                                    default:
                                        <span class="badge badge-slate">@o.Status</span>
                                        break;
                                }
                            </td>
                            <td class="text-right font-semibold text-slate-900 tabular-nums">
                                ৳@o.Total.ToString("N0")
                            </td>
                            <td class="text-right">
                                <a href="/admin/orders/@o.Id" class="inline-flex items-center gap-1 text-xs font-medium text-blue-600 hover:text-blue-800">
                                    Manage <Icon Name="arrow" Class="size-3" />
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (orders.Count == 0)
        {
            <div class="empty-state">
                <Icon Name="receipt" Class="size-10 text-slate-300" />
                <p>No customer orders yet. They will appear here in real time.</p>
            </div>
        }
    </div>

    <!-- Stock Alerts Section -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-xs flex flex-col justify-between">
        <div>
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 class="font-bold text-slate-900 text-lg">Inventory Alerts</h2>
                    <p class="text-xs text-slate-500 mt-0.5">Critical stock needing restock</p>
                </div>
                <a href="/admin/inventory" class="text-xs font-semibold text-amber-600 hover:text-amber-800">
                    Inventory →
                </a>
            </div>

            <div class="divide-y divide-slate-100">
                @foreach (var item in lowItems)
                {
                    var available = item.QuantityOnHand - item.QuantityReserved;
                    <a href="/admin/inventory/@item.ProductVariantId/edit" class="flex items-center justify-between py-3 group hover:bg-slate-50/80 rounded-lg px-2 -mx-2 transition">
                        <div class="min-w-0 flex-1 pr-3">
                            <strong class="block text-xs font-semibold text-slate-900 truncate group-hover:text-blue-600 transition">
                                @item.ProductVariant?.Product?.Name
                            </strong>
                            <span class="block text-[11px] text-slate-400 font-mono">
                                @(item.ProductVariant?.SKU ?? "SKU-N/A")
                            </span>
                        </div>
                        <span class="badge @(available <= 1 ? "badge-rose" : "badge-amber") shrink-0">
                            @available in stock
                        </span>
                    </a>
                }
            </div>

            @if (lowItems.Count == 0)
            {
                <div class="empty-state py-8">
                    <Icon Name="check" Class="size-8 text-emerald-500" />
                    <p class="text-emerald-700 font-medium">All products are healthy in stock.</p>
                </div>
            }
        </div>

        <div class="mt-6 pt-4 border-t border-slate-100">
            <a href="/admin/inventory" class="btn-secondary w-full text-xs">
                Open Stock Manager
            </a>
        </div>
    </div>
</div>

@code
{
    private int productCount, pending, lowStock, unconfirmedPayments;
    private SalesSummary? sales;
    private List<Order> orders = [];
    private List<InventoryItem> lowItems = [];

    protected override async Task OnInitializedAsync()
    {
        sales = await Metrics.GetSummaryAsync();
        productCount = await Db.Products.CountAsync(p => !p.IsDeleted);
        pending = await Db.Orders.CountAsync(o => o.Status == OrderStatus.Pending);
        unconfirmedPayments = await Db.Orders.CountAsync(o => o.Status != OrderStatus.Cancelled && o.PaidAmount == 0 && !string.IsNullOrEmpty(o.TransactionId));
        var low = Db.InventoryItems.AsNoTracking()
            .Where(i => i.QuantityOnHand - i.QuantityReserved <= 5
            && i.ProductVariant!.IsActive
            && !i.ProductVariant.IsDeleted);
        lowStock = await low.CountAsync();
        lowItems = await low.Include(i => i.ProductVariant)
            .ThenInclude(v => v!.Product)
            .OrderBy(i => i.QuantityOnHand - i.QuantityReserved)
            .Take(6)
            .ToListAsync();
        orders = await Db.Orders.AsNoTracking()
            .Include(o => o.DeliveryAddress)
            .OrderByDescending(o => o.CreatedAt)
            .Take(8)
            .ToListAsync();
    }
}
