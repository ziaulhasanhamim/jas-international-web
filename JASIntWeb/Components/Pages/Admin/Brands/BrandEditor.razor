@page "/admin/brands/new"
@page "/admin/brands/{Id:int}/edit"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AdminSession Session
@inject NavigationManager Nav

<AdminPageHeader
    Title="@(Id == 0 ? "Add Brand" : "Edit Brand")"
    ActionHref="/admin/brands"
    ActionText="Back to list"
/>

@if (notFound)
{
    <p class="admin-empty">Record not found.</p>
}
else
{
    @if (error is not null)
    {
        <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-700 flex items-center gap-2" role="alert">
            <Icon Name="alert" Class="size-4 shrink-0" />
            <span>@error</span>
        </div>
    }

    @if (Input is null)
    {
        <p class="admin-help">Loading form…</p>
    }
    else
    {
        <EditForm
            Model="Input"
            OnValidSubmit="Save"
            FormName="BrandEditor"
            method="post"
            data-submit-indication="true"
            class="shop-panel admin-form"
        >
            <DataAnnotationsValidator />
            <ValidationSummary class="text-xs text-rose-600 mb-3" />

            <label class="shop-label">
                Brand name
                <InputText @bind-Value="Input!.Name" class="shop-input" placeholder="e.g. Apple, Samsung, Anker" />
            </label>

            <label class="shop-label">
                URL slug
                <InputText @bind-Value="Input!.Slug" class="shop-input" placeholder="e.g. apple, samsung, anker" />
                <small>Dedicated canonical brand page: /brand/[slug]</small>
            </label>

            <!-- Brand Logo Upload & Visual Preview -->
            <div class="shop-label space-y-2">
                <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-900 text-sm">Brand Logo</span>
                    <span class="text-xs text-slate-400">SVG, PNG, WEBP, or JPG (max 5MB)</span>
                </div>

                <!-- Hidden Input bound to form model for enhanced form submission -->
                <input type="hidden" name="Input.LogoUrl" id="input-brand-logo-url" value="@Input!.LogoUrl" />

                <div id="brand-logo-uploader" class="space-y-3">
                    <!-- Dropzone & Upload Action Area -->
                    <div id="brand-logo-dropzone" class="border-2 border-dashed border-slate-300 rounded-2xl p-5 text-center hover:border-blue-500 hover:bg-blue-50/20 transition-all bg-slate-50/60">
                        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                            <!-- Dual-Background Preview Card (Checks contrast against light and dark) -->
                            <div id="brand-logo-preview-box" class="relative size-20 rounded-2xl border border-slate-200 bg-white p-2 shadow-2xs flex items-center justify-center overflow-hidden shrink-0 group">
                                <img id="brand-logo-preview-img"
                                     src="@(string.IsNullOrWhiteSpace(Input!.LogoUrl) ? "/jas-logo.png" : Input!.LogoUrl)"
                                     alt="Brand logo preview"
                                     class="size-full object-contain @(string.IsNullOrWhiteSpace(Input!.LogoUrl) ? "opacity-25 grayscale" : "")" />
                            </div>

                            <div class="text-center sm:text-left">
                                <p class="text-xs font-semibold text-slate-800" id="brand-logo-status-text">
                                    @(string.IsNullOrWhiteSpace(Input!.LogoUrl) ? "No brand logo uploaded yet" : "Logo attached to brand")
                                </p>
                                <p class="text-[11px] text-slate-500 mt-0.5">Drag &amp; drop an image here, browse your device, or edit the URL</p>

                                <div class="mt-3 flex flex-wrap items-center justify-center sm:justify-start gap-2">
                                    <label class="btn-primary cursor-pointer text-xs py-1.5 px-3.5 shadow-2xs inline-flex items-center gap-1.5 select-none">
                                        <Icon Name="camera" Class="size-3.5" />
                                        <span>Browse &amp; Upload</span>
                                        <input type="file" accept="image/png,image/svg+xml,image/webp,image/jpeg,image/avif" class="hidden" id="brand-logo-file-input" />
                                    </label>

                                    <button type="button" id="btn-toggle-logo-url" class="btn-secondary text-xs py-1.5 px-3">
                                        Edit URL
                                    </button>

                                    <button type="button" id="btn-clear-brand-logo" class="btn-secondary text-xs py-1.5 px-2.5 text-rose-600 hover:bg-rose-50 border-rose-200 @(string.IsNullOrWhiteSpace(Input!.LogoUrl) ? "hidden" : "")" title="Remove logo">
                                        Remove
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Progress Indicator -->
                        <div id="brand-logo-upload-progress" class="mt-3 flex items-center justify-center gap-2 text-xs font-semibold text-blue-600" hidden>
                            <span class="size-2 rounded-full bg-blue-600 animate-ping"></span>
                            <span>Uploading brand logo...</span>
                        </div>
                    </div>

                    <!-- Direct URL Drawer (collapsible or populated) -->
                    <div id="brand-logo-url-drawer" class="space-y-1.5 rounded-xl border border-slate-200 bg-slate-50/50 p-3 @(string.IsNullOrWhiteSpace(Input!.LogoUrl) ? "hidden" : "")">
                        <div class="flex items-center justify-between text-2xs text-slate-500">
                            <span class="font-semibold uppercase tracking-wider">Asset URL / Path</span>
                            <span class="font-mono text-slate-600 truncate max-w-xs" id="brand-logo-url-display">@(Input!.LogoUrl ?? "")</span>
                        </div>
                        <input type="text"
                               id="brand-logo-url-input"
                               value="@Input!.LogoUrl"
                               class="shop-input text-xs"
                               placeholder="https://... or /uploads/..." />
                        <small class="text-slate-400 block">Transparent SVG or PNG with 1:1 or 2:1 aspect ratio is recommended for best storefront appearance.</small>
                    </div>
                </div>
            </div>

            <label class="shop-label">
                Brief description (optional)
                <InputTextArea @bind-Value="Input!.Description" class="shop-input min-h-[70px]" placeholder="Brief background about brand products" />
            </label>

            <label class="shop-label">
                Sort Order
                <InputNumber @bind-Value="Input!.SortOrder" class="shop-input" />
                <small>Lower numbers appear first on featured brand strips.</small>
            </label>

            <div class="space-y-2 pt-2">
                <label class="check-label">
                    <input type="checkbox" name="Input.IsFeatured" checked="@(Input!.IsFeatured)" value="true" />
                    <input type="hidden" name="Input.IsFeatured" value="false" />
                    Feature this brand on the storefront homepage strip
                </label>

                <label class="check-label">
                    <input type="checkbox" name="Input.Hidden" checked="@(Input!.Hidden)" value="true" />
                    <input type="hidden" name="Input.Hidden" value="false" />
                    Hide brand from storefront filters
                </label>
            </div>

            <!-- SEO & Google SERP Preview -->
            <div class="mt-6 rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <h3 class="text-sm font-bold text-slate-900">🔍 Brand Page Optimization (Google SERP)</h3>
                </div>

                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 font-sans space-y-1">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">GOOGLE SNIPPET PREVIEW</span>
                    <div class="flex items-center gap-2 text-xs text-slate-700">
                        <span class="flex size-4 items-center justify-center rounded-full bg-blue-600 text-[10px] text-white font-bold">J</span>
                        <span class="truncate">https://www.jasinternational.com.bd › brand › @(string.IsNullOrWhiteSpace(Input!.Slug) ? "brand-slug" : Input!.Slug.Trim().ToLowerInvariant())</span>
                    </div>
                    <h4 class="text-base font-medium text-blue-800 leading-tight">
                        @(string.IsNullOrWhiteSpace(Input!.MetaTitle)
                            ? (string.IsNullOrWhiteSpace(Input!.Name) ? "Brand Products & Price in Bangladesh | JAS International" : $"{Input!.Name.Trim()} Products & Price in Bangladesh | JAS International")
                            : Input!.MetaTitle.Trim())
                    </h4>
                    <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                        @(string.IsNullOrWhiteSpace(Input!.MetaDescription)
                            ? $"Browse 100% authentic {Input!.Name} products with official warranty, nationwide cash on delivery, and showroom support in Khulna from JAS International."
                            : Input!.MetaDescription.Trim())
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <label class="shop-label">
                        <div class="flex items-center justify-between">
                            <span>Custom Meta Title</span>
                            <span class="text-[11px] @((Input!.MetaTitle?.Length ?? 0) > 60 ? "text-amber-600 font-bold" : "text-slate-400")">
                                @(Input!.MetaTitle?.Length ?? 0) / 60 chars
                            </span>
                        </div>
                        <InputText @bind-Value="Input!.MetaTitle" class="shop-input" placeholder="e.g. Apple Products & Price in Bangladesh | JAS International" />
                    </label>

                    <label class="shop-label">
                        <div class="flex items-center justify-between">
                            <span>Custom Meta Description</span>
                            <span class="text-[11px] @((Input!.MetaDescription?.Length ?? 0) > 155 ? "text-amber-600 font-bold" : "text-slate-400")">
                                @(Input!.MetaDescription?.Length ?? 0) / 155 chars
                            </span>
                        </div>
                        <InputText @bind-Value="Input!.MetaDescription" class="shop-input" placeholder="e.g. Browse authentic Apple products with warranty in Bangladesh..." />
                    </label>
                </div>

                <label class="shop-label">
                    <span>Brand Intro Copy (Top of /brand/[slug])</span>
                    <InputTextArea @bind-Value="Input!.IntroText" class="shop-input" rows="2" placeholder="Brief 1-2 sentence overview of this brand for shoppers." />
                </label>

                <label class="shop-label">
                    <span>Bottom Rich SEO Text / Brand Story (HTML / Markdown supported)</span>
                    <InputTextArea @bind-Value="Input!.BottomSeoCopy" class="shop-input font-mono text-xs" rows="4" placeholder="Comprehensive brand buying guide, authorization statements, warranty and delivery details." />
                </label>

                <!-- Brand Social Sharing Image -->
                <AdminSingleImageUpload
                    FieldName="Input.OgImageUrl"
                    Value="@Input!.OgImageUrl"
                    Label="Brand Social Sharing / OG Image (Optional)"
                    HelpText="High-res 1200×630 image for Facebook/WhatsApp shares"
                    Aspect="banner"
                />
            </div>

            <div class="form-actions mt-6 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <button type="submit" class="shop-button" data-pending-text="Saving brand...">
                        <span class="form-submit-spinner" hidden></span>
                        <span>@(Id == 0 ? "Create Brand" : "Save Changes")</span>
                    </button>
                    <a href="/admin/brands" class="shop-button-secondary">Cancel</a>
                </div>

                @if (Id != 0 && productCount == 0)
                {
                    <button type="submit" name="FormAction" value="delete" class="btn-danger !px-3 !py-2 text-xs cursor-pointer" onclick="return confirm('Are you sure you want to delete this brand?');">
                        Delete Brand
                    </button>
                }
            </div>
        </EditForm>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromForm(FormName = "BrandEditor")]
    private BrandEditForm? Input { get; set; }

    [SupplyParameterFromForm(FormName = "BrandEditor")]
    private string? FormAction { get; set; }

    private string? error;
    private bool notFound;
    private int productCount;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (Id != 0)
        {
            productCount = await db.Products.CountAsync(p => p.BrandId == Id && !p.IsDeleted);
        }

        if (Input is not null)
        {
            return;
        }

        if (Id == 0)
        {
            Input = new BrandEditForm
            {
                SortOrder = (await db.Brands.MaxAsync(b => (int?)b.SortOrder) ?? 0) + 1
            };
        }
        else
        {
            var b = await db.Brands.SingleOrDefaultAsync(x => x.Id == Id);
            if (b is null)
            {
                notFound = true;
                return;
            }
            Input = new BrandEditForm
            {
                Id = b.Id,
                Name = b.Name,
                Slug = b.Slug,
                Description = b.Description,
                LogoUrl = b.LogoUrl,
                IsFeatured = b.IsFeatured,
                SortOrder = b.SortOrder,
                Hidden = b.IsDeleted,
                MetaTitle = b.MetaTitle,
                MetaDescription = b.MetaDescription,
                OgImageUrl = b.OgImageUrl,
                IntroText = b.IntroText,
                BottomSeoCopy = b.BottomSeoCopy
            };
        }
    }

    private async Task Save()
    {
        if (FormAction == "delete")
        {
            await Delete();
            return;
        }

        error = null;
        try
        {
            await Session.RunAsync(s => s.SaveBrandAsync(Input!));
            Nav.NavigateTo("/admin/brands");
        }
        catch (ShopException ex)
        {
            error = ex.Message;
        }
    }

    private async Task Delete()
    {
        if (Id == 0 || productCount > 0) return;
        error = null;
        try
        {
            await Session.RunAsync(s => s.DeleteBrandAsync(Id));
            Nav.NavigateTo("/admin/brands");
        }
        catch (ShopException ex)
        {
            error = ex.Message;
        }
    }
}
