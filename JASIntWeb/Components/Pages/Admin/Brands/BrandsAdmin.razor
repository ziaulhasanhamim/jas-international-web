@page "/admin/brands"
@inject AppDbContext Db
@inject AdminSession Session
@inject NavigationManager Nav
<PageTitle>Brands · JAS Admin</PageTitle>
<AdminPageHeader Title="Brands" Eyebrow="Catalog" Description="Manage brand pages, logos and homepage visibility." ActionHref="/admin/brands/new" ActionText="Add brand" />
@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="brand-notice @(toastIsError ? "is-error" : "")" role="status"><span>@_toast</span><button type="button" data-admin-dismiss aria-label="Dismiss notification"><Icon Name="close" Class="size-4" /></button></div>
}
<div class="brand-list-panel">
    <div class="brand-list-toolbar">
        <nav class="brand-filters" aria-label="Brand filters">
            <a href="@FilterUrl("all")" aria-current="@(Filter == "all" ? "page" : null)">All brands <span>@totalAll</span></a>
            <a href="@FilterUrl("featured")" aria-current="@(Filter == "featured" ? "page" : null)">Featured <span>@totalFeatured</span></a>
        </nav>
        <form method="get" data-enhance class="brand-search" role="search">
            <input type="hidden" name="status" value="@Filter" />
            <label class="sr-only" for="brand-search">Search brands</label>
            <input id="brand-search" name="q" value="@Query" placeholder="Search brands…" oninput="clearTimeout(this._t); this._t=setTimeout(()=>this.form.requestSubmit(), 350)" />
            <button type="submit" aria-label="Search brands"><Icon Name="search" Class="size-4" /></button>
        </form>
    </div>
    @if (Filter == "featured")
    {
        <p class="brand-list-hint">The homepage shows up to 10 featured brands, ordered by their display position.</p>
    }
    @if (totalFiltered == 0)
    {
        <div class="brand-empty"><Icon Name="box" Class="size-8" /><h2>@(string.IsNullOrEmpty(Query) ? "No brands here yet" : "No matching brands")</h2><p>@(string.IsNullOrEmpty(Query) ? "Add a brand to organize products and create its storefront page." : "Try another search or clear the current filters.")</p><a href="@(string.IsNullOrEmpty(Query) ? "/admin/brands/new" : "/admin/brands")" class="btn-secondary">@(string.IsNullOrEmpty(Query) ? "Add brand" : "Clear filters")</a></div>
    }
    else
    {
        <form method="post" @formname="brands-table-action" data-enhance>
            <AntiforgeryToken />
            <div class="table-scroll brands-desktop">
                <QuickGrid Items="brandsQuery" class="data-table brand-table">
                    <PropertyColumn Property="@(b => b.Id)" Title="#ID" Class="col-id font-mono text-xs text-slate-500 w-16 text-center" Align="Align.Center" />
                    <TemplateColumn Title="Brand" Class="col-brand min-w-[220px]"><HeaderTemplate><AdminSortHeader Label="Brand" SortKey="Name" /></HeaderTemplate><ChildContent><BrandIdentity Id="context.Id" Name="@context.Name" Slug="@context.Slug" Logo="@context.LogoUrl" /></ChildContent></TemplateColumn>
                    <TemplateColumn Title="Homepage" Class="w-28 text-center" Align="Align.Center"><ChildContent><BrandFeaturedToggle Id="context.Id" Name="@context.Name" Featured="context.IsFeatured" /></ChildContent></TemplateColumn>
                    <PropertyColumn Property="@(b => b.SortOrder)" Title="Position" Class="w-20 text-center" Align="Align.Center"><HeaderTemplate><AdminSortHeader Label="Position" SortKey="SortOrder" /></HeaderTemplate></PropertyColumn>
                    <PropertyColumn Property="@(b => b.ProductCount)" Title="Products" Class="w-24 text-center font-semibold" Align="Align.Center"><HeaderTemplate><AdminSortHeader Label="Products" SortKey="ProductCount" /></HeaderTemplate></PropertyColumn>
                    <TemplateColumn Title="Status" Class="w-24 text-center" Align="Align.Center"><HeaderTemplate><AdminSortHeader Label="Status" SortKey="IsDeleted" /></HeaderTemplate><ChildContent><span class="brand-status @(context.IsDeleted ? "is-hidden" : "")">@(context.IsDeleted ? "Hidden" : "Active")</span></ChildContent></TemplateColumn>
                    <TemplateColumn Title="Actions" Class="w-44 text-right" Align="Align.End"><ChildContent><BrandActions Id="context.Id" Name="@context.Name" Hidden="context.IsDeleted" ProductCount="context.ProductCount" /></ChildContent></TemplateColumn>
                </QuickGrid>
            </div>
            <div class="brands-mobile">
                @foreach (var brand in brandsQuery ?? Enumerable.Empty<AdminBrandRow>().AsQueryable())
                {
                    <article class="brand-mobile-card" @key="brand.Id">
                        <div class="brand-mobile-heading"><BrandIdentity Id="brand.Id" Name="@brand.Name" Slug="@brand.Slug" Logo="@brand.LogoUrl" /><span class="brand-status @(brand.IsDeleted ? "is-hidden" : "")">@(brand.IsDeleted ? "Hidden" : "Active")</span></div>
                        <div class="brand-mobile-meta"><BrandFeaturedToggle Id="brand.Id" Name="@brand.Name" Featured="brand.IsFeatured" /><span>@brand.ProductCount products · Position @brand.SortOrder</span></div>
                        <BrandActions Id="brand.Id" Name="@brand.Name" Hidden="brand.IsDeleted" ProductCount="brand.ProductCount" />
                    </article>
                }
            </div>
        </form>
        <div class="brand-list-pagination"><AdminPagination Total="totalFiltered" Page="Page" Size="PageSize" /></div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string Filter { get; set; } = "all";

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromForm(FormName = "brands-table-action")]
    public int ToggleBrandId { get; set; }

    [SupplyParameterFromForm(FormName = "brands-table-action")]
    public int ToggleVisibilityId { get; set; }

    [SupplyParameterFromForm(FormName = "brands-table-action")]
    public int DeleteBrandId { get; set; }

    public record AdminBrandRow(
        int Id,
        string Name,
        string Slug,
        string? Description,
        string? LogoUrl,
        bool IsFeatured,
        int SortOrder,
        int ProductCount,
        bool IsDeleted
    );

    private IQueryable<AdminBrandRow>? brandsQuery;
    private const int PageSize = 15;
    private int totalFiltered;

    private string? _toast;
    private bool toastIsError;
    private int totalAll;
    private int totalFeatured;

    private string FilterUrl(string status)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(status) && status != "all") parts.Add($"status={Uri.EscapeDataString(status)}");
        if (!string.IsNullOrWhiteSpace(Query)) parts.Add($"q={Uri.EscapeDataString(Query)}");
        return parts.Count > 0 ? $"/admin/brands?{string.Join("&", parts)}" : "/admin/brands";
    }

    protected override async Task OnInitializedAsync()
    {
        if (ToggleBrandId > 0)
        {
            var res = await Session.RunAsync(service => service.ToggleBrandFeaturedAsync(ToggleBrandId));
            switch (res)
            {
                case Success:
                    _toast = "Brand homepage featured status updated.";
                    ToggleBrandId = 0;
                    break;
                case Error err:
                    _toast = err.Message;
                    toastIsError = true;
                    break;
            }
        }
        else if (ToggleVisibilityId > 0)
        {
            var res = await Session.RunAsync(service => service.ToggleBrandVisibilityAsync(ToggleVisibilityId));
            switch (res)
            {
                case Success:
                    _toast = "Brand visibility updated.";
                    ToggleVisibilityId = 0;
                    break;
                case Error err:
                    _toast = err.Message;
                    toastIsError = true;
                    break;
            }
        }
        else if (DeleteBrandId > 0)
        {
            var res = await Session.RunAsync(service => service.DeleteBrandAsync(DeleteBrandId, permanent: true));
            switch (res)
            {
                case Success:
                    _toast = "Brand permanently deleted. Any assigned products remain safely in the catalog.";
                    DeleteBrandId = 0;
                    break;
                case Error err:
                    _toast = err.Message;
                    toastIsError = true;
                    break;
            }
        }

        await LoadBrands();
    }

    private async Task LoadBrands()
    {
        Filter = Filter == "featured" ? "featured" : "all";
        totalAll = await Db.Brands.CountAsync();
        totalFeatured = await Db.Brands.CountAsync(b => b.IsFeatured);

        var q = Db.Brands.AsNoTracking();

        if (Filter == "featured")
        {
            q = q.Where(b => b.IsFeatured);
        }

        if (!string.IsNullOrWhiteSpace(Query))
        {
            var term = Query.Trim().ToLower();
            q = q.Where(b => b.Name.ToLower().Contains(term) || b.Slug.ToLower().Contains(term));
        }

        Page = Math.Max(1, Page);
        totalFiltered = await q.CountAsync();
        Page = Math.Clamp(Page, 1, Math.Max(1, (int)Math.Ceiling(totalFiltered / (double)PageSize)));

        var list = await AdminSorting.Apply(q.OrderBy(b => b.SortOrder)
            .ThenBy(b => b.Name), Nav, ("Name", b => b.Name), ("Slug", b => b.Slug), ("SortOrder", b => b.SortOrder), ("ProductCount", b => b.Products.Count(p => !p.IsDeleted)), ("IsDeleted", b => b.IsDeleted))
            .Skip((Page - 1) * PageSize)
            .Take(PageSize)
            .Select(b => new AdminBrandRow(
                b.Id,
                b.Name,
                b.Slug,
                b.Description,
                b.LogoUrl,
                b.IsFeatured,
                b.SortOrder,
                b.Products.Count(p => !p.IsDeleted),
                b.IsDeleted
            ))
            .ToListAsync();

        brandsQuery = list.AsQueryable();
    }
}
