@page "/admin/brands"
@attribute [StreamRendering]
@inject AppDbContext Db
@inject AdminSession Session
@inject CatalogService Catalog
@inject NavigationManager Nav

<PageTitle>Brands · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">CATALOG BRANDS</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Brands &amp; Featured Strips</h1>
        <p class="text-sm text-slate-500 mt-1">
            Manage gadget manufacturers, toggle which brands appear on the homepage featured brand strip, and configure logos.
        </p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/admin/brands/new" class="btn-primary shadow-xs">
            <Icon Name="plus" Class="size-4" />
            Add Brand
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800 flex items-center justify-between">
        <span class="flex items-center gap-2">
            <Icon Name="check" Class="size-4 text-emerald-600" />
            @_toast
        </span>
        <button type="button" @onclick="() => _toast = null" class="text-emerald-600 hover:text-emerald-950">
            <Icon Name="close" Class="size-3.5" />
        </button>
    </div>
}

<!-- Filters Bar -->
<div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
    <div class="flex flex-wrap items-center gap-2">
        <a
            href="@FilterUrl("all")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Filter == "all" ? "bg-slate-900 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            All Brands (@totalAll)
        </a>
        <a
            href="@FilterUrl("featured")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Filter == "featured" ? "bg-indigo-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            ⭐ Featured on Homepage (@totalFeatured)
        </a>
    </div>

    <form method="get" data-enhance class="relative w-64">
        <input type="hidden" name="status" value="@Filter" />
        <input
            name="q"
            value="@Query"
            class="field pr-9 !py-1.5 text-xs"
            placeholder="Search brands..."
        />
        <button type="submit" class="absolute right-2 top-2 text-slate-400 hover:text-slate-700">
            <Icon Name="search" Class="size-3.5" />
        </button>
    </form>
</div>

<!-- Brands Table -->
<div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Brand Name</th>
                    <th>Slug</th>
                    <th class="text-center">Homepage Strip</th>
                    <th>Sort Order</th>
                    <th>Products</th>
                    <th>Status</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in DisplayedBrands)
                {
                    <tr>
                        <td>
                            <div class="flex items-center gap-3">
                                @if (!string.IsNullOrEmpty(b.LogoUrl))
                                {
                                    <img src="@b.LogoUrl" alt="@b.Name" class="size-8 object-contain rounded-lg border border-slate-100 p-1 bg-white" />
                                }
                                else
                                {
                                    <span class="flex size-8 items-center justify-center rounded-lg bg-slate-100 text-xs font-bold text-slate-600">
                                        @b.Name[..Math.Min(2, b.Name.Length)].ToUpperInvariant()
                                    </span>
                                }
                                <div>
                                    <strong class="text-slate-900 block font-semibold">@b.Name</strong>
                                    @if (!string.IsNullOrEmpty(b.Description))
                                    {
                                        <span class="text-xs text-slate-400 truncate max-w-xs block">@b.Description</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="font-mono text-xs text-slate-600">
                            /@b.Slug
                        </td>
                        <td class="text-center">
                            <form method="post" data-enhance class="inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="ToggleBrandId" value="@b.Id" />
                                <button
                                    type="submit"
                                    name="ToggleAction"
                                    value="featured"
                                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold transition cursor-pointer @(b.IsFeatured ? "bg-indigo-50 text-indigo-700 border border-indigo-200 hover:bg-indigo-100" : "bg-slate-100 text-slate-400 border border-slate-200 hover:bg-slate-200")"
                                    title="Click to toggle homepage visibility"
                                >
                                    <span class="size-1.5 rounded-full @(b.IsFeatured ? "bg-indigo-600" : "bg-slate-400")"></span>
                                    @(b.IsFeatured ? "⭐ Featured" : "Hidden")
                                </button>
                            </form>
                        </td>
                        <td class="text-xs font-medium text-slate-700">
                            @b.SortOrder
                        </td>
                        <td>
                            <span class="inline-flex items-center gap-1 rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">
                                @b.ProductCount items
                            </span>
                        </td>
                        <td>
                            <span class="badge @(b.Hidden ? "badge-rose" : "badge-emerald")">
                                @(b.Hidden ? "Hidden" : "Active")
                            </span>
                        </td>
                        <td class="text-right">
                            <a href="/admin/brands/@b.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                                Edit Brand
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (DisplayedBrands.Count == 0)
    {
        <div class="empty-state py-12">
            <Icon Name="box" Class="size-10 text-slate-300" />
            <p>No brands found matching your criteria.</p>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string Filter { get; set; } = "all";

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromForm]
    public int ToggleBrandId { get; set; }

    [SupplyParameterFromForm]
    public string? ToggleAction { get; set; }

    private List<AdminBrandRow> _allBrands = [];
    private string? _toast;
    private int totalAll;
    private int totalFeatured;

    private string FilterUrl(string status)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(status) && status != "all") parts.Add($"status={Uri.EscapeDataString(status)}");
        if (!string.IsNullOrWhiteSpace(Query)) parts.Add($"q={Uri.EscapeDataString(Query)}");
        return parts.Count > 0 ? $"/admin/brands?{string.Join("&", parts)}" : "/admin/brands";
    }

    protected override async Task OnInitializedAsync()
    {
        if (ToggleBrandId > 0 && ToggleAction == "featured")
        {
            var brand = await Db.Brands.FindAsync(ToggleBrandId);
            if (brand != null)
            {
                brand.IsFeatured = !brand.IsFeatured;
                brand.UpdatedAt = DateTimeOffset.UtcNow;
                await Db.SaveChangesAsync();
                Catalog.InvalidateBrandsCache();
                _toast = $"Updated homepage visibility for {brand.Name}.";
            }
        }

        await LoadBrands();
    }

    private async Task LoadBrands()
    {
        var list = await Db.Brands.AsNoTracking()
            .OrderBy(b => b.SortOrder)
            .ThenBy(b => b.Name)
            .Select(b => new AdminBrandRow(
                b.Id,
                b.Name,
                b.Slug,
                b.Description,
                b.LogoUrl,
                b.IsFeatured,
                b.SortOrder,
                b.Products.Count(p => !p.IsDeleted),
                b.IsDeleted
            ))
            .ToListAsync();

        _allBrands = list;
        totalAll = list.Count;
        totalFeatured = list.Count(b => b.IsFeatured);
    }

    private List<AdminBrandRow> DisplayedBrands
    {
        get
        {
            var q = _allBrands.AsEnumerable();
            if (Filter == "featured") q = q.Where(b => b.IsFeatured);

            if (!string.IsNullOrWhiteSpace(Query))
            {
                var term = Query.Trim().ToLowerInvariant();
                q = q.Where(b => b.Name.ToLowerInvariant().Contains(term) || b.Slug.ToLowerInvariant().Contains(term));
            }
            return q.ToList();
        }
    }
}
