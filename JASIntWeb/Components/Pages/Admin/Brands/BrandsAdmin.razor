@page "/admin/brands"
@layout AdminLayout
@using Microsoft.AspNetCore.Components.QuickGrid
@inject AppDbContext Db
@inject JASIntWeb.Services.AdminService AdminSvc
@inject AdminSession Session
@inject CatalogService Catalog
@inject NavigationManager Nav

<PageTitle>Brands · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">CATALOG BRANDS</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Brands &amp; Featured Strips</h1>
        <p class="text-sm text-slate-500 mt-1">
            Manage gadget manufacturers, toggle which brands appear on the homepage featured brand strip, and configure logos with database QuickGrid.
        </p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/admin/brands/new" class="btn-primary shadow-xs">
            <Icon Name="plus" Class="size-4" />
            Add Brand
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800 flex items-center justify-between">
        <span class="flex items-center gap-2">
            <Icon Name="check" Class="size-4 text-emerald-600" />
            @_toast
        </span>
        <button type="button" data-admin-dismiss aria-label="Dismiss notification" class="text-emerald-600 hover:text-emerald-950">
            <Icon Name="close" Class="size-3.5" />
        </button>
    </div>
}

<!-- Filters Bar -->
<div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
    <div class="flex flex-wrap items-center gap-2">
        <a
            href="@FilterUrl("all")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Filter == "all" ? "bg-slate-900 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            All Brands (@totalAll)
        </a>
        <a
            href="@FilterUrl("featured")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Filter == "featured" ? "bg-indigo-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            ⭐ Featured on Homepage (@totalFeatured)
        </a>
    </div>

    <form method="get" data-enhance class="relative w-64">
        <input type="hidden" name="status" value="@Filter" />
        <input
            name="q"
            value="@Query"
            class="field pr-9 !py-1.5 text-xs"
            placeholder="Search brands..."
        />
        <button type="submit" class="absolute right-2 top-2 text-slate-400 hover:text-slate-700">
            <Icon Name="search" Class="size-3.5" />
        </button>
    </form>
</div>

@if (Filter == "featured")
{
    <div class="mb-4 flex items-center gap-2.5 rounded-xl border border-blue-200/80 bg-blue-50/60 p-3 text-xs text-blue-900">
        <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-blue-600 text-white font-bold text-[10px]">ℹ</span>
        <span><strong>Homepage Display Limit:</strong> Up to 10 featured brands appear on the homepage featured ribbon, prioritized by <strong>Sort Order</strong> (lowest number first). Use the edit screen to change sort priority.</span>
    </div>
}

<!-- Brands QuickGrid (Direct DB Query via EntityFrameworkAdapter) -->
<form method="post" @formname="brands-table-action" data-enhance>
    <AntiforgeryToken />
    <div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
        <div class="table-scroll">
            <QuickGrid Items="@brandsQuery" class="data-table">
                <TemplateColumn Title="Brand Name" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Brand Name" SortKey="Name" /></HeaderTemplate><ChildContent>
                    <div class="flex items-center gap-3">
                        @if (!string.IsNullOrEmpty(context.LogoUrl))
                        {
                            <PictureImage Src="@context.LogoUrl" Alt="@context.Name" Class="size-8 object-contain rounded-lg border border-slate-100 p-1 bg-white" Loading="lazy" Width="32" Height="32" />
                        }
                        else
                        {
                            <span class="flex size-8 items-center justify-center rounded-lg bg-slate-100 text-xs font-bold text-slate-600">
                                @context.Name[..Math.Min(2, context.Name.Length)].ToUpperInvariant()
                            </span>
                        }
                        <div>
                            <strong class="text-slate-900 block font-semibold">@context.Name</strong>
                            @if (!string.IsNullOrEmpty(context.Description))
                            {
                                <span class="text-xs text-slate-400 truncate max-w-xs block">@context.Description</span>
                            }
                        </div>
                    </div>
                </ChildContent></TemplateColumn>

                <PropertyColumn Property="@(b => b.Slug)" Title="Slug" Sortable="false" Class="font-mono text-xs text-slate-600" ><HeaderTemplate><AdminSortHeader Label="Slug" SortKey="Slug" /></HeaderTemplate></PropertyColumn>

                <TemplateColumn Title="Homepage Strip" Align="Align.Center">
                    <button
                        type="submit"
                        name="ToggleBrandId"
                        value="@context.Id"
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold transition cursor-pointer @(context.IsFeatured ? "bg-indigo-50 text-indigo-700 border border-indigo-200 hover:bg-indigo-100" : "bg-slate-100 text-slate-400 border border-slate-200 hover:bg-slate-200")"
                        title="Click to toggle homepage visibility"
                    >
                        <span class="size-1.5 rounded-full @(context.IsFeatured ? "bg-indigo-600" : "bg-slate-400")"></span>
                        @(context.IsFeatured ? "⭐ Featured" : "Standard")
                    </button>
                </TemplateColumn>

                <PropertyColumn Property="@(b => b.SortOrder)" Title="Sort Order" Sortable="false" ><HeaderTemplate><AdminSortHeader Label="Sort Order" SortKey="SortOrder" /></HeaderTemplate></PropertyColumn>
                <PropertyColumn Property="@(b => b.ProductCount)" Title="Products" Sortable="false" ><HeaderTemplate><AdminSortHeader Label="Products" SortKey="ProductCount" /></HeaderTemplate></PropertyColumn>

                <TemplateColumn Title="Status" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Status" SortKey="IsDeleted" /></HeaderTemplate><ChildContent>
                    <span class="badge @(context.IsDeleted ? "badge-rose" : "badge-emerald")">
                        @(context.IsDeleted ? "Archived" : "Active")
                    </span>
                </ChildContent></TemplateColumn>

                <TemplateColumn Title="Actions" Align="Align.End">
                    <div class="flex items-center justify-end gap-1.5">
                        <a href="/admin/brands/@context.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                            Edit
                        </a>
                        <button
                            type="submit"
                            name="ToggleVisibilityId"
                            value="@context.Id"
                            class="btn-secondary !px-2.5 !py-1 text-xs @(context.IsDeleted ? "text-emerald-600 hover:bg-emerald-50" : "text-amber-700 hover:bg-amber-50") cursor-pointer"
                            onclick="@(context.IsDeleted ? "" : "return confirm('Hide this brand from catalog?');")"
                            title="@(context.IsDeleted ? "Restore brand" : "Hide brand")"
                        >
                            @(context.IsDeleted ? "Restore" : "Hide")
                        </button>
                        @if (context.ProductCount == 0)
                        {
                            <button
                                type="submit"
                                name="DeleteBrandId"
                                value="@context.Id"
                                class="btn-secondary !px-2.5 !py-1 text-xs text-rose-600 hover:bg-rose-50 cursor-pointer"
                                onclick="return confirm('Permanently delete this brand?');"
                                title="Delete brand"
                            >
                                Delete
                            </button>
                        }
                        else
                        {
                            <button
                                type="button"
                                class="btn-secondary !px-2.5 !py-1 text-xs text-slate-300 cursor-not-allowed select-none"
                                title="Cannot delete: Brand has @context.ProductCount products."
                                disabled
                            >
                                Delete
                            </button>
                        }
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="p-4 border-t border-slate-200/90 flex items-center justify-between">
            <AdminPagination Total="totalFiltered" Page="Page" Size="PageSize" />
        </div>
    </div>
</form>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string Filter { get; set; } = "all";

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromForm(FormName = "brands-table-action")]
    public int ToggleBrandId { get; set; }

    [SupplyParameterFromForm(FormName = "brands-table-action")]
    public int ToggleVisibilityId { get; set; }

    [SupplyParameterFromForm(FormName = "brands-table-action")]
    public int DeleteBrandId { get; set; }

    public record AdminBrandRow(
        int Id,
        string Name,
        string Slug,
        string? Description,
        string? LogoUrl,
        bool IsFeatured,
        int SortOrder,
        int ProductCount,
        bool IsDeleted
    );

    private IQueryable<AdminBrandRow>? brandsQuery;
    private const int PageSize = 15;
    private int totalFiltered;

    private string? _toast;
    private int totalAll;
    private int totalFeatured;

    private string FilterUrl(string status)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(status) && status != "all") parts.Add($"status={Uri.EscapeDataString(status)}");
        if (!string.IsNullOrWhiteSpace(Query)) parts.Add($"q={Uri.EscapeDataString(Query)}");
        return parts.Count > 0 ? $"/admin/brands?{string.Join("&", parts)}" : "/admin/brands";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (ToggleBrandId > 0)
            {
                await AdminSvc.ToggleBrandFeaturedAsync(ToggleBrandId);
                _toast = "Brand homepage featured status updated.";
                ToggleBrandId = 0;
            }
            else if (ToggleVisibilityId > 0)
            {
                await AdminSvc.ToggleBrandVisibilityAsync(ToggleVisibilityId);
                _toast = "Brand visibility updated.";
                ToggleVisibilityId = 0;
            }
            else if (DeleteBrandId > 0)
            {
                await AdminSvc.DeleteBrandAsync(DeleteBrandId, permanent: true);
                _toast = "Brand permanently deleted. Any assigned products remain safely in the catalog.";
                DeleteBrandId = 0;
            }

            await LoadBrands();
        }
        catch (Exception ex)
        {
            _toast = ex.Message;
            await LoadBrands();
        }
    }

    private async Task LoadBrands()
    {
        totalAll = await Db.Brands.CountAsync();
        totalFeatured = await Db.Brands.CountAsync(b => b.IsFeatured);

        var q = Db.Brands.AsNoTracking();

        if (Filter == "featured")
        {
            q = q.Where(b => b.IsFeatured);
        }

        if (!string.IsNullOrWhiteSpace(Query))
        {
            var term = Query.Trim().ToLower();
            q = q.Where(b => b.Name.ToLower().Contains(term) || b.Slug.ToLower().Contains(term));
        }

        Page = Math.Max(1, Page);
        totalFiltered = await q.CountAsync();

        var list = await AdminSorting.Apply(q.OrderBy(b => b.SortOrder)
            .ThenBy(b => b.Name), Nav, ("Name", b => b.Name), ("Slug", b => b.Slug), ("SortOrder", b => b.SortOrder), ("ProductCount", b => b.Products.Count(p => !p.IsDeleted)), ("IsDeleted", b => b.IsDeleted))
            .Skip((Page - 1) * PageSize)
            .Take(PageSize)
            .Select(b => new AdminBrandRow(
                b.Id,
                b.Name,
                b.Slug,
                b.Description,
                b.LogoUrl,
                b.IsFeatured,
                b.SortOrder,
                b.Products.Count(p => !p.IsDeleted),
                b.IsDeleted
            ))
            .ToListAsync();

        brandsQuery = list.AsQueryable();
    }
}
