@page "/admin/orders"
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components.QuickGrid
@inject AppDbContext Db
@inject ShoppingService Shop
@inject NavigationManager Nav

<PageTitle>Orders Management · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">COMMERCE OPERATIONS</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Customer Orders</h1>
        <p class="text-sm text-slate-500 mt-1">Review, confirm, dispatch, and fulfill online store orders using database-powered QuickGrid.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800 flex items-center justify-between">
        <span class="flex items-center gap-2">
            <Icon Name="check" Class="size-4 text-emerald-600" />
            @_toast
        </span>
        <button type="button" data-admin-dismiss aria-label="Dismiss notification" class="text-emerald-600 hover:text-emerald-950">
            <Icon Name="close" Class="size-3.5" />
        </button>
    </div>
}

<!-- Filter Toolbar -->
<div class="mb-4 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
    <form method="get" data-enhance class="flex flex-wrap items-center gap-3">
        <div class="relative flex-1 min-w-55">
            <input name="q" value="@Query" placeholder="Search Order #, customer name, phone, or TrxID..." data-debounce-submit="350" class="field pr-9" />
            <span class="absolute right-3 top-3 text-slate-400">
                <Icon Name="search" Class="size-4" />
            </span>
        </div>
        <select name="status" class="field w-auto min-w-37.5">
            <option value="">All Statuses</option>
            @foreach (var s in Enum.GetValues<OrderStatus>())
            {
                <option value="@s" selected="@(Status == s.ToString() && string.IsNullOrEmpty(PaymentFilter))">@s</option>
            }
        </select>
        <button type="submit" class="btn-primary">
            Filter
        </button>
        @if (!string.IsNullOrWhiteSpace(Query) || !string.IsNullOrWhiteSpace(Status) || !string.IsNullOrWhiteSpace(PaymentFilter))
        {
            <a href="/admin/orders" class="btn-secondary">
                Reset
            </a>
        }
    </form>
</div>

<!-- Quick Filter Tabs -->
<div class="mb-5 flex flex-wrap items-center gap-2 text-xs">
    <a href="@FilterUrl(null, null)" class="rounded-xl px-3.5 py-1.5 font-bold transition @(string.IsNullOrEmpty(Status) && string.IsNullOrEmpty(PaymentFilter) ? "bg-slate-900 text-white shadow-xs" : "bg-white text-slate-600 hover:bg-slate-100 border border-slate-200/80")">
        All Orders
    </a>

    <a href="@FilterUrl(null, "unconfirmed")" class="rounded-xl px-3.5 py-1.5 font-bold transition flex items-center gap-2 @(PaymentFilter == "unconfirmed" ? "bg-amber-600 text-white shadow-xs" : "bg-amber-50 text-amber-900 hover:bg-amber-100 border border-amber-300/80")">
        <span>Needs Payment Confirmation</span>
        @if (unconfirmedPaymentCount > 0)
        {
            <span class="rounded-full bg-amber-900 text-white px-1.5 py-0.5 text-[10px] font-extrabold leading-none @(PaymentFilter == "unconfirmed" ? "!bg-white !text-amber-700" : "")">
                @unconfirmedPaymentCount
            </span>
        }
    </a>

    @foreach (var s in Enum.GetValues<OrderStatus>())
    {
        <a href="@FilterUrl(s.ToString(), null)" class="rounded-xl px-3 py-1.5 font-bold transition @(Status == s.ToString() && string.IsNullOrEmpty(PaymentFilter) ? "bg-slate-900 text-white shadow-xs" : "bg-white text-slate-600 hover:bg-slate-100 border border-slate-200/80")">
            @s
        </a>
    }
</div>

<!-- Orders Table -->
<form method="post" @formname="orders-quick-action" data-enhance>
    <AntiforgeryToken />
    <div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
        <div class="table-scroll">
            <QuickGrid Items="@ordersQuery" class="data-table">
                <TemplateColumn Title="Order #" Sortable="false" Class="col-id font-mono text-xs w-20 text-center" Align="Align.Center"><HeaderTemplate><AdminSortHeader Label="Order #" SortKey="Id" /></HeaderTemplate><ChildContent>
                    <a href="/admin/orders/@context.Id" class="font-bold text-blue-600 hover:underline">
                        #@context.Id
                    </a>
                </ChildContent></TemplateColumn>

                <TemplateColumn Title="Date & Time" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Date & Time" SortKey="CreatedAt" /></HeaderTemplate><ChildContent>
                    <span class="text-xs text-slate-500 whitespace-nowrap">
                        @context.CreatedAt.ToOffset(TimeSpan.FromHours(6)).ToString("dd MMM yyyy, hh:mm tt")
                    </span>
                </ChildContent></TemplateColumn>

                <TemplateColumn Title="Customer Name">
                    <strong class="font-semibold text-slate-800 block text-xs">
                        @(context.DeliveryAddress?.CustomerName ?? "Guest")
                    </strong>
                    <span class="text-xs font-mono text-slate-500">
                        @(context.DeliveryAddress?.PhoneNumber ?? "-")
                    </span>
                </TemplateColumn>

                <TemplateColumn Title="Delivery Area">
                    <span class="text-xs text-slate-600">
                        @(context.DeliveryAddress?.City ?? "-"), @(context.DeliveryAddress?.District ?? "-")
                    </span>
                </TemplateColumn>

                <TemplateColumn Title="Status" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Status" SortKey="Status" /></HeaderTemplate><ChildContent>
                    @switch (context.Status)
                    {
                        case OrderStatus.Pending:
                            <span class="badge badge-amber">Pending</span>
                            break;
                        case OrderStatus.Processing:
                            <span class="badge badge-blue">Processing</span>
                            break;
                        case OrderStatus.InTransit:
                            <span class="badge badge-purple">In Transit</span>
                            break;
                        case OrderStatus.Delivered:
                            <span class="badge badge-emerald">Delivered</span>
                            break;
                        case OrderStatus.Cancelled:
                            <span class="badge badge-rose">Cancelled</span>
                            break;
                        default:
                            <span class="badge badge-slate">@context.Status</span>
                            break;
                    }
                </ChildContent></TemplateColumn>

                <TemplateColumn Title="Payment">
                    @if (context.Status == OrderStatus.Cancelled)
                    {
                        <span class="badge badge-rose">Order Cancelled</span>
                    }
                    else if (context.PaidAmount > 0)
                    {
                        <div class="space-y-1">
                            <span class="badge badge-emerald">
                                <Icon Name="check" Class="size-3" />
                                <span>Verified (৳@context.PaidAmount.ToString("N0"))</span>
                            </span>
                            <div>
                                <button type="submit" name="Action" value="@($"unverify:{context.Id}")" class="text-[11px] text-amber-700 hover:text-amber-900 underline font-medium cursor-pointer">
                                    Mark Unverified
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-1.5">
                            @if (!string.IsNullOrEmpty(context.TransactionId))
                            {
                                <span class="badge badge-amber font-bold animate-pulse">
                                    Needs Confirmation
                                    <span class="block font-mono text-[10px] font-normal">@context.TransactionId</span>
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-slate">Unpaid</span>
                            }
                            <div class="flex items-center gap-1.5 pt-0.5">
                                <button type="submit" name="Action" value="@($"verify:{context.Id}")" class="btn-primary bg-emerald-600! hover:bg-emerald-700! text-white! py-1! px-2! text-[11px] font-bold rounded-lg shadow-2xs whitespace-nowrap inline-flex items-center gap-1 cursor-pointer">
                                    <Icon Name="check" Class="size-3" />
                                    <span>Verify</span>
                                </button>
                                <button type="submit" name="Action" value="@($"reject:{context.Id}")" class="btn-secondary text-rose-700! hover:bg-rose-50! py-1! px-2! text-[11px] font-bold rounded-lg shadow-2xs whitespace-nowrap inline-flex items-center gap-1 cursor-pointer">
                                    <Icon Name="close" Class="size-3" />
                                    <span>Not Received</span>
                                </button>
                            </div>
                        </div>
                    }
                </TemplateColumn>

                <PropertyColumn Property="@(o => o.Total)" Title="Total Amount" Format="N0" Sortable="false" Align="Align.End" Class="text-right font-bold text-slate-900 tabular-nums" ><HeaderTemplate><AdminSortHeader Label="Total Amount" SortKey="Total" /></HeaderTemplate></PropertyColumn>

                <TemplateColumn Title="Action" Align="Align.End">
                    <a href="/admin/orders/@context.Id" class="btn-secondary !px-2.5 !py-1 text-xs">
                        View &amp; Fulfill
                    </a>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="p-4 border-t border-slate-200/90 flex items-center justify-between">
            <AdminPagination Total="totalFiltered" Page="Page" Size="PageSize" />
        </div>
    </div>
</form>

@code
{
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "payment")]
    public string? PaymentFilter { get; set; }

    [SupplyParameterFromForm(FormName = "orders-quick-action")]
    public string? Action { get; set; }

    private IQueryable<Order>? ordersQuery;
    private const int PageSize = 20;
    private int totalFiltered;

    private int unconfirmedPaymentCount;
    private string? _toast;

    private string FilterUrl(string? status, string? payment)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(status)) parts.Add($"status={Uri.EscapeDataString(status)}");
        if (!string.IsNullOrWhiteSpace(payment)) parts.Add($"payment={Uri.EscapeDataString(payment)}");
        if (!string.IsNullOrWhiteSpace(Query)) parts.Add($"q={Uri.EscapeDataString(Query)}");
        return parts.Count > 0 ? $"/admin/orders?{string.Join("&", parts)}" : "/admin/orders";
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Action))
        {
            var colonIdx = Action.IndexOf(':');
            if (colonIdx > 0 && int.TryParse(Action[(colonIdx + 1)..], out var orderId))
            {
                var actionType = Action[..colonIdx];
                if (actionType == "verify")
                {
                    await Shop.VerifyPaymentAsync(orderId);
                    _toast = $"Payment verified for order #{orderId}.";
                }
                else if (actionType == "unverify")
                {
                    await Shop.UnverifyPaymentAsync(orderId);
                    _toast = $"Payment unverified for order #{orderId}.";
                }
                else if (actionType == "reject")
                {
                    await Shop.RejectPaymentAndCancelOrderAsync(orderId, "Payment not received");
                    _toast = $"Order #{orderId} cancelled and marked as payment not received.";
                }
                Action = null;
            }
        }

        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        unconfirmedPaymentCount = await Db.Orders.CountAsync(o => o.Status != OrderStatus.Cancelled && o.PaidAmount == 0 && !string.IsNullOrEmpty(o.TransactionId));

        var q = Db.Orders.AsNoTracking().Include(o => o.DeliveryAddress).AsQueryable();

        if (PaymentFilter == "unconfirmed" || Status == "unconfirmed_payment")
        {
            q = q.Where(o => o.Status != OrderStatus.Cancelled && o.PaidAmount == 0 && !string.IsNullOrEmpty(o.TransactionId));
        }
        else if (Enum.TryParse<OrderStatus>(Status, out var status))
        {
            q = q.Where(o => o.Status == status);
        }

        if (!string.IsNullOrWhiteSpace(Query))
        {
            var search = Query.Trim().ToLower();
            q = q.Where(o => o.Id.ToString() == search
                || (o.TransactionId != null && o.TransactionId.ToLower().Contains(search))
                || (o.DeliveryAddress != null && o.DeliveryAddress.CustomerName.ToLower().Contains(search))
                || (o.DeliveryAddress != null && o.DeliveryAddress.PhoneNumber.Contains(search)));
        }

        Page = Math.Max(1, Page);
        totalFiltered = await q.CountAsync();

        var list = await AdminSorting.Apply(q.OrderByDescending(o => o.CreatedAt)
            .ThenByDescending(o => o.Id), Nav, ("Id", o => o.Id), ("CreatedAt", o => o.CreatedAt), ("Status", o => o.Status), ("Total", o => o.Total))
            .Skip((Page - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();

        ordersQuery = list.AsQueryable();
    }
}
