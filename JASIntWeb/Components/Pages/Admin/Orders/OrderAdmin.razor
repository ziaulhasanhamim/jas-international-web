@page "/admin/orders/{Id:int}"
@rendermode InteractiveServer
@inject AppDbContext Db
@inject IServiceScopeFactory ScopeFactory
@inject AdminSession Session
@inject ShoppingService Shop
@inject NavigationManager Nav

<PageTitle>Order #@Id · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">ORDER DETAILS</p>
        <div class="flex items-center gap-3">
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Order #@Id</h1>
            @if (order is not null)
            {
                @switch (order.Status)
                {
                    case OrderStatus.Pending:
                        <span class="badge badge-amber text-xs">Pending Review</span>
                        break;
                    case OrderStatus.Processing:
                        <span class="badge badge-blue text-xs">Processing</span>
                        break;
                    case OrderStatus.InTransit:
                        <span class="badge badge-purple text-xs">In Delivery</span>
                        break;
                    case OrderStatus.Delivered:
                        <span class="badge badge-emerald text-xs">Delivered &amp; Collected</span>
                        break;
                    case OrderStatus.Cancelled:
                        <span class="badge badge-rose text-xs">Cancelled</span>
                        break;
                    default:
                        <span class="badge badge-slate text-xs">@order.Status</span>
                        break;
                }
            }
        </div>
        <p class="text-xs text-slate-500 mt-1">
            Placed on @(order?.CreatedAt.ToOffset(TimeSpan.FromHours(6)).ToString("dddd, dd MMMM yyyy · hh:mm tt") ?? "")
        </p>
    </div>

    <div class="flex items-center gap-2">
        <a href="/admin/orders" class="btn-secondary">
            <Icon Name="back" Class="size-4" />
            Back to Orders
        </a>
    </div>
</div>

@if (order is null)
{
    <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center">
        <Icon Name="alert" Class="size-10 text-slate-300 mx-auto mb-3" />
        <p class="text-slate-500">Order #@Id was not found.</p>
    </div>
}
else
{
    @if (error is not null)
    {
        <div class="error-panel" role="alert">
            <p class="font-medium">Action Failed</p>
            <p>@error</p>
        </div>
    }
    @if (alertMessage is not null)
    {
        <div class="rounded-xl border @(alertType == "rose" ? "border-rose-300 bg-rose-50 text-rose-900" : (alertType == "amber" ? "border-amber-300 bg-amber-50 text-amber-900" : "border-emerald-300 bg-emerald-50 text-emerald-900")) p-3.5 mb-5 text-xs font-semibold flex items-center justify-between shadow-2xs" role="alert">
            <div class="flex items-center gap-2">
                @if (alertType == "rose")
                {
                    <Icon Name="close" Class="size-4 text-rose-600" />
                }
                else if (alertType == "amber")
                {
                    <Icon Name="alert" Class="size-4 text-amber-600" />
                }
                else
                {
                    <Icon Name="check" Class="size-4 text-emerald-600" />
                }
                <span>@alertMessage</span>
            </div>
            <button type="button" @onclick="() => alertMessage = null" class="text-slate-400 hover:text-slate-600 font-bold ml-2">✕</button>
        </div>
    }

    <!-- Visual Order Progress Stepper -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-xs mb-6">
        <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-3">
            <span class="text-xs font-bold uppercase tracking-widest text-slate-500">Order Progress Timeline</span>
            @if (order.DeliveredAt.HasValue)
            {
                <span class="text-xs text-emerald-700 font-semibold">Delivered on @order.DeliveredAt.Value.ToOffset(TimeSpan.FromHours(6)).ToString("dd MMM yyyy, hh:mm tt")</span>
            }
            else if (order.Status == OrderStatus.Cancelled)
            {
                <span class="text-xs text-rose-600 font-bold">Cancelled &amp; Reserved Stock Released</span>
            }
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <!-- Step 1: Placed -->
            <div class="rounded-xl border p-3 @(order.Status != OrderStatus.Cancelled ? "border-emerald-200 bg-emerald-50/60 text-emerald-950" : "border-slate-200 bg-slate-50 text-slate-500")">
                <div class="flex items-center gap-2 mb-1">
                    <span class="flex size-5 items-center justify-center rounded-full bg-emerald-600 text-white text-[10px] font-bold">✓</span>
                    <span class="text-xs font-bold">1. Order Placed</span>
                </div>
                <p class="text-[11px] text-slate-500">@(order.CreatedAt.ToOffset(TimeSpan.FromHours(6)).ToString("dd MMM, hh:mm tt"))</p>
            </div>

            <!-- Step 2: Confirmed / Processing -->
            @{
                var isStep2Active = order.Status is OrderStatus.Processing or OrderStatus.InTransit or OrderStatus.Delivered;
            }
            <div class="rounded-xl border p-3 @(isStep2Active ? "border-emerald-200 bg-emerald-50/60 text-emerald-950" : (order.Status == OrderStatus.Cancelled ? "border-slate-200 bg-slate-50 text-slate-400" : "border-blue-200 bg-blue-50/60 text-blue-950"))">
                <div class="flex items-center gap-2 mb-1">
                    <span class="flex size-5 items-center justify-center rounded-full @(isStep2Active ? "bg-emerald-600 text-white" : "bg-slate-200 text-slate-700") text-[10px] font-bold">
                        @(isStep2Active ? "✓" : "2")
                    </span>
                    <span class="text-xs font-bold">2. Confirmed &amp; Packing</span>
                </div>
                <p class="text-[11px] text-slate-500">@(order.PaidAmount > 0 ? "Payment verified" : "Payment confirmation")</p>
            </div>

            <!-- Step 3: In Transit -->
            @{
                var isStep3Active = order.Status is OrderStatus.InTransit or OrderStatus.Delivered;
            }
            <div class="rounded-xl border p-3 @(isStep3Active ? "border-emerald-200 bg-emerald-50/60 text-emerald-950" : (order.Status == OrderStatus.Processing ? "border-blue-200 bg-blue-50/60 text-blue-950" : "border-slate-200 bg-slate-50 text-slate-400"))">
                <div class="flex items-center gap-2 mb-1">
                    <span class="flex size-5 items-center justify-center rounded-full @(isStep3Active ? "bg-emerald-600 text-white" : "bg-slate-200 text-slate-700") text-[10px] font-bold">
                        @(isStep3Active ? "✓" : "3")
                    </span>
                    <span class="text-xs font-bold">3. In Transit / Dispatched</span>
                </div>
                <p class="text-[11px] text-slate-500">@(string.IsNullOrEmpty(order.CourierName) ? "Pending dispatch" : order.CourierName)</p>
            </div>

            <!-- Step 4: Delivered -->
            @{
                var isStep4Active = order.Status == OrderStatus.Delivered;
            }
            <div class="rounded-xl border p-3 @(isStep4Active ? "border-emerald-300 bg-emerald-100 text-emerald-950 font-bold" : "border-slate-200 bg-slate-50 text-slate-400")">
                <div class="flex items-center gap-2 mb-1">
                    <span class="flex size-5 items-center justify-center rounded-full @(isStep4Active ? "bg-emerald-600 text-white" : "bg-slate-200 text-slate-700") text-[10px] font-bold">
                        @(isStep4Active ? "✓" : "4")
                    </span>
                    <span class="text-xs font-bold">4. Delivered</span>
                </div>
                <p class="text-[11px] text-slate-500">@(isStep4Active ? "Completed & collected" : "Pending delivery")</p>
            </div>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-3 mb-7">
        <!-- Customer & Delivery Card -->
        <div class="rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-xs">
            <div class="flex items-center gap-3 mb-4 text-slate-900 font-bold border-b border-slate-100 pb-3">
                <span class="flex size-8 items-center justify-center rounded-lg bg-blue-50 text-blue-700">
                    <Icon Name="map-pin" Class="size-4" />
                </span>
                <span>Delivery Information</span>
            </div>
            <div class="space-y-2 text-sm">
                <div>
                    <span class="text-xs text-slate-400 block">Customer Name</span>
                    <strong class="text-slate-900 text-base">@order.DeliveryAddress?.CustomerName</strong>
                </div>
                <div>
                    <span class="text-xs text-slate-400 block">Contact Phone</span>
                    <a href="tel:@order.DeliveryAddress?.PhoneNumber" class="text-blue-600 font-mono font-medium hover:underline">
                        @order.DeliveryAddress?.PhoneNumber
                    </a>
                </div>
                <div>
                    <span class="text-xs text-slate-400 block">Customer Email</span>
                    <p class="text-slate-700 text-xs">@(order.DeliveryAddress?.Email ?? order.User?.Email ?? "No email provided")</p>
                </div>
                <div>
                    <span class="text-xs text-slate-400 block">Street Address</span>
                    <p class="text-slate-700">@order.DeliveryAddress?.FullAddress</p>
                </div>
                <div>
                    <span class="text-xs text-slate-400 block">City &amp; District</span>
                    <p class="text-slate-700">@order.DeliveryAddress?.City, @order.DeliveryAddress?.District</p>
                </div>
                <div class="pt-3 border-t border-slate-100">
                    <span class="text-xs text-slate-400 block">Customer Type</span>
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-slate-600 mt-0.5">
                        <Icon Name="user" Class="size-3.5" />
                        @(order.UserId.HasValue ? "Registered Account Customer" : "Guest Customer")
                    </span>
                </div>
            </div>
        </div>

        <!-- Fulfillment & Status Controls -->
        <div class="lg:col-span-2 rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-xs flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-3">
                    <div class="flex items-center gap-3 text-slate-900 font-bold">
                        <span class="flex size-8 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700">
                            <Icon Name="receipt" Class="size-4" />
                        </span>
                        <span>Fulfillment Operations</span>
                    </div>
                    <span class="text-xs text-slate-400">Order Token: <code class="font-mono text-slate-600 font-bold">@order.PublicToken.ToString()[..8]...</code></span>
                </div>

                <!-- Payment Verification Panel -->
                <div class="rounded-xl border border-slate-200/90 bg-slate-50/70 p-4 text-xs space-y-3 mb-6">
                    <div class="flex items-center justify-between pb-2.5 border-b border-slate-200/70">
                        <div class="flex items-center gap-2">
                            <span class="flex size-6 items-center justify-center rounded-md bg-blue-50 text-blue-700">
                                <Icon Name="wallet" Class="size-3.5" />
                            </span>
                            <span class="font-bold text-slate-800 text-xs">Payment Verification</span>
                        </div>
                        <div>
                            @if (order.Status == OrderStatus.Cancelled)
                            {
                                <span class="badge badge-rose font-bold">Order Cancelled</span>
                            }
                            else if (order.PaidAmount > 0)
                            {
                                <span class="badge badge-emerald font-bold">
                                    <Icon Name="check" Class="size-3" />
                                    <span>Verified (৳@order.PaidAmount.ToString("N0"))</span>
                                </span>
                            }
                            else if (!string.IsNullOrEmpty(order.TransactionId))
                            {
                                <span class="badge badge-amber font-bold animate-pulse">
                                    Needs Confirmation
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-slate">Unpaid</span>
                            }
                        </div>
                    </div>

                    <!-- Payment Details Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 py-1">
                        <div>
                            <span class="text-[11px] text-slate-400 block mb-0.5">Claimed bKash TrxID</span>
                            @if (!string.IsNullOrEmpty(order.TransactionId))
                            {
                                <strong class="font-mono text-xs text-slate-900 bg-white px-2 py-0.5 rounded border border-slate-200 inline-block font-bold">
                                    @order.TransactionId
                                </strong>
                            }
                            else
                            {
                                <span class="font-mono text-slate-400 italic text-[11px]">None Submitted</span>
                            }
                        </div>

                        <div>
                            <span class="text-[11px] text-slate-400 block mb-0.5">Sender Phone</span>
                            @if (!string.IsNullOrEmpty(order.SenderPhoneNumber))
                            {
                                <a href="tel:@order.SenderPhoneNumber" class="font-mono text-xs text-blue-600 hover:underline font-semibold">
                                    @order.SenderPhoneNumber
                                </a>
                            }
                            else
                            {
                                <span class="text-slate-400">-</span>
                            }
                        </div>

                        <div>
                            <span class="text-[11px] text-slate-400 block mb-0.5">Payment Reference</span>
                            @if (!string.IsNullOrEmpty(order.PaymentReferenceCode))
                            {
                                <span class="font-mono text-xs text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded font-bold border border-blue-100">
                                    @order.PaymentReferenceCode
                                </span>
                            }
                            else
                            {
                                <span class="text-slate-400">-</span>
                            }
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="pt-2.5 border-t border-slate-200/70 flex flex-wrap items-center justify-between gap-3">
                        <div class="text-slate-500 text-xs">
                            Order Total: <strong class="text-slate-900 font-bold text-sm">৳@order.Total.ToString("N0")</strong>
                            @if (order.PaidAmount > 0)
                            {
                                <span class="ml-1 text-emerald-700 font-semibold">(Paid: ৳@order.PaidAmount.ToString("N0"))</span>
                            }
                        </div>

                        <div class="flex items-center gap-2">
                            @if (order.Status != OrderStatus.Cancelled && order.Status != OrderStatus.Delivered)
                            {
                                @if (order.PaidAmount == 0)
                                {
                                    <button type="button" @onclick="VerifyPayment" class="btn-primary !bg-emerald-600 hover:!bg-emerald-700 !text-white text-xs font-bold py-1.5 px-3 rounded-xl shadow-xs inline-flex items-center gap-1.5">
                                        <Icon Name="check" Class="size-3.5" />
                                        <span>Verify Payment</span>
                                    </button>

                                    <button type="button" @onclick="RejectPaymentAndCancel" class="btn-secondary !text-rose-700 !bg-white hover:!bg-rose-50 !border-rose-300 text-xs font-bold py-1.5 px-3 rounded-xl shadow-2xs inline-flex items-center gap-1.5">
                                        <Icon Name="close" Class="size-3" />
                                        <span>Payment Not Received (Cancel Order)</span>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" @onclick="UnverifyPayment" class="btn-secondary !text-slate-700 !bg-white hover:!bg-slate-100 !border-slate-300 text-xs font-medium py-1.5 px-3 rounded-xl">
                                        Mark as Unverified
                                    </button>

                                    <button type="button" @onclick="RejectPaymentAndCancel" class="btn-secondary !text-rose-700 !bg-white hover:!bg-rose-50 !border-rose-300 text-xs font-medium py-1.5 px-3 rounded-xl inline-flex items-center gap-1">
                                        <Icon Name="close" Class="size-3" />
                                        <span>Cancel Order</span>
                                    </button>
                                }
                            }
                            else if (order.Status == OrderStatus.Cancelled)
                            {
                                <span class="text-xs text-rose-600 font-semibold italic">Order is cancelled &amp; inventory released.</span>
                            }
                        </div>
                    </div>
                </div>

                @if (Input is null)
                {
                    <p class="text-xs text-slate-400">Loading form…</p>
                }
                else
                {
                    <EditForm Model="Input" OnValidSubmit="Save" class="space-y-4">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="grid gap-4 sm:grid-cols-2">
                            <div>
                                <label class="field-label font-bold text-slate-800">Order Status</label>
                                <InputSelect @bind-Value="Input.Status" class="field font-semibold text-slate-900" disabled="@(order.Status is OrderStatus.Delivered or OrderStatus.Cancelled)">
                                    @foreach (var status in AllowedStatuses().Distinct())
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </InputSelect>
                            </div>

                            <div>
                                <label class="field-label font-bold text-slate-800">Courier Service</label>
                                <InputSelect @bind-Value="Input.CourierName" class="field" disabled="@(order.Status is OrderStatus.Delivered or OrderStatus.Cancelled)">
                                    <option value="">Select courier provider...</option>
                                    <option value="Steadfast Courier">Steadfast Courier</option>
                                    <option value="Pathao Courier">Pathao Courier</option>
                                    <option value="RedX">RedX Delivery</option>
                                    <option value="Sundarban Courier">Sundarban Courier</option>
                                    <option value="Paperfly">Paperfly</option>
                                    <option value="Showroom Pickup">Showroom Pickup (Khulna)</option>
                                    <option value="Other">Other / Self-Delivery</option>
                                </InputSelect>
                            </div>
                        </div>

                        <div class="grid gap-4 sm:grid-cols-2">
                            <div>
                                <label class="field-label">Courier Consignment / Tracking Code</label>
                                <InputText @bind-Value="Input.CourierTrackingId" placeholder="e.g. STEADFAST-109281" class="field font-mono text-xs" disabled="@(order.Status is OrderStatus.Delivered or OrderStatus.Cancelled)" />
                            </div>

                            <div>
                                <label class="field-label">Courier Tracking URL</label>
                                <InputText @bind-Value="Input.CourierTrackingUrl" placeholder="https://steadfast.com.bd/t/..." class="field font-mono text-xs" disabled="@(order.Status is OrderStatus.Delivered or OrderStatus.Cancelled)" />
                            </div>
                        </div>

                        <div>
                            <label class="field-label">Internal Fulfillment &amp; Audit Notes</label>
                            <InputTextArea @bind-Value="Input.AdminNotes" placeholder="Add packaging notes, customer requests, or special handling instructions..." rows="2" class="field text-xs" />
                        </div>

                        <div class="pt-2">
                            <button type="submit" class="btn-primary w-full flex items-center justify-center gap-2" disabled="@(order.Status is OrderStatus.Delivered or OrderStatus.Cancelled)">
                                <Icon Name="check" Class="size-4" />
                                <span>Save Changes &amp; Update Order</span>
                            </button>
                        </div>
                    </EditForm>
                }

                <div class="mt-4 rounded-xl bg-slate-50 p-3 text-xs text-slate-500 space-y-1">
                    <p>• Setting status to <strong>Delivered</strong> collects Cash on Delivery, records sales revenue, and finalizes inventory reduction.</p>
                    <p>• Setting status to <strong>Cancelled</strong> releases all reserved stock back to active inventory.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Items Table -->
    <div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden mb-7">
        <div class="p-5 border-b border-slate-100 flex items-center justify-between">
            <h2 class="font-bold text-slate-900 text-base">Ordered Products</h2>
            <span class="text-xs text-slate-400 font-medium">@order.Items.Count line items</span>
        </div>
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Product Description</th>
                        <th>Variant Details</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-right">Unit Price</th>
                        <th class="text-right">Line Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in order.Items)
                    {
                        <tr>
                            <td class="font-semibold text-slate-900">
                                @i.ProductName
                            </td>
                            <td class="text-xs text-slate-500">
                                @i.VariantName
                            </td>
                            <td class="text-center font-medium text-slate-800">
                                @i.Quantity
                            </td>
                            <td class="text-right text-slate-700 tabular-nums">
                                ৳@i.UnitPrice.ToString("N0")
                            </td>
                            <td class="text-right font-bold text-slate-900 tabular-nums">
                                ৳@i.LineTotal.ToString("N0")
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-right font-semibold text-slate-600">Subtotal</td>
                        <td class="text-right font-bold text-slate-900 tabular-nums">
                            ৳@order.Items.Sum(i => i.LineTotal).ToString("N0")
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4" class="text-right text-xs text-slate-500">Delivery Fee (@(order.DeliveryCharge == 80 ? "Khulna City" : "Outside Khulna"))</td>
                        <td class="text-right font-medium text-slate-800 tabular-nums">
                            ৳@order.DeliveryCharge.ToString("N0")
                        </td>
                    </tr>
                    <tr class="text-base bg-slate-50/80">
                        <td colspan="4" class="text-right font-bold text-slate-900">Final Order Total</td>
                        <td class="text-right font-extrabold text-blue-700 tabular-nums text-lg">
                            ৳@order.Total.ToString("N0")
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@code
{
    [Parameter]
    public int Id { get; set; }
    private OrderEditForm? Input { get; set; }
    private Order? order;
    private string? error;
    private string? alertMessage;
    private string alertType = "emerald";

    protected override async Task OnInitializedAsync()
    {
        await ReloadOrderAsync();
    }

    private IEnumerable<OrderStatus> AllowedStatuses()
    {
        if (order is null) yield break;
        yield return order.Status;
        if (order.Status == OrderStatus.Pending)
        {
            yield return OrderStatus.Processing;
            yield return OrderStatus.InTransit;
        }
        else if (order.Status == OrderStatus.Processing)
        {
            yield return OrderStatus.InTransit;
            yield return OrderStatus.Delivered;
        }
        else if (order.Status == OrderStatus.InTransit)
        {
            yield return OrderStatus.Delivered;
        }

        if (order.Status is not (OrderStatus.Delivered or OrderStatus.Cancelled))
        {
            yield return OrderStatus.Cancelled;
        }
    }

    private async Task Save()
    {
        try
        {
            error = null;
            if (Input == null) return;
            Input.Id = Id;
            await Session.RunAsync(s => s.ChangeOrderAsync(Input));
            await ReloadOrderAsync();
            alertType = "emerald";
            alertMessage = $"Order #{Id} details and status ({order?.Status}) updated successfully!";
        }
        catch (ShopException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task VerifyPayment()
    {
        try
        {
            error = null;
            await Shop.VerifyPaymentAsync(Id);
            await ReloadOrderAsync();
            alertType = "emerald";
            alertMessage = "Payment verified successfully! Customer has been notified.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task UnverifyPayment()
    {
        try
        {
            error = null;
            await Shop.UnverifyPaymentAsync(Id);
            await ReloadOrderAsync();
            alertType = "amber";
            alertMessage = "Payment marked as unverified.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task RejectPaymentAndCancel()
    {
        try
        {
            error = null;
            await Shop.RejectPaymentAndCancelOrderAsync(Id, "Payment not received");
            await ReloadOrderAsync();
            alertType = "rose";
            alertMessage = "Payment marked as not received. Order has been cancelled and reserved inventory released.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task ReloadOrderAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var freshDb = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        order = await freshDb.Orders.AsNoTracking()
            .Include(o => o.DeliveryAddress)
            .Include(o => o.Items)
            .Include(o => o.Payments)
            .Include(o => o.User)
            .AsSplitQuery()
            .SingleOrDefaultAsync(o => o.Id == Id);

        if (order != null)
        {
            Input = new OrderEditForm
            {
                Id = order.Id,
                Status = order.Status.ToString(),
                CourierName = order.CourierName,
                CourierTrackingId = order.CourierTrackingId,
                CourierTrackingUrl = order.CourierTrackingUrl,
                AdminNotes = order.AdminNotes
            };
        }
    }
}
