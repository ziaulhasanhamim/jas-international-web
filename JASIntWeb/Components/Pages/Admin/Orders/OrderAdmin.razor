@page "/admin/orders/{Id:int}"
@inject AppDbContext Db
@inject AdminSession Session
@inject NavigationManager Nav

<PageTitle>Order #@Id · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">ORDER DETAILS</p>
        <div class="flex items-center gap-3">
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Order #@Id</h1>
            @if (order is not null)
            {
                @switch (order.Status)
                {
                    case OrderStatus.Pending:
                        <span class="badge badge-amber text-xs">Pending Review</span>
                        break;
                    case OrderStatus.Processing:
                        <span class="badge badge-blue text-xs">Processing</span>
                        break;
                    case OrderStatus.InTransit:
                        <span class="badge badge-purple text-xs">In Delivery</span>
                        break;
                    case OrderStatus.Delivered:
                        <span class="badge badge-emerald text-xs">Delivered &amp; Collected</span>
                        break;
                    case OrderStatus.Cancelled:
                        <span class="badge badge-rose text-xs">Cancelled</span>
                        break;
                    default:
                        <span class="badge badge-slate text-xs">@order.Status</span>
                        break;
                }
            }
        </div>
        <p class="text-xs text-slate-500 mt-1">
            Placed on @(order?.CreatedAt.ToOffset(TimeSpan.FromHours(6)).ToString("dddd, dd MMMM yyyy · hh:mm tt") ?? "")
        </p>
    </div>

    <div class="flex items-center gap-2">
        <a href="/admin/orders" class="btn-secondary">
            <Icon Name="back" Class="size-4" />
            Back to Orders
        </a>
    </div>
</div>

@if (order is null)
{
    <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center">
        <Icon Name="alert" Class="size-10 text-slate-300 mx-auto mb-3" />
        <p class="text-slate-500">Order #@Id was not found.</p>
    </div>
}
else
{
    @if (error is not null)
    {
        <div class="error-panel" role="alert">
            <p class="font-medium">Action Failed</p>
            <p>@error</p>
        </div>
    }

    <div class="grid gap-6 lg:grid-cols-3 mb-7">
        <!-- Customer & Delivery Card -->
        <div class="rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-xs">
            <div class="flex items-center gap-3 mb-4 text-slate-900 font-bold border-b border-slate-100 pb-3">
                <span class="flex size-8 items-center justify-center rounded-lg bg-blue-50 text-blue-700">
                    <Icon Name="map-pin" Class="size-4" />
                </span>
                <span>Delivery Information</span>
            </div>
            <div class="space-y-2 text-sm">
                <div>
                    <span class="text-xs text-slate-400 block">Customer Name</span>
                    <strong class="text-slate-900 text-base">@order.DeliveryAddress?.CustomerName</strong>
                </div>
                <div>
                    <span class="text-xs text-slate-400 block">Contact Phone</span>
                    <a href="tel:@order.DeliveryAddress?.PhoneNumber" class="text-blue-600 font-mono font-medium hover:underline">
                        @order.DeliveryAddress?.PhoneNumber
                    </a>
                </div>
                <div>
                    <span class="text-xs text-slate-400 block">Street Address</span>
                    <p class="text-slate-700">@order.DeliveryAddress?.FullAddress</p>
                </div>
                <div>
                    <span class="text-xs text-slate-400 block">City &amp; District</span>
                    <p class="text-slate-700">@order.DeliveryAddress?.City, @order.DeliveryAddress?.District</p>
                </div>
                <div class="pt-3 border-t border-slate-100">
                    <span class="text-xs text-slate-400 block">Customer Type</span>
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-slate-600 mt-0.5">
                        <Icon Name="user" Class="size-3.5" />
                        @(order.UserId.HasValue ? "Registered Account Customer" : "Guest Customer")
                    </span>
                </div>
            </div>
        </div>

        <!-- Fulfillment & Status Controls -->
        <div class="lg:col-span-2 rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-xs flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-3">
                    <div class="flex items-center gap-3 text-slate-900 font-bold">
                        <span class="flex size-8 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700">
                            <Icon Name="receipt" Class="size-4" />
                        </span>
                        <span>Fulfillment Operations</span>
                    </div>
                    <span class="text-xs text-slate-400">Order Token: <code class="font-mono text-slate-600 font-bold">@order.PublicToken.ToString()[..8]...</code></span>
                </div>

                @if (Input is null)
                {
                    <p class="text-xs text-slate-400">Loading form…</p>
                }
                else
                {
                    <EditForm Model="Input" OnValidSubmit="Save" FormName="order-status" method="post" Enhance data-submit-indication="true" class="space-y-4">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="grid gap-4 sm:grid-cols-2 items-end">
                            <div>
                                <label class="field-label">Update Order Status</label>
                                <InputSelect @bind-Value="Input!.Status" class="field">
                                    @foreach (var status in AllowedStatuses())
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </InputSelect>
                            </div>
                            <div>
                                <button type="submit" class="btn-primary w-full" data-pending-text="Saving status..." disabled="@(order.Status is OrderStatus.Delivered or OrderStatus.Cancelled)">
                                    <span class="form-submit-spinner" hidden></span>
                                    <span>Save Status</span>
                                </button>
                            </div>
                        </div>
                    </EditForm>
                }

                <div class="mt-4 rounded-xl bg-slate-50 p-3 text-xs text-slate-500 space-y-1">
                    <p>• Setting status to <strong>Delivered</strong> collects Cash on Delivery, records sales revenue, and finalizes inventory reduction.</p>
                    <p>• Setting status to <strong>Cancelled</strong> releases all reserved stock back to active inventory.</p>
                </div>
            </div>

            <!-- Payment details summary -->
            <div class="mt-6 pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-600">
                <div class="flex items-center gap-2">
                    <Icon Name="cash" Class="size-4 text-slate-400" />
                    <span>Payment Method: <strong>Cash on Delivery (COD)</strong></span>
                </div>
                <div>
                    @foreach (var p in order.Payments)
                    {
                        <span class="badge @(p.Status == PaymentStatus.Completed ? "badge-emerald" : "badge-amber")">
                            @p.Method: @p.Status (৳@p.Amount.ToString("N0"))
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Order Items Table -->
    <div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden mb-7">
        <div class="p-5 border-b border-slate-100 flex items-center justify-between">
            <h2 class="font-bold text-slate-900 text-base">Ordered Products</h2>
            <span class="text-xs text-slate-400 font-medium">@order.Items.Count line items</span>
        </div>
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Product Description</th>
                        <th>Variant Details</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-right">Unit Price</th>
                        <th class="text-right">Line Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in order.Items)
                    {
                        <tr>
                            <td class="font-semibold text-slate-900">
                                @i.ProductName
                            </td>
                            <td class="text-xs text-slate-500">
                                @i.VariantName
                            </td>
                            <td class="text-center font-medium text-slate-800">
                                @i.Quantity
                            </td>
                            <td class="text-right text-slate-700 tabular-nums">
                                ৳@i.UnitPrice.ToString("N0")
                            </td>
                            <td class="text-right font-bold text-slate-900 tabular-nums">
                                ৳@i.LineTotal.ToString("N0")
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-right font-semibold text-slate-600">Subtotal</td>
                        <td class="text-right font-bold text-slate-900 tabular-nums">
                            ৳@order.Items.Sum(i => i.LineTotal).ToString("N0")
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4" class="text-right text-xs text-slate-500">Delivery Fee (@(order.DeliveryCharge == 80 ? "Khulna City" : "Outside Khulna"))</td>
                        <td class="text-right font-medium text-slate-800 tabular-nums">
                            ৳@order.DeliveryCharge.ToString("N0")
                        </td>
                    </tr>
                    <tr class="text-base bg-slate-50/80">
                        <td colspan="4" class="text-right font-bold text-slate-900">Final Order Total</td>
                        <td class="text-right font-extrabold text-blue-700 tabular-nums text-lg">
                            ৳@order.Total.ToString("N0")
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@code
{
    [Parameter]
    public int Id { get; set; }
    [SupplyParameterFromForm(FormName = "order-status")]
    private OrderEditForm? Input { get; set; }
    private Order? order;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        order = await Db.Orders.AsNoTracking()
            .Include(o => o.DeliveryAddress)
            .Include(o => o.Items)
            .Include(o => o.Payments)
            .AsSplitQuery()
            .SingleOrDefaultAsync(o => o.Id == Id);
        Input ??= new()
        {
            Id = Id,
            Status = order?.Status.ToString() ?? "Pending"
        };
    }

    private IEnumerable<OrderStatus> AllowedStatuses()
    {
        if (order is null)
        {
            yield break;
        }
        yield return order.Status;
        if (order.Status == OrderStatus.Pending)
        {
            yield return OrderStatus.Processing;
        }
        if (order.Status == OrderStatus.Processing)
        {
            yield return OrderStatus.InTransit;
        }
        if (order.Status == OrderStatus.InTransit)
        {
            yield return OrderStatus.Delivered;
        }
        if (order.Status is OrderStatus.Pending or OrderStatus.Processing or OrderStatus.InTransit)
        {
            yield return OrderStatus.Cancelled;
        }
    }

    private async Task Save()
    {
        try
        {
            Input!.Id = Id;
            await Session.RunAsync(s => s.ChangeOrderAsync(Input));
            Nav.NavigateTo($"/admin/orders/{Id}?saved=true");
        }
        catch (ShopException ex)
        {
            error = ex.Message;
        }
    }
}
