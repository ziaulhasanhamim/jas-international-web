@page "/admin/orders/{Id:int}"
@inject AppDbContext Db
@inject AdminSession Session
@inject NavigationManager Nav

<AdminPageHeader
    Title="@($"Order #{Id}")"
    Description="Review delivery details and update fulfillment."
    ActionHref="/admin/orders"
    ActionText="Back to orders"
/>
@if (order is null)
{
    <p class="admin-empty">Order not found.</p>
}
else
{
    @if (error is not null)
    {
        <p role="alert" class="form-error">@error</p>
    }
    <div class="admin-form-grid">
        <section class="shop-panel">
            <h2 class="admin-section-title">Delivery</h2>
            <p>
                <strong>@order.DeliveryAddress?.CustomerName</strong>
            </p>
            <p>@order.DeliveryAddress?.PhoneNumber</p>
            <p>@order.DeliveryAddress?.FullAddress</p>
            <p>@order.DeliveryAddress?.City, @order.DeliveryAddress?.District</p>
            <p class="admin-help mt-4">@(order.UserId.HasValue ? "Account customer" : "Guest customer")</p>
        </section>
        <section class="shop-panel">
            <h2 class="admin-section-title">Fulfillment</h2>
            @if (Input is null)
            {
                <p class="admin-help">Loading form…</p>
            }
            else
            {
                <EditForm Model="Input" OnValidSubmit="Save" FormName="order-status" method="post" Enhance>
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <label class="shop-label">
                        Status
                        <InputSelect @bind-Value="Input!.Status" class="shop-input">
                            @foreach (var status in AllowedStatuses())
                            {
                                <option value="@status">@status</option>
                            }
                        </InputSelect>
                    </label>
                    <button
                        type="submit"
                        class="shop-button"
                        disabled="@(order.Status is OrderStatus.Delivered or OrderStatus.Cancelled)"
                    >
                        Update order
                    </button>
                </EditForm>
            }
            <p class="admin-help mt-4">Delivering records the sale and collects COD payment. Cancelling releases reserved stock.</p>
            @foreach (var p in order.Payments)
            {
                <p class="mt-3 text-sm">@p.Method · @p.Status · ৳@p.Amount.ToString("N0")</p>
            }
        </section>
    </div>
    <section class="shop-panel admin-table-wrap mt-6">
        <h2 class="admin-section-title">Order items</h2>
        <table class="shop-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Variant</th>
                    <th>Quantity</th>
                    <th>Unit price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in order.Items)
                {
                    <tr>
                        <td>@i.ProductName</td>
                        <td>@i.VariantName</td>
                        <td>@i.Quantity</td>
                        <td>৳@i.UnitPrice.ToString("N0")</td>
                        <td>৳@i.LineTotal.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="order-totals">
            <p>
                Delivery
                <strong>৳@order.DeliveryCharge.ToString("N0")</strong>
            </p>
            <p>
                Total
                <strong>৳@order.Total.ToString("N0")</strong>
            </p>
        </div>
    </section>
}

@code
{
    [Parameter]
    public int Id { get; set; }
    [SupplyParameterFromForm(FormName = "order-status")]
    private OrderEditForm? Input { get; set; }
    private Order? order;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        order = await Db.Orders.AsNoTracking()
            .Include(o => o.DeliveryAddress)
            .Include(o => o.Items)
            .Include(o => o.Payments)
            .AsSplitQuery()
            .SingleOrDefaultAsync(o => o.Id == Id);
        Input ??= new()
        {
            Id = Id,
            Status = order?.Status.ToString() ?? "Pending"
        };
    }

    private IEnumerable<OrderStatus> AllowedStatuses()
    {
        if (order is null)
        {
            yield break;
        }
        yield return order.Status;
        if (order.Status == OrderStatus.Pending)
        {
            yield return OrderStatus.Processing;
        }
        if (order.Status == OrderStatus.Processing)
        {
            yield return OrderStatus.InTransit;
        }
        if (order.Status == OrderStatus.InTransit)
        {
            yield return OrderStatus.Delivered;
        }
        if (order.Status is OrderStatus.Pending or OrderStatus.Processing or OrderStatus.InTransit)
        {
            yield return OrderStatus.Cancelled;
        }
    }

    private async Task Save()
    {
        try
        {
            Input!.Id = Id;
            await Session.RunAsync(s => s.ChangeOrderAsync(Input));
            Nav.NavigateTo($"/admin/orders/{Id}?saved=true");
        }
        catch (ShopException ex)
        {
            error = ex.Message;
        }
    }
}
