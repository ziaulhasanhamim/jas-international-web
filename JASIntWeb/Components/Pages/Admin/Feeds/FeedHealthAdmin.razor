@page "/admin/feeds"
@attribute [StreamRendering]
@layout AdminLayout
@using JASIntWeb.Persistence
@using JASIntWeb.Persistence.Entities
@using JASIntWeb.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject DeliverySettingsService SettingsService
@inject NavigationManager Nav

<PageTitle>Catalog Feeds &amp; Sync Health — JAS Admin</PageTitle>

<AdminPageHeader Title="Catalog Feeds &amp; Sync Health"
                 Description="Live XML/CSV product catalog feeds for Meta Advantage+ Dynamic Ads and Google Merchant Center."
                 ActionHref="/admin"
                 ActionText="Back to dashboard" />

<div class="shop-container py-6 space-y-6">
    <!-- Live Feed Endpoints -->
    <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-2xs space-y-5">
        <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Live Catalog Feeds</h2>
        <p class="text-xs text-slate-500">
            Submit these URLs directly in Meta Commerce Manager (Data Sources &gt; Data Feeds) and Google Merchant Center (Feeds).
            Updates reflect immediately upon re-fetch.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Meta XML -->
            <div class="rounded-xl border border-slate-200/80 bg-slate-50/50 p-4 space-y-3">
                <div class="flex items-center justify-between">
                    <span class="rounded bg-blue-100 px-2 py-0.5 text-3xs font-bold text-blue-700 uppercase">Meta XML (RSS 2.0)</span>
                    <a href="@GetFeedUrl("/feeds/meta.xml")" target="_blank" class="text-xs font-semibold text-blue-600 hover:underline">View XML ↗</a>
                </div>
                <p class="text-2xs text-slate-600">Primary feed for Meta Ads, Instagram Shops &amp; Dynamic Retargeting.</p>
                <div class="rounded-lg bg-white border border-slate-200 p-2 font-mono text-3xs text-slate-800 break-all select-all">
                    @GetFeedUrl("/feeds/meta.xml")
                </div>
            </div>

            <!-- Meta CSV -->
            <div class="rounded-xl border border-slate-200/80 bg-slate-50/50 p-4 space-y-3">
                <div class="flex items-center justify-between">
                    <span class="rounded bg-emerald-100 px-2 py-0.5 text-3xs font-bold text-emerald-700 uppercase">Meta CSV</span>
                    <a href="@GetFeedUrl("/feeds/meta.csv")" target="_blank" class="text-xs font-semibold text-blue-600 hover:underline">Download CSV ↗</a>
                </div>
                <p class="text-2xs text-slate-600">CSV alternative for Meta catalog batch import or spreadsheet audit.</p>
                <div class="rounded-lg bg-white border border-slate-200 p-2 font-mono text-3xs text-slate-800 break-all select-all">
                    @GetFeedUrl("/feeds/meta.csv")
                </div>
            </div>

            <!-- Google Merchant -->
            <div class="rounded-xl border border-slate-200/80 bg-slate-50/50 p-4 space-y-3">
                <div class="flex items-center justify-between">
                    <span class="rounded bg-purple-100 px-2 py-0.5 text-3xs font-bold text-purple-700 uppercase">Google Shopping XML</span>
                    <a href="@GetFeedUrl("/feeds/google.xml")" target="_blank" class="text-xs font-semibold text-blue-600 hover:underline">View XML ↗</a>
                </div>
                <p class="text-2xs text-slate-600">Includes Bangladesh shipping rules (৳80 Khulna / ৳130 outside).</p>
                <div class="rounded-lg bg-white border border-slate-200 p-2 font-mono text-3xs text-slate-800 break-all select-all">
                    @GetFeedUrl("/feeds/google.xml")
                </div>
            </div>
        </div>
    </div>

    <!-- Feed Health Diagnostics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-2xs">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Catalog Variants</p>
            <p class="mt-2 text-2xl font-bold text-slate-900">@activeVariantsCount</p>
            <p class="mt-1 text-2xs text-slate-400">across @activeProductsCount active products</p>
        </div>

        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-2xs">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">In-Stock Rate</p>
            <p class="mt-2 text-2xl font-bold text-emerald-600">@inStockCount</p>
            <p class="mt-1 text-2xs text-emerald-700 font-semibold">
                @(activeVariantsCount > 0 ? $"{(decimal)inStockCount / activeVariantsCount * 100:F0}% available for ads" : "0%")
            </p>
        </div>

        <div class="rounded-2xl border @(missingImagesCount == 0 ? "border-slate-200/80 bg-white" : "border-amber-200 bg-amber-50/40") p-5 shadow-2xs">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Missing Images</p>
            <p class="mt-2 text-2xl font-bold @(missingImagesCount == 0 ? "text-slate-900" : "text-amber-700")">@missingImagesCount</p>
            <p class="mt-1 text-2xs text-slate-400">Meta requires high-res image URLs</p>
        </div>

        <div class="rounded-2xl border @(missingBarcodesCount == 0 ? "border-slate-200/80 bg-white" : "border-slate-200/80 bg-white") p-5 shadow-2xs">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Missing GTIN / Barcode</p>
            <p class="mt-2 text-2xl font-bold text-slate-900">@missingBarcodesCount</p>
            <p class="mt-1 text-2xs text-slate-400">Optional for custom accessories</p>
        </div>
    </div>

    <!-- Feed Security & Token Management -->
    <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-2xs space-y-4">
        <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Feed Access Security</h2>
        <p class="text-xs text-slate-500 leading-relaxed">
            By default, product feeds are publicly accessible so crawler bots can index catalog items.
            If you wish to restrict feed access exclusively to Meta and Google, set a private security token below.
        </p>

        <form method="post" action="/admin/settings/delivery" class="flex flex-wrap items-center gap-3">
            <input type="text" name="CatalogFeedToken" value="@feedToken" placeholder="Optional token (e.g. jas_feed_secret_2026)" class="w-80 rounded-xl border border-slate-300 px-3.5 py-2 text-xs font-mono text-slate-900 shadow-2xs focus:border-blue-500 focus:outline-none" />
            <a href="/admin/settings/delivery" class="btn-primary !px-4 !py-2 text-xs font-semibold">Manage Settings</a>
        </form>
    </div>
</div>

@code {
    private int activeProductsCount;
    private int activeVariantsCount;
    private int inStockCount;
    private int missingImagesCount;
    private int missingBarcodesCount;
    private string? feedToken;

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetSettingsAsync();
        feedToken = settings.CatalogFeedToken;

        var prods = await Db.Products.AsNoTracking()
            .Include(p => p.ProductVariants)
            .Where(p => !p.IsDeleted)
            .ToListAsync();

        activeProductsCount = prods.Count;
        var variants = prods.SelectMany(p => p.ProductVariants).Where(v => v.IsActive && !v.IsDeleted).ToList();
        activeVariantsCount = variants.Count;

        var inventory = await Db.InventoryItems.AsNoTracking().ToDictionaryAsync(i => i.ProductVariantId, i => i.AvailableQuantity);
        inStockCount = variants.Count(v => inventory.TryGetValue(v.Id, out var qty) && qty > 0);

        missingImagesCount = prods.Count(p => string.IsNullOrWhiteSpace(p.MainImageUrl) || p.MainImageUrl.Contains("placehold.co"));
        missingBarcodesCount = variants.Count(v => string.IsNullOrWhiteSpace(v.Barcode));
    }

    private string GetFeedUrl(string relativePath)
    {
        var baseUrl = "https://www.jasinternational.com.bd";
        if (!string.IsNullOrWhiteSpace(feedToken))
        {
            return $"{baseUrl}{relativePath}?token={Uri.EscapeDataString(feedToken)}";
        }
        return $"{baseUrl}{relativePath}";
    }
}
