@page "/admin/coupons/new"
@page "/admin/coupons/{Id:int}/edit"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>@(Id == 0 ? "Create Coupon" : "Edit Coupon") · JAS Admin</PageTitle>

<AdminPageHeader
    Title="@(Id == 0 ? "Create Coupon" : "Edit Coupon")"
    Description="Set coupon code, promo title, discount percentage, flat amount or free delivery, minimum order spend, targeting rules, and expiration."
    ActionHref="/admin/coupons"
    ActionText="Back to coupons"
/>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="mb-5 rounded-2xl border border-rose-200 bg-rose-50 p-4 text-xs font-semibold text-rose-800 flex items-center justify-between">
        <span class="flex items-center gap-2">
            <span class="text-base">⚠️</span>
            @errorMessage
        </span>
        <button type="button" @onclick="() => errorMessage = null" class="text-rose-600 hover:text-rose-950 font-bold cursor-pointer">✕</button>
    </div>
}

@if (loading || Input is null)
{
    <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center shadow-xs">
        <p class="text-sm font-semibold text-slate-500">Loading coupon editor…</p>
    </div>
}
else
{
    <EditForm Model="Input" OnValidSubmit="Save" class="shop-panel admin-form space-y-6">
        <DataAnnotationsValidator />
        <ValidationSummary class="rounded-xl bg-rose-50 border border-rose-200 p-3 text-xs text-rose-700 space-y-1 mb-4" />

        <!-- Section 1: Code & Name -->
        <div class="admin-form-grid">
            <label class="shop-label">
                Coupon Code <span class="admin-required">Required</span>
                <InputText @bind-Value="Input.Code" class="shop-input uppercase font-mono tracking-wider font-bold" placeholder="e.g. WELCOME200 or EIDFREE" />
                <small>Unique promo code entered by customers in checkout.</small>
            </label>

            <label class="shop-label">
                Coupon Name / Campaign Label
                <InputText @bind-Value="Input.Description" class="shop-input" placeholder="e.g. Eid 2026 Free Shipping / New Customer Discount" />
                <small>Internal or customer-facing description of this promotion.</small>
            </label>
        </div>

        <!-- Section 2: Discount Type -->
        <div class="p-4 bg-slate-50 border border-slate-200 rounded-2xl space-y-4">
            <label class="shop-label">
                Discount Benefit Type <span class="admin-required">Required</span>
                <InputSelect @bind-Value="Input.DiscountType" @bind-Value:after="OnDiscountTypeChanged" class="shop-input font-medium cursor-pointer">
                    <option value="@CouponDiscountType.Percentage">Percentage Off (%)</option>
                    <option value="@CouponDiscountType.FixedAmount">Fixed Amount Off (৳ Flat)</option>
                    <option value="@CouponDiscountType.FreeDelivery">🚚 Free Delivery (Waives full delivery fee)</option>
                </InputSelect>
                <small>Choose whether this coupon deducts a percentage, a fixed BDT amount, or grants 100% free delivery nationwide.</small>
            </label>

            @if (Input.DiscountType == CouponDiscountType.FreeDelivery)
            {
                <div class="p-3.5 bg-emerald-50 border border-emerald-200 rounded-xl text-xs text-emerald-800 flex items-start gap-2.5 animate-fadeIn">
                    <span class="text-base leading-none">🚚</span>
                    <div>
                        <strong class="block font-bold text-emerald-900">Free Delivery Mode Active</strong>
                        <span>This coupon automatically waives the customer's delivery charge (inside Khulna or nationwide) at checkout. No discount value input is needed.</span>
                    </div>
                </div>
            }
            else
            {
                <div class="admin-form-grid">
                    <label class="shop-label">
                        Discount Value (@(Input.DiscountType == CouponDiscountType.Percentage ? "%" : "৳"))
                        <InputNumber @bind-Value="Input.DiscountValue" class="shop-input" />
                        <small>@(Input.DiscountType == CouponDiscountType.Percentage ? "Percentage rate to deduct (e.g. 10 for 10% off)." : "Flat amount in BDT to deduct (e.g. 200 for ৳200 off).")</small>
                    </label>

                    @if (Input.DiscountType == CouponDiscountType.Percentage)
                    {
                        <label class="shop-label animate-fadeIn">
                            Maximum Discount Cap (৳, optional)
                            <InputNumber @bind-Value="Input.MaxDiscountAmount" class="shop-input" />
                            <small>Upper limit cap for percentage discounts (e.g. 15% off up to ৳500).</small>
                        </label>
                    }
                </div>
            }
        </div>

        <!-- Section 3: Usage Constraints & Expiration -->
        <div class="admin-form-grid">
            <label class="shop-label">
                Minimum Order Spend (৳, optional)
                <InputNumber @bind-Value="Input.MinOrderAmount" class="shop-input" />
                <small>Minimum cart subtotal required to apply this coupon.</small>
            </label>

            <label class="shop-label">
                Total Usage Limit (optional)
                <InputNumber @bind-Value="Input.UsageLimit" class="shop-input" />
                <small>Maximum times this coupon can be redeemed across all shoppers.</small>
            </label>
        </div>

        <div class="admin-form-grid">
            <label class="shop-label">
                Expiration Date (optional)
                <InputDate Type="InputDateType.Date" @bind-Value="Input.ExpiryDate" class="shop-input" />
                <small>Leave empty if this coupon should never expire.</small>
            </label>

            <div class="flex items-center pt-6">
                <label class="check-label flex items-center gap-2.5 cursor-pointer select-none">
                    <InputCheckbox @bind-Value="Input.IsActive" class="size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" />
                    <span class="font-bold text-slate-800 text-sm">Coupon is Active</span>
                </label>
            </div>
        </div>

        <!-- Section 4: Targeting Rules (Include / Exclude) -->
        <div class="p-5 bg-slate-50/80 border border-slate-200 rounded-2xl space-y-5">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h3 class="font-display text-base font-bold text-slate-900 flex items-center gap-2">
                        <span>🎯</span> Product Targeting Rules (Include &amp; Exclude)
                    </h3>
                    <p class="text-xs text-slate-500 mt-1">
                        Optionally restrict this coupon to specific categories, brands, or product tags. Exclusions always override inclusions.
                        If no rules are set, the coupon applies to all products in the catalog.
                    </p>
                </div>
                <div class="text-right">
                    @if (HasTargetingRules)
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900 border border-amber-300">
                            <span>⚡ Targeted Rules Active</span>
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-200 text-slate-700">
                            <span>🌐 All Products Allowed</span>
                        </span>
                    }
                </div>
            </div>

            <!-- Inclusions Block -->
            <div class="p-4 bg-emerald-50/50 border border-emerald-200/80 rounded-xl space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 flex items-center gap-1.5">
                        <span class="size-2 rounded-full bg-emerald-500"></span>
                        Include List (Coupon only valid for these)
                    </span>
                    <span class="text-[11px] text-emerald-700 font-medium">Leave empty to include all eligible items</span>
                </div>

                <!-- Category Inclusions -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 mb-1.5">Categories</label>
                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var c in categories)
                        {
                            var active = Input.IncludedCategoryIds.Contains(c.Id);
                            <button type="button" @onclick="() => ToggleIncludeCategory(c.Id)"
                                    class="text-xs px-2.5 py-1 rounded-lg border font-medium transition cursor-pointer @(active ? "bg-emerald-600 text-white border-emerald-700 shadow-xs" : "bg-white text-slate-700 border-slate-200 hover:bg-slate-100")">
                                @(active ? "✓ " : "+ ")@c.Name
                            </button>
                        }
                    </div>
                </div>

                <!-- Brand Inclusions -->
                @if (brands.Count > 0)
                {
                    <div class="pt-2">
                        <label class="block text-[11px] font-bold text-slate-700 mb-1.5">Brands</label>
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var b in brands)
                            {
                                var active = Input.IncludedBrandIds.Contains(b.Id);
                                <button type="button" @onclick="() => ToggleIncludeBrand(b.Id)"
                                        class="text-xs px-2.5 py-1 rounded-lg border font-medium transition cursor-pointer @(active ? "bg-emerald-600 text-white border-emerald-700 shadow-xs" : "bg-white text-slate-700 border-slate-200 hover:bg-slate-100")">
                                    @(active ? "✓ " : "+ ")@b.Name
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Tag Inclusions -->
                <div class="pt-2">
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-[11px] font-bold text-slate-700">Product Tags (Campaigns &amp; Grouping)</label>
                        <a href="/admin/tags" target="_blank" class="text-[11px] font-semibold text-blue-600 hover:underline">Manage Tags ↗</a>
                    </div>
                    @if (tags.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var t in tags)
                            {
                                var active = Input.IncludedTagIds.Contains(t.Id);
                                <button type="button" @onclick="() => ToggleIncludeTag(t.Id)"
                                        class="text-xs px-2.5 py-1 rounded-lg border font-medium transition cursor-pointer @(active ? "bg-emerald-600 text-white border-emerald-700 shadow-xs" : "bg-white text-slate-700 border-slate-200 hover:bg-slate-100")">
                                    @(active ? "✓ " : "+ ")@t.Name
                                    @if (t.IsHidden)
                                    {
                                        <span class="text-[9px] px-1 rounded bg-amber-100 text-amber-900 ml-1">Admin</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-xs text-slate-400 italic bg-white/70 p-2.5 rounded-lg border border-slate-200">
                            No product tags created yet. <a href="/admin/tags" target="_blank" class="text-blue-600 font-semibold underline">Create tags in Catalog &gt; Product Tags</a> (e.g. Summer Sale, Clearance, Flash Deal) to target coupons by tag.
                        </p>
                    }
                </div>
            </div>

            <!-- Exclusions Block -->
            <div class="p-4 bg-rose-50/50 border border-rose-200/80 rounded-xl space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-rose-800 flex items-center gap-1.5">
                        <span class="size-2 rounded-full bg-rose-500"></span>
                        Exclude List (Never apply to these items)
                    </span>
                    <span class="text-[11px] text-rose-700 font-medium">Exclusions override inclusions</span>
                </div>

                <!-- Category Exclusions -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 mb-1.5">Categories</label>
                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var c in categories)
                        {
                            var active = Input.ExcludedCategoryIds.Contains(c.Id);
                            <button type="button" @onclick="() => ToggleExcludeCategory(c.Id)"
                                    class="text-xs px-2.5 py-1 rounded-lg border font-medium transition cursor-pointer @(active ? "bg-rose-600 text-white border-rose-700 shadow-xs" : "bg-white text-slate-700 border-slate-200 hover:bg-slate-100")">
                                @(active ? "✕ " : "+ ")@c.Name
                            </button>
                        }
                    </div>
                </div>

                <!-- Brand Exclusions -->
                @if (brands.Count > 0)
                {
                    <div class="pt-2">
                        <label class="block text-[11px] font-bold text-slate-700 mb-1.5">Brands</label>
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var b in brands)
                            {
                                var active = Input.ExcludedBrandIds.Contains(b.Id);
                                <button type="button" @onclick="() => ToggleExcludeBrand(b.Id)"
                                        class="text-xs px-2.5 py-1 rounded-lg border font-medium transition cursor-pointer @(active ? "bg-rose-600 text-white border-rose-700 shadow-xs" : "bg-white text-slate-700 border-slate-200 hover:bg-slate-100")">
                                    @(active ? "✕ " : "+ ")@b.Name
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Tag Exclusions -->
                <div class="pt-2">
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-[11px] font-bold text-slate-700">Product Tags</label>
                        <a href="/admin/tags" target="_blank" class="text-[11px] font-semibold text-rose-600 hover:underline">Manage Tags ↗</a>
                    </div>
                    @if (tags.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var t in tags)
                            {
                                var active = Input.ExcludedTagIds.Contains(t.Id);
                                <button type="button" @onclick="() => ToggleExcludeTag(t.Id)"
                                        class="text-xs px-2.5 py-1 rounded-lg border font-medium transition cursor-pointer @(active ? "bg-rose-600 text-white border-rose-700 shadow-xs" : "bg-white text-slate-700 border-slate-200 hover:bg-slate-100")">
                                    @(active ? "✕ " : "+ ")@t.Name
                                    @if (t.IsHidden)
                                    {
                                        <span class="text-[9px] px-1 rounded bg-amber-100 text-amber-900 ml-1">Admin</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-xs text-slate-400 italic bg-white/70 p-2.5 rounded-lg border border-slate-200">
                            No product tags created yet.
                        </p>
                    }
                </div>
            </div>
        </div>

        <div class="form-actions pt-2 border-t border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <button type="submit" disabled="@saving" class="shop-button flex items-center gap-2">
                    @if (saving)
                    {
                        <span class="inline-block animate-spin">⏳</span>
                        <span>Saving coupon…</span>
                    }
                    else
                    {
                        <span>@(Id == 0 ? "Create Coupon" : "Save Changes")</span>
                    }
                </button>
                <a href="/admin/coupons" class="shop-button-secondary">Cancel</a>
            </div>

            @if (Id > 0)
            {
                <span class="text-xs text-slate-400">Coupon ID: #@Id</span>
            }
        </div>
    </EditForm>
}

@code
{
    [Parameter]
    public int Id { get; set; }

    [PersistentState]
    public CouponFormModel? Input { get; set; }

    private string? errorMessage;
    private bool loading = true;
    private bool saving;

    private List<CategoryItem> categories = [];
    private List<BrandItem> brands = [];
    private List<TagItem> tags = [];

    public sealed record CategoryItem(int Id, string Name);
    public sealed record BrandItem(int Id, string Name);
    public sealed record TagItem(int Id, string Name, bool IsHidden, string? BadgeColor);

    private bool HasTargetingRules => Input is not null && (
        Input.IncludedCategoryIds.Count > 0 ||
        Input.ExcludedCategoryIds.Count > 0 ||
        Input.IncludedBrandIds.Count > 0 ||
        Input.ExcludedBrandIds.Count > 0 ||
        Input.IncludedTagIds.Count > 0 ||
        Input.ExcludedTagIds.Count > 0);

    public class CouponFormModel
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "Coupon Code is required.")]
        [StringLength(50, MinimumLength = 2, ErrorMessage = "Coupon Code must be between 2 and 50 characters.")]
        public string Code { get; set; } = "";

        [StringLength(200, ErrorMessage = "Coupon Name / Description cannot exceed 200 characters.")]
        public string? Description { get; set; }

        public CouponDiscountType DiscountType { get; set; } = CouponDiscountType.Percentage;

        public decimal DiscountValue { get; set; } = 10;

        public decimal? MaxDiscountAmount { get; set; }

        public decimal? MinOrderAmount { get; set; }

        public DateTime? ExpiryDate { get; set; }

        public int? UsageLimit { get; set; }

        public bool IsActive { get; set; } = true;

        public List<int> IncludedCategoryIds { get; set; } = [];
        public List<int> ExcludedCategoryIds { get; set; } = [];
        public List<int> IncludedBrandIds { get; set; } = [];
        public List<int> ExcludedBrandIds { get; set; } = [];
        public List<int> IncludedTagIds { get; set; } = [];
        public List<int> ExcludedTagIds { get; set; } = [];
    }

    protected override async Task OnInitializedAsync()
    {
        categories = await Db.Categories.AsNoTracking().OrderBy(c => c.Name).Select(c => new CategoryItem(c.Id, c.Name)).ToListAsync();
        brands = await Db.Brands.AsNoTracking().OrderBy(b => b.Name).Select(b => new BrandItem(b.Id, b.Name)).ToListAsync();
        tags = await Db.Tags.AsNoTracking().Where(t => !t.IsDeleted).OrderBy(t => t.Name).Select(t => new TagItem(t.Id, t.Name, t.IsHidden, t.BadgeColor)).ToListAsync();

        if (Input is null)
        {
            if (Id != 0)
            {
                var existing = await Db.Coupons.FindAsync(Id);
                if (existing == null)
                {
                    Nav.NavigateTo("/admin/coupons");
                    return;
                }

                Input = new CouponFormModel
                {
                    Id = existing.Id,
                    Code = existing.Code,
                    Description = existing.Description,
                    DiscountType = existing.DiscountType,
                    DiscountValue = existing.DiscountValue,
                    MaxDiscountAmount = existing.MaxDiscountAmount,
                    MinOrderAmount = existing.MinOrderAmount,
                    ExpiryDate = existing.ExpiryDate?.LocalDateTime,
                    UsageLimit = existing.UsageLimit,
                    IsActive = existing.IsActive,
                    IncludedCategoryIds = [.. existing.IncludedCategoryIds],
                    ExcludedCategoryIds = [.. existing.ExcludedCategoryIds],
                    IncludedBrandIds = [.. existing.IncludedBrandIds],
                    ExcludedBrandIds = [.. existing.ExcludedBrandIds],
                    IncludedTagIds = [.. existing.IncludedTagIds],
                    ExcludedTagIds = [.. existing.ExcludedTagIds]
                };
            }
            else
            {
                Input = new CouponFormModel();
            }
        }
        loading = false;
    }

    private void ToggleId(List<int> list, int id)
    {
        if (list.Contains(id)) list.Remove(id);
        else list.Add(id);
    }

    private void ToggleIncludeCategory(int id)
    {
        if (Input is null) return;
        Input.ExcludedCategoryIds.Remove(id);
        ToggleId(Input.IncludedCategoryIds, id);
    }

    private void ToggleExcludeCategory(int id)
    {
        if (Input is null) return;
        Input.IncludedCategoryIds.Remove(id);
        ToggleId(Input.ExcludedCategoryIds, id);
    }

    private void ToggleIncludeBrand(int id)
    {
        if (Input is null) return;
        Input.ExcludedBrandIds.Remove(id);
        ToggleId(Input.IncludedBrandIds, id);
    }

    private void ToggleExcludeBrand(int id)
    {
        if (Input is null) return;
        Input.IncludedBrandIds.Remove(id);
        ToggleId(Input.ExcludedBrandIds, id);
    }

    private void ToggleIncludeTag(int id)
    {
        if (Input is null) return;
        Input.ExcludedTagIds.Remove(id);
        ToggleId(Input.IncludedTagIds, id);
    }

    private void ToggleExcludeTag(int id)
    {
        if (Input is null) return;
        Input.IncludedTagIds.Remove(id);
        ToggleId(Input.ExcludedTagIds, id);
    }

    private void OnDiscountTypeChanged()
    {
        if (Input is null) return;
        if (Input.DiscountType == CouponDiscountType.FreeDelivery)
        {
            Input.DiscountValue = 0;
            Input.MaxDiscountAmount = null;
        }
        else if (Input.DiscountType == CouponDiscountType.Percentage && Input.DiscountValue == 0)
        {
            Input.DiscountValue = 10;
        }
        else if (Input.DiscountType == CouponDiscountType.FixedAmount && Input.DiscountValue == 0)
        {
            Input.DiscountValue = 100;
        }
    }

    private async Task Save()
    {
        if (saving || Input is null) return;
        errorMessage = null;

        var cleanCode = (Input.Code ?? "").Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(cleanCode))
        {
            errorMessage = "Please provide a valid coupon code.";
            return;
        }

        var isDuplicate = await Db.Coupons.AnyAsync(c => c.Code == cleanCode && c.Id != Id);
        if (isDuplicate)
        {
            errorMessage = $"A coupon with code '{cleanCode}' already exists. Please choose a different code.";
            return;
        }

        if (Input.DiscountType == CouponDiscountType.FreeDelivery)
        {
            Input.DiscountValue = 0;
            Input.MaxDiscountAmount = null;
        }

        DateTimeOffset? expiryOffset = Input.ExpiryDate.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(Input.ExpiryDate.Value, DateTimeKind.Utc))
            : null;

        var cleanDesc = string.IsNullOrWhiteSpace(Input.Description) ? null : Input.Description.Trim();

        saving = true;
        try
        {
            if (Id == 0)
            {
                var newCoupon = new Coupon
                {
                    Code = cleanCode,
                    Description = cleanDesc,
                    DiscountType = Input.DiscountType,
                    DiscountValue = Input.DiscountValue,
                    MaxDiscountAmount = Input.MaxDiscountAmount,
                    MinOrderAmount = Input.MinOrderAmount,
                    ExpiryDate = expiryOffset,
                    UsageLimit = Input.UsageLimit,
                    IsActive = Input.IsActive,
                    IncludedCategoryIds = [.. Input.IncludedCategoryIds],
                    ExcludedCategoryIds = [.. Input.ExcludedCategoryIds],
                    IncludedBrandIds = [.. Input.IncludedBrandIds],
                    ExcludedBrandIds = [.. Input.ExcludedBrandIds],
                    IncludedTagIds = [.. Input.IncludedTagIds],
                    ExcludedTagIds = [.. Input.ExcludedTagIds]
                };
                Db.Coupons.Add(newCoupon);
            }
            else
            {
                var existing = await Db.Coupons.FindAsync(Id);
                if (existing != null)
                {
                    existing.Code = cleanCode;
                    existing.Description = cleanDesc;
                    existing.DiscountType = Input.DiscountType;
                    existing.DiscountValue = Input.DiscountValue;
                    existing.MaxDiscountAmount = Input.MaxDiscountAmount;
                    existing.MinOrderAmount = Input.MinOrderAmount;
                    existing.ExpiryDate = expiryOffset;
                    existing.UsageLimit = Input.UsageLimit;
                    existing.IsActive = Input.IsActive;
                    existing.IncludedCategoryIds = [.. Input.IncludedCategoryIds];
                    existing.ExcludedCategoryIds = [.. Input.ExcludedCategoryIds];
                    existing.IncludedBrandIds = [.. Input.IncludedBrandIds];
                    existing.ExcludedBrandIds = [.. Input.ExcludedBrandIds];
                    existing.IncludedTagIds = [.. Input.IncludedTagIds];
                    existing.ExcludedTagIds = [.. Input.ExcludedTagIds];
                }
            }

            await Db.SaveChangesAsync();
            Nav.NavigateTo("/admin/coupons?saved=true");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save coupon: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }
}
