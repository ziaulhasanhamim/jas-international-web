@page "/admin/coupons"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Components.QuickGrid
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>Coupons &amp; Promo Codes · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">PROMOTIONS &amp; DISCOUNTS</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Coupons &amp; Promo Codes</h1>
        <p class="text-sm text-slate-500 mt-1">Manage customer promotional discount codes, percentage caps, minimum spends, and free delivery vouchers.</p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/admin/coupons/new" class="btn-primary shadow-xs">
            <Icon Name="plus" Class="size-4" />
            Create Coupon
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800 flex items-center justify-between">
        <span class="flex items-center gap-2">
            <Icon Name="check" Class="size-4 text-emerald-600" />
            @_toast
        </span>
        <button type="button" data-admin-dismiss aria-label="Dismiss notification" class="text-emerald-600 hover:text-emerald-950">
            <Icon Name="close" Class="size-3.5" />
        </button>
    </div>
}

<form method="post" @formname="coupons-table-action" data-enhance>
    <AntiforgeryToken />
    <div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
        <div class="table-scroll">
            <QuickGrid Items="@couponsQuery" class="data-table">
                <TemplateColumn Title="Coupon Code" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Coupon Code" SortKey="Code" /></HeaderTemplate><ChildContent>
                    <strong class="font-mono text-sm text-blue-600 font-bold">@context.Code</strong>
                    @if (!string.IsNullOrEmpty(context.Description))
                    {
                        <span class="text-xs text-slate-400 block mt-0.5">@context.Description</span>
                    }
                </ChildContent></TemplateColumn>

                <TemplateColumn Title="Discount" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Discount" SortKey="DiscountValue" /></HeaderTemplate><ChildContent>
                    @switch (context.DiscountType)
                    {
                        case CouponDiscountType.Percentage:
                            <span class="font-semibold text-slate-800">@context.DiscountValue.ToString("N0")% Off</span>
                            break;
                        case CouponDiscountType.FixedAmount:
                            <span class="font-semibold text-slate-800">৳@context.DiscountValue.ToString("N0") Flat Off</span>
                            break;
                        case CouponDiscountType.FreeDelivery:
                            <span class="text-emerald-600 font-semibold">Free Delivery</span>
                            break;
                    }
                </ChildContent></TemplateColumn>

                <TemplateColumn Title="Min. Spend" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Min. Spend" SortKey="MinOrderAmount" /></HeaderTemplate><ChildContent>
                    <span class="text-slate-600 text-xs">
                        @(context.MinOrderAmount.HasValue ? $"৳{context.MinOrderAmount.Value:N0}" : "No minimum")
                    </span>
                </ChildContent></TemplateColumn>

                <TemplateColumn Title="Max. Cap" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Max. Cap" SortKey="MaxDiscountAmount" /></HeaderTemplate><ChildContent>
                    <span class="text-slate-600 text-xs">
                        @(context.MaxDiscountAmount.HasValue ? $"৳{context.MaxDiscountAmount.Value:N0}" : "—")
                    </span>
                </ChildContent></TemplateColumn>

                <TemplateColumn Title="Usage" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Usage" SortKey="TimesUsed" /></HeaderTemplate><ChildContent>
                    <span class="text-slate-700 text-xs font-medium">
                        @context.TimesUsed @(context.UsageLimit.HasValue ? $"/ {context.UsageLimit.Value}" : "uses")
                    </span>
                </ChildContent></TemplateColumn>

                <TemplateColumn Title="Status" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Status" SortKey="IsActive" /></HeaderTemplate><ChildContent>
                    @{
                        var isExpired = context.ExpiryDate.HasValue && context.ExpiryDate.Value < DateTimeOffset.UtcNow;
                    }
                    @if (!context.IsActive)
                    {
                        <span class="badge badge-rose">Disabled</span>
                    }
                    else if (isExpired)
                    {
                        <span class="badge badge-amber">Expired</span>
                    }
                    else
                    {
                        <span class="badge badge-emerald">Active</span>
                    }
                </ChildContent></TemplateColumn>

                <TemplateColumn Title="Actions" Align="Align.End">
                    <div class="flex items-center justify-end gap-1.5">
                        <a href="/admin/coupons/@context.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                            Edit
                        </a>
                        <button type="submit" name="ToggleCouponId" value="@context.Id" class="btn-secondary !px-2.5 !py-1 text-xs cursor-pointer @(context.IsActive ? "text-amber-700 hover:bg-amber-50" : "text-emerald-700 hover:bg-emerald-50")">
                            @(context.IsActive ? "Disable" : "Enable")
                        </button>
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="p-4 border-t border-slate-200/90 flex items-center justify-between">
            <AdminPagination Total="totalFiltered" Page="Page" Size="PageSize" />
        </div>
    </div>
</form>

@code
{
    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "saved")]
    public bool Saved { get; set; }

    [SupplyParameterFromForm(FormName = "coupons-table-action")]
    public int ToggleCouponId { get; set; }

    private const int PageSize = 25;
    private int totalFiltered;
    private IQueryable<Coupon>? couponsQuery;
    private string? _toast;

    protected override async Task OnInitializedAsync()
    {
        if (Saved)
        {
            _toast = "Coupon saved successfully.";
        }

        if (ToggleCouponId > 0)
        {
            var existing = await Db.Coupons.FindAsync(ToggleCouponId);
            if (existing != null)
            {
                existing.IsActive = !existing.IsActive;
                await Db.SaveChangesAsync();
                _toast = existing.IsActive ? $"Coupon '{existing.Code}' enabled." : $"Coupon '{existing.Code}' disabled.";
            }
            ToggleCouponId = 0;
        }

        Page = Math.Max(1, Page);
        var q = Db.Coupons.AsNoTracking();
        totalFiltered = await q.CountAsync();

        var list = await AdminSorting.Apply(q.OrderByDescending(c => c.CreatedAt), Nav, ("Code", c => c.Code), ("DiscountValue", c => c.DiscountValue), ("MinOrderAmount", c => c.MinOrderAmount ?? 0), ("MaxDiscountAmount", c => c.MaxDiscountAmount ?? 0), ("TimesUsed", c => c.TimesUsed), ("IsActive", c => c.IsActive))
            .Skip((Page - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();

        couponsQuery = list.AsQueryable();
    }
}
