@inject NavigationManager Nav
@page "/admin/carousel"
@using Microsoft.AspNetCore.Components.QuickGrid
@inject AppDbContext Db

<PageTitle>Homepage Carousel · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">MARKETING &amp; MERCHANDISING</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Homepage Carousel</h1>
        <p class="text-sm text-slate-500 mt-1">Manage promotional banners, hero slide graphics, target links, and order with QuickGrid.</p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/admin/carousel/new" class="btn-primary shadow-xs">
            <Icon Name="plus" Class="size-4" />
            Add Slide
        </a>
    </div>
</div>

<!-- Slides QuickGrid Table -->
<div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
    <div class="table-scroll">
        <QuickGrid Items="@slidesQuery" class="data-table">
            <PropertyColumn Property="@(s => s.Id)" Title="#ID" Class="col-id font-mono text-xs text-slate-500 w-16 text-center" Align="Align.Center" />
            <TemplateColumn Title="Slide Preview" Class="w-36">
                <PictureImage Src="@context.ImageUrl" Alt="@context.ImageAlt" Class="h-14 w-28 object-cover rounded-lg border border-slate-200" Loading="lazy" Width="112" Height="56" />
            </TemplateColumn>

            <TemplateColumn Title="Banner Title &amp; Target" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Banner Title &amp; Target" SortKey="Title" /></HeaderTemplate><ChildContent>
                <strong class="text-slate-900 block font-semibold text-xs sm:text-sm">@(context.Title ?? context.ImageAlt)</strong>
                <span class="text-xs text-blue-600 hover:underline font-mono">@context.LinkUrl</span>
            </ChildContent></TemplateColumn>

            <TemplateColumn Title="Publish Status" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Publish Status" SortKey="IsActive" /></HeaderTemplate><ChildContent>
                <span class="badge @(context.IsActive ? "badge-emerald" : "badge-slate")">
                    @(context.IsActive ? "Published Live" : "Hidden")
                </span>
            </ChildContent></TemplateColumn>

            <TemplateColumn Title="Sort Order" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Sort Order" SortKey="SortOrder" /></HeaderTemplate><ChildContent>
                <span class="font-mono text-xs text-slate-600">#@context.SortOrder</span>
            </ChildContent></TemplateColumn>

            <TemplateColumn Title="Actions" Align="Align.End">
                <a href="/admin/carousel/@context.Id/edit" class="btn-secondary !px-2.5 !py-1 text-xs">
                    Edit Slide
                </a>
            </TemplateColumn>
        </QuickGrid>
    </div>
</div>

@if (slidesList.Count > 1)
{
    <div class="mt-8 rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-xs">
        <OrderEditor
            Kind="OrderableKind.Carousel"
            Items="@slidesList.Select(s => new OrderableItemDto(s.Id, s.Title ?? s.ImageAlt)).ToList()"
            Title="Carousel Slide Display Order"
        />
    </div>
}

@code
{
    private IQueryable<CarouselSlide>? slidesQuery;
    private List<CarouselSlide> slidesList = [];

    protected override async Task OnInitializedAsync()
    {
        slidesList = await AdminSorting.Apply(Db.CarouselSlides.AsNoTracking()
            .OrderBy(s => s.SortOrder)
            .ThenBy(s => s.Id), Nav, ("Title", s => s.Title ?? s.ImageAlt), ("IsActive", s => s.IsActive), ("SortOrder", s => s.SortOrder))
            .ToListAsync();
        slidesQuery = slidesList.AsQueryable();
    }
}
