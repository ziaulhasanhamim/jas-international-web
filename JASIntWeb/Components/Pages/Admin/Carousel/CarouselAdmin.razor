@page "/admin/carousel"
@inject AppDbContext Db

<AdminPageHeader
    Title="Homepage carousel"
    Description="Manage homepage campaigns and their display order."
    ActionHref="/admin/carousel/new"
    ActionText="+ Add slide"
/>
<div class="shop-panel admin-table-wrap">
    <table class="shop-table">
        <thead>
            <tr>
                <th>Preview</th>
                <th>Slide</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in slides)
            {
                <tr>
                    <td>
                        <img src="@s.ImageUrl" alt="@s.ImageAlt" class="admin-thumbnail" loading="lazy" />
                    </td>
                    <td>
                        <strong>@(s.Title ?? s.ImageAlt)</strong>
                        <small class="cell-secondary">@s.LinkUrl</small>
                    </td>
                    <td>
                        <span class="status-badge">@(s.IsActive ? "Published" : "Hidden")</span>
                    </td>
                    <td>
                        <a href="/admin/carousel/@s.Id/edit">Edit slide</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (slides.Count == 0)
    {
        <p class="admin-empty">No slides yet. Add a homepage campaign.</p>
    }
</div>
@if (slides.Count > 1)
{
    <div class="shop-panel mt-6">
        <OrderEditor
            Kind="OrderableKind.Carousel"
            Items="@slides.Select(s => new OrderableItemDto(s.Id, s.Title ?? s.ImageAlt)).ToList()"
            Title="Carousel display order"
        />
    </div>
}

@code
{
    private List<CarouselSlide> slides = [];

    protected override async Task OnInitializedAsync() => slides = await Db.CarouselSlides.AsNoTracking()
        .OrderBy(s => s.SortOrder)
        .ThenBy(s => s.Id)
        .ToListAsync();
}
