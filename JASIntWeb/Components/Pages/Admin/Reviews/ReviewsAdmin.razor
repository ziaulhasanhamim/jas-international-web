@page "/admin/reviews"
@attribute [StreamRendering]
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>Customer Reviews &amp; Moderation · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">STOREFRONT REPUTATION</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Customer Reviews Moderation</h1>
        <p class="text-sm text-slate-500 mt-1">Review, approve, and reply to genuine verified buyer feedback across the storefront.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3.5 text-xs text-emerald-800 flex items-center justify-between shadow-xs animate-fadeIn">
        <span class="flex items-center gap-2.5">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white">
                <Icon Name="check" Class="size-3.5" />
            </span>
            <span class="font-medium">@_toast</span>
        </span>
        <a href="@FilterUrl(Filter)" class="text-emerald-600 hover:text-emerald-950 p-1">
            <Icon Name="close" Class="size-3.5" />
        </a>
    </div>
}

<!-- Filters Bar -->
<div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
    <div class="flex flex-wrap items-center gap-2">
        <a
            href="@FilterUrl("all")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Filter == "all" ? "bg-slate-900 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            All Reviews (@_totalAll)
        </a>
        <a
            href="@FilterUrl("approved")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(Filter == "approved" ? "bg-emerald-600 text-white shadow-xs" : "bg-emerald-50 text-emerald-800 border border-emerald-200 hover:bg-emerald-100")"
        >
            <span class="size-1.5 rounded-full @(Filter == "approved" ? "bg-white" : "bg-emerald-600")"></span>
            Approved Live (@_totalApproved)
        </a>
        <a
            href="@FilterUrl("pending")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(Filter == "pending" ? "bg-amber-600 text-white shadow-xs" : "bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100")"
        >
            <span class="size-1.5 rounded-full @(Filter == "pending" ? "bg-white" : "bg-amber-600")"></span>
            Pending Moderation (@_totalPending)
        </a>
    </div>

    <form method="get" data-enhance class="relative w-64">
        <input type="hidden" name="status" value="@Filter" />
        <input
            name="q"
            value="@Query"
            class="field pr-9 !py-1.5 text-xs"
            placeholder="Search reviews or customers..."
        />
        <button type="submit" class="absolute right-2 top-2 text-slate-400 hover:text-slate-700">
            <Icon Name="search" Class="size-3.5" />
        </button>
    </form>
</div>

<!-- Single container form for all review table quick actions (guarantees exactly 1 form instance) -->
<form method="post" @formname="reviews-table-action">
    <AntiforgeryToken />
    <!-- Reviews Stream -->
    <div class="space-y-4">
        @foreach (var r in _reviews)
        {
            <div class="rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-xs transition hover:border-slate-300">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                    <div class="space-y-2">
                        <div class="flex items-center gap-3">
                            <div class="flex items-center text-amber-400 text-sm">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span>@(i <= r.Rating ? "★" : "☆")</span>
                                }
                            </div>
                            <span class="text-xs font-bold text-slate-800">@(r.Title ?? "Product Review")</span>
                            <span class="badge @(r.IsApproved ? "badge-emerald" : "badge-amber") text-[10px]">
                                @(r.IsApproved ? "Approved Live" : "Pending Moderation")
                            </span>
                        </div>

                        <p class="text-sm text-slate-700 leading-relaxed">
                            @r.Comment
                        </p>

                        <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 pt-1">
                            <span class="font-semibold text-slate-900">@r.CustomerName</span>
                            @if (!string.IsNullOrEmpty(r.CustomerEmail))
                            {
                                <span class="text-slate-400 font-mono">(@r.CustomerEmail)</span>
                            }
                            <span>•</span>
                            <span class="font-medium text-blue-600">Product: @r.ProductName</span>
                            <span>•</span>
                            <span>@r.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                        </div>

                        @if (!string.IsNullOrEmpty(r.StaffReply))
                        {
                            <div class="mt-3 rounded-xl bg-slate-50 border border-slate-200 p-3 text-xs">
                                <span class="font-bold text-slate-800 block mb-1">Official Response from JAS International:</span>
                                <p class="text-slate-600">@r.StaffReply</p>
                            </div>
                        }
                    </div>

                    <div class="flex sm:flex-col items-center sm:items-end gap-2 shrink-0">
                        <button
                            type="submit"
                            name="ToggleReviewId"
                            value="@r.Id"
                            class="btn-secondary !px-3 !py-1.5 text-xs font-bold cursor-pointer @(r.IsApproved ? "!text-rose-600 hover:!bg-rose-50" : "!text-emerald-700 hover:!bg-emerald-50")"
                        >
                            @(r.IsApproved ? "Hide / Unpublish" : "✓ Approve & Publish")
                        </button>

                        <a
                            href="@FilterUrl(Filter, r.Id)"
                            class="btn-secondary !px-3 !py-1.5 text-xs font-medium text-slate-700 cursor-pointer inline-flex items-center gap-1.5"
                        >
                            <Icon Name="edit" Class="size-3" />
                            <span>@(string.IsNullOrEmpty(r.StaffReply) ? "Reply to Review" : "Edit Reply")</span>
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (_reviews.Count == 0)
        {
            <div class="rounded-2xl border border-slate-200/90 bg-white p-12 text-center shadow-xs">
                <Icon Name="box" Class="size-10 text-slate-300 mx-auto mb-3" />
                <p class="text-slate-500 font-medium">No reviews match your selected filter.</p>
            </div>
        }
    </div>
</form>

<!-- Dedicated Single Reply Modal (rendered outside loop, guaranteed exactly 1 instance) -->
@if (_activeReplyReview != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-xs animate-fadeIn">
        <div class="w-full max-w-lg rounded-2xl bg-white p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div>
                    <h3 class="text-base font-bold text-slate-900">Reply to Customer Review</h3>
                    <p class="text-xs text-slate-500">Customer: @_activeReplyReview.CustomerName · @_activeReplyReview.ProductName</p>
                </div>
                <a href="@FilterUrl(Filter)" class="text-slate-400 hover:text-slate-600 font-bold p-1 cursor-pointer">✕</a>
            </div>

            <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-700 space-y-1">
                <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-900">@(_activeReplyReview.Title ?? "Product Review")</span>
                    <span class="text-amber-500 font-bold">@_activeReplyReview.Rating ★</span>
                </div>
                <p class="text-slate-600 italic">"@_activeReplyReview.Comment"</p>
            </div>

            <form method="post" @formname="review-reply-modal" class="space-y-3">
                <AntiforgeryToken />
                <input type="hidden" name="ModalReplyId" value="@_activeReplyReview.Id" />
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Official Response from JAS International</label>
                    <textarea name="StaffReply" rows="4" class="field text-xs w-full" placeholder="Thank you for your feedback! Our support team is here to ensure...">@_activeReplyReview.StaffReply</textarea>
                </div>
                <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
                    <a href="@FilterUrl(Filter)" class="btn-secondary text-xs">Cancel</a>
                    <button type="submit" class="btn-primary text-xs">Save Official Response</button>
                </div>
            </form>
        </div>
    </div>
}

@code
{
    [SupplyParameterFromQuery(Name = "status")]
    public string Filter { get; set; } = "all";

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "reply")]
    public int ReplyId { get; set; }

    [SupplyParameterFromQuery(Name = "notice")]
    public string? NoticeQuery { get; set; }

    [SupplyParameterFromForm(FormName = "reviews-table-action")]
    public int ToggleReviewId { get; set; }

    [SupplyParameterFromForm(FormName = "review-reply-modal")]
    public int ModalReplyId { get; set; }

    [SupplyParameterFromForm(FormName = "review-reply-modal")]
    public string? StaffReply { get; set; }

    private string? _toast;
    private int _totalAll;
    private int _totalApproved;
    private int _totalPending;
    private List<ReviewRow> _reviews = [];
    private ReviewRow? _activeReplyReview;

    private sealed record ReviewRow(
        int Id,
        int ProductId,
        string ProductName,
        string CustomerName,
        string? CustomerEmail,
        int Rating,
        string? Title,
        string Comment,
        bool IsApproved,
        string? StaffReply,
        DateTimeOffset CreatedAt
    );

    private string FilterUrl(string status, int? replyId = null, string? notice = null)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(status) && status != "all") parts.Add($"status={Uri.EscapeDataString(status)}");
        if (!string.IsNullOrWhiteSpace(Query)) parts.Add($"q={Uri.EscapeDataString(Query)}");
        if (replyId.HasValue && replyId.Value > 0) parts.Add($"reply={replyId.Value}");
        if (!string.IsNullOrWhiteSpace(notice)) parts.Add($"notice={Uri.EscapeDataString(notice)}");
        return parts.Count > 0 ? $"/admin/reviews?{string.Join("&", parts)}" : "/admin/reviews";
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(NoticeQuery))
        {
            _toast = NoticeQuery switch
            {
                "approved" => "Review approved and published to storefront.",
                "hidden" => "Review hidden from storefront.",
                "replied" => "Saved official response to customer review.",
                _ => NoticeQuery
            };
        }

        if (ToggleReviewId > 0)
        {
            var rev = await Db.ProductReviews.FindAsync(ToggleReviewId);
            if (rev != null)
            {
                rev.IsApproved = !rev.IsApproved;
                rev.UpdatedAt = DateTimeOffset.UtcNow;
                await Db.SaveChangesAsync();
                Nav.NavigateTo(FilterUrl(Filter, notice: rev.IsApproved ? "approved" : "hidden"));
                return;
            }
        }
        else if (ModalReplyId > 0)
        {
            var rev = await Db.ProductReviews.FindAsync(ModalReplyId);
            if (rev != null)
            {
                rev.StaffReply = string.IsNullOrWhiteSpace(StaffReply) ? null : StaffReply.Trim();
                rev.UpdatedAt = DateTimeOffset.UtcNow;
                await Db.SaveChangesAsync();
                Nav.NavigateTo(FilterUrl(Filter, notice: "replied"));
                return;
            }
        }

        await LoadCountsAsync();
        await LoadReviewsAsync();

        if (ReplyId > 0)
        {
            _activeReplyReview = _reviews.FirstOrDefault(r => r.Id == ReplyId);
        }
    }

    private async Task LoadCountsAsync()
    {
        _totalAll = await Db.ProductReviews.CountAsync();
        _totalApproved = await Db.ProductReviews.CountAsync(r => r.IsApproved);
        _totalPending = await Db.ProductReviews.CountAsync(r => !r.IsApproved);
    }

    private async Task LoadReviewsAsync()
    {
        var q = Db.ProductReviews.AsNoTracking().Include(r => r.Product).AsQueryable();

        if (Filter == "approved")
        {
            q = q.Where(r => r.IsApproved);
        }
        else if (Filter == "pending")
        {
            q = q.Where(r => !r.IsApproved);
        }

        if (!string.IsNullOrWhiteSpace(Query))
        {
            var term = Query.Trim().ToLower();
            q = q.Where(r => r.CustomerName.ToLower().Contains(term) ||
                             r.Comment.ToLower().Contains(term) ||
                             (r.Product != null && r.Product.Name.ToLower().Contains(term)));
        }

        _reviews = await q.OrderByDescending(r => r.CreatedAt)
            .Select(r => new ReviewRow(
                r.Id,
                r.ProductId,
                r.Product != null ? r.Product.Name : "Product",
                r.CustomerName,
                r.CustomerEmail,
                r.Rating,
                r.Title,
                r.Comment,
                r.IsApproved,
                r.StaffReply,
                r.CreatedAt
            ))
            .ToListAsync();
    }
}
