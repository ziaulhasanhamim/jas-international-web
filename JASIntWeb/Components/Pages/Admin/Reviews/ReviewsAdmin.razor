@page "/admin/reviews"
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components.QuickGrid
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>Customer Reviews &amp; Moderation · JAS Admin</PageTitle>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <p class="eyebrow">STOREFRONT REPUTATION</p>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Customer Reviews Moderation</h1>
        <p class="text-sm text-slate-500 mt-1">Review, approve, and reply to genuine verified buyer feedback across the storefront using QuickGrid.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3.5 text-xs text-emerald-800 flex items-center justify-between shadow-xs animate-fadeIn">
        <span class="flex items-center gap-2.5">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white">
                <Icon Name="check" Class="size-3.5" />
            </span>
            <span class="font-medium">@_toast</span>
        </span>
        <button type="button" data-admin-dismiss aria-label="Dismiss notification" class="text-emerald-600 hover:text-emerald-950 p-1">
            <Icon Name="close" Class="size-3.5" />
        </button>
    </div>
}

<!-- Filters Bar -->
<div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
    <div class="flex flex-wrap items-center gap-2">
        <a
            href="@FilterUrl("all")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(Filter == "all" ? "bg-slate-900 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")"
        >
            All Reviews (@_totalAll)
        </a>
        <a
            href="@FilterUrl("approved")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(Filter == "approved" ? "bg-emerald-600 text-white shadow-xs" : "bg-emerald-50 text-emerald-800 border border-emerald-200 hover:bg-emerald-100")"
        >
            <span class="size-1.5 rounded-full @(Filter == "approved" ? "bg-white" : "bg-emerald-600")"></span>
            Approved Live (@_totalApproved)
        </a>
        <a
            href="@FilterUrl("pending")"
            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(Filter == "pending" ? "bg-amber-600 text-white shadow-xs" : "bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100")"
        >
            <span class="size-1.5 rounded-full @(Filter == "pending" ? "bg-white" : "bg-amber-600")"></span>
            Pending Moderation (@_totalPending)
        </a>
    </div>

    <form method="get" data-enhance class="relative w-64">
        <input type="hidden" name="status" value="@Filter" />
        <input
            name="q"
            value="@Query"
            class="field pr-9 !py-1.5 text-xs"
            placeholder="Search reviews or customers..."
        />
        <button type="submit" class="absolute right-2 top-2 text-slate-400 hover:text-slate-700">
            <Icon Name="search" Class="size-3.5" />
        </button>
    </form>
</div>

<!-- Table Action Form -->
<form method="post" @formname="reviews-table-action" data-enhance>
    <AntiforgeryToken />

    <!-- Bulk Actions Toolbar -->
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200/90 bg-slate-50 p-3 shadow-2xs">
        <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-slate-700">Bulk Actions:</span>
            <button type="submit" name="BulkAction" value="approve" class="btn-secondary !py-1 !px-3 text-xs font-bold text-emerald-700 hover:bg-emerald-50 cursor-pointer">
                Approve Selected
            </button>
            <button type="submit" name="BulkAction" value="hide" class="btn-secondary !py-1 !px-3 text-xs font-bold hover:bg-slate-200 cursor-pointer">
                Hide Selected
            </button>
            <button type="submit" name="BulkAction" value="delete" class="btn-secondary !py-1 !px-3 text-xs font-bold text-rose-600 hover:bg-rose-50 cursor-pointer" data-confirm="Permanently delete selected reviews?">
                Delete Selected
            </button>
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
        <div class="table-scroll">
            <QuickGrid Items="@reviewsQuery" class="data-table">
                <TemplateColumn Class="w-10 text-center" Align="Align.Center">
                    <HeaderTemplate Context="_">
                        <input type="checkbox" id="select-all-reviews"
                               class="rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer"
                               data-select-all=".rev-select-cb"
                               title="Select all" />
                    </HeaderTemplate>
                    <ChildContent Context="r">
                        <input type="checkbox" name="SelectedReviewIds" value="@r.Id"
                               class="rev-select-cb rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" />
                    </ChildContent>
                </TemplateColumn>

                <PropertyColumn Property="@(r => r.Id)" Title="#ID" Class="col-id font-mono text-xs text-slate-500 w-16 text-center" Align="Align.Center" />

                <TemplateColumn Title="Rating &amp; Title" Sortable="false"><HeaderTemplate><AdminSortHeader Label="Rating &amp; Title" SortKey="Rating" /></HeaderTemplate><ChildContent>
                    <div class="space-y-1">
                        <div class="flex items-center text-amber-400 text-xs">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span>@(i <= context.Rating ? "★" : "☆")</span>
                            }
                            <span class="text-slate-700 font-bold ml-1.5 text-2xs">@context.Rating.0</span>
                        </div>
                        <strong class="text-slate-900 block font-semibold text-xs">
                            @(context.Title ?? "Product Review")
                        </strong>
                        <span class="text-[11px] text-slate-400 block">
                            @context.CreatedAt.ToString("dd MMM yyyy")
                        </span>
                    </div>
                </ChildContent></TemplateColumn>

                <TemplateColumn Title="Customer">
                    <div class="space-y-0.5">
                        <strong class="text-slate-800 block text-xs font-semibold">@context.CustomerName</strong>
                        @if (!string.IsNullOrEmpty(context.CustomerEmail))
                        {
                            <span class="text-xs font-mono text-slate-500 block">@context.CustomerEmail</span>
                        }
                    </div>
                </TemplateColumn>

                <TemplateColumn Title="Product">
                    <a href="/admin/products/@context.ProductId/edit" class="text-xs font-medium text-blue-600 hover:underline max-w-[180px] block truncate" title="@context.ProductName">
                        @context.ProductName
                    </a>
                </TemplateColumn>

                <TemplateColumn Title="Customer Feedback">
                    <div class="space-y-1.5 max-w-md">
                        <p class="text-xs text-slate-700 line-clamp-2">
                            "@context.Comment"
                        </p>
                        @if (!string.IsNullOrEmpty(context.StaffReply))
                        {
                            <div class="rounded-lg bg-slate-50 border border-slate-200/80 px-2 py-1 text-[11px] text-slate-600 line-clamp-1">
                                <span class="font-bold text-slate-800 mr-1">Reply:</span>@context.StaffReply
                            </div>
                        }
                    </div>
                </TemplateColumn>

                <TemplateColumn Title="Status" Sortable="false" Align="Align.Center"><HeaderTemplate><AdminSortHeader Label="Status" SortKey="IsApproved" /></HeaderTemplate><ChildContent>
                    <span class="badge @(context.IsApproved ? "badge-emerald" : "badge-amber") text-[11px]">
                        @(context.IsApproved ? "Approved Live" : "Pending")
                    </span>
                </ChildContent></TemplateColumn>

                <TemplateColumn Title="Actions" Align="Align.End">
                    <div class="flex items-center justify-end gap-1.5">
                        <button
                            type="submit"
                            name="ToggleReviewId"
                            value="@context.Id"
                            class="btn-secondary !px-2.5 !py-1 text-xs font-bold cursor-pointer @(context.IsApproved ? "!text-amber-700 hover:!bg-amber-50" : "!text-emerald-700 hover:!bg-emerald-50")"
                            title="@(context.IsApproved ? "Hide from storefront" : "Approve and show live")"
                        >
                            @(context.IsApproved ? "Hide" : "Approve")
                        </button>

                        <a
                            href="@FilterUrl(Filter, context.Id)"
                            class="btn-secondary !px-2.5 !py-1 text-xs font-medium text-slate-700 cursor-pointer inline-flex items-center gap-1"
                            title="Reply to this review"
                        >
                            <Icon Name="edit" Class="size-3" />
                            <span>@(string.IsNullOrEmpty(context.StaffReply) ? "Reply" : "Edit")</span>
                        </a>

                        <button
                            type="submit"
                            name="DeleteReviewId"
                            value="@context.Id"
                            class="btn-secondary !px-2 !py-1 text-xs text-rose-600 hover:text-rose-700 hover:bg-rose-50 cursor-pointer"
                            data-confirm="Permanently delete this customer review?"
                            title="Delete review"
                        >
                            <Icon Name="close" Class="size-3" />
                        </button>
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="p-4 border-t border-slate-200/90 flex items-center justify-between">
            <AdminPagination Total="totalFiltered" Page="Page" Size="PageSize" />
        </div>
    </div>
</form>

<!-- Dedicated Single Reply Modal -->
@if (_activeReplyReview != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-xs animate-fadeIn">
        <div class="w-full max-w-lg rounded-2xl bg-white p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div>
                    <h3 class="text-base font-bold text-slate-900">Reply to Customer Review</h3>
                    <p class="text-xs text-slate-500">Customer: @_activeReplyReview.CustomerName · @_activeReplyReview.ProductName</p>
                </div>
                <a href="@FilterUrl(Filter)" class="text-slate-400 hover:text-slate-600 font-bold p-1 cursor-pointer">✕</a>
            </div>

            <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-700 space-y-1">
                <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-900">@(_activeReplyReview.Title ?? "Product Review")</span>
                    <span class="text-amber-500 font-bold">@_activeReplyReview.Rating ★</span>
                </div>
                <p class="text-slate-600 italic">"@_activeReplyReview.Comment"</p>
            </div>

            <form method="post" @formname="review-reply-modal" data-enhance class="space-y-3">
                <AntiforgeryToken />
                <input type="hidden" name="ModalReplyId" value="@_activeReplyReview.Id" />
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Official Response from JAS International</label>
                    <textarea name="StaffReply" rows="4" class="field text-xs w-full" placeholder="Thank you for your feedback! Our support team is here to ensure...">@_activeReplyReview.StaffReply</textarea>
                </div>
                <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
                    <a href="@FilterUrl(Filter)" class="btn-secondary text-xs">Cancel</a>
                    <button type="submit" class="btn-primary text-xs">Save Official Response</button>
                </div>
            </form>
        </div>
    </div>
}

@code
{
    [SupplyParameterFromQuery(Name = "status")]
    public string Filter { get; set; } = "all";

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "reply")]
    public int ReplyId { get; set; }

    [SupplyParameterFromForm(FormName = "reviews-table-action")]
    public int ToggleReviewId { get; set; }

    [SupplyParameterFromForm(FormName = "reviews-table-action")]
    public int DeleteReviewId { get; set; }

    [SupplyParameterFromForm(FormName = "reviews-table-action")]
    public List<int>? SelectedReviewIds { get; set; }

    [SupplyParameterFromForm(FormName = "reviews-table-action")]
    public string? BulkAction { get; set; }

    [SupplyParameterFromForm(FormName = "review-reply-modal")]
    public int ModalReplyId { get; set; }

    [SupplyParameterFromForm(FormName = "review-reply-modal")]
    public string? StaffReply { get; set; }

    public sealed record AdminReviewRow(
        int Id,
        int ProductId,
        string ProductName,
        string CustomerName,
        string? CustomerEmail,
        int Rating,
        string? Title,
        string Comment,
        bool IsApproved,
        string? StaffReply,
        DateTimeOffset CreatedAt
    );

    private IQueryable<AdminReviewRow>? reviewsQuery;
    private const int PageSize = 20;
    private int totalFiltered;

    private string? _toast;
    private int _totalAll;
    private int _totalApproved;
    private int _totalPending;
    private AdminReviewRow? _activeReplyReview;

    private string FilterUrl(string status, int? replyId = null)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(status) && status != "all") parts.Add($"status={Uri.EscapeDataString(status)}");
        if (!string.IsNullOrWhiteSpace(Query)) parts.Add($"q={Uri.EscapeDataString(Query)}");
        if (replyId.HasValue && replyId.Value > 0) parts.Add($"reply={replyId.Value}");
        return parts.Count > 0 ? $"/admin/reviews?{string.Join("&", parts)}" : "/admin/reviews";
    }

    protected override async Task OnInitializedAsync()
    {
        if (ToggleReviewId > 0)
        {
            var rev = await Db.ProductReviews.FindAsync(ToggleReviewId);
            if (rev != null)
            {
                rev.IsApproved = !rev.IsApproved;
                rev.UpdatedAt = DateTimeOffset.UtcNow;
                await Db.SaveChangesAsync();
                _toast = rev.IsApproved ? "Review approved and published live." : "Review hidden from storefront.";
            }
            ToggleReviewId = 0;
        }
        else if (DeleteReviewId > 0)
        {
            var rev = await Db.ProductReviews.FindAsync(DeleteReviewId);
            if (rev != null)
            {
                Db.ProductReviews.Remove(rev);
                await Db.SaveChangesAsync();
                _toast = "Review permanently deleted.";
            }
            DeleteReviewId = 0;
        }
        else if (ModalReplyId > 0)
        {
            var rev = await Db.ProductReviews.FindAsync(ModalReplyId);
            if (rev != null)
            {
                rev.StaffReply = string.IsNullOrWhiteSpace(StaffReply) ? null : StaffReply.Trim();
                rev.UpdatedAt = DateTimeOffset.UtcNow;
                await Db.SaveChangesAsync();
                _toast = "Official response saved.";
            }
            ModalReplyId = 0;
            StaffReply = null;
            ReplyId = 0;
        }
        else if (!string.IsNullOrWhiteSpace(BulkAction) && SelectedReviewIds != null && SelectedReviewIds.Count > 0)
        {
            var reviews = await Db.ProductReviews.Where(r => SelectedReviewIds.Contains(r.Id)).ToListAsync();
            switch (BulkAction.ToLowerInvariant())
            {
                case "approve":
                    foreach (var r in reviews) r.IsApproved = true;
                    _toast = $"{reviews.Count} reviews approved and published.";
                    break;
                case "hide":
                    foreach (var r in reviews) r.IsApproved = false;
                    _toast = $"{reviews.Count} reviews hidden from storefront.";
                    break;
                case "delete":
                    Db.ProductReviews.RemoveRange(reviews);
                    _toast = $"{reviews.Count} reviews permanently deleted.";
                    break;
            }
            await Db.SaveChangesAsync();
            BulkAction = null;
            SelectedReviewIds = null;
        }

        await LoadCountsAsync();
        await LoadReviewsAsync();

        if (ReplyId > 0)
        {
            var r = await Db.ProductReviews.Include(x => x.Product).FirstOrDefaultAsync(x => x.Id == ReplyId);
            if (r != null)
            {
                _activeReplyReview = new AdminReviewRow(
                    r.Id,
                    r.ProductId,
                    r.Product?.Name ?? "Product",
                    r.CustomerName,
                    r.CustomerEmail,
                    r.Rating,
                    r.Title,
                    r.Comment,
                    r.IsApproved,
                    r.StaffReply,
                    r.CreatedAt
                );
            }
        }
    }

    private async Task LoadCountsAsync()
    {
        _totalAll = await Db.ProductReviews.CountAsync();
        _totalApproved = await Db.ProductReviews.CountAsync(r => r.IsApproved);
        _totalPending = await Db.ProductReviews.CountAsync(r => !r.IsApproved);
    }

    private async Task LoadReviewsAsync()
    {
        var q = Db.ProductReviews.AsNoTracking().Include(r => r.Product).AsQueryable();

        if (Filter == "approved")
        {
            q = q.Where(r => r.IsApproved);
        }
        else if (Filter == "pending")
        {
            q = q.Where(r => !r.IsApproved);
        }

        if (!string.IsNullOrWhiteSpace(Query))
        {
            var term = Query.Trim().ToLower();
            q = q.Where(r => r.CustomerName.ToLower().Contains(term) ||
                             r.Comment.ToLower().Contains(term) ||
                             (r.Product != null && r.Product.Name.ToLower().Contains(term)));
        }

        Page = Math.Max(1, Page);
        totalFiltered = await q.CountAsync();

        var list = await AdminSorting.Apply(q.OrderByDescending(r => r.CreatedAt), Nav, ("Rating", r => r.Rating), ("IsApproved", r => r.IsApproved))
            .Skip((Page - 1) * PageSize)
            .Take(PageSize)
            .Select(r => new AdminReviewRow(
                r.Id,
                r.ProductId,
                r.Product != null ? r.Product.Name : "Product",
                r.CustomerName,
                r.CustomerEmail,
                r.Rating,
                r.Title,
                r.Comment,
                r.IsApproved,
                r.StaffReply,
                r.CreatedAt
            ))
            .ToListAsync();

        reviewsQuery = list.AsQueryable();
    }
}
