@page "/contact"

<PageTitle>Contact Us &amp; Showroom · JAS International</PageTitle>

<div class="shop-container py-10 max-w-5xl mx-auto">
    <div class="text-center mb-10">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700 ring-1 ring-blue-600/20 mb-3">
            CUSTOMER ASSISTANCE
        </span>
        <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mb-3">
            Contact &amp; Showroom
        </h1>
        <p class="text-sm sm:text-base text-slate-600 max-w-xl mx-auto">
            Have questions about a gadget, warranty claim, or order status? Visit our Khulna showroom or reach out to our team directly.
        </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-3 mb-12">
        <!-- Contact Information Cards -->
        <div class="space-y-4">
            <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
                <div class="flex items-center gap-3 text-slate-900 font-bold mb-2">
                    <span class="flex size-9 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                        <Icon Name="map-pin" Class="size-5" />
                    </span>
                    <span>Showroom Location</span>
                </div>
                <p class="text-sm text-slate-600">
                    Khulna Shopping Complex, 3rd Floor<br />
                    Dakbangla, Khulna - 9100, Bangladesh
                </p>
                <div class="mt-3 pt-3 border-t border-slate-100 text-xs text-slate-500">
                    Visiting Hours: 10:00 AM – 9:00 PM (Sat–Thu)<br />
                    Friday: 3:00 PM – 9:00 PM
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
                <div class="flex items-center gap-3 text-slate-900 font-bold mb-2">
                    <span class="flex size-9 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                        <Icon Name="phone" Class="size-5" />
                    </span>
                    <span>Phone &amp; WhatsApp</span>
                </div>
                <p class="text-sm text-slate-600">
                    Hotline: <a href="tel:01711465078" class="font-bold text-blue-600 hover:underline">01711465078</a><br />
                    WhatsApp inquiries available 7 days a week.
                </p>
                <div class="mt-3 pt-3 border-t border-slate-100 flex gap-2">
                    <a href="https://wa.me/8801711465078" target="_blank" rel="noopener" class="btn-primary !bg-emerald-600 hover:!bg-emerald-700 !px-3 !py-1.5 text-xs">
                        Message on WhatsApp
                    </a>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
                <div class="flex items-center gap-3 text-slate-900 font-bold mb-2">
                    <span class="flex size-9 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
                        <Icon Name="users" Class="size-5" />
                    </span>
                    <span>Social &amp; Community</span>
                </div>
                <p class="text-sm text-slate-600 mb-3">
                    Follow our official Facebook page for latest stock arrivals and special offers.
                </p>
                <a href="https://facebook.com/international.jas" target="_blank" rel="noopener" class="text-blue-600 font-medium text-xs hover:underline inline-flex items-center gap-1">
                    facebook.com/international.jas <Icon Name="arrow" Class="size-3" />
                </a>
            </div>
        </div>

        <!-- Contact Inquiry Form -->
        <div class="lg:col-span-2 rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs">
            <h2 class="text-xl font-bold text-slate-900 mb-1">Send Us a Direct Message</h2>
            <p class="text-xs text-slate-500 mb-6">Fill in your inquiry details and our customer support desk will get back to you promptly.</p>

            @if (submitted)
            {
                <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6 text-center">
                    <span class="flex size-12 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 mx-auto mb-3">
                        <Icon Name="check" Class="size-6" />
                    </span>
                    <h3 class="font-bold text-emerald-900 text-lg mb-1">Message Received!</h3>
                    <p class="text-xs text-emerald-700 max-w-sm mx-auto">
                        Thank you for reaching out. A JAS International representative will contact you via phone or email shortly.
                    </p>
                    <button type="button" @onclick="() => submitted = false" class="btn-secondary mt-4 text-xs">
                        Send Another Message
                    </button>
                </div>
            }
            else
            {
                <form @onsubmit="HandleSubmit" class="space-y-4">
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                            <label class="field-label">Your Full Name</label>
                            <input @bind="name" required class="field" placeholder="e.g. Tanvir Hasan" />
                        </div>
                        <div>
                            <label class="field-label">Contact Mobile Number</label>
                            <input @bind="phone" required type="tel" class="field" placeholder="017xxxxxxxx" />
                        </div>
                    </div>
                    <div>
                        <label class="field-label">Email Address (Optional)</label>
                        <input @bind="email" type="email" class="field" placeholder="you@example.com" />
                    </div>
                    <div>
                        <label class="field-label">Subject</label>
                        <select @bind="subject" class="field">
                            <option value="Product Inquiry">Product Inquiry / Stock Check</option>
                            <option value="Order Tracking">Order Tracking &amp; Delivery</option>
                            <option value="Warranty Claim">Warranty Claim / Replacement</option>
                            <option value="Corporate / Bulk Order">Corporate / Bulk Order</option>
                            <option value="General Inquiry">General Inquiry</option>
                        </select>
                    </div>
                    <div>
                        <label class="field-label">Message Details</label>
                        <textarea @bind="message" required rows="4" class="field" placeholder="Tell us what product or assistance you need..."></textarea>
                    </div>
                    <button type="submit" class="btn-primary w-full sm:w-auto">
                        Submit Message
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@code {
    private string name = "";
    private string phone = "";
    private string email = "";
    private string subject = "Product Inquiry";
    private string message = "";
    private bool submitted;

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(name) && !string.IsNullOrWhiteSpace(phone) && !string.IsNullOrWhiteSpace(message))
        {
            submitted = true;
        }
    }
}
