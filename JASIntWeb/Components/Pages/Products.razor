@page "/products"
@page "/category/{CategorySlug}"
@inject JASIntWeb.Services.CatalogService Catalog
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>@(string.IsNullOrWhiteSpace(Query) ? "All Products" : $"“{Query}”") · JAS International</PageTitle>

<div class="shop-container py-8">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div>
            <span class="text-xs font-bold uppercase tracking-widest text-blue-600 block mb-1">
                @(CategorySlug != null ? "CATEGORY VIEW" : "PRODUCT CATALOG")
            </span>
            <h1 class="font-display text-2xl sm:text-4xl font-bold tracking-tight text-slate-900">
                @(string.IsNullOrWhiteSpace(Query) ? (activeCategoryName ?? "All Gadgets & Gear") : $"Results for “{Query}”")
            </h1>
        </div>
        <div class="flex items-center gap-2">
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
                @total product@(total == 1 ? "" : "s")
            </span>
        </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-[240px_1fr] items-start">
        <!-- Sidebar Filter Column -->
        <aside class="space-y-6">
            <div class="rounded-3xl border border-slate-200/90 bg-white p-5 shadow-xs">
                <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
                    <h2 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                        <Icon Name="filter" Class="size-4 text-blue-600" />
                        Categories
                    </h2>
                    @if (CategorySlug != null)
                    {
                        <a href="/products" class="text-[11px] text-blue-600 font-semibold hover:underline">Reset</a>
                    }
                </div>

                <div class="space-y-1 text-xs">
                    <a href="@CategoryUrl(null)" class="flex items-center justify-between rounded-xl px-3 py-2 font-medium transition @(CategorySlug == null ? "bg-blue-50 text-blue-700 font-bold" : "text-slate-600 hover:bg-slate-50")">
                        <span>All Products</span>
                    </a>
                    @foreach (var parent in categories.Where(c => !c.ParentId.HasValue))
                    {
                        var isParentActive = parent.Slug == CategorySlug;
                        var hasActiveChild = children.TryGetValue(parent.Id, out var sub) && sub.Any(s => s.Slug == CategorySlug);

                        <details class="group" open="@(isParentActive || hasActiveChild)">
                            <summary class="flex items-center justify-between rounded-xl px-3 py-2 font-semibold text-slate-800 hover:bg-slate-50 cursor-pointer list-none select-none transition">
                                <a href="@CategoryUrl(parent.Slug)" class="@(isParentActive ? "text-blue-600 font-bold" : "")">
                                    @parent.Name
                                </a>
                                @if (children.ContainsKey(parent.Id))
                                {
                                    <span class="text-slate-400 group-open:rotate-180 transition-transform">⌄</span>
                                }
                            </summary>
                            @if (children.TryGetValue(parent.Id, out var subcategories))
                            {
                                <div class="ml-4 pl-2 border-l border-slate-200 space-y-1 py-1">
                                    @foreach (var child in subcategories)
                                    {
                                        <a href="@CategoryUrl(child.Slug)" class="block rounded-lg px-2.5 py-1.5 transition @(child.Slug == CategorySlug ? "bg-blue-50 text-blue-700 font-bold" : "text-slate-500 hover:text-slate-900 hover:bg-slate-50")">
                                            @child.Name
                                        </a>
                                    }
                                </div>
                            }
                        </details>
                    }
                </div>
            </div>

            <!-- Brand Filter -->
            <div class="rounded-3xl border border-slate-200/90 bg-white p-5 shadow-xs">
                <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
                    <h2 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                        <Icon Name="box" Class="size-4 text-blue-600" />
                        Brands
                    </h2>
                    @if (BrandSlug != null)
                    {
                        <a href="@FilterUrl(CategorySlug, null)" class="text-[11px] text-blue-600 font-semibold hover:underline">Clear</a>
                    }
                </div>
                <div class="space-y-1 text-xs max-h-56 overflow-y-auto pr-1 scrollbar-none">
                    <a href="@FilterUrl(CategorySlug, null)" class="flex items-center justify-between rounded-xl px-3 py-2 font-medium transition @(BrandSlug == null ? "bg-blue-50 text-blue-700 font-bold" : "text-slate-600 hover:bg-slate-50")">
                        <span>All Brands</span>
                    </a>
                    @foreach (var b in brands)
                    {
                        <a href="@FilterUrl(CategorySlug, b.Slug)" class="flex items-center justify-between rounded-xl px-3 py-2 font-medium transition @(b.Slug == BrandSlug ? "bg-blue-50 text-blue-700 font-bold" : "text-slate-600 hover:bg-slate-50")">
                            <span>@b.Name</span>
                        </a>
                    }
                </div>
            </div>
        </aside>

        <!-- Product Grid & Search Toolbar -->
        <section>
            <!-- Filter & Sort Toolbar -->
            <div class="mb-6 rounded-3xl border border-slate-200/90 bg-white p-4 shadow-xs">
                <form method="get" class="flex flex-wrap items-center gap-3">
                    @if (!string.IsNullOrWhiteSpace(BrandSlug))
                    {
                        <input type="hidden" name="brand" value="@BrandSlug" />
                    }
                    <div class="relative flex-1 min-w-[200px]">
                        <input name="q" value="@Query" class="field pr-9" placeholder="Search by model or name..." />
                        <span class="absolute right-3 top-3 text-slate-400">
                            <Icon Name="search" Class="size-4" />
                        </span>
                    </div>

                    <div class="flex items-center gap-2">
                        <input name="min-price" type="number" min="0" placeholder="Min ৳" value="@MinPrice" class="field w-24 text-xs" />
                        <span class="text-slate-400">-</span>
                        <input name="max-price" type="number" min="0" placeholder="Max ৳" value="@MaxPrice" class="field w-24 text-xs" />
                    </div>

                    <select name="sort" class="field w-auto text-xs">
                        <option value="relevance" selected="@(Sort == null || Sort == "relevance")">Sort: Relevance</option>
                        <option value="newest" selected="@(Sort == "newest")">Sort: Newest First</option>
                        <option value="price-low" selected="@(Sort == "price-low")">Price: Low to High</option>
                        <option value="price-high" selected="@(Sort == "price-high")">Price: High to Low</option>
                        <option value="name" selected="@(Sort == "name")">Sort: Product Name</option>
                    </select>

                    <button type="submit" class="btn-primary !px-4 !py-2.5 text-xs">
                        Apply
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Query) || MinPrice != null || MaxPrice != null || Sort != null)
                    {
                        <a href="@CategoryUrl(CategorySlug)" class="btn-secondary !px-3 !py-2.5 text-xs">
                            Reset
                        </a>
                    }
                </form>
            </div>

            <!-- Product Grid -->
            @if (products.Count == 0)
            {
                <div class="rounded-3xl border border-slate-200/90 bg-white p-12 text-center shadow-xs">
                    <Icon Name="box" Class="size-12 text-slate-300 mx-auto mb-3" />
                    <h3 class="font-bold text-slate-900 text-lg mb-1">No Products Found</h3>
                    <p class="text-xs text-slate-500 max-w-sm mx-auto mb-6">
                        No items matched your current filter criteria. Try adjusting your search query, price range, or category filter.
                    </p>
                    <a href="/products" class="btn-secondary text-xs">
                        Clear All Filters
                    </a>
                </div>
            }
            else
            {
                <ProductGrid Products="products" />
            }

            <!-- Pagination Bar -->
            @if (total > 18)
            {
                <div class="mt-10 flex items-center justify-between border-t border-slate-200 pt-6">
                    <div>
                        @if (Page > 1)
                        {
                            <a href="@Nav.GetUriWithQueryParameter("page", Page - 1)" class="btn-secondary text-xs">
                                ← Previous Page
                            </a>
                        }
                    </div>

                    <span class="text-xs font-semibold text-slate-500">
                        Page @Page of @Math.Max(1, (int)Math.Ceiling(total / 18.0))
                    </span>

                    <div>
                        @if (Page * 18 < total)
                        {
                            <a href="@Nav.GetUriWithQueryParameter("page", Page + 1)" class="btn-secondary text-xs">
                                Next Page →
                            </a>
                        }
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@code
{
    [Parameter]
    public string? CategorySlug { get; set; }
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "brand")]
    public string? BrandSlug { get; set; }
    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "min-price")]
    public decimal? MinPrice { get; set; }
    [SupplyParameterFromQuery(Name = "max-price")]
    public decimal? MaxPrice { get; set; }
    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    private List<ProductSummaryDto> products = [];
    private List<CategoryLinkDto> categories = [];
    private List<BrandLinkDto> brands = [];
    private Dictionary<int, List<CategoryLinkDto>> children = [];
    private string? activeCategoryName;
    private int total;

    protected override async Task OnInitializedAsync()
    {
        Page = Math.Clamp(Page, 1, 10000);
        (products, total) = await Catalog.SearchAsync(CategorySlug, Query, Sort, MinPrice, MaxPrice, Page, pageSize: 18, brand: BrandSlug);

        categories = await Catalog.CategoriesAsync();
        brands = await Catalog.BrandsAsync();
        children = categories.Where(c => c.ParentId.HasValue)
            .GroupBy(c => c.ParentId!.Value)
            .ToDictionary(g => g.Key, g => g.ToList());

        if (CategorySlug != null)
        {
            activeCategoryName = categories.FirstOrDefault(c => c.Slug == CategorySlug)?.Name;
        }
    }

    private string CategoryUrl(string? slug) => FilterUrl(slug, BrandSlug);

    private string FilterUrl(string? catSlug, string? brand)
    {
        var baseUri = catSlug is null ? "/products" : $"/category/{catSlug}";
        var query = new Dictionary<string, string?>();
        if (!string.IsNullOrWhiteSpace(Query)) query["q"] = Query;
        if (!string.IsNullOrWhiteSpace(brand)) query["brand"] = brand;
        if (!string.IsNullOrWhiteSpace(Sort)) query["sort"] = Sort;
        if (MinPrice.HasValue) query["min-price"] = MinPrice.Value.ToString();
        if (MaxPrice.HasValue) query["max-price"] = MaxPrice.Value.ToString();
        return QueryHelpers.AddQueryString(baseUri, query);
    }
}
