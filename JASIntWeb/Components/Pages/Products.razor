@page "/products/{categorySlug?}"

<PageTitle>Products — JAS International</PageTitle>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    <div class="mb-8">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-volt">
            JAS International
        </p>

        <h1 class="font-display mt-1 text-3xl font-semibold tracking-tight sm:text-4xl">
            Products
        </h1>

        <p class="mt-2 text-sm text-slate-500">
            Explore our latest gadgets and accessories.
        </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-[240px_1fr]">

        <!-- Desktop sidebar -->
        <CategorySidebar CategorySlug="@CategorySlug" />

        <!-- Main catalog -->
        <section>

            <!-- Mobile filters -->
            <MobileCategorySidebar CategorySlug="@CategorySlug" />

            <div class="mb-5 flex items-center justify-between gap-4">

                <p class="text-sm text-slate-500">
                    <span class="font-medium text-ink">
                        @_products.Count
                    </span>
                    products
                </p>

                <SortDropdown />

            </div>

            <ProductGrid Products="_products" />

        </section>

    </div>

</div>

@code {

    private List<Product> _products = [];

    [Parameter]
    public string? CategorySlug { get; set; }

    

    protected override async Task OnInitializedAsync()
    {
        _products = await LoadProductsAsync();
