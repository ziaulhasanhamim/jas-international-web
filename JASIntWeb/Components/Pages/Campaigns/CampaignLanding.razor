@page "/campaigns/{Slug}"
@page "/offers/{Slug}"
@rendermode InteractiveServer
@inject CampaignService CampaignSvc
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(campaign != null ? $"{campaign.Name} · Deals &amp; Offers" : "Campaign") · JAS International</PageTitle>

@if (loading)
{
    <div class="min-h-[50vh] flex items-center justify-center">
        <div class="text-center">
            <span class="inline-block animate-spin text-3xl mb-3">⏳</span>
            <p class="text-sm font-semibold text-slate-500">Loading campaign deals…</p>
        </div>
    </div>
}
else if (campaign is null)
{
    <div class="max-w-3xl mx-auto px-4 py-20 text-center">
        <span class="text-5xl block mb-4">🔍</span>
        <h1 class="text-2xl font-bold text-slate-900">Campaign Not Found</h1>
        <p class="text-sm text-slate-500 mt-2">The campaign you are looking for has expired or is no longer available.</p>
        <div class="mt-6 flex justify-center gap-3">
            <a href="/offers" class="shop-button">View All Offers</a>
            <a href="/products" class="shop-button-secondary">Browse Catalog</a>
        </div>
    </div>
}
else
{
    <SeoHead
        Title="@(string.IsNullOrWhiteSpace(campaign.MetaTitle) ? $"{campaign.Name} | Mega Festival Deals | JAS International" : campaign.MetaTitle)"
        Description="@(string.IsNullOrWhiteSpace(campaign.MetaDescription) ? (campaign.Description ?? $"Shop exclusive {campaign.Name} discounts and deals at JAS International.") : campaign.MetaDescription)"
        CanonicalPath="@($"/campaigns/{campaign.Slug}")"
        OgImage="@(string.IsNullOrWhiteSpace(campaign.OgImageUrl) ? campaign.BannerImageUrl : campaign.OgImageUrl)"
        OgType="website"
    />

    <main class="min-h-screen bg-slate-50/70 pb-20">
        <!-- Hero Section with Campaign Theme -->
        <section class="@GetThemeHeroClasses(campaign.ThemeColor) relative overflow-hidden py-10 sm:py-16 text-white shadow-inner">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.1),transparent_60%)] pointer-events-none"></div>

            <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Breadcrumbs -->
                <nav class="flex items-center gap-2 text-xs text-white/70 mb-6 font-medium" aria-label="Breadcrumb">
                    <a href="/" class="hover:text-white transition">Home</a>
                    <span>/</span>
                    <a href="/offers" class="hover:text-white transition">Offers</a>
                    <span>/</span>
                    <span class="text-white font-semibold truncate max-w-[200px] sm:max-w-none">@campaign.Name</span>
                </nav>

                @if (!string.IsNullOrWhiteSpace(campaign.BannerImageUrl) || !string.IsNullOrWhiteSpace(campaign.MobileBannerImageUrl))
                {
                    var desktopSrc = !string.IsNullOrWhiteSpace(campaign.BannerImageUrl)
                        ? campaign.BannerImageUrl
                        : campaign.MobileBannerImageUrl!;
                    <div class="mb-6 sm:mb-8 rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl border border-white/15 bg-black/20">
                        <picture class="block w-full">
                            @if (!string.IsNullOrWhiteSpace(campaign.MobileBannerImageUrl))
                            {
                                <source media="(max-width: 640px)" srcset="@campaign.MobileBannerImageUrl" />
                            }
                            <img src="@desktopSrc"
                                 alt="@campaign.Name"
                                 class="w-full h-auto block" />
                        </picture>
                    </div>
                }

                <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
                    <div class="space-y-4 max-w-3xl">
                        <div class="flex flex-wrap items-center gap-2">
                            @if (!string.IsNullOrWhiteSpace(campaign.Eyebrow))
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-white/15 backdrop-blur-xs text-white border border-white/20">
                                    ⚡ @campaign.Eyebrow
                                </span>
                            }
                            @if (isUpcoming)
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-blue-500/80 text-white border border-white/20">
                                    🕒 Coming Soon · Teaser Preview
                                </span>
                            }
                            else if (campaign.DiscountScenario != CampaignDiscountScenario.MarketingOnly)
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-500/90 text-white border border-white/20">
                                    @GetHeroScenarioPill(campaign)
                                </span>
                            }
                        </div>

                        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight font-display text-white leading-tight">
                            @campaign.Name
                        </h1>

                        @if (!string.IsNullOrWhiteSpace(campaign.BanglaName))
                        {
                            <p class="text-lg sm:text-xl font-bold text-amber-300">
                                @campaign.BanglaName
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(campaign.Description))
                        {
                            <p class="text-sm sm:text-base text-white/85 max-w-2xl leading-relaxed">
                                @campaign.Description
                            </p>
                        }
                    </div>

                    <div class="shrink-0 flex flex-col items-start lg:items-end gap-3">
                        <!-- Live Countdown Timer (Upcoming Start OR Live Expiration) -->
                        @if (campaign.ShowCountdown && !hasExpired && ((isUpcoming && campaign.StartDate.HasValue) || campaign.EndDate.HasValue))
                        {
                            <div>
                                <span class="block text-xs font-bold uppercase tracking-wider text-white/80 mb-2 lg:text-right">
                                    @(isUpcoming ? "🚀 Campaign Starts In" : "⏳ Deals Expire In")
                                </span>
                                <div class="flex items-center gap-2 sm:gap-3 text-center">
                                    <div class="px-3 py-2 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 min-w-[56px] sm:min-w-[64px]">
                                        <span class="block text-xl sm:text-2xl font-black font-mono text-white">@daysRemaining.ToString("D2")</span>
                                        <span class="block text-[10px] font-bold text-white/70 uppercase">Days</span>
                                    </div>
                                    <span class="text-xl font-black text-white/60">:</span>
                                    <div class="px-3 py-2 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 min-w-[56px] sm:min-w-[64px]">
                                        <span class="block text-xl sm:text-2xl font-black font-mono text-white">@hoursRemaining.ToString("D2")</span>
                                        <span class="block text-[10px] font-bold text-white/70 uppercase">Hours</span>
                                    </div>
                                    <span class="text-xl font-black text-white/60">:</span>
                                    <div class="px-3 py-2 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 min-w-[56px] sm:min-w-[64px]">
                                        <span class="block text-xl sm:text-2xl font-black font-mono text-white">@minsRemaining.ToString("D2")</span>
                                        <span class="block text-[10px] font-bold text-white/70 uppercase">Mins</span>
                                    </div>
                                    <span class="text-xl font-black text-white/60">:</span>
                                    <div class="px-3 py-2 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 min-w-[56px] sm:min-w-[64px]">
                                        <span class="block text-xl sm:text-2xl font-black font-mono text-white">@secsRemaining.ToString("D2")</span>
                                        <span class="block text-[10px] font-bold text-white/70 uppercase">Secs</span>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Highlighted Coupon Promo Code Box -->
                        @if (!string.IsNullOrWhiteSpace(campaign.HighlightCouponCode))
                        {
                            <div>
                                <div class="inline-flex flex-col sm:flex-row items-stretch sm:items-center gap-2 p-2 rounded-2xl bg-white/10 backdrop-blur-md border border-white/25">
                                    <div class="flex items-center gap-2 px-3 py-1.5 text-xs font-semibold text-white">
                                        <span>🎟️ Promo Voucher:</span>
                                        <span class="font-mono text-sm tracking-wider uppercase font-extrabold text-amber-300">
                                            @campaign.HighlightCouponCode
                                        </span>
                                    </div>
                                    <button type="button"
                                            @onclick="CopyCouponCode"
                                            class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl font-bold text-xs bg-white text-slate-900 hover:bg-slate-100 shadow-sm transition active:scale-95 cursor-pointer">
                                        @if (copiedCode)
                                        {
                                            <span>✓ Copied!</span>
                                        }
                                        else
                                        {
                                            <Icon Name="copy" Class="size-3.5" />
                                            <span>Copy Code</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>

        @if (campaign.Products.Count > 0)
        {
            @if (isUpcoming && (campaign.DiscountScenario == CampaignDiscountScenario.DirectDiscount || campaign.DiscountScenario == CampaignDiscountScenario.DirectAndCoupon))
            {
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
                    <div class="rounded-2xl border border-indigo-200 bg-indigo-50 px-4 py-3 text-xs sm:text-sm text-indigo-900 flex items-center gap-2.5 shadow-2xs">
                        <span class="text-base shrink-0">🕒</span>
                        <span>
                            <strong>Campaign starts @(campaign.StartDate?.ToLocalTime().ToString("MMM dd, hh:mm tt")):</strong>
                            Regular prices apply now; each deal card below previews the exact offer price that activates automatically at launch.
                        </span>
                    </div>
                </div>
            }
            <!-- Category Chips & Social Share Toolbar -->
            <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-2xl bg-white border border-slate-200/90 shadow-2xs">
                    <!-- Category Filter Chips -->
                    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 scrollbar-none">
                        <button type="button" @onclick="() => selectedCategory = null"
                                class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition whitespace-nowrap cursor-pointer @(string.IsNullOrWhiteSpace(selectedCategory) ? "bg-slate-900 text-white shadow-2xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                            All Deals (@campaign.Products.Count)
                        </button>
                        @foreach (var cat in AvailableCategories)
                        {
                            var count = campaign.Products.Count(p => p.Category == cat);
                            <button type="button" @onclick="() => selectedCategory = cat"
                                    class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition whitespace-nowrap cursor-pointer @(selectedCategory == cat ? "bg-slate-900 text-white shadow-2xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                                @cat (@count)
                            </button>
                        }
                    </div>

                    <!-- Social Sharing -->
                    <div class="flex items-center gap-2 shrink-0 self-end sm:self-center">
                        <span class="text-xs font-bold text-slate-400 mr-1">Share:</span>
                        <a href="@($"https://api.whatsapp.com/send?text={Uri.EscapeDataString($"{campaign.Name} Deal: {Nav.Uri}")}")"
                           target="_blank" rel="noopener noreferrer"
                           class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 transition" title="Share via WhatsApp">
                            <span>💬</span> WhatsApp
                        </a>
                        <a href="@($"https://www.facebook.com/sharer/sharer.php?u={Uri.EscapeDataString(Nav.Uri)}")"
                           target="_blank" rel="noopener noreferrer"
                           class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100 transition" title="Share on Facebook">
                            <span>👍</span> Facebook
                        </a>
                        <button type="button" @onclick="CopyShareLink"
                                class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 transition cursor-pointer" title="Copy campaign link">
                            <span>@(copiedLink ? "✓ Copied!" : "🔗 Copy Link")</span>
                        </button>
                    </div>
                </div>
            </section>
        }

        <!-- Deals Products Grid Section -->
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
            <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-200">
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 font-display">
                        @(string.IsNullOrWhiteSpace(selectedCategory) ? "Featured Campaign Deals" : $"{selectedCategory} Deals")
                    </h2>
                    <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
                        Grab verified original gear at special promotional prices with official warranty.
                    </p>
                </div>
                <span class="text-xs font-bold text-slate-600 bg-slate-100 px-3 py-1 rounded-full">
                    @FilteredProducts.Count() Product@(FilteredProducts.Count() == 1 ? "" : "s")
                </span>
            </div>

            @if (campaign.Products.Count == 0)
            {
                <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center shadow-xs">
                    <span class="text-4xl block mb-2">📦</span>
                    <h3 class="text-base font-bold text-slate-800">Deals Coming Soon</h3>
                    <p class="text-xs text-slate-500 mt-1">Products for this campaign are being loaded. Please check back shortly!</p>
                </div>
            }
            else if (!FilteredProducts.Any())
            {
                <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center shadow-xs">
                    <span class="text-3xl block mb-2">🔍</span>
                    <h3 class="text-base font-bold text-slate-800">No deals in this category</h3>
                    <p class="text-xs text-slate-500 mt-1">Select another category or view all deals.</p>
                    <button type="button" @onclick="() => selectedCategory = null" class="btn-secondary text-xs mt-3">View All Deals</button>
                </div>
            }
            else
            {
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
                    @foreach (var p in FilteredProducts)
                    {
                        <ProductCard Product="@p" />
                    }
                </div>
            }
        </section>

        <!-- Trust & Official Guarantee Banner -->
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 p-6 rounded-3xl bg-white border border-slate-200/90 shadow-2xs text-center">
                <div class="space-y-1">
                    <span class="text-2xl">🛡️</span>
                    <h4 class="font-bold text-slate-900 text-sm">Official Warranty</h4>
                    <p class="text-xs text-slate-500">100% authentic tech with manufacturer replacement warranty.</p>
                </div>
                <div class="space-y-1">
                    <span class="text-2xl">🚚</span>
                    <h4 class="font-bold text-slate-900 text-sm">Fast Courier Delivery</h4>
                    <p class="text-xs text-slate-500">Khulna local delivery in 24h, nationwide 64 districts in 48-72h.</p>
                </div>
                <div class="space-y-1">
                    <span class="text-2xl">⚡</span>
                    <h4 class="font-bold text-slate-900 text-sm">Best Price Guarantee</h4>
                    <p class="text-xs text-slate-500">Exclusive campaign discount pricing directly from authorized imports.</p>
                </div>
            </div>
        </section>
    </main>
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private CampaignDetailsDto? campaign;
    private bool loading = true;
    private bool copiedCode;
    private bool copiedLink;
    private string? selectedCategory;

    private IEnumerable<string> AvailableCategories =>
        campaign?.Products.Select(p => p.Category).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct() ?? [];

    private IEnumerable<ProductSummaryDto> FilteredProducts =>
        string.IsNullOrWhiteSpace(selectedCategory)
            ? campaign?.Products ?? []
            : (campaign?.Products.Where(p => p.Category == selectedCategory) ?? []);

    private int daysRemaining;
    private int hoursRemaining;
    private int minsRemaining;
    private int secsRemaining;
    private bool isUpcoming;
    private bool hasExpired;

    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        campaign = await CampaignSvc.GetCampaignBySlugAsync(Slug);
        loading = false;

        if (campaign?.StartDate.HasValue == true || campaign?.EndDate.HasValue == true)
        {
            UpdateCountdown();
            StartTimer();
        }
    }

    private void UpdateCountdown()
    {
        if (campaign == null) return;
        var now = DateTimeOffset.UtcNow;

        DateTimeOffset? targetDate = null;
        if (campaign.StartDate.HasValue && campaign.StartDate.Value > now)
        {
            isUpcoming = true;
            hasExpired = false;
            targetDate = campaign.StartDate.Value;
        }
        else if (campaign.EndDate.HasValue)
        {
            isUpcoming = false;
            targetDate = campaign.EndDate.Value;
        }
        else
        {
            isUpcoming = false;
            hasExpired = false;
            return;
        }

        var diff = targetDate.Value - now;
        if (diff <= TimeSpan.Zero)
        {
            if (isUpcoming)
            {
                // Window just started; re-evaluate toward EndDate if present
                isUpcoming = false;
                if (campaign.EndDate.HasValue && campaign.EndDate.Value > now)
                {
                    diff = campaign.EndDate.Value - now;
                    hasExpired = false;
                }
                else
                {
                    hasExpired = campaign.EndDate.HasValue;
                    daysRemaining = hoursRemaining = minsRemaining = secsRemaining = 0;
                    return;
                }
            }
            else
            {
                hasExpired = true;
                daysRemaining = 0;
                hoursRemaining = 0;
                minsRemaining = 0;
                secsRemaining = 0;
                return;
            }
        }

        hasExpired = false;
        daysRemaining = (int)diff.TotalDays;
        hoursRemaining = diff.Hours;
        minsRemaining = diff.Minutes;
        secsRemaining = diff.Seconds;
    }

    private static string GetHeroScenarioPill(CampaignDetailsDto c) => c.DiscountScenario switch
    {
        CampaignDiscountScenario.DirectDiscount when c.DefaultDiscountType == CampaignProductDiscountType.Percentage && c.DefaultDiscountValue > 0
            => $"🔥 Up to {c.DefaultDiscountValue:0.##}% Off Sitewide Deals",
        CampaignDiscountScenario.DirectDiscount => "🔥 Scheduled Direct Discounts Live",
        CampaignDiscountScenario.CouponOnly => "🎟️ Coupon Voucher Exclusive",
        CampaignDiscountScenario.DirectAndCoupon => "⚡ Direct Markdowns + Coupon Stackable",
        _ => "✨ Special Showcase Event"
    };

    private void StartTimer()
    {
        cts?.Cancel();
        cts = new CancellationTokenSource();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RunTimerAsync(cts.Token);
    }

    private async Task RunTimerAsync(CancellationToken token)
    {
        try
        {
            while (await timer!.WaitForNextTickAsync(token))
            {
                UpdateCountdown();
                await InvokeAsync(StateHasChanged);
                if (hasExpired) break;
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task CopyCouponCode()
    {
        if (string.IsNullOrWhiteSpace(campaign?.HighlightCouponCode)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", campaign.HighlightCouponCode);
            copiedCode = true;
            await Task.Delay(2000);
            copiedCode = false;
        }
        catch { }
    }

    private async Task CopyShareLink()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Nav.Uri);
            copiedLink = true;
            await Task.Delay(2000);
            copiedLink = false;
        }
        catch { }
    }

    private static string GetThemeHeroClasses(string? theme) => theme?.ToLowerInvariant() switch
    {
        "crimson" or "red" => "bg-gradient-to-br from-rose-950 via-red-950 to-slate-950",
        "emerald" or "green" => "bg-gradient-to-br from-emerald-950 via-teal-950 to-slate-950",
        "amber" or "orange" => "bg-gradient-to-br from-amber-950 via-orange-950 to-slate-950",
        "purple" => "bg-gradient-to-br from-purple-950 via-violet-950 to-slate-950",
        "navy" => "bg-gradient-to-br from-slate-950 via-blue-950 to-slate-900",
        _ => "bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-950"
    };

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
        timer?.Dispose();
    }
}
