@page "/wishlist"
@rendermode InteractiveServer
@using JASIntWeb.Persistence
@using JASIntWeb.Persistence.Entities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>My Wishlist — JAS International</PageTitle>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="mb-6 flex items-center gap-2 text-xs font-semibold text-slate-500">
        <a href="/" class="hover:text-blue-600 transition">Home</a>
        <span>/</span>
        <span class="text-slate-900 font-bold">Wishlist</span>
    </nav>

    <!-- Header -->
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-slate-200/80 pb-5">
        <div class="flex items-center gap-3">
            <div class="flex size-12 items-center justify-center rounded-2xl bg-rose-50 text-rose-600 border border-rose-100">
                <Icon Name="heart" Class="size-6 text-rose-600 fill-rose-100" />
            </div>
            <div>
                <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900">My Wishlist</h1>
                <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
                    Saved items on this device. Price updates and stock availability are tracked automatically.
                </p>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="py-16 text-center text-slate-400 text-xs flex items-center justify-center gap-2">
            <span class="size-2 rounded-full bg-rose-600 animate-ping"></span>
            <span>Loading saved wishlist items…</span>
        </div>
    }
    else if (products.Count == 0)
    {
        <div class="mx-auto max-w-md py-16 text-center">
            <div class="mx-auto flex size-20 items-center justify-center rounded-3xl bg-slate-100 text-slate-400 mb-5">
                <svg class="size-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
            </div>
            <h2 class="text-xl font-bold text-slate-900">Your wishlist is currently empty</h2>
            <p class="mt-2 text-sm text-slate-500 leading-relaxed">
                Explore our catalog of authentic smartwatches, audio gear, chargers, and gadget accessories. Click the heart icon on any product to save it here.
            </p>
            <div class="mt-6 flex justify-center">
                <a href="/products" class="btn-primary shadow-xs">Explore Products</a>
            </div>
        </div>
    }
    else
    {
        <div class="mb-6 flex items-center justify-between">
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">
                @products.Count @(products.Count == 1 ? "Item" : "Items")
            </span>
            <button
                type="button"
                @onclick="ClearWishlistAsync"
                class="rounded-xl border border-slate-200 px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 transition cursor-pointer"
            >
                Clear All
            </button>
        </div>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
            @foreach (var p in products)
            {
                var price = p.ProductVariants.Where(v => v.IsActive && !v.IsDeleted).OrderByDescending(v => v.IsDefault).Select(v => v.SellingPrice).FirstOrDefault();
                <article @key="p.Id" class="product-card group relative flex flex-col justify-between h-full bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-xl hover:border-slate-300 transition-all duration-300 overflow-hidden">
                    <button
                        type="button"
                        @onclick="() => RemoveItemAsync(p.Id)"
                        class="absolute top-2.5 right-2.5 z-20 flex size-8 items-center justify-center rounded-full bg-white/90 backdrop-blur-sm border border-slate-200/90 text-rose-500 hover:scale-110 shadow-xs transition cursor-pointer"
                        title="Remove from wishlist"
                        aria-label="@($"Remove {p.Name} from wishlist")"
                    >
                        <svg class="size-4 fill-rose-500 text-rose-500" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                        </svg>
                    </button>
                    <a href="/product/@p.Slug" class="block relative aspect-square p-5 bg-white overflow-hidden">
                        <img
                            src="@(string.IsNullOrWhiteSpace(p.MainImageUrl) ? "/jas-logo.png" : p.MainImageUrl)"
                            alt="@p.Name"
                            loading="lazy"
                            class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
                        />
                    </a>
                    <div class="px-4 pb-4 pt-1 flex flex-col flex-1 text-center">
                        <a href="/product/@p.Slug" class="block font-bold text-slate-900 text-sm hover:text-orange-600 transition line-clamp-2 min-h-[2.5rem] leading-snug">
                            @p.Name
                        </a>
                        <div class="flex items-baseline justify-center gap-1.5 my-2">
                            <span class="text-base sm:text-lg font-black text-[#ea580c]">Tk. @price.ToString("N0")</span>
                        </div>
                        <div class="mt-auto pt-2 border-t border-slate-100">
                            <form method="post" action="/cart/buy-now" data-enhance class="w-full">
                                <AntiforgeryToken />
                                <input type="hidden" name="productId" value="@p.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <button
                                    type="submit"
                                    data-buy-now
                                    data-product-id="@p.Id"
                                    class="btn-primary w-full py-2 text-xs font-bold transition flex items-center justify-center gap-1.5 shadow-xs hover:shadow-md cursor-pointer"
                                >
                                    <span>⚡ Buy Now</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private bool loading = true;
    private List<Product> products = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadWishlistAsync();
        }
    }

    private async Task LoadWishlistAsync()
    {
        try
        {
            var ids = await JS.InvokeAsync<int[]>("jasGetWishlistIds");
            if (ids != null && ids.Length > 0)
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                products = await db.Products.AsNoTracking()
                    .Include(p => p.ProductVariants)
                    .Where(p => ids.Contains(p.Id) && !p.IsDeleted)
                    .ToListAsync();
            }
            else
            {
                products = [];
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task RemoveItemAsync(int productId)
    {
        products.RemoveAll(p => p.Id == productId);
        try
        {
            await JS.InvokeVoidAsync("jasRemoveFromWishlist", productId);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
        }
    }

    private async Task ClearWishlistAsync()
    {
        products.Clear();
        try
        {
            await JS.InvokeVoidAsync("jasClearWishlist");
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
        }
    }
}
