@page "/wishlist"
@attribute [StreamRendering]

<PageTitle>My Wishlist — JAS International</PageTitle>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="mb-6 flex items-center gap-2 text-xs font-semibold text-slate-500">
        <a href="/" class="hover:text-blue-600 transition">Home</a>
        <span>/</span>
        <span class="text-slate-900 font-bold">Wishlist</span>
    </nav>

    <!-- Header -->
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-slate-200/80 pb-5">
        <div class="flex items-center gap-3">
            <div class="flex size-12 items-center justify-center rounded-2xl bg-rose-50 text-rose-600 border border-rose-100">
                <Icon Name="heart" Class="size-6 text-rose-600 fill-rose-100" />
            </div>
            <div>
                <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900">My Wishlist</h1>
                <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
                    Saved items you are interested in. Price updates and stock availability are tracked automatically.
                </p>
            </div>
        </div>
    </div>

    <!-- Client Interactive Content -->
    <WishlistClientView />
</div>
