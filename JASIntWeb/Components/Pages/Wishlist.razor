@page "/wishlist"
@rendermode InteractiveServer
@implements IDisposable
@inject WishlistService WishlistSvc
@inject CartService Cart

<PageTitle>My Wishlist — JAS International</PageTitle>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="mb-6 flex items-center gap-2 text-xs font-semibold text-slate-500">
        <a href="/" class="hover:text-blue-600 transition">Home</a>
        <span>/</span>
        <span class="text-slate-900 font-bold">Wishlist</span>
    </nav>

    <!-- Header -->
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-slate-200/80 pb-5">
        <div class="flex items-center gap-3">
            <div class="flex size-12 items-center justify-center rounded-2xl bg-rose-50 text-rose-600 border border-rose-100">
                <Icon Name="heart" Class="size-6 text-rose-600 fill-rose-100" />
            </div>
            <div>
                <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900">My Wishlist</h1>
                <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
                    Saved items you are interested in. Price updates and stock availability are tracked automatically.
                </p>
            </div>
        </div>

        @if (WishlistSvc.Items.Count > 0)
        {
            <div class="flex items-center gap-3">
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">
                    @WishlistSvc.Items.Count @(WishlistSvc.Items.Count == 1 ? "Item" : "Items")
                </span>
                <button
                    type="button"
                    @onclick="ClearWishlist"
                    class="rounded-xl border border-slate-200 px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 transition"
                >
                    Clear All
                </button>
            </div>
        }
    </div>

    <!-- Content -->
    @if (WishlistSvc.Items.Count == 0)
    {
        <div class="mx-auto max-w-md py-16 text-center">
            <div class="mx-auto flex size-20 items-center justify-center rounded-3xl bg-slate-100 text-slate-400 mb-5">
                <Icon Name="heart" Class="size-10 text-slate-400" />
            </div>
            <h2 class="text-xl font-bold text-slate-900">Your wishlist is currently empty</h2>
            <p class="mt-2 text-sm text-slate-500 leading-relaxed">
                Explore our catalog of smartphones, premium audio gear, smartwatches, and chargers. Click the heart icon on any product to save it here for later.
            </p>
            <div class="mt-6 flex justify-center gap-3">
                <a href="/products" class="rounded-xl bg-blue-600 px-6 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-blue-700 transition">
                    Explore Gadgets
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
            @foreach (var product in WishlistSvc.Items)
            {
                <div class="relative">
                    <ProductCard Product="product" />
                </div>
            }
        </div>
    }
</div>

@code
{
    protected override void OnInitialized()
    {
        WishlistSvc.OnChange += OnWishlistChanged;
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            await WishlistSvc.EnsureLoadedAsync();
            StateHasChanged();
        }
    }

    private void OnWishlistChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ClearWishlist()
    {
        await WishlistSvc.ClearAsync();
    }

    public void Dispose()
    {
        WishlistSvc.OnChange -= OnWishlistChanged;
    }
}
