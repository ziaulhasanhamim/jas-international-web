@page "/not-found"
@layout MainLayout

<CascadingAuthenticationState>
@{
    if (HttpContext != null)
    {
        HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
    }
}
<SeoHead Title="404 Page Not Found | JAS International"
         Description="The requested page could not be found on JAS International."
         Robots="noindex,follow" />

<div class="shop-container py-20 text-center max-w-lg mx-auto">
    <div class="mx-auto flex size-16 items-center justify-center rounded-2xl bg-rose-50 text-rose-600 mb-4 ring-1 ring-rose-200">
        <Icon Name="alert" Class="size-8" />
    </div>
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Page Not Found</h1>
    <p class="text-xs sm:text-sm text-slate-500 mt-2 mb-8 leading-relaxed">
        The page you are looking for may have been moved, renamed, or is temporarily unavailable.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/" class="btn-primary w-full sm:w-auto text-xs px-6 py-2.5">
            Return to Homepage
        </a>
        <a href="/products" class="btn-secondary w-full sm:w-auto text-xs px-6 py-2.5">
            Browse All Products
        </a>
    </div>
</div>
</CascadingAuthenticationState>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
}
