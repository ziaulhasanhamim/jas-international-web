@page "/payment-verification"
@rendermode InteractiveServer
@implements IDisposable
@using JASIntWeb.Persistence
@using JASIntWeb.Persistence.Entities
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Nav

<PageTitle>@(order is null ? "Payment Verification" : $"Payment Verification · Order #{order.Id}") · JAS International</PageTitle>

<div class="shop-container py-12 max-w-2xl mx-auto">
    @if (isLoading)
    {
        <div class="rounded-3xl border border-slate-200/90 bg-white p-12 text-center shadow-xs">
            <span class="inline-block size-8 border-3 border-blue-600 border-t-transparent rounded-full animate-spin mb-4"></span>
            <p class="text-sm font-semibold text-slate-700">Checking order payment status…</p>
        </div>
    }
    else if (order is null)
    {
        <div class="rounded-3xl border border-slate-200/90 bg-white p-12 text-center shadow-xs">
            <Icon Name="alert" Class="size-12 text-slate-300 mx-auto mb-3" />
            <h1 class="text-2xl font-bold text-slate-900">Order Not Found</h1>
            <p class="text-xs text-slate-500 mt-2 mb-6">The requested order reference could not be located or invalid reference provided.</p>
            <a href="/orders" class="btn-primary">View Your Orders</a>
        </div>
    }
    else
    {
        <div id="payment-verification-stream" data-order-id="@order.Id" class="rounded-3xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
            <!-- Header Banner -->
            <div class="bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 p-8 text-white text-center">
                <span class="flex size-14 items-center justify-center rounded-full bg-white/10 ring-4 ring-white/20 text-white mx-auto mb-4 backdrop-blur-xs">
                    <svg class="size-8 animate-spin" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                </span>

                <span class="text-xs font-bold uppercase tracking-widest text-blue-200 block mb-1">
                    STEP 2 OF 3 · PAYMENT VERIFICATION
                </span>

                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
                    Awaiting Payment Verification
                </h1>

                <p class="text-xs text-blue-100 mt-2 max-w-md mx-auto">
                    We have recorded your transaction details for <strong>Order #@order.Id</strong>. We are verifying the payment with our bKash merchant system.
                </p>
            </div>

            <!-- Body Content -->
            <div class="p-6 sm:p-8 space-y-6">
                <!-- Live SSE Connection Badge -->
                <div class="rounded-2xl border border-blue-200 bg-blue-50/80 p-4 text-xs text-blue-950 space-y-2">
                    <div class="flex items-center gap-2.5 font-bold text-sm text-blue-900">
                        <span class="relative flex size-3">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full size-3 bg-blue-600"></span>
                        </span>
                        <span id="sse-status-label">Live Verification Stream Active (SSE)</span>
                    </div>
                    <p class="text-xs text-blue-800 leading-relaxed">
                        If you leave this tab open, <strong>this page will automatically redirect to your final order receipt</strong> the instant payment confirmation is received.
                    </p>
                    <p class="text-[11px] text-blue-700 pt-1.5 border-t border-blue-200/60">
                        ✓ <strong>You can also safely close this tab.</strong> If you return to this order via your Order History, you will be brought back here until payment verification is complete.
                    </p>
                </div>

                <!-- Transaction Details Card -->
                <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-5 text-xs space-y-3">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-200">
                        <span class="text-slate-500 font-semibold">Order Reference:</span>
                        <span class="font-mono font-bold text-blue-600 text-sm">#@order.Id</span>
                    </div>

                    <div class="flex items-center justify-between">
                        <span class="text-slate-500">Claimed bKash TrxID:</span>
                        <strong class="font-mono text-slate-900 text-xs bg-white px-2 py-0.5 rounded border border-slate-200">
                            @(string.IsNullOrEmpty(order.TransactionId) ? "Pending Submission" : order.TransactionId)
                        </strong>
                    </div>

                    @if (!string.IsNullOrEmpty(order.SenderPhoneNumber))
                    {
                        <div class="flex items-center justify-between">
                            <span class="text-slate-500">Sender Phone:</span>
                            <span class="font-mono text-slate-800">@order.SenderPhoneNumber</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(order.PaymentReferenceCode))
                    {
                        <div class="flex items-center justify-between">
                            <span class="text-slate-500">Payment Ref Code:</span>
                            <span class="font-mono text-slate-800">@order.PaymentReferenceCode</span>
                        </div>
                    }

                    <div class="flex items-center justify-between pt-2 border-t border-slate-200">
                        <span class="text-slate-500">Order Total:</span>
                        <span class="font-bold text-slate-900 text-sm">৳@order.Total.ToString("N0")</span>
                    </div>
                </div>

                <!-- Action / Help Notice -->
                <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-4 text-xs text-amber-900 space-y-1">
                    <div class="font-bold flex items-center gap-1.5 text-amber-950">
                        <Icon Name="clock" Class="size-4" />
                        Verification Timeline
                    </div>
                    <p class="text-[11px] text-amber-800">
                        Payments are usually verified within 2 to 10 minutes during business hours. An official confirmation email will also be sent as soon as verified.
                    </p>
                </div>

                <!-- Manual refresh button & history button -->
                <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
                    <a href="/order/@order.Id" class="btn-primary w-full text-center">
                        Check Status &amp; Go to Order
                    </a>
                    <a href="/orders" class="btn-secondary w-full text-center">
                        View All Orders
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@code
{
    [SupplyParameterFromQuery(Name = "orderid")]
    public string? OrderIdParam { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? TokenParam { get; set; }

    private Order? order;
    private bool isLoading = true;
    private CancellationTokenSource? cts;

    protected override async Task OnInitializedAsync()
    {
        var targetRef = !string.IsNullOrWhiteSpace(OrderIdParam) ? OrderIdParam : TokenParam;
        if (!string.IsNullOrWhiteSpace(targetRef))
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            var q = db.Orders.AsNoTracking()
                .Include(o => o.DeliveryAddress)
                .Include(o => o.Payments)
                .AsQueryable();

            if (int.TryParse(targetRef, out int id))
            {
                order = await q.FirstOrDefaultAsync(o => o.Id == id);
            }
            else if (Guid.TryParse(targetRef, out Guid token))
            {
                order = await q.FirstOrDefaultAsync(o => o.PublicToken == token);
            }

            if (order != null)
            {
                var isVerified = order.PaidAmount > 0 && order.Payments.Any(p => p.Status == PaymentStatus.Completed);
                var isCancelled = order.Status == OrderStatus.Cancelled;

                // If already verified or cancelled, redirect immediately to final order summary!
                if (isVerified || isCancelled)
                {
                    Nav.NavigateTo($"/order/{order.Id}");
                    return;
                }
            }
        }
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && order != null)
        {
            cts = new CancellationTokenSource();
            _ = MonitorPaymentAsync(cts.Token);
        }
    }

    private async Task MonitorPaymentAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        while (!ct.IsCancellationRequested && await timer.WaitForNextTickAsync(ct))
        {
            try
            {
                await using var scope = ScopeFactory.CreateAsyncScope();
                var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
                var cur = await db.Orders.AsNoTracking()
                    .Where(o => o.Id == order!.Id)
                    .Select(o => new
                    {
                        IsVerified = o.PaidAmount > 0 && o.Payments.Any(p => p.Status == PaymentStatus.Completed),
                        IsCancelled = o.Status == OrderStatus.Cancelled
                    })
                    .FirstOrDefaultAsync(ct);

                if (cur != null && (cur.IsVerified || cur.IsCancelled))
                {
                    await InvokeAsync(() =>
                    {
                        Nav.NavigateTo($"/order/{order!.Id}", forceLoad: true);
                    });
                    break;
                }
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch
            {
                // Silently retry next tick
            }
        }
    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }
}
