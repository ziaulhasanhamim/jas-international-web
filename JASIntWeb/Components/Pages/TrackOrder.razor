@page "/track"
@inject AppDbContext Db

<PageTitle>Track Order · JAS International</PageTitle>

<div class="shop-container py-10 max-w-4xl mx-auto">
    <div class="text-center mb-8">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700 ring-1 ring-blue-600/20 mb-3">
            ORDER FULFILLMENT
        </span>
        <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mb-2">
            Live Order Tracking
        </h1>
        <p class="text-sm text-slate-500 max-w-md mx-auto">
            Check the real-time shipping status and delivery updates of your order.
        </p>
    </div>

    <!-- Search Form -->
    <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs mb-8">
        <form method="get" data-enhance class="grid gap-4 sm:grid-cols-2 items-end">
            <div>
                <label class="field-label">Order Number or Tracking Token</label>
                <input name="orderId" value="@OrderId" required placeholder="e.g. 1042 or tracking code" class="field" />
            </div>
            <div>
                <label class="field-label">Delivery Phone Number</label>
                <input name="phone" value="@Phone" required type="tel" placeholder="e.g. 017xxxxxxxx" class="field" />
            </div>
            <div class="sm:col-span-2 flex justify-end">
                <button type="submit" class="btn-primary w-full sm:w-auto">
                    <Icon Name="search" Class="size-4" />
                    Track Shipment
                </button>
            </div>
        </form>
    </div>

    @if (hasSearched)
    {
        @if (order is null)
        {
            <div class="rounded-2xl border border-rose-200 bg-rose-50 p-6 text-center">
                <Icon Name="alert" Class="size-10 text-rose-500 mx-auto mb-2" />
                <h3 class="font-bold text-rose-900 text-base mb-1">Order Not Found</h3>
                <p class="text-xs text-rose-700 max-w-sm mx-auto">
                    We could not find an order matching the specified number and phone number. Please verify your details from your confirmation SMS or receipt and try again.
                </p>
            </div>
        }
        else
        {
            <div class="rounded-3xl border border-slate-200/90 bg-white shadow-xs overflow-hidden mb-8">
                <!-- Status Timeline Header -->
                <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-blue-950 p-6 sm:p-8 text-white">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
                        <div>
                            <span class="text-xs text-blue-300 uppercase tracking-widest font-semibold block">Order Reference</span>
                            <h2 class="text-2xl font-bold">#@order.Id</h2>
                        </div>
                        <div class="text-right sm:text-right">
                            <span class="text-xs text-slate-300 block">Placed on</span>
                            <span class="text-sm font-semibold">@order.CreatedAt.ToOffset(TimeSpan.FromHours(6)).ToString("dd MMM yyyy · hh:mm tt")</span>
                        </div>
                    </div>

                    @if (order.Status == OrderStatus.Cancelled)
                    {
                        <div class="rounded-xl bg-red-500/20 border border-red-400/30 p-4 text-center">
                            <span class="text-red-200 font-bold block">This order has been cancelled</span>
                            <span class="text-xs text-red-300 mt-1 block">Please contact customer support at 01711465078 if you have any questions.</span>
                        </div>
                    }
                    else
                    {
                        <!-- Timeline Step Indicator -->
                        <div class="grid grid-cols-4 gap-2 pt-2">
                            <!-- Step 1: Placed -->
                            <div class="text-center">
                                <span class="flex size-8 mx-auto items-center justify-center rounded-full bg-emerald-500 text-white font-bold text-xs shadow-xs mb-1.5">
                                    ✓
                                </span>
                                <span class="text-[11px] font-semibold text-emerald-300 block">Placed</span>
                                <span class="text-[10px] text-slate-400 hidden sm:block">Order Received</span>
                            </div>

                            <!-- Step 2: Processing -->
                            <div class="text-center">
                                @if (order.Status is OrderStatus.Processing or OrderStatus.InTransit or OrderStatus.Delivered)
                                {
                                    <span class="flex size-8 mx-auto items-center justify-center rounded-full bg-emerald-500 text-white font-bold text-xs shadow-xs mb-1.5">✓</span>
                                    <span class="text-[11px] font-semibold text-emerald-300 block">Confirmed</span>
                                    <span class="text-[10px] text-slate-400 hidden sm:block">Item Packed</span>
                                }
                                else
                                {
                                    <span class="flex size-8 mx-auto items-center justify-center rounded-full bg-white/20 text-slate-300 font-bold text-xs mb-1.5">2</span>
                                    <span class="text-[11px] text-slate-400 block">Review</span>
                                    <span class="text-[10px] text-slate-500 hidden sm:block">Pending Pack</span>
                                }
                            </div>

                            <!-- Step 3: InTransit -->
                            <div class="text-center">
                                @if (order.Status is OrderStatus.InTransit or OrderStatus.Delivered)
                                {
                                    <span class="flex size-8 mx-auto items-center justify-center rounded-full bg-emerald-500 text-white font-bold text-xs shadow-xs mb-1.5">✓</span>
                                    <span class="text-[11px] font-semibold text-emerald-300 block">Shipped</span>
                                    <span class="text-[10px] text-slate-400 hidden sm:block">In Delivery</span>
                                }
                                else
                                {
                                    <span class="flex size-8 mx-auto items-center justify-center rounded-full bg-white/20 text-slate-300 font-bold text-xs mb-1.5">3</span>
                                    <span class="text-[11px] text-slate-400 block">Shipping</span>
                                    <span class="text-[10px] text-slate-500 hidden sm:block">Awaiting Courier</span>
                                }
                            </div>

                            <!-- Step 4: Delivered -->
                            <div class="text-center">
                                @if (order.Status is OrderStatus.Delivered)
                                {
                                    <span class="flex size-8 mx-auto items-center justify-center rounded-full bg-emerald-500 text-white font-bold text-xs shadow-xs mb-1.5">✓</span>
                                    <span class="text-[11px] font-semibold text-emerald-300 block">Delivered</span>
                                    <span class="text-[10px] text-slate-400 hidden sm:block">Complete</span>
                                }
                                else
                                {
                                    <span class="flex size-8 mx-auto items-center justify-center rounded-full bg-white/20 text-slate-300 font-bold text-xs mb-1.5">4</span>
                                    <span class="text-[11px] text-slate-400 block">Delivery</span>
                                    <span class="text-[10px] text-slate-500 hidden sm:block">Final Destination</span>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Order Content Breakdown -->
                <div class="p-6 sm:p-8 space-y-6">
                    <div class="grid gap-6 sm:grid-cols-2">
                        <div>
                            <span class="text-xs text-slate-400 font-medium block">Recipient Customer</span>
                            <strong class="text-slate-900 text-sm">@order.DeliveryAddress?.CustomerName</strong>
                            <p class="text-xs text-slate-600 mt-1">@order.DeliveryAddress?.PhoneNumber</p>
                        </div>
                        <div>
                            <span class="text-xs text-slate-400 font-medium block">Destination Address</span>
                            <p class="text-xs text-slate-800 font-medium">@order.DeliveryAddress?.FullAddress</p>
                            <p class="text-xs text-slate-500">@order.DeliveryAddress?.City, @order.DeliveryAddress?.District</p>
                        </div>
                    </div>

                    <div class="border-t border-slate-100 pt-6">
                        <h4 class="font-bold text-slate-900 text-sm mb-3">Order Items</h4>
                        <div class="divide-y divide-slate-100">
                            @foreach (var i in order.Items)
                            {
                                <div class="py-2.5 flex items-center justify-between text-xs">
                                    <div>
                                        <span class="font-semibold text-slate-900">@i.ProductName</span>
                                        <span class="text-slate-400 block">@i.VariantName · Qty: @i.Quantity</span>
                                    </div>
                                    <span class="font-semibold text-slate-900 tabular-nums">৳@i.LineTotal.ToString("N0")</span>
                                </div>
                            }
                        </div>
                        <div class="border-t border-slate-200 mt-4 pt-4 flex justify-between items-center text-sm">
                            <span class="font-bold text-slate-900">Total (Including Delivery)</span>
                            <span class="font-extrabold text-blue-600 text-lg tabular-nums">৳@order.Total.ToString("N0")</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "orderId")]
    public string? OrderId { get; set; }

    [SupplyParameterFromQuery(Name = "phone")]
    public string? Phone { get; set; }

    private Order? order;
    private bool hasSearched;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(OrderId) && !string.IsNullOrWhiteSpace(Phone))
        {
            hasSearched = true;
            var cleanPhone = Phone.Trim();
            var idQuery = OrderId.Trim();

            var q = Db.Orders.AsNoTracking()
                .Include(o => o.DeliveryAddress)
                .Include(o => o.Items)
                .AsQueryable();

            if (int.TryParse(idQuery, out var parsedId))
            {
                order = await q.FirstOrDefaultAsync(o => o.Id == parsedId
                    && o.DeliveryAddress != null
                    && o.DeliveryAddress.PhoneNumber.Contains(cleanPhone));
            }
            else if (Guid.TryParse(idQuery, out var token))
            {
                order = await q.FirstOrDefaultAsync(o => o.PublicToken == token
                    && o.DeliveryAddress != null
                    && o.DeliveryAddress.PhoneNumber.Contains(cleanPhone));
            }
        }
    }
}
