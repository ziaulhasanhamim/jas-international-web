@page "/guides"
@attribute [StreamRendering]
@using JASIntWeb.Persistence
@using JASIntWeb.Persistence.Entities
@using JASIntWeb.Services.Seo
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject ISeoService Seo

@{
    var canonical = "/guides";
    var crumbs = new (string Name, string Url)[]
    {
        ("Home", Seo.PublicBaseUrl),
        ("Buying Guides", $"{Seo.PublicBaseUrl}{canonical}")
    };
    var jsonLdList = new[] { JsonLdBuilder.BuildBreadcrumbs(crumbs) };
}

<SeoHead Title="Tech Buying Guides & Comparisons | JAS International Bangladesh"
         Description="Expert buying guides, smartwatch comparisons, audio recommendations, and price analysis for tech gadgets in Bangladesh from the JAS International editorial team."
         CanonicalPath="@canonical"
         OgImage="/jas-og-card.png"
         JsonLd="jsonLdList" />

<div class="shop-container py-10 max-w-5xl mx-auto">
    <div class="text-center mb-10">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700 ring-1 ring-blue-600/20 mb-3">
            EXPERT ADVICE &amp; REVIEWS
        </span>
        <h1 class="font-display text-3xl sm:text-5xl font-bold tracking-tight text-slate-900 mb-3">
            Gadget Buying Guides
        </h1>
        <p class="text-sm sm:text-base text-slate-600 max-w-xl mx-auto">
            Make informed tech purchases. Objective reviews, model comparisons, and price-to-performance recommendations tailored for buyers in Bangladesh.
        </p>
    </div>

    @if (loading)
    {
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @for (var i = 0; i < 6; i++)
            {
                <div class="rounded-3xl border border-slate-200 bg-white p-5 animate-pulse h-64"></div>
            }
        </div>
    }
    else if (guides.Count == 0)
    {
        <div class="rounded-3xl border border-dashed border-slate-200 p-12 text-center">
            <Icon Name="box" Class="size-10 text-slate-300 mx-auto mb-2" />
            <p class="text-sm font-semibold text-slate-700">Buying guides are being prepared by our editorial team.</p>
            <p class="text-xs text-slate-400 mt-1">Check back shortly for in-depth comparisons and reviews.</p>
            <a href="/products" class="btn-primary mt-4 inline-block text-xs">Explore Catalog</a>
        </div>
    }
    else
    {
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var g in guides)
            {
                <a href="/guides/@g.Slug" class="shop-card group flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-5 hover:border-blue-500 hover:shadow-md transition">
                    <div>
                        @if (!string.IsNullOrWhiteSpace(g.FeaturedImageUrl))
                        {
                            <div class="aspect-video w-full overflow-hidden rounded-2xl bg-slate-100 mb-4">
                                <PictureImage Src="@g.FeaturedImageUrl" Alt="@g.Title" Class="size-full object-cover group-hover:scale-105 transition duration-300" Loading="lazy" />
                            </div>
                        }
                        <div class="flex items-center gap-2 text-[11px] text-slate-400 mb-2">
                            <span>@g.PublishedAt.ToString("dd MMM yyyy")</span>
                            <span>•</span>
                            <span class="font-medium text-slate-600">@g.Author</span>
                            @if (!string.IsNullOrWhiteSpace(g.BanglaTitle))
                            {
                                <span class="ml-auto inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">
                                    বাংলা
                                </span>
                            }
                        </div>
                        <h2 class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition leading-snug">
                            @g.Title
                        </h2>
                        <p class="text-xs text-slate-500 line-clamp-3 mt-2 leading-relaxed">
                            @g.Summary
                        </p>
                    </div>
                    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-blue-600">
                        <span>Read Full Guide</span>
                        <span class="group-hover:translate-x-1 transition">→</span>
                    </div>
                </a>
            }
        </div>
    }
</div>

@code {
    private bool loading = true;
    private List<Guide> guides = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            guides = await Db.Guides.AsNoTracking()
                .Where(g => g.IsPublished && !g.IsDeleted)
                .OrderByDescending(g => g.PublishedAt)
                .ToListAsync();
        }
        finally
        {
            loading = false;
        }
    }
}
