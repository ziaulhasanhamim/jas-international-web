@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        var currentUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(currentUri) ? "/" : $"/{currentUri}";
        NavigationManager.NavigateTo($"/account/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
