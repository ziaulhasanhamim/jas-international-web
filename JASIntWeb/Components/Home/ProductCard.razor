@using JASIntWeb.Endpoints
@using JASIntWeb.Persistence
@using JASIntWeb.Services
@using JASIntWeb.Services.Meta
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ShoppingService Shop
@inject IMetaConversionsApiService MetaApi
@inject NavigationManager Nav

<article class="product-card group relative flex flex-col justify-between h-full bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-xl hover:border-slate-300 transition-all duration-300 overflow-hidden">
    @if (Product.CampaignOffer is { } offer)
    {
        <a href="/campaigns/@offer.CampaignSlug"
           @onclick:stopPropagation="true"
           class="absolute top-2.5 left-2.5 z-20 inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wide shadow-sm @(offer.IsUpcoming ? "bg-indigo-600 text-white" : GetCampaignBadgeClasses(offer.ThemeColor)) hover:opacity-90 transition">
            <span>@(offer.IsUpcoming ? "🕒 SOON" : "🔥") @offer.BadgeLabel</span>
            @if (offer.DiscountPercent > 0)
            {
                <span>· -@offer.DiscountPercent%</span>
            }
        </a>
    }
    else if (Product.IsNewArrival)
    {
        <span class="product-new-label">New arrival</span>
    }

    <!-- Static Wishlist Toggle Button (Driven by Vanilla JS via data-wishlist-toggle) -->
    <button
        type="button"
        data-wishlist-toggle="@Product.Id"
        data-product-name="@Product.Name"
        data-product-slug="@Product.Slug"
        data-product-image="@Product.Image"
        data-product-price="@Product.Price"
        class="absolute top-2.5 right-2.5 z-20 flex size-8 items-center justify-center rounded-full bg-white/90 backdrop-blur-sm border border-slate-200/90 text-slate-400 hover:text-rose-500 hover:scale-110 shadow-xs transition cursor-pointer"
        aria-label="Add @Product.Name to wishlist"
    >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-slate-400 group-[.is-wishlisted]:text-rose-500 group-[.is-wishlisted]:fill-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
        </svg>
    </button>

    <!-- Product Image Container -->
    <a href="/product/@Product.Slug" class="block relative aspect-square p-5 bg-white overflow-hidden">
        <PictureImage
            Src="@Product.Image"
            Alt="@Product.Name"
            Loading="lazy"
            Decoding="async"
            Width="400"
            Height="400"
            Class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
        />
    </a>

    <!-- Product Card Details -->
    <div class="px-4 pb-4 pt-1 flex flex-col flex-1 text-center">
        <!-- Brand Badge -->
        <div class="flex items-center justify-center gap-1.5 mb-1.5 min-h-[22px] flex-wrap">
            @if (Product.TopTag is not null)
            {
                var topTag = Product.TopTag;
                <a href="/products?tag=@topTag.Slug" @onclick:stopPropagation="true" class="inline-block text-[10px] font-bold px-1.5 py-0.5 rounded border hover:opacity-85 transition @TagDto.GetBadgeClasses(topTag.BadgeColor)" title="View all @topTag.Name products">
                    @topTag.Name
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(Product.BrandName))
            {
                <span class="inline-block text-[11px] font-black uppercase tracking-wider text-slate-800 bg-slate-100 px-2 py-0.5 rounded">
                    @Product.BrandName
                </span>
            }
            else if (!string.IsNullOrWhiteSpace(Product.Category))
            {
                <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-slate-400">
                    @Product.Category
                </span>
            }
        </div>

        <!-- Title -->
        <a href="/product/@Product.Slug" class="block font-bold text-slate-900 text-sm hover:text-blue-700 transition line-clamp-2 h-[2.5rem] text-center leading-snug">
            @Product.Name
        </a>

        <!-- Savings Pill -->
        <div class="flex items-center justify-center mt-2.5 mb-1 min-h-[24px]">
            @if (Product.CampaignOffer is { IsUpcoming: false } cardOffer && Product.OriginalPrice.HasValue && Product.OriginalPrice > Product.Price)
            {
                <a href="/campaigns/@cardOffer.CampaignSlug" @onclick:stopPropagation="true" class="inline-flex items-center gap-1 text-[10px] font-extrabold text-rose-700 bg-rose-50 border border-rose-200/90 px-2.5 py-0.5 rounded-md hover:bg-rose-100 transition">
                    <span>⚡ @cardOffer.CampaignName · SAVE ৳@((Product.OriginalPrice.Value - Product.Price).ToString("N0"))</span>
                </a>
            }
            else if (Product.OriginalPrice.HasValue && Product.OriginalPrice > Product.Price)
            {
                <span class="inline-flex items-center text-[11px] font-extrabold text-slate-900 bg-orange-50 border border-orange-200/90 px-2.5 py-0.5 rounded-md">
                    SAVE ৳ @((Product.OriginalPrice.Value - Product.Price).ToString("N0"))
                </span>
            }
        </div>

        <!-- Price Row -->
        <div class="flex items-baseline justify-center gap-1.5 my-1 @(Product.CampaignOffer is { IsUpcoming: true } ? "mb-1.5" : "mb-3")">
            <span class="text-base sm:text-lg font-black @(Product.CampaignOffer is { IsUpcoming: false } ? "text-rose-600" : "text-slate-900")">Tk. @Product.Price.ToString("N0")</span>
            @if (Product.OriginalPrice.HasValue && Product.OriginalPrice > Product.Price)
            {
                <span class="text-xs text-slate-400 line-through">Tk. @Product.OriginalPrice.Value.ToString("N0")</span>
            }
        </div>

        @if (Product.CampaignOffer is { IsUpcoming: true } upcomingOffer)
        {
            <div class="mb-2.5 rounded-xl border border-indigo-200 bg-indigo-50/90 px-2.5 py-1.5 text-center">
                <span class="block text-[10px] font-bold uppercase tracking-wide text-indigo-700">
                    🕒 Offer Price@(upcomingOffer.StartsAt.HasValue ? $" · {upcomingOffer.StartsAt.Value.ToLocalTime():MMM dd}" : "")
                </span>
                <span class="text-xs font-black text-indigo-950">
                    Tk. @upcomingOffer.EffectivePrice.ToString("N0")
                    <span class="text-rose-600 font-extrabold">(-@upcomingOffer.DiscountPercent%)</span>
                </span>
            </div>
        }

        <StockAvailability Quantity="Product.DefaultVariantStock" />

        <!-- Buy Now Action (Component-scoped Blazor Static SSR form handler -> redirects to /cart) -->
        <div class="mt-auto pt-2 border-t border-slate-100">
            <form method="post" @formname="@cardFormName" @onsubmit="HandleBuyNowAsync" data-enhance class="w-full">
                <AntiforgeryToken />
                <input type="hidden" name="productId" value="@Product.Id" />
                <input type="hidden" name="variantId" value="@(Product.DefaultVariantId ?? 0)" />
                <input type="hidden" name="quantity" value="1" />
                @if (!string.IsNullOrWhiteSpace(buyNowError))
                {
                    <p class="text-[11px] font-semibold text-rose-600 mb-1.5" role="alert">@buyNowError</p>
                }
                <button
                    type="submit"
                    data-buy-now
                    data-variant-id="@(Product.DefaultVariantId ?? 0)"
                    data-product-id="@Product.Id"
                    class="btn-primary w-full py-2 text-xs font-bold transition flex items-center justify-center gap-1.5 shadow-xs hover:shadow-md cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                    disabled="@(Product.DefaultVariantStock <= 0 || Product.DefaultVariantId is null)"
                    aria-label="Buy @Product.Name now"
                >
                    <Icon Name="cart" Class="size-3.5" />
                    <span>@(Product.DefaultVariantStock <= 0 ? "Out of Stock" : "Buy Now")</span>
                </button>
            </form>
        </div>
    </div>
</article>

@code
{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [Parameter, EditorRequired]
    public ProductSummaryDto Product { get; set; } = default!;

    [Parameter]
    public string? FormScope { get; set; }

    private string cardFormName = "";
    private string? lastBaseKey;
    private string? buyNowError;

    protected override void OnParametersSet()
    {
        var prefix = string.IsNullOrWhiteSpace(FormScope) ? "" : $"{FormScope}-";
        var baseKey = $"buy-now-{prefix}{Product.Id}";
        if (lastBaseKey == baseKey && !string.IsNullOrEmpty(cardFormName)) return;
        lastBaseKey = baseKey;

        var candidate = baseKey;
        if (HttpContext?.Items is { } items)
        {
            if (items[typeof(ProductCard)] is not HashSet<string> used)
            {
                used = new HashSet<string>(StringComparer.Ordinal);
                items[typeof(ProductCard)] = used;
            }
            if (!used.Add(candidate))
            {
                var suffix = 2;
                while (!used.Add($"{baseKey}-{suffix}")) suffix++;
                candidate = $"{baseKey}-{suffix}";
            }
        }
        cardFormName = candidate;
    }

    private async Task HandleBuyNowAsync()
    {
        if (HttpContext is null) return;
        buyNowError = null;

        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await CartEndpoints.AddToCartFromSsrAsync(
            HttpContext,
            Product.Id,
            Product.DefaultVariantId,
            1,
            db,
            Shop,
            MetaApi);

        switch (result)
        {
            case CartDto:
                Nav.NavigateTo("/cart");
                break;
            case Error err:
                buyNowError = err.Message;
                break;
        }
    }

    private static string GetCampaignBadgeClasses(string? theme) => theme?.ToLowerInvariant() switch
    {
        "indigo" => "bg-indigo-600 text-white",
        "emerald" or "green" => "bg-emerald-600 text-white",
        "amber" or "orange" => "bg-amber-500 text-slate-950",
        "purple" => "bg-purple-600 text-white",
        "navy" => "bg-slate-900 text-white",
        _ => "bg-rose-600 text-white"
    };
}
