<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">

    <div class="mb-6">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-volt">
            Explore
        </p>

        <h2 class="font-display mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">
            Shop by category
        </h2>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-8">

        @foreach (var category in Categories)
        {
            <a href="@category.Href"
               class="group rounded-2xl border border-slate-200/80
                      bg-white p-4 text-center transition
                      hover:-translate-y-1 hover:border-slate-300
                      hover:shadow-md">

                <span class="mx-auto flex h-12 w-12 items-center
                             justify-center rounded-xl bg-mist text-xl
                             transition group-hover:scale-110">
                    @category.Icon
                </span>

                <p class="mt-3 text-sm font-medium">
                    @category.Name
                </p>

            </a>
        }

    </div>

</section>

@code {

    [Parameter, EditorRequired]
    public IReadOnlyList<Category> Categories { get; set; } = [];

}