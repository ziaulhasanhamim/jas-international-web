<button type="submit" name="ToggleBrandId" value="@Id" class="brand-feature-toggle @(Featured ? "is-featured" : "")" aria-label="@(Featured ? $"Remove {Name} from homepage" : $"Feature {Name} on homepage")" aria-pressed="@(Featured ? "true" : "false")">
    <span class="brand-feature-dot" aria-hidden="true"></span>
    @(Featured ? "Featured" : "Not featured")
</button>
@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public bool Featured { get; set; }
}
