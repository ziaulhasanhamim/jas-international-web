@namespace JASIntWeb.Components.Admin

<div class="admin-image-uploader space-y-2" data-admin-image-uploader>
    <div class="flex items-center justify-between">
        <label class="font-bold text-slate-900 text-sm">@Label</label>
        @if (!string.IsNullOrWhiteSpace(HelpText))
        {
            <span class="text-xs text-slate-400">@HelpText</span>
        }
    </div>

    <!-- Hidden Input bound to form model for standard form POST submission -->
    <input type="hidden" name="@FieldName" class="image-uploader-value" value="@Value" />

    <div class="border-2 border-dashed border-slate-300 rounded-2xl p-4 sm:p-5 text-center hover:border-blue-500 hover:bg-blue-50/20 transition-all bg-slate-50/60 image-uploader-dropzone">
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <!-- Preview Box -->
            <div class="relative @(Aspect == "banner" ? "w-40 h-20 sm:w-52 sm:h-24" : "size-20") rounded-2xl border border-slate-200 bg-white p-2 shadow-2xs flex items-center justify-center overflow-hidden shrink-0 group">
                <img src="@(string.IsNullOrWhiteSpace(Value) ? (Placeholder ?? "/jas-logo.png") : Value)"
                     alt="Preview"
                     class="size-full @(Aspect == "banner" ? "object-cover" : "object-contain") @(string.IsNullOrWhiteSpace(Value) ? "opacity-25 grayscale" : "") image-uploader-preview"
                     onerror="this.src='/jas-logo.png'; this.classList.add('opacity-25', 'grayscale');" />
            </div>

            <div class="text-center sm:text-left flex-1 min-w-0">
                <p class="text-xs font-semibold text-slate-800 image-uploader-status">
                    @(string.IsNullOrWhiteSpace(Value) ? "No image uploaded yet" : "Image attached")
                </p>
                <p class="text-[11px] text-slate-500 mt-0.5">Drag &amp; drop an image, browse your device, or paste a URL</p>

                <div class="mt-3 flex flex-wrap items-center justify-center sm:justify-start gap-2">
                    <label for="@_inputId" class="btn-primary cursor-pointer text-xs py-1.5 px-3.5 shadow-2xs inline-flex items-center gap-1.5 select-none">
                        <Icon Name="camera" Class="size-3.5" />
                        <span>Browse &amp; Upload</span>
                    </label>
                    <input type="file" id="@_inputId" accept="image/png,image/svg+xml,image/webp,image/jpeg,image/avif,image/gif" class="sr-only opacity-0 absolute pointer-events-none image-uploader-file-input" />

                    <button type="button" class="btn-secondary text-xs py-1.5 px-3 image-uploader-btn-url">
                        Edit URL
                    </button>

                    <button type="button" class="btn-secondary text-xs py-1.5 px-2.5 text-rose-600 hover:bg-rose-50 border-rose-200 @(string.IsNullOrWhiteSpace(Value) ? "hidden" : "") image-uploader-btn-clear" title="Remove image">
                        Remove
                    </button>
                </div>
            </div>
        </div>

        <!-- Progress Indicator -->
        <div class="mt-3 flex items-center justify-center gap-2 text-xs font-semibold text-blue-600 image-uploader-progress" hidden>
            <span class="size-2 rounded-full bg-blue-600 animate-ping"></span>
            <span>Uploading image...</span>
        </div>
    </div>

    <!-- Direct URL Drawer (collapsible) -->
    <div class="space-y-1.5 rounded-xl border border-slate-200 bg-slate-50/50 p-3 @(string.IsNullOrWhiteSpace(Value) ? "hidden" : "") image-uploader-drawer">
        <div class="flex items-center justify-between text-2xs text-slate-500">
            <span class="font-semibold uppercase tracking-wider">Asset URL / Path</span>
            <span class="font-mono text-slate-600 truncate max-w-xs image-uploader-url-display">@(Value ?? "")</span>
        </div>
        <input type="text"
               value="@Value"
               class="shop-input text-xs image-uploader-url-input"
               placeholder="https://... or /uploads/..." />
    </div>
</div>

@code {
    private readonly string _inputId = $"img-input-{Guid.NewGuid():N}";

    [Parameter, EditorRequired]
    public required string FieldName { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public string Label { get; set; } = "Image";

    [Parameter]
    public string? HelpText { get; set; }

    [Parameter]
    public string Aspect { get; set; } = "square"; // "square", "banner", "auto"

    [Parameter]
    public string? Placeholder { get; set; } = "/jas-logo.png";
}
