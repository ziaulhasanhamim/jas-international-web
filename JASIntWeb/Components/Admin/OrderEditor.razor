@inject JASIntWeb.Services.AdminSession Session
@inject NavigationManager Nav

<section class="order-editor">
    <div class="admin-section-heading">
        <div>
            <h3>@Title</h3>
            <p>Use the arrow buttons to adjust display order.</p>
        </div>
    </div>
    <form method="post" @formname="order-editor" data-enhance>
        <AntiforgeryToken />
        <input type="hidden" name="ActionKind" value="@Kind" />
        <input type="hidden" name="ActionScopeId" value="@ScopeId" />
        <ol class="order-list">
            @for (var i = 0; i < Items.Count; i++)
            {
                var index = i;
                var item = Items[i];
                <li @key="item.Id">
                    <span class="order-label">@item.Label</span>
                    <button
                        type="submit"
                        name="MoveAction"
                        value="@($"{item.Id}:-1")"
                        disabled="@(index == 0)"
                        aria-label="Move @item.Label up"
                        class="p-1 rounded text-slate-600 hover:text-slate-950 hover:bg-slate-100 disabled:opacity-25"
                    >
                        ↑
                    </button>
                    <button
                        type="submit"
                        name="MoveAction"
                        value="@($"{item.Id}:1")"
                        disabled="@(index == Items.Count - 1)"
                        aria-label="Move @item.Label down"
                        class="p-1 rounded text-slate-600 hover:text-slate-950 hover:bg-slate-100 disabled:opacity-25"
                    >
                        ↓
                    </button>
                </li>
            }
        </ol>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mt-2 text-xs text-rose-600">@errorMessage</div>
        }
    </form>
</section>

@code
{
    [Parameter]
    public string Title { get; set; } = "Display order";
    [Parameter]
    public OrderableKind Kind { get; set; }
    [Parameter]
    public int ScopeId { get; set; }
    [Parameter]
    public List<OrderableItemDto> Items { get; set; } = [];

    [SupplyParameterFromForm(FormName = "order-editor")]
    public string? ActionKind { get; set; }

    [SupplyParameterFromForm(FormName = "order-editor")]
    public int? ActionScopeId { get; set; }

    [SupplyParameterFromForm(FormName = "order-editor")]
    public string? MoveAction { get; set; }

    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(MoveAction)
            && ActionKind == Kind.ToString()
            && ActionScopeId == ScopeId)
        {
            var parts = MoveAction.Split(':');
            if (parts.Length == 2 && int.TryParse(parts[0], out var itemId) && int.TryParse(parts[1], out var offset))
            {
                var currentIndex = Items.FindIndex(r => r.Id == itemId);
                var targetIndex = currentIndex + offset;
                if (currentIndex >= 0 && targetIndex >= 0 && targetIndex < Items.Count)
                {
                    try
                    {
                        var item = Items[currentIndex];
                        Items.RemoveAt(currentIndex);
                        Items.Insert(targetIndex, item);
                        await Session.RunAsync(s => s.ReorderAsync(Kind, ScopeId, Items.Select(r => r.Id).ToList()));
                        Nav.NavigateTo(Nav.Uri);
                    }
                    catch (JASIntWeb.Services.ShopException ex)
                    {
                        errorMessage = ex.Message;
                    }
                }
            }
        }
    }
}
