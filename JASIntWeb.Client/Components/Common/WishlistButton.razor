@rendermode InteractiveAuto
@implements IDisposable
@inject WishlistService Wishlist

<button
    type="button"
    @onclick="Toggle"
    class="@Class"
    title="@(isWishlisted ? "Remove from wishlist" : "Add to wishlist")"
    aria-label="@(isWishlisted ? "Remove from wishlist" : "Add to wishlist")"
>
    <svg xmlns="http://www.w3.org/2000/svg" class="@IconClass @(isWishlisted ? "text-rose-500 fill-rose-500" : "text-slate-400")" viewBox="0 0 24 24" fill="@(isWishlisted ? "currentColor" : "none")" stroke="currentColor" stroke-width="2">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
    </svg>
    @if (!string.IsNullOrEmpty(Label))
    {
        <span>@(isWishlisted ? "Saved" : Label)</span>
    }
</button>

@code {
    [Parameter, EditorRequired]
    public ProductSummaryDto Product { get; set; } = default!;

    [Parameter]
    public string? Class { get; set; } = "flex size-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-500 hover:text-rose-600 hover:border-rose-200 transition shadow-xs";

    [Parameter]
    public string? IconClass { get; set; } = "size-5";

    [Parameter]
    public string? Label { get; set; }

    private bool isWishlisted => Wishlist.IsInWishlist(Product.Id);

    protected override void OnInitialized() => Wishlist.OnChange += OnChange;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            await Wishlist.EnsureLoadedAsync();
            StateHasChanged();
        }
    }

    private void OnChange() => _ = InvokeAsync(StateHasChanged);

    private async Task Toggle() => await Wishlist.ToggleWishlistAsync(Product);

    public void Dispose() => Wishlist.OnChange -= OnChange;
}
