@rendermode InteractiveAuto
@inject CartService Cart
@inject NavigationManager Nav

<div class="space-y-3">
    <div class="flex items-center gap-3">
        <!-- Quantity Stepper -->
        <div class="flex items-center rounded-xl border border-slate-200 bg-white p-1 shadow-xs">
            <button
                type="button"
                @onclick="Decrement"
                disabled="@(quantity <= 1 || busy)"
                class="flex size-9 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition disabled:opacity-30 disabled:cursor-not-allowed"
                aria-label="Decrease quantity"
            >
                -
            </button>
            <span class="w-10 text-center font-bold text-sm text-slate-900 tabular-nums">@quantity</span>
            <button
                type="button"
                @onclick="Increment"
                disabled="@(quantity >= Math.Min(Stock, 99) || busy)"
                class="flex size-9 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition disabled:opacity-30 disabled:cursor-not-allowed"
                aria-label="Increase quantity"
            >
                +
            </button>
        </div>

        <!-- Add to Cart Button -->
        <button
            type="button"
            class="flex-1 btn-primary gap-2 shadow-xs"
            disabled="@(VariantId <= 0 || Stock <= 0 || busy)"
            @onclick="Add"
        >
            <Icon Name="cart" Class="size-4" />
            <span>@(busy ? "Adding to Cart…" : "Add to Cart")</span>
        </button>
    </div>

    <!-- Buy Now Direct Button -->
    <button
        type="button"
        class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white transition hover:bg-slate-800 shadow-xs select-none disabled:opacity-50 disabled:cursor-not-allowed"
        disabled="@(VariantId <= 0 || Stock <= 0 || busy)"
        @onclick="Buy"
    >
        <Icon Name="bag" Class="size-4 text-emerald-400" />
        <span>Buy Now · Direct Checkout</span>
    </button>

    @if (message is not null)
    {
        <div class="flex items-center gap-2 rounded-xl bg-blue-50 px-3 py-2 text-xs font-medium text-blue-700 ring-1 ring-blue-600/20" role="status">
            <Icon Name="check" Class="size-3.5 text-blue-600 shrink-0" />
            <span>@message</span>
            <a href="/cart" class="ml-auto underline font-bold">View Cart</a>
        </div>
    }
</div>

@code
{
    [Parameter]
    public int VariantId { get; set; }
    [Parameter]
    public int Stock { get; set; }
    private int quantity = 1;
    private bool busy;
    private string? message;

    private void Increment()
    {
        if (quantity < Math.Min(Stock, 99))
        {
            quantity++;
        }
    }

    private void Decrement()
    {
        if (quantity > 1)
        {
            quantity--;
        }
    }

    private async Task Add()
    {
        busy = true;
        await Cart.AddAsync(VariantId, quantity);
        message = Cart.Error ?? $"Added {quantity} unit{(quantity == 1 ? "" : "s")} to your cart.";
        busy = false;
    }

    private async Task Buy()
    {
        await Add();
        if (Cart.Error is null)
        {
            Nav.NavigateTo("/checkout");
        }
    }
}
