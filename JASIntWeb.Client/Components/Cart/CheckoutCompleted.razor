@rendermode InteractiveAuto
@inject CartService Cart
@inject IJSRuntime JS

@if (Cart.Error is not null)
{
    <p class="form-notice">
        Your order is placed. Your browser cart could not be refreshed;
        reload this page to try again.
    </p>
}

@code
{
    [Parameter]
    public Guid CheckoutToken { get; set; }
    [Parameter]
    public int OrderId { get; set; }
    [Parameter]
    public Guid OrderPublicToken { get; set; }
    [Parameter]
    public decimal Total { get; set; }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            await Cart.CompleteCheckoutAsync(CheckoutToken);
            if (OrderId > 0 && OrderPublicToken != Guid.Empty)
            {
                try
                {
                    await JS.InvokeVoidAsync("jasRecordGuestOrder", OrderId, OrderPublicToken.ToString(), (double)Total);
                    await JS.InvokeVoidAsync("window.jasTrackMeta", "Purchase", new
                    {
                        value = (double)Total,
                        currency = "BDT",
                        content_type = "product",
                        order_id = OrderId.ToString()
                    }, OrderPublicToken.ToString());
                }
                catch
                {
                    // Ignore storage errors in restricted private mode
                }
            }
            StateHasChanged();
        }
    }
}
