@rendermode InteractiveAuto
@implements IDisposable
@inject WishlistService Wishlist

<article class="product-card group relative flex flex-col justify-between h-full bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-xl hover:border-slate-300 transition-all duration-300 overflow-hidden">
    @if (Product.IsNewArrival)
    {
        <!-- Diagonal Red Ribbon (Gadget & Gear style) -->
        <div class="absolute -top-1 -left-1 w-20 h-20 overflow-hidden pointer-events-none z-10">
            <div class="absolute transform -rotate-45 bg-[#ff0055] text-white font-extrabold text-[8.5px] leading-tight tracking-wider py-1 left-[-26px] top-[14px] w-[100px] text-center shadow-sm uppercase">
                NEW<br />ARRIVAL
            </div>
        </div>
    }

    <!-- Wishlist Heart Button -->
    <button
        type="button"
        @onclick="ToggleWishlist"
        class="absolute top-2.5 right-2.5 z-20 flex size-8 items-center justify-center rounded-full bg-white/90 backdrop-blur-sm border border-slate-200/90 text-slate-400 hover:text-rose-500 hover:scale-110 shadow-xs transition"
        aria-label="@(isWishlisted ? "Remove from wishlist" : "Add to wishlist")"
        title="@(isWishlisted ? "Remove from wishlist" : "Add to wishlist")"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="@(isWishlisted ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" class="@(isWishlisted ? "text-rose-500 fill-rose-500" : "text-slate-400")">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
        </svg>
    </button>

    <!-- Product Image Container -->
    <a href="/product/@Product.Slug" class="block relative aspect-square p-5 bg-white overflow-hidden">
        <img
            src="@Product.Image"
            alt="@Product.Name"
            loading="lazy"
            decoding="async"
            width="400"
            height="400"
            class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
        />
    </a>

    <!-- Product Card Details (Gadget & Gear Layout) -->
    <div class="px-4 pb-4 pt-1 flex flex-col flex-1 text-center">
        <!-- Brand Badge -->
        <div class="flex items-center justify-center mb-1.5 min-h-[22px]">
            @if (!string.IsNullOrWhiteSpace(Product.BrandName))
            {
                <span class="inline-block text-[11px] font-black uppercase tracking-wider text-slate-800 bg-slate-100 px-2 py-0.5 rounded">
                    @Product.BrandName
                </span>
            }
            else if (!string.IsNullOrWhiteSpace(Product.Category))
            {
                <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-slate-400">
                    @Product.Category
                </span>
            }
        </div>

        <!-- Title -->
        <a href="/product/@Product.Slug" class="block font-bold text-slate-900 text-sm hover:text-orange-600 transition line-clamp-2 min-h-[2.5rem] leading-snug">
            @Product.Name
        </a>

        <!-- Savings Pill -->
        <div class="flex items-center justify-center mt-2.5 mb-1 min-h-[24px]">
            @if (Product.OriginalPrice.HasValue && Product.OriginalPrice > Product.Price)
            {
                <span class="inline-flex items-center text-[11px] font-extrabold text-[#ea580c] bg-orange-50 border border-orange-200/90 px-2.5 py-0.5 rounded-md">
                    SAVE ৳ @((Product.OriginalPrice.Value - Product.Price).ToString("N0"))
                </span>
            }
        </div>

        <!-- Price Row -->
        <div class="flex items-baseline justify-center gap-1.5 my-1">
            <span class="text-base sm:text-lg font-black text-[#ea580c]">Tk. @Product.Price.ToString("N0")</span>
            @if (Product.OriginalPrice.HasValue && Product.OriginalPrice > Product.Price)
            {
                <span class="text-xs text-slate-400 line-through">Tk. @Product.OriginalPrice.Value.ToString("N0")</span>
            }
        </div>

        <!-- Rating Stars -->
        <div class="flex items-center justify-center gap-1 text-xs text-amber-400 font-bold mb-3">
            <span>★★★★★</span>
            <span class="text-[11px] text-slate-700 font-semibold">(@(Product.Rating > 0 ? Product.Rating.ToString("F1") : "5.0"))</span>
        </div>

        <!-- Quick Add to Cart Action -->
        <div class="mt-auto pt-2 border-t border-slate-100">
            <QuickAddToCart
                @key="Product.DefaultVariantId"
                VariantId="Product.DefaultVariantId"
                Stock="Product.DefaultVariantStock"
                ProductName="@Product.Name"
            />
        </div>
    </div>
</article>

@code
{
    [Parameter, EditorRequired]
    public ProductSummaryDto Product { get; set; } = default!;

    private bool isWishlisted => Wishlist.IsInWishlist(Product.Id);

    protected override void OnInitialized()
    {
        Wishlist.OnChange += OnWishlistChanged;
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            await Wishlist.EnsureLoadedAsync();
            StateHasChanged();
        }
    }

    private void OnWishlistChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ToggleWishlist()
    {
        await Wishlist.ToggleWishlistAsync(Product);
    }

    public void Dispose()
    {
        Wishlist.OnChange -= OnWishlistChanged;
    }
}
