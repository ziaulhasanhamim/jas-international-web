@rendermode InteractiveAuto
<article class="group overflow-hidden rounded-2xl border border-slate-200/80 bg-white">

    <a href="/product/@ProductSlug"
       class="block">

        <div class="relative aspect-square overflow-hidden bg-slate-100">

            <img src="@Product.Image"
                 alt="@Product.Name"
                 loading="lazy"
                 class="h-full w-full object-cover transition duration-500
                        group-hover:scale-105" />

            @if (!string.IsNullOrWhiteSpace(Product.Badge))
            {
                <span class="absolute left-3 top-3 rounded-full bg-volt
                             px-2.5 py-1 text-[10px] font-semibold uppercase
                             tracking-wide text-white">
                    @Product.Badge
                </span>
            }

        </div>

    </a>

    <div class="p-4">

        <p class="text-xs text-slate-500">
            @Product.Category
        </p>

        <a href="/products/@ProductSlug">
            <h3 class="mt-1 font-medium leading-snug transition
                       group-hover:text-volt">
                @Product.Name
            </h3>
        </a>

        <div class="mt-3 flex items-center justify-between gap-2">

            <p class="font-display text-lg font-semibold">
                ৳@Product.Price.ToString("N0")
            </p>

            <button type="button"
                    @onclick="AddToCart"
                    class="rounded-full bg-ink px-3 py-1.5 text-xs
                           font-semibold text-white transition
                           hover:bg-volt active:scale-95">

                Add

            </button>

        </div>

    </div>

</article>

@code {

    [Parameter, EditorRequired]
    public Product Product { get; set; } = default!;

    [Inject]
    private CartService Cart { get; set; } = default!;

    private string ProductSlug =>
        Product.Name
            .ToLowerInvariant()
            .Replace(oldValue: " ", newValue: "-");

    private void AddToCart()
    {
        Cart.Add(Product);
    }
}