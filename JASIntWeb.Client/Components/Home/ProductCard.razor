<article class="product-card group overflow-hidden rounded-2xl">
    <a href="/product/@Product.Slug" class="block">
        <div class="product-card-image relative aspect-square overflow-hidden">
            <img
                src="@Product.Image"
                alt="@Product.Name"
                loading="lazy"
                decoding="async"
                width="400"
                height="400"
                class="h-full w-full object-contain transition duration-500 group-hover:scale-105"
            />
        </div>
    </a>
    <div class="p-4">
        <p class="text-xs font-medium text-volt">@Product.Category</p>
        <a href="/product/@Product.Slug">
            <h3 class="mt-1 font-medium leading-snug transition group-hover:text-volt">@Product.Name</h3>
        </a>
        <p class="font-display mt-3 text-lg font-semibold">৳@Product.Price.ToString("N0")</p>
        <div class="mt-3">
            <QuickAddToCart
                @key="Product.DefaultVariantId"
                VariantId="Product.DefaultVariantId"
                Stock="Product.DefaultVariantStock"
                ProductName="@Product.Name"
            />
        </div>
    </div>
</article>

@code
{
    [Parameter, EditorRequired]
    public ProductSummaryDto Product { get; set; } = default!;
}
