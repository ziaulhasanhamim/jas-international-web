@if (Slides.Count > 0)
{
    <!-- Contained, modern hero carousel matching Gadget & Gear layout (Fast SSR + Touch-Enabled Data Controller) -->
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 pb-2">
        <section
            data-carousel
            class="relative overflow-hidden rounded-2xl sm:rounded-3xl bg-slate-100 border border-slate-200/70 shadow-xs group select-none aspect-[16/8] sm:aspect-[21/9] lg:aspect-[24/9] min-h-[200px] max-h-[460px] w-full touch-pan-y"
            aria-roledescription="carousel"
            aria-label="Featured promotions"
        >
            <!-- Slide Stage -->
            <div class="relative h-full w-full overflow-hidden">
                @for (var i = 0; i < Slides.Count; i++)
                {
                    var slide = Slides[i];
                    var active = i == 0;
                    var targetUrl = string.IsNullOrWhiteSpace(slide.LinkUrl) ? "/products" : slide.LinkUrl;
                    <div
                        data-carousel-slide
                        class="absolute inset-0 transition-opacity duration-700 ease-in-out
                            @(active ? "opacity-100 z-10" : "pointer-events-none opacity-0 z-0")"
                        role="group"
                        aria-roledescription="slide"
                        aria-hidden="@(!active)"
                    >
                        <!-- Pure clean banner artwork without text clutter (Gadget & Gear style) -->
                        <a href="@targetUrl" class="block w-full h-full relative" title="@slide.ImageAlt">
                            <img
                                src="@slide.Image"
                                alt="@slide.ImageAlt"
                                loading="@(i == 0 ? "eager" : "lazy")"
                                fetchpriority="@(i == 0 ? "high" : "low")"
                                decoding="async"
                                class="w-full h-full object-cover object-center"
                            />
                        </a>
                    </div>
                }
            </div>

            <!-- Vertically Centered Subtle Navigation Arrows (Glassmorphic, appear on hover) -->
            <button
                type="button"
                data-carousel-prev
                class="absolute left-3.5 top-1/2 -translate-y-1/2 z-20 flex size-9 sm:size-11 items-center justify-center rounded-full bg-white/80 hover:bg-white text-slate-800 shadow-md backdrop-blur-xs transition opacity-0 group-hover:opacity-100 cursor-pointer active:scale-95"
                aria-label="Previous slide"
            >
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 sm:size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
            </button>
            <button
                type="button"
                data-carousel-next
                class="absolute right-3.5 top-1/2 -translate-y-1/2 z-20 flex size-9 sm:size-11 items-center justify-center rounded-full bg-white/80 hover:bg-white text-slate-800 shadow-md backdrop-blur-xs transition opacity-0 group-hover:opacity-100 cursor-pointer active:scale-95"
                aria-label="Next slide"
            >
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 sm:size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" />
                </svg>
            </button>

            <!-- Minimal Pagination Dots (Centered at bottom, Gadget & Gear style) -->
            <div class="absolute inset-x-0 bottom-3.5 z-20 flex items-center justify-center gap-1.5 sm:gap-2 pointer-events-auto" role="tablist" aria-label="Slides">
                @for (var idx = 0; idx < Slides.Count; idx++)
                {
                    var slideIdx = idx;
                    <button
                        type="button"
                        data-carousel-dot
                        class="h-2 rounded-full transition-all duration-300 cursor-pointer
                               @(slideIdx == 0 ? "w-6 sm:w-7 bg-slate-900 shadow-xs" : "w-2 bg-slate-400/60 hover:bg-slate-700")"
                        aria-label="Go to slide @(idx + 1)"
                        aria-selected="@(slideIdx == 0)"
                    >
                    </button>
                }
            </div>
        </section>
    </div>
}

@code
{
    [Parameter]
    public List<CarouselSlideDto> Slides { get; set; } = [];
}
