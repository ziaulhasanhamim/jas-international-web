@rendermode InteractiveAuto
@implements IDisposable
@inject WishlistService WishlistSvc
@inject CartService Cart

@if (!ready)
{
    <div class="py-16 text-center text-slate-400 text-xs flex items-center justify-center gap-2">
        <span class="size-2 rounded-full bg-rose-600 animate-ping"></span>
        <span>Loading saved wishlist items…</span>
    </div>
}
else if (WishlistSvc.Items.Count == 0)
{
    <div class="mx-auto max-w-md py-16 text-center">
        <div class="mx-auto flex size-20 items-center justify-center rounded-3xl bg-slate-100 text-slate-400 mb-5">
            <Icon Name="heart" Class="size-10 text-slate-400" />
        </div>
        <h2 class="text-xl font-bold text-slate-900">Your wishlist is currently empty</h2>
        <p class="mt-2 text-sm text-slate-500 leading-relaxed">
            Explore our catalog of smartwatches, premium audio gear, chargers, and gadget accessories. Click the heart icon on any product to save it here for later.
        </p>
        <div class="mt-6 flex justify-center gap-3">
            <a href="/products" class="rounded-xl bg-blue-600 px-6 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-blue-700 transition">
                Explore Gadgets
            </a>
        </div>
    </div>
}
else
{
    <div class="mb-6 flex items-center justify-between">
        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">
            @WishlistSvc.Items.Count @(WishlistSvc.Items.Count == 1 ? "Item" : "Items")
        </span>
        <button
            type="button"
            @onclick="ClearWishlist"
            class="rounded-xl border border-slate-200 px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 transition cursor-pointer"
        >
            Clear All
        </button>
    </div>

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
        @foreach (var product in WishlistSvc.Items)
        {
            <div class="relative">
                <ProductCard Product="product" />
            </div>
        }
    </div>
}

@code
{
    private bool ready;

    protected override void OnInitialized()
    {
        WishlistSvc.OnChange += OnWishlistChanged;
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            await WishlistSvc.EnsureLoadedAsync();
            ready = true;
            StateHasChanged();
        }
    }

    private void OnWishlistChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ClearWishlist()
    {
        await WishlistSvc.ClearAsync();
    }

    public void Dispose()
    {
        WishlistSvc.OnChange -= OnWishlistChanged;
    }
}
