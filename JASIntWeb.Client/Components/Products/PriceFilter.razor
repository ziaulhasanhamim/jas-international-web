<div class="mt-7 border-t border-slate-200 pt-6">

    <h2 class="text-sm font-semibold">
        Price
    </h2>
    <form data-enhance>
        <div class="mt-4 grid grid-cols-2 gap-2">

            <div>
                <label class="text-xs text-slate-500">
                    Min
                </label>

                <input type="number" name="min-price" placeholder="৳0" value="@MinPrice" class="mt-1 w-full rounded-lg border
                border-slate-200 px-3 py-2 text-sm
                outline-none focus:border-volt" />
            </div>

            <div>
                <label class="text-xs text-slate-500">
                    Max
                </label>

                <input type="number" name="max-price" placeholder="৳50,000" value="@MaxPrice" class="mt-1 w-full rounded-lg border
                border-slate-200 px-3 py-2 text-sm
                outline-none focus:border-volt" />
            </div>

        </div>

        <button class="mt-3 w-full rounded-lg bg-ink px-4 py-2
            text-sm font-semibold text-white
            hover:bg-slate-800">

            Apply

        </button>
    </form>

</div>

@code {

    [Parameter]
    [SupplyParameterFromQuery(Name = "min-price")]
    public decimal? MinPrice { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "max-price")]
    public decimal? MaxPrice { get; set; }
}