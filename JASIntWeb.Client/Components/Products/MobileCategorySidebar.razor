@rendermode InteractiveAuto
<div class="mb-5 lg:hidden">
    <button type="button" @onclick="ToggleFilters" class="flex w-full items-center justify-between
        rounded-lg border border-slate-200
        bg-white px-4 py-3 text-sm font-medium
        text-ink shadow-sm">

        <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h18M6 9.75h12M10 15h4M11 20h2" />
            </svg>

            Filters
        </span>

        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-200
            @(MobileFiltersOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
        </svg>
    </button>

    @if (MobileFiltersOpen)
    {
        <div class="mt-3 rounded-lg border border-slate-200
            bg-white p-4 shadow-sm">

            <CategorySidebar Mobile="true" CategorySlug="@CategorySlug" />

        </div>
    }
</div>

@code {
    private bool MobileFiltersOpen;
    [Parameter]
    public string? CategorySlug { get; set; }
    private void ToggleFilters()
    {
        MobileFiltersOpen = !MobileFiltersOpen;
    }
}