@inject CartService Cart

<article class="group overflow-hidden rounded-2xl border
                border-slate-200/80 bg-white">

    <a href="/products/id"
       class="block">

        <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">

            <img src="@Product.Image"
                 alt="@Product.Name"
                 loading="lazy"
                 class="h-full w-full object-cover
                        transition duration-500
                        group-hover:scale-105" />

            @if (Product.Badge is not null)
            {
                <span class="absolute left-3 top-3 rounded-full
                             bg-volt px-2.5 py-1 text-[10px]
                             font-semibold uppercase tracking-wide text-white">
                    @Product.Badge
                </span>
            }

        </div>

        <div class="p-4">

            <p class="text-xs text-slate-500">
                @Product.Category
            </p>

            <h3 class="mt-1 font-medium leading-snug">
                @Product.Name
            </h3>

        </div>

    </a>

    <div class="flex items-center justify-between px-4 pb-4">

        <p class="font-display text-lg font-semibold">
            ৳@Product.Price.ToString("N0")
        </p>

        <button type="button"
                @onclick="AddToCart"
                @onclick:stopPropagation
                class="rounded-full bg-ink px-3 py-1.5
                       text-xs font-semibold text-white
                       hover:bg-slate-800">
            Add
        </button>

    </div>

</article>

@code {

    [Parameter, EditorRequired]
    public Product Product { get; set; } = default!;

    private void AddToCart()
    {
        Cart.Add(Product);
    }
}