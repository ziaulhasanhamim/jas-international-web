@implements IAsyncDisposable
<PageTitle>@(Id == 0 ? "Add product" : "Edit product") — JAS Admin</PageTitle>
<AdminPageHeader Title="@(Id == 0 ? "Add product" : state.Draft.Information.Name)" Description="Save details, options and selected variants together. Existing stock movements stay explicit." ActionHref="/admin/products" ActionText="Back to products" />
<NavigationLock ConfirmExternalNavigation="@state.Dirty" OnBeforeInternalNavigation="BeforeNavigation" />
@if (restoredFromDraft && state.Dirty)
{
    <div class="editor-recovery flex items-center justify-between p-3 mb-4 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-800" role="status">
        <span class="flex items-center gap-1.5 font-medium">
            <svg class="size-4 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            Restored unsaved draft from local storage.
        </span>
        <button type="button" class="text-xs font-semibold text-amber-900 underline hover:text-amber-950 ml-3 cursor-pointer" @onclick="DiscardDraft">Discard draft</button>
    </div>
}
@if (state.Message is not null)
{
    <div class="@(state.Phase == EditorPhase.Saved ? "editor-success" : "form-error")" role="@(state.Phase == EditorPhase.Saved ? "status" : "alert")">@state.Message</div>
}
@if (state.Errors.Count > 0) { <ul class="editor-error-list" role="alert">@foreach (var error in state.Errors) { <li><strong>@error.Key:</strong> @string.Join(" ", error.Value)</li> }</ul> }
@if (state.Phase == EditorPhase.Conflict)
{
    <div class="editor-recovery"><p>Your draft is retained. Compare the latest product before replacing it.</p><button type="button" class="shop-button-secondary" @onclick="ReviewLatest">Review latest</button><button type="button" class="shop-button-secondary" @onclick="Export">Download draft</button>
    @if (latest is not null) { <p>Latest revision: @latest.Draft.Revision · Your revision: @state.Draft.Revision</p><button type="button" class="brand-text-action" @onclick="UseLatest">Replace draft with latest (confirm)</button><a href="@($"/admin/products/{Id}/edit")" target="_blank">Open latest in another tab ↗</a> }</div>
}
@if (state.Phase == EditorPhase.SessionExpired) { <p><a href="/account/login" target="_blank">Sign in again ↗</a> then check the operation or retry. <button type="button" class="brand-text-action" @onclick="Export">Download draft</button></p> }
@if (reloadRequired) { <button type="button" class="shop-button-secondary" @onclick="Reload">Reload saved product</button> }
@if (uncertain)
{
    <div class="editor-recovery"><p>A previous request has not been confirmed. The submitted draft is retained; retry uses the same operation ID.</p><button type="button" class="shop-button-secondary" disabled="@state.Busy" @onclick="CheckOperation">Check save status</button><button type="button" class="shop-button-secondary" disabled="@(state.Busy || !retryAllowed)" @onclick="Retry">Retry same request</button><button type="button" class="brand-text-action" @onclick="Export">Download draft</button></div>
}
@if (state.Data is null)
{
    <p class="admin-empty">@(state.Phase == EditorPhase.Loading ? "Loading product editor…" : "The editor could not be loaded.")</p>
    @if (!state.Busy) { <button type="button" class="shop-button-secondary" @onclick="Reload">Reload editor</button> }
}
else
{
    <form data-admin-draft="product" @onsubmit="Save" @onsubmit:preventDefault novalidate>
        <fieldset disabled="@(Disabled || uncertain || stockVariant is not null)">
            <div class="editor-savebar"><label class="shop-label">Status<select class="shop-input" value="@(state.Draft.Information.Hidden ? "true" : "false")" @onchange="e => Change(d => d.Information.Hidden = bool.Parse(e.Value!.ToString()!))"><option value="true">Draft</option><option value="false">Published</option></select></label>
            <span class="admin-help">@(state.Dirty ? "Unsaved changes" : state.Draft.Id == 0 ? "New draft" : "Saved")</span><button type="submit" class="shop-button">@(state.Phase == EditorPhase.Saving ? "Saving…" : "Save product")</button></div>
            <nav class="admin-tabs product-editor-tabs" aria-label="Product editor sections">@foreach (var section in sections) { <button type="button" aria-current="@(tab == section.Key ? "page" : null)" @onclick="() => tab = section.Key">@section.Value</button> }</nav>
            <div hidden="@(tab != "details")"><ProductInformationFields Information="state.Draft.Information" Categories="state.Data.Categories" Brands="state.Data.Brands" Changed="InfoChanged" UploadBusy="UploadBusy" Disabled="Disabled" /></div>
            <div hidden="@(tab != "options")"><ProductEditorAttributes Attributes="state.Draft.Attributes" Templates="state.Data.Templates" Changed="AttributeChanged" Added="AddAttribute" Move="MoveAttribute" RefreshTemplates="RefreshTemplates" /></div>
            <div hidden="@(tab != "variants")"><ProductCombinationPicker Draft="state.Draft" Page="preview" Preview="Preview" Stage="Stage" Restore="RestoreVariant" Map="MapVariant" />
                <ProductEditorVariantRows Draft="state.Draft" Errors="state.Errors" Changed="VariantChanged" Default="SetDefault" Stock="OpenStock" Archive="ArchiveVariant" Standard="AddStandard" /></div>
            <div hidden="@(tab != "content")"><ProductEditorSeo Information="state.Draft.Information" BaseUrl="@state.Data.PublicBaseUrl" Changed="InfoChanged" UploadBusy="UploadBusy" /></div>
            <aside class="editor-readiness"><h3>Before publishing</h3><p class="admin-help">Drafts need a name and category. Publishing also needs a cover image, description, and one active default variant with a positive price. Sold-out variants are allowed.</p></aside>
            <div class="form-actions"><button type="submit" class="shop-button">Save product</button><button type="button" class="shop-button-secondary" @onclick="Export">Download draft</button></div>
        </fieldset>
    </form>
    @if (pendingStock is not null && stockVariant is null)
    {
        <section class="shop-panel editor-recovery"><p>Save the product draft before adjusting stock.</p><button type="button" class="shop-button" disabled="@Disabled" @onclick="SaveAndOpenStock">Save and continue</button><button type="button" class="shop-button-secondary" @onclick="() => pendingStock = null">Keep editing</button></section>
    }
    @if (stockVariant is not null)
    {
        <ProductEditorStockDialog ProductId="state.Draft.Id" Variant="stockVariant" Busy="@(state.Busy || uncertain)" Message="@stockMessage" Save="Stock" Refresh="RefreshStock" Cancel="() => { stockVariant = null; stockMessage = null; }" />
    }
}
