@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IAdminCatalogBackend Backend
<section class="my-5 space-y-3 rounded-xl border border-slate-200 p-4" aria-label="Product images">
    <h3 class="font-semibold">Product images</h3>
    <p class="admin-help">The first image is the cover. Drag thumbnails to reorder, or use the arrow buttons.</p>
    <AdminImageDropZone Label="Product images" Multiple="true" Disabled="@(uploading && !readingStreams)" Selected="Upload" />
    <div class="flex gap-2"><input class="shop-input" @bind="url" placeholder="Image URL or local path" aria-label="Add product image URL" /><button type="button" class="btn-secondary" @onclick="AddUrl" disabled="@uploading">Add URL</button></div>
    @if (error is not null) { <p class="form-error" role="alert">@error</p> }
    @if (uploading) { <p role="status">Uploading images…</p> }
    <ol @ref="galleryRoot" class="admin-media-gallery" data-uploading="@(uploading ? "true" : "false")">
        @for (var i = 0; i < images.Count; i++)
        {
            var index = i;
            <li @key="images[index]" draggable="@(uploading ? "false" : "true")" data-media-key="@images[index]" data-media-index="@index" class="admin-media-item">
                <img src="@ImageUrlHelper.GetAutoOptimizedUrl(images[index])" alt="Product image @(index + 1)" class="admin-media-thumbnail" draggable="false" />
                <span class="admin-media-caption">@(index == 0 ? "Cover image" : $"Image {index + 1}") <span aria-hidden="true">⋮⋮</span></span>
                <div class="admin-media-actions">
                    <button type="button" class="btn-secondary" disabled="@(uploading || index == 0)" @onclick="() => Move(index, -1)" aria-label="Move image @(index + 1) up">↑</button>
                    <button type="button" class="btn-secondary" disabled="@(uploading || index == images.Count - 1)" @onclick="() => Move(index, 1)" aria-label="Move image @(index + 1) down">↓</button>
                    <button type="button" class="btn-secondary" disabled="@uploading" @onclick="() => Remove(index)">Remove</button>
                </div>
            </li>
        }
    </ol>
</section>
@code {
    [Parameter] public AdminMediaValue Value { get; set; } = new("", "");
    [Parameter] public EventCallback<AdminMediaValue> ValueChanged { get; set; }
    [Parameter] public EventCallback<bool> BusyChanged { get; set; }
    private ElementReference galleryRoot;
    private AdminEditorInterop? interop;
    private DotNetObjectReference<AdminProductMedia>? reference;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { interop = new(JS); reference = DotNetObjectReference.Create(this); await interop.GalleryAsync(galleryRoot, reference); }
        catch (JSDisconnectedException) { }
        catch (JSException) { /* Arrow buttons remain available. */ }
    }
    [JSInvokable] public async Task Reorder(string key, int target)
    {
        if (uploading || target < 0 || target >= images.Count) return;
        var from = images.IndexOf(key);
        if (from < 0 || from == target) return;
        images.RemoveAt(from); images.Insert(target, key);
        await Changed(); StateHasChanged();
    }
    public async ValueTask DisposeAsync() { if (interop is not null) await interop.DisposeAsync(); reference?.Dispose(); }
    private AdminMediaValue? previous;
    private List<string> images = [];
    private string url = "";
    private string? error;
    private bool uploading;
    private bool readingStreams;
    protected override void OnParametersSet()
    {
        if (Value == previous) return;
        previous = Value;
        images = [.. Value.Gallery.Split('\n').Prepend(Value.Cover).Select(x => x.Trim()).Where(x => x.Length > 0).Distinct()];
    }
    private async Task Changed()
    {
        previous = new(images.FirstOrDefault() ?? "", string.Join('\n', images.Skip(1)));
        await ValueChanged.InvokeAsync(previous);
    }
    private async Task AddUrl()
    {
        if (!CategoryVisuals.IsImage(url)) { error = "Enter an HTTP(S) image URL or a local path."; return; }
        error = null;
        if (!images.Contains(url.Trim())) images.Add(url.Trim());
        url = ""; await Changed();
    }
    private async Task Move(int index, int change) { if (uploading || index < 0 || index >= images.Count || index + change < 0 || index + change >= images.Count) return; (images[index], images[index + change]) = (images[index + change], images[index]); await Changed(); }
    private async Task Remove(int index) { if (uploading || index < 0 || index >= images.Count) return; images.RemoveAt(index); await Changed(); }
    private async Task Upload(InputFileChangeEventArgs args)
    {
        if (uploading) return;
        uploading = true;
        readingStreams = true;
        error = null;

        List<(string Name, string ContentType, MemoryStream Buffer)> buffered = [];
        try
        {
            // Buffer all selected streams before disabling the <InputFile> DOM element so multi-file drops/picks never lose later files.
            foreach (var file in args.GetMultipleFiles(10))
            {
                var ms = new MemoryStream();
                await using var stream = file.OpenReadStream(10 * 1024 * 1024);
                await stream.CopyToAsync(ms);
                ms.Position = 0;
                buffered.Add((file.Name, file.ContentType, ms));
            }

            readingStreams = false;
            await BusyChanged.InvokeAsync(true);
            await InvokeAsync(StateHasChanged);

            foreach (var item in buffered)
            {
                var uploadRes = await Backend.UploadAsync(item.Buffer, item.Name, item.ContentType, false);
                switch (uploadRes)
                {
                    case string uploaded:
                        if (!images.Contains(uploaded)) images.Add(uploaded);
                        await Changed();
                        break;
                    case Error err:
                        error = err.Message;
                        break;
                }
                if (uploadRes is Error) break;
            }
        }
        catch (Exception failure) when (failure is IOException or HttpRequestException or InvalidOperationException)
        {
            error = "One or more images could not be uploaded. Check the file count, size and connection.";
        }
        finally
        {
            foreach (var item in buffered) await item.Buffer.DisposeAsync();
            readingStreams = false;
            uploading = false;
            await BusyChanged.InvokeAsync(false);
        }
    }
}
