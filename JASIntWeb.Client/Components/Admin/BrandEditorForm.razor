@inherits AdminEditorBase<BrandEditForm>
<PageTitle>@(Id == 0 ? "Add brand" : "Edit brand") — JAS Admin</PageTitle>
<AdminPageHeader Title="@(Id == 0 ? "Add brand" : "Edit brand")" Description="Set up the brand’s identity, storefront content and visibility." ActionHref="/admin/brands" ActionText="Back to brands" />
@if (notFound)
{
    <p class="admin-empty">Brand not found.</p>
}
else
{
    @if (error is not null) { <p class="form-error" role="alert">@error</p> }
    @if (AccessDenied) { <a href="/account/login?returnUrl=/admin/brands" class="btn-secondary">Sign in again</a> }
    @if (RestoredFromDraft)
    {
        <div class="editor-recovery flex items-center justify-between p-3 mb-4 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-800" role="status">
            <span class="flex items-center gap-1.5 font-medium">
                <svg class="size-4 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                Restored unsaved draft from local storage.
            </span>
            <button type="button" class="text-xs font-semibold text-amber-900 underline hover:text-amber-950 ml-3 cursor-pointer" @onclick="DiscardDraftAsync">Discard draft</button>
        </div>
    }
    @if (Input is null) { <p class="admin-help">Loading brand…</p> }
    else
    {
        <EditForm data-admin-draft data-admin-dirty="@(HasUnsavedChanges ? "true" : "false")" @oninput="MarkEdited" @onchange="MarkEdited" EditContext="EditContext" OnValidSubmit="Save" class="admin-form brand-editor">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <fieldset disabled="@(!RendererInfo.IsInteractive || saving)">
                <div class="brand-editor-grid">
                    <div class="brand-editor-main">
                        <section class="brand-editor-section">
                            <h2>Brand details</h2>
                            <p class="brand-section-description">The name and summary customers see across your store.</p>
                            <div class="admin-form-grid">
                                <label class="shop-label">Brand name <span class="admin-required">Required</span>
                                    <input @bind="Input!.Name" @bind:event="oninput" @bind:after="NameChanged" class="shop-input" placeholder="e.g. realme" />
                                </label>
                                <label class="shop-label">URL slug
                                    <input @bind="Input!.Slug" @bind:event="oninput" @bind:after="SlugChanged" class="shop-input" placeholder="e.g. realme" />
                                    <small>Storefront address: /brand/@(string.IsNullOrWhiteSpace(Input.Slug) ? "brand-name" : Input.Slug)</small>
                                </label>
                            </div>
                            <label class="shop-label">Brief description <span class="admin-optional">Optional</span>
                                <textarea @bind="Input!.Description" @bind:event="oninput" class="shop-input" rows="3" placeholder="A short introduction to the brand and its products"></textarea>
                                <small>Appears below the brand heading when no custom introduction is set. Also supplies the default SEO description.</small>
                            </label>
                        </section>
                        <details class="brand-editor-section brand-editor-disclosure">
                            <summary><span>Storefront content</span><span class="admin-optional">Optional</span></summary>
                            <p class="brand-section-description">Add an introduction and a buying guide to the public brand page.</p>
                            <AdminRichText ConvertLegacyContent="true" Disabled="Busy" Label="Introduction — above the products" @bind-Value="Input!.IntroText" @bind-Value:after="MarkEdited" />
                            <AdminRichText ConvertLegacyContent="true" Disabled="Busy" Label="Buyer guide — below the products" @bind-Value="Input!.BottomSeoCopy" @bind-Value:after="MarkEdited" />
                        </details>
                        <details class="brand-editor-section brand-editor-disclosure">
                            <summary><span>Search &amp; social sharing</span><span class="admin-optional">Optional</span></summary>
                            <p class="brand-section-description">Customize search results and link previews. Leave blank to use the store’s defaults.</p>
                            <AdminSeoFields Kind="brand" Name="@Input!.Name" Slug="@Input.Slug" @bind-Title="Input.MetaTitle" @bind-Description="Input.MetaDescription" FallbackDescription="@Input.Description" BaseUrl="@Snapshot!.PublicBaseUrl" />
                            <AdminImagePicker Label="Social sharing image" @bind-Value="Input!.OgImageUrl" @bind-Value:after="MarkEdited" BusyChanged="UploadBusy" />
                        </details>
                    </div>
                    <div class="brand-editor-sidebar">
                        <section class="brand-editor-section">
                            <AdminImagePicker Label="Brand logo" @bind-Value="Input!.LogoUrl" @bind-Value:after="MarkEdited" BrandLogo="true" BusyChanged="UploadBusy" />
                        </section>
                        <section class="brand-editor-section">
                            <h2>Storefront visibility</h2>
                            <label class="brand-setting"><InputCheckbox @bind-Value="Input!.IsFeatured" /><span><strong>Feature on homepage</strong><small>Show in the featured brand strip.</small></span></label>
                            <label class="brand-setting"><InputCheckbox @bind-Value="Input!.Hidden" /><span><strong>Hide brand</strong><small>Remove from storefront filters.</small></span></label>
                            <label class="shop-label">Display position<InputNumber @bind-Value="Input!.SortOrder" class="shop-input" /><small>Lower numbers appear first.</small></label>
                        </section>
                    </div>
                </div>
                <div class="brand-editor-actions">
                    <div class="brand-save-actions"><button type="submit" disabled="@Busy" class="shop-button">@(saving ? "Saving…" : Id == 0 ? "Create brand" : "Save changes")</button><a href="/admin/brands" class="shop-button-secondary">Cancel</a></div>
                    @if (Id != 0 && productCount == 0) { <button type="button" disabled="@Busy" @onclick="Delete" class="brand-text-action is-danger">Delete brand</button> }
                </div>
            </fieldset>
        </EditForm>
    }
}

@code {
    private bool slugEdited;
    protected override Task<AdminEditorData<BrandEditForm>> LoadAsync() => Backend.BrandAsync(Id);
    protected override Task<AdminSaveResult> SaveAsync(BrandEditForm input) => Backend.SaveBrandAsync(input);
    private void SlugChanged() => slugEdited = true;
    private void NameChanged()
    {
        if (Id == 0 && !slugEdited) Input!.Slug = EditorSlug.FromName(Input.Name);
    }
    private int productCount => Snapshot?.ProductCount ?? 0;
    private async Task Delete()
    {
        if (Busy) return;
        try { if (!await JS.InvokeAsync<bool>("confirm", "Delete this brand?")) return; saving = true; await Backend.DeleteBrandAsync(Id); HasUnsavedChanges = false; try { await JS.InvokeVoidAsync("jasAdminDrafts.remove", GetDraftStorageKey()); } catch (Exception) { } await JS.InvokeVoidAsync("jasAdminDrafts.clear"); Nav.NavigateTo("/admin/brands"); }
        catch (AdminCatalogException failure) { error = failure.Message; }
        catch (JSException) { error = "Confirmation could not be opened. Try again."; }
        catch (HttpRequestException) { error = "Connection failed. Try again."; }
        finally { saving = false; }
    }
}
