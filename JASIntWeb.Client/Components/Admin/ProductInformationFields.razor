@using JASIntWeb.Client.Contracts
@using JASIntWeb.Client.Services

<section class="rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs space-y-6">
    <div class="pb-4 border-b border-slate-100">
        <h2 class="text-lg font-bold text-slate-900">Basic Information</h2>
        <p class="text-xs text-slate-500 mt-1">
            Core product identity, category placement, and media assets.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1" for="prod-name">Product Name *</label>
            <input id="prod-name" class="shop-input text-xs font-semibold text-slate-900" value="@Information.Name" maxlength="200" placeholder="e.g. CMF by Nothing Watch Pro 2" @oninput="e => Patch(i => i.Name = Text(e))" />
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1" for="prod-slug">URL Slug</label>
            <input id="prod-slug" class="shop-input text-xs font-mono text-slate-600" value="@Information.Slug" @oninput="e => Patch(i => i.Slug = Text(e))" placeholder="Generated from name if empty" />
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1" for="prod-category">Category *</label>
            <select id="prod-category" class="shop-input text-xs" value="@Information.CategoryId" @onchange="e => Patch(i => i.CategoryId = int.TryParse(Text(e), out var id) ? id : 0)">
                <option value="0">Select category...</option>
                @foreach (var category in Categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1" for="prod-brand">Brand</label>
            <select id="prod-brand" class="shop-input text-xs" value="@Information.BrandId" @onchange="e => Patch(i => i.BrandId = int.TryParse(Text(e), out var id) ? id : null)">
                <option value="">No brand / generic</option>
                @foreach (var brand in Brands)
                {
                    <option value="@brand.Id">@brand.Name</option>
                }
            </select>
        </div>
    </div>

    <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1" for="prod-desc">Short Overview</label>
        <textarea id="prod-desc" class="shop-input text-xs" rows="3" placeholder="Brief summary displayed on product cards and search results..." @bind:get="Information.Description" @bind:set="value => Patch(i => i.Description = value)" @bind:event="oninput"></textarea>
    </div>

    <!-- Product Media -->
    <div class="pt-4 border-t border-slate-100">
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-3">Product Media &amp; Gallery</label>
        <AdminProductMedia Value="@(new(Information.Image, Information.Images))" ValueChanged="Media" BusyChanged="UploadBusy" />
    </div>

    <!-- Rich Description & Specs -->
    <div class="pt-4 border-t border-slate-100">
        <AdminRichText Label="Product description & specifications" Height="400" Specifications="true" Disabled="Disabled" Value="@Information.Details" ValueChanged="value => Patch(i => i.Details = value)" />
    </div>

    <!-- Marketing Flags -->
    <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center gap-6">
        <label class="inline-flex items-center gap-2 text-xs font-semibold text-slate-700 cursor-pointer select-none">
            <input type="checkbox" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" checked="@Information.Featured" @onchange="e => Patch(i => i.Featured = (bool)e.Value!)" />
            <span>Feature on homepage</span>
        </label>
        <label class="inline-flex items-center gap-2 text-xs font-semibold text-slate-700 cursor-pointer select-none">
            <input type="checkbox" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" checked="@Information.NewArrival" @onchange="e => Patch(i => i.NewArrival = (bool)e.Value!)" />
            <span>Mark as New Arrival</span>
        </label>
    </div>
</section>

@code {
    [Parameter] public ProductInformation Information { get; set; } = new();
    [Parameter] public List<JASIntWeb.Client.Dtos.CategoryLinkDto> Categories { get; set; } = [];
    [Parameter] public List<JASIntWeb.Client.Dtos.BrandLinkDto> Brands { get; set; } = [];
    [Parameter] public EventCallback<InformationPatch> Changed { get; set; }
    [Parameter] public EventCallback<bool> UploadBusy { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private Task Patch(Action<ProductInformation> update) => Changed.InvokeAsync(new(update));
    private Task Media(AdminMediaValue value) => Patch(i => { i.Image = value.Cover; i.Images = value.Gallery; });
    private static string Text(ChangeEventArgs args) => args.Value?.ToString() ?? "";
}
