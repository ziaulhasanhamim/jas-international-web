<div class="admin-page-header">
    <div class="admin-heading-copy">
        @if (!string.IsNullOrWhiteSpace(Eyebrow)) { <p class="admin-heading-eyebrow">@Eyebrow</p> }
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description)) { <p class="admin-heading-description">@Description</p> }
    </div>
    @if (!string.IsNullOrWhiteSpace(ActionHref))
    {
        <div class="admin-heading-actions">
            @if (!string.IsNullOrWhiteSpace(SecondaryActionHref)) { <a href="@SecondaryActionHref" class="btn-secondary">@SecondaryActionText</a> }
            <a href="@ActionHref" class="@(ActionText.StartsWith("Back", StringComparison.OrdinalIgnoreCase) ? "btn-secondary" : "btn-primary")">@ActionText.TrimStart('+', ' ')</a>
        </div>
    }
</div>

@code
{
    [Parameter]
    public string Title { get; set; } = "";
    [Parameter]
    public string? Eyebrow { get; set; }
    [Parameter]
    public string? Description { get; set; }
    [Parameter]
    public string? ActionHref { get; set; }
    [Parameter]
    public string ActionText { get; set; } = "Add record";
    [Parameter]
    public string? SecondaryActionHref { get; set; }
    [Parameter]
    public string? SecondaryActionText { get; set; }
}
