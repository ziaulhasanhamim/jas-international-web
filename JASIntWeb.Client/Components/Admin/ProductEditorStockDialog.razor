@using JASIntWeb.Client.Contracts

<div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-xs animate-fadeIn" role="dialog" aria-modal="true" aria-labelledby="stock-dialog-title">
    <div class="w-full max-w-lg rounded-2xl bg-white p-6 shadow-2xl border border-slate-200/90 space-y-5 animate-scaleIn">
        <!-- Header -->
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-blue-600 block">Inventory Ledger</span>
                <h3 id="stock-dialog-title" class="text-base font-bold text-slate-900 flex items-center gap-2">
                    Adjust Stock — <span class="font-mono text-slate-700">@(string.IsNullOrWhiteSpace(Variant.Sku) ? "Variant" : Variant.Sku)</span>
                </h3>
            </div>
            <button type="button" class="text-slate-400 hover:text-slate-600 font-bold p-1 rounded-lg hover:bg-slate-100 transition cursor-pointer" @onclick="Cancel" aria-label="Close dialog">✕</button>
        </div>

        <!-- Inventory Metrics -->
        <div class="grid grid-cols-3 gap-3 text-center">
            <div class="rounded-xl border border-slate-200/80 bg-slate-50 p-3">
                <span class="text-[11px] font-medium text-slate-500 block">On Hand</span>
                <strong class="text-lg font-bold text-slate-900">@Variant.OnHand</strong>
            </div>
            <div class="rounded-xl border border-slate-200/80 bg-slate-50 p-3">
                <span class="text-[11px] font-medium text-slate-500 block">Reserved</span>
                <strong class="text-lg font-bold text-amber-600">@Variant.Reserved</strong>
            </div>
            <div class="rounded-xl border border-slate-200/80 bg-emerald-50/60 border-emerald-200/80 p-3">
                <span class="text-[11px] font-medium text-emerald-700 block">Available</span>
                <strong class="text-lg font-bold text-emerald-700">@(Variant.OnHand - Variant.Reserved)</strong>
            </div>
        </div>

        <!-- Form Inputs -->
        <div class="space-y-4">
            <div>
                <div class="flex items-center justify-between mb-1">
                    <label class="block text-xs font-semibold text-slate-700">New On-Hand Quantity *</label>
                    @if (ValidQuantity)
                    {
                        var delta = Quantity - Variant.OnHand;
                        @if (delta > 0)
                        {
                            <span class="inline-flex items-center text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                                +@delta units (Addition)
                            </span>
                        }
                        else if (delta < 0)
                        {
                            <span class="inline-flex items-center text-[11px] font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded-full border border-rose-200">
                                @delta units (Deduction)
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center text-[11px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full">
                                No change (0)
                            </span>
                        }
                    }
                </div>
                <input class="shop-input text-sm font-bold text-slate-900" type="number" min="0" value="@quantityText" @oninput="@(e => quantityText = e.Value?.ToString() ?? "")" placeholder="Enter updated on-hand count" />
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Reason for Adjustment *</label>
                <input class="shop-input text-xs" value="@reason" maxlength="500" placeholder="e.g. Restocked shipment, audit correction, damaged item..." @oninput="@(e => reason = e.Value?.ToString() ?? "")" />
                <!-- Quick Reason Pills -->
                <div class="flex flex-wrap items-center gap-1.5 mt-2">
                    <span class="text-[11px] text-slate-400">Quick:</span>
                    @foreach (var r in quickReasons)
                    {
                        <button type="button" class="text-[11px] px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 hover:bg-blue-50 hover:text-blue-700 border border-slate-200/60 transition cursor-pointer" @onclick="() => reason = r">
                            @r
                        </button>
                    }
                </div>
            </div>
        </div>

        @if (Message is not null)
        {
            <div class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800 font-semibold" role="alert">
                @Message
            </div>
        }

        <!-- Actions -->
        <div class="flex items-center justify-between pt-3 border-t border-slate-100 gap-2">
            <button type="button" class="btn-secondary text-xs !py-2 !px-3 font-medium cursor-pointer" disabled="@Busy" @onclick="Refresh">
                Review Current Stock
            </button>
            <div class="flex items-center gap-2">
                <button type="button" class="btn-secondary text-xs !py-2 !px-4 cursor-pointer" disabled="@Busy" @onclick="Cancel">
                    Cancel
                </button>
                <button type="button" class="btn-primary text-xs !py-2 !px-5 !bg-blue-600 hover:!bg-blue-700 font-bold shadow-xs cursor-pointer disabled:opacity-50" disabled="@(Busy || !ValidQuantity || string.IsNullOrWhiteSpace(reason))" @onclick="Submit">
                    @(Busy ? "Recording..." : "Record Adjustment")
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int ProductId { get; set; }
    [Parameter] public EditorVariant Variant { get; set; } = new();
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback<EditorStock> Save { get; set; }
    [Parameter] public EventCallback Refresh { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }

    private Guid loaded;
    private string quantityText = "";
    private string reason = "";

    private readonly string[] quickReasons =
    [
        "Restock from shipment",
        "Physical audit correction",
        "Damaged / Defective item",
        "Returned to stock"
    ];

    private bool ValidQuantity => int.TryParse(quantityText, out var value) && value >= 0;
    private int Quantity => int.TryParse(quantityText, System.Globalization.CultureInfo.InvariantCulture, out var value) ? value : 0;

    protected override void OnParametersSet()
    {
        if (loaded != Variant.ClientId)
        {
            loaded = Variant.ClientId;
            quantityText = Variant.OnHand.ToString(System.Globalization.CultureInfo.InvariantCulture);
            reason = "";
        }
    }

    private Task Submit() => Save.InvokeAsync(new(Guid.NewGuid(), ProductId, Variant.Id, Variant.InventoryVersion, Quantity, reason));
}
