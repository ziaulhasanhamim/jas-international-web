@rendermode InteractiveAuto
@inject IJSRuntime JS
@using System.Text.Json
@using JASIntWeb.Client.Dtos

@if (loading)
{
    <div class="py-8 text-center text-xs text-slate-400">
        <span class="inline-block size-4 animate-spin rounded-full border-2 border-current border-r-transparent mr-2 align-middle"></span>
        Loading recent orders from this device…
    </div>
}
else if (deviceOrders.Count == 0)
{
    <div class="rounded-3xl border border-slate-200/90 bg-white p-8 sm:p-12 text-center shadow-xs">
        <span class="flex size-14 items-center justify-center rounded-2xl bg-slate-50 text-slate-400 mx-auto mb-4">
            <Icon Name="receipt" Class="size-7" />
        </span>
        <h2 class="text-lg font-bold text-slate-900 mb-1">No Orders On This Device</h2>
        <p class="text-xs text-slate-500 max-w-sm mx-auto mb-6">
            You haven't placed any orders on this browser yet. If you have an account, sign in to view your full order history.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
            <a href="/products" class="btn-primary text-xs">
                Explore Gadgets
            </a>
            <a href="/account/login" data-enhance="false" class="btn-secondary text-xs">
                Sign In to Account
            </a>
        </div>
    </div>
}
else
{
    <div class="space-y-4">
        @foreach (var o in deviceOrders)
        {
            <div class="rounded-3xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-xs hover:border-slate-300 transition">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-4 border-b border-slate-100">
                    <div>
                        <div class="flex items-center gap-2.5">
                            <h3 class="font-bold text-slate-900 text-base">Order #@o.Id</h3>
                            @switch (o.Status)
                            {
                                case "Pending":
                                    <span class="badge badge-amber">Placed &amp; Reserved</span>
                                    break;
                                case "Processing":
                                    <span class="badge badge-blue">Confirmed &amp; Preparing</span>
                                    break;
                                case "InTransit":
                                    <span class="badge badge-purple">Ready for Pickup / In Transit</span>
                                    break;
                                case "Delivered":
                                    <span class="badge badge-emerald">Fulfilled / Delivered</span>
                                    break;
                                case "Cancelled":
                                    <span class="badge badge-rose">Cancelled</span>
                                    break;
                                default:
                                    <span class="badge badge-slate">@o.Status</span>
                                    break;
                            }
                        </div>
                        <span class="text-xs text-slate-400 block mt-1">
                            Placed on @o.CreatedAt.ToOffset(TimeSpan.FromHours(6)).ToString("dd MMM yyyy, hh:mm tt")
                        </span>
                    </div>

                    <div class="text-left sm:text-right">
                        <span class="text-xs text-slate-400 block">Total Payable</span>
                        <strong class="text-lg font-extrabold text-blue-600 tabular-nums">৳@o.Total.ToString("N0")</strong>
                    </div>
                </div>

                <div class="py-3">
                    <p class="text-xs font-semibold text-slate-700 mb-1.5">Items (@o.ItemCount):</p>
                    <ul class="text-xs text-slate-600 space-y-1">
                        @foreach (var item in o.ItemNames)
                        {
                            <li class="flex items-center gap-2">
                                <span class="size-1 rounded-full bg-slate-400"></span>
                                <span>@item</span>
                            </li>
                        }
                    </ul>
                </div>

                <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-[11px] text-slate-400">@(o.IsVerified ? "Payment Verified" : (o.Status == "Cancelled" ? "Cancelled" : "Verification Pending"))</span>
                    @if (!o.IsVerified && o.Status != "Cancelled")
                    {
                        <a href="/payment-verification?orderid=@o.Id" class="btn-primary !px-3 !py-1.5 text-xs">
                            Awaiting Verification →
                        </a>
                    }
                    else
                    {
                        <a href="/order/@o.Id" class="btn-secondary !px-3 !py-1.5 text-xs">
                            View Order Receipt
                        </a>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private bool loading = true;
    private List<DeviceOrderDto> deviceOrders = [];

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;

        try
        {
            var raw = await JS.InvokeAsync<string>("jasGetGuestOrders");
            if (!string.IsNullOrWhiteSpace(raw) && raw != "[]")
            {
                using var doc = JsonDocument.Parse(raw);
                var tokens = new List<Guid>();
                foreach (var element in doc.RootElement.EnumerateArray())
                {
                    if (element.TryGetProperty("token", out var tokenProp) && Guid.TryParse(tokenProp.GetString(), out var token))
                    {
                        tokens.Add(token);
                    }
                }

                if (tokens.Count > 0)
                {
                    var jsonResult = await JS.InvokeAsync<string>("jasFetchDeviceOrders", JsonSerializer.Serialize(tokens));
                    if (!string.IsNullOrWhiteSpace(jsonResult) && jsonResult != "[]")
                    {
                        var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                        deviceOrders = JsonSerializer.Deserialize<List<DeviceOrderDto>>(jsonResult, options) ?? [];
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching device orders: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }
}
