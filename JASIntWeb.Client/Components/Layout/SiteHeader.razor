<!-- Primary Brand Header (Pure Static SSR with Data-Attribute Micro-Interactions) -->
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur-md shadow-xs">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 sm:gap-6 px-4 py-3 sm:px-6">
        <!-- Brand Logo with SINCE 2005 and Brand Name -->
        <a href="/" class="flex shrink-0 items-center gap-2.5 sm:gap-3 group">
            <img src="/jas-logo.png" width="48" height="48" class="size-10 sm:size-11 rounded-xl shadow-xs group-hover:scale-105 transition-transform" alt="JAS International" />
            <div class="leading-none">
                <div class="flex items-center gap-1.5">
                    <span class="font-display font-extrabold text-xl sm:text-2xl text-blue-600 tracking-tight">JAS</span>
                    <span class="text-slate-300 font-light text-base select-none">|</span>
                    <span class="text-[10px] sm:text-[11px] font-black tracking-widest text-slate-600 uppercase">SINCE 2005</span>
                </div>
                <span class="block text-[9px] sm:text-[10px] font-bold uppercase tracking-widest text-slate-400 mt-1">International</span>
            </div>
        </a>

        <!-- Global Search Bar (Native Static SSR Enhanced Form) -->
        <form method="get" action="/products" data-enhance class="hidden md:flex flex-1 max-w-md lg:max-w-xl relative">
            <input
                id="site-search"
                name="q"
                type="search"
                placeholder="Search smartwatches, earbuds, chargers, gadgets..."
                class="w-full rounded-full border border-slate-200/90 bg-slate-50/90 px-4 py-2.5 pl-10 pr-24 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-3 focus:ring-blue-100"
            />
            <span class="absolute left-3.5 top-3 text-slate-400">
                <Icon Name="search" Class="size-4" />
            </span>
            <button type="submit" class="absolute right-1.5 top-1.5 rounded-full bg-blue-600 px-4 py-1.5 text-xs font-bold text-white shadow-xs hover:bg-blue-700 active:scale-95 transition cursor-pointer">
                Search
            </button>
        </form>

        <!-- Right Utility Actions (Gadget & Gear inspired) -->
        <div class="flex items-center gap-1.5 sm:gap-2.5">
            <!-- Mobile Call Button -->
            <a href="tel:01711465078" class="inline-flex sm:hidden items-center gap-1 text-[11px] font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 px-2.5 py-1.5 rounded-full transition active:scale-95" aria-label="Call Showroom">
                <Icon Name="phone" Class="size-3.5 text-blue-600" />
                <span>Call</span>
            </a>

            <!-- Offers Link -->
            <a href="/products?sort=newest" class="hidden xl:inline-flex items-center gap-1.5 text-xs font-bold text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-200/80 px-3 py-1.5 rounded-full transition shadow-2xs">
                <span>🔥 Offers</span>
            </a>

            <!-- Track Order Link -->
            <a href="/track-order" class="hidden lg:inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 hover:text-blue-600 hover:bg-slate-100 px-3 py-1.5 rounded-full transition">
                <span>📦</span>
                <span>Track Order</span>
            </a>

            <!-- Showroom / Store Locator -->
            <a href="/contact" class="hidden lg:inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 hover:text-blue-600 hover:bg-slate-100 px-3 py-1.5 rounded-full transition">
                <Icon Name="map-pin" Class="size-3.5 text-blue-600" />
                <span>Showroom</span>
            </a>

            <!-- Account / Auth (Hidden on small mobile where Account lives in bottom nav) -->
            <AuthorizeView>
                <Authorized Context="user">
                    <a href="/account" data-enhance="false" class="hidden sm:inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700 hover:border-blue-200 transition">
                        <span class="flex size-6 items-center justify-center rounded-full bg-blue-600 text-[10px] text-white font-bold">
                            @(user.User.Identity?.Name?.FirstOrDefault().ToString().ToUpperInvariant() ?? "U")
                        </span>
                        <span class="hidden sm:inline max-w-[100px] truncate">Account</span>
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a href="/account/login" data-enhance="false" class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition whitespace-nowrap">
                        <Icon Name="user" Class="size-4 text-slate-500" />
                        <span>Sign In</span>
                    </a>
                </NotAuthorized>
            </AuthorizeView>

            <!-- Admin Link if Admin -->
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <a href="/admin" class="hidden sm:inline-flex items-center gap-1 rounded-full bg-indigo-50 px-3 py-1.5 text-xs font-semibold text-indigo-700 hover:bg-indigo-100 transition ring-1 ring-indigo-500/20">
                        <Icon Name="dashboard" Class="size-3.5" />
                        <span>Admin</span>
                    </a>
                </Authorized>
            </AuthorizeView>

            <!-- Wishlist Link (Hidden on small mobile where Wishlist lives in bottom nav) -->
            <a href="/wishlist" class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-rose-600 transition relative" aria-label="Wishlist">
                <Icon Name="heart" Class="size-4 text-rose-500" />
                <span>Wishlist</span>
            </a>

            <!-- Cart Trigger Button (Static SSR with data-jas-cart-count) -->
            <a
                href="/cart"
                class="inline-flex items-center gap-1.5 sm:gap-2 rounded-full bg-blue-600 px-3 sm:px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-white shadow-xs hover:bg-blue-700 transition active:scale-95"
                aria-label="Open shopping cart"
            >
                <Icon Name="cart" Class="size-4" />
                <span class="hidden xs:inline">Cart</span>
                <span data-jas-cart-count class="flex size-5 items-center justify-center rounded-full bg-white text-[11px] font-bold text-blue-700">
                    0
                </span>
            </a>
        </div>
    </div>

    <!-- Mobile Quick Search Bar (Static SSR Enhanced Form) -->
    <div class="md:hidden px-4 pb-2.5 pt-0.5">
        <form method="get" action="/products" data-enhance class="relative">
            <input
                id="site-search-mobile"
                name="q"
                type="search"
                placeholder="Search smartwatches, earbuds, chargers..."
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 pl-9 pr-14 text-xs text-slate-800 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100"
            />
            <span class="absolute left-3 top-2.5 text-slate-400">
                <Icon Name="search" Class="size-3.5" />
            </span>
            <button type="submit" class="absolute right-1.5 top-1.5 rounded-lg bg-blue-600 px-2.5 py-1 text-[11px] font-bold text-white shadow-2xs hover:bg-blue-700 active:scale-95 transition">
                Go
            </button>
        </form>
    </div>

    <!-- Category Strip -->
    <div class="border-t border-slate-100 bg-white px-4 py-2 sm:px-6">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 overflow-x-auto text-xs font-medium text-slate-600 scrollbar-none touch-pan-x [-webkit-overflow-scrolling:touch]">
            <div class="flex items-center gap-6 whitespace-nowrap">
                <a href="/products" class="hover:text-blue-600 transition font-semibold text-slate-900">All Gadgets</a>
                <a href="/category/smartwatches" class="hover:text-blue-600 transition">Smart Watches</a>
                <a href="/category/audio-earbuds" class="hover:text-blue-600 transition">Audio &amp; Earbuds</a>
                <a href="/category/power-charging" class="hover:text-blue-600 transition">Power &amp; Chargers</a>
                <a href="/category/cables-adapters" class="hover:text-blue-600 transition">Cables &amp; Adapters</a>
                <a href="/category/speakers" class="hover:text-blue-600 transition">Speakers</a>
                <a href="/category/cases-protection" class="hover:text-blue-600 transition">Protection</a>
                <a href="/category/creator-gear" class="hover:text-blue-600 transition">Creator Gear</a>
                <a href="/products?sort=newest" class="text-blue-600 font-semibold hover:underline">New Arrivals</a>
            </div>
            <div class="hidden sm:flex items-center gap-3 shrink-0 text-slate-400">
                <span class="text-[11px]">Free delivery on select products</span>
            </div>
        </div>
    </div>
</header>

<!-- Fixed 5-Tab Native Mobile Bottom Navigation Bar -->
<nav class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-200/90 shadow-xl px-1.5 pt-1.5 pb-[calc(0.5rem+env(safe-area-inset-bottom,0px))] flex items-center justify-between text-[10px] font-semibold text-slate-500">
    <NavLink href="/" Match="NavLinkMatch.All" class="flex flex-1 flex-col items-center justify-center gap-1 py-1 px-1 rounded-xl transition-all duration-150 hover:text-blue-600 active:scale-95 [&.active]:text-blue-600 [&.active]:font-bold">
        <Icon Name="dashboard" Class="size-5" />
        <span class="tracking-tight">Home</span>
    </NavLink>
    
    <NavLink href="/products" class="flex flex-1 flex-col items-center justify-center gap-1 py-1 px-1 rounded-xl transition-all duration-150 hover:text-blue-600 active:scale-95 [&.active]:text-blue-600 [&.active]:font-bold">
        <Icon Name="box" Class="size-5" />
        <span class="tracking-tight">Shop</span>
    </NavLink>

    <!-- Cart Button with live Badge (Static SSR with data-jas-cart-count) -->
    <a href="/cart" class="flex flex-1 flex-col items-center justify-center gap-1 py-1 px-1 rounded-xl transition-all duration-150 hover:text-blue-600 active:scale-95 cursor-pointer relative" aria-label="Cart">
        <div class="relative">
            <Icon Name="cart" Class="size-5 text-slate-700" />
            <span data-jas-cart-count class="absolute -top-1.5 -right-2 flex size-4 items-center justify-center rounded-full bg-blue-600 text-[9px] font-bold text-white shadow-xs">
                0
            </span>
        </div>
        <span class="tracking-tight text-slate-700">Cart</span>
    </a>

    <!-- Wishlist Button -->
    <NavLink href="/wishlist" class="flex flex-1 flex-col items-center justify-center gap-1 py-1 px-1 rounded-xl transition-all duration-150 hover:text-rose-600 active:scale-95 [&.active]:text-rose-600 [&.active]:font-bold relative">
        <div class="relative">
            <Icon Name="heart" Class="size-5 text-slate-700" />
        </div>
        <span class="tracking-tight">Wishlist</span>
    </NavLink>

    <!-- Account Button (Orders & Profile accessible within) -->
    <NavLink href="/account" data-enhance="false" class="flex flex-1 flex-col items-center justify-center gap-1 py-1 px-1 rounded-xl transition-all duration-150 hover:text-blue-600 active:scale-95 [&.active]:text-blue-600 [&.active]:font-bold">
        <Icon Name="user" Class="size-5" />
        <span class="tracking-tight">Account</span>
    </NavLink>
</nav>
