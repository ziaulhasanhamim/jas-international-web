@rendermode InteractiveAuto
@implements IAsyncDisposable
@inject NavigationManager NavManager
@inject CartService Cart

<header class="sticky top-0 z-50">
    <div class="border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
        <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-3 sm:px-6 lg:px-8">
            <a href="/" class="flex shrink-0 items-center gap-2">
                <img src="@Assets["jas-logo.png"]" class="w-12 rounded-xl" alt="">
                <span class="leading-tight">
                    <span class="font-display block text-lg font-semibold tracking-tight">International</span>
                    <span class="block text-[10px] uppercase tracking-[0.18em] text-slate-500">Gadget store</span>
                </span>
            </a>

            <nav class="hidden items-center gap-6 text-sm font-medium text-slate-600 lg:flex">
                <a href="#phones" class="hover:text-ink">Phones</a>
                <a href="#laptops" class="hover:text-ink">Laptops</a>
                <a href="#audio" class="hover:text-ink">Audio</a>
                <a href="#wearables" class="hover:text-ink">Wearables</a>
                <a href="#featured" class="hover:text-ink">Deals</a>
            </nav>

            <form class="relative ml-auto hidden min-w-0 flex-1 max-w-md md:block" action="/" method="get"
                  @onsubmit:preventDefault>
                <label class="sr-only" for="site-search">Search gadgets</label>
                <input id="site-search" type="search" placeholder="Search phones, laptops, earbuds…"
                       class="w-full rounded-full border border-slate-200 bg-mist py-2.5 pl-4 pr-11 text-sm outline-none ring-volt/30 placeholder:text-slate-400 focus:border-volt focus:ring-2" />
                <span class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="m21 21-4.3-4.3M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
                    </svg>
                </span>
            </form>

            <div class="ml-auto flex items-center gap-1 md:ml-0">
                <a href="#account"
                   class="hidden rounded-full p-2.5 text-slate-600 hover:bg-mist hover:text-ink sm:inline-flex"
                   aria-label="Account">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M15.75 7.5a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 19.5a7.5 7.5 0 0 1 15 0" />
                    </svg>
                </a>
                <button type="button" @onclick="OpenCart" class="relative flex h-10 w-10 items-center justify-center
                    rounded-full text-slate-600 hover:bg-slate-100" aria-label="Open cart">

                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="1.8">

                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.75 3.75h2l1.5 11h10.5l2-8H6" />

                        <circle cx="9" cy="19" r="1" />
                        <circle cx="17" cy="19" r="1" />

                    </svg>

                    @if (Cart.ItemCount > 0)
                    {
                        <span class="absolute -right-1 -top-1 flex h-5 min-w-5
                            items-center justify-center rounded-full
                            bg-volt px-1 text-[10px] font-bold text-white">
                            @Cart.ItemCount
                        </span>
                    }

                </button>
                <button type="button" class="rounded-full p-2.5 text-slate-600 hover:bg-mist lg:hidden"
                        aria-label="Open menu" aria-expanded="@(MenuOpen ? "true" : "false")" @onclick="ToggleMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="1.8">
                        @if (MenuOpen)
                        {
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                        }
                        else
                        {
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
                        }
                    </svg>
                </button>
            </div>
        </div>

        <nav
            class="@($"space-y-1 border-t border-slate-100 px-4 py-3 lg:hidden overflow-hidden transition-all duration-100 ease {(MenuOpen ? "max-h-96 opacity-100" : "max-h-0 opacity-0 py-0 border-transparent")}")">
            <a href="#phones" class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-mist" @onclick="CloseMenu">
                Phones
            </a>

            <a href="#laptops" class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-mist"
               @onclick="CloseMenu">
                Laptops
            </a>

            <a href="#audio" class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-mist" @onclick="CloseMenu">
                Audio
            </a>

            <a href="#wearables" class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-mist"
               @onclick="CloseMenu">
                Wearables
            </a>

            <a href="#featured" class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-mist"
               @onclick="CloseMenu">
                Deals
            </a>
        </nav>
    </div>
</header>
<CartDrawer Open=_cartOpen OpenChanged="() => _cartOpen = false" />

@code {
    [Parameter]
    public bool MenuOpen { get; set; }
    private bool _cartOpen;

    private void ToggleMenu() => MenuOpen = !MenuOpen;

    private void CloseMenu() => MenuOpen = false;

    private void OpenCart()
    {
        _cartOpen = true;
    }

    private void CloseCart()
    {
        _cartOpen = false;
    }

    protected override void OnInitialized()
    {
        Cart.OnChange += OnCartChanged;
    }

    private void OnCartChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public ValueTask DisposeAsync()
    {
        Cart.OnChange -= OnCartChanged;
        return ValueTask.CompletedTask;
    }
}