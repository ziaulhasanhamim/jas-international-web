@rendermode InteractiveAuto
@implements IDisposable
@inject CartService Cart
@inject WishlistService Wishlist
@inject NavigationManager Nav

<!-- Primary Brand Header -->
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur-md shadow-xs">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 sm:gap-6 px-4 py-3 sm:px-6">
        <!-- Brand Logo with SINCE 2005 and Brand Name -->
        <a href="/" class="flex shrink-0 items-center gap-2.5 sm:gap-3 group">
            <img src="/jas-logo.png" width="48" height="48" class="size-10 sm:size-11 rounded-xl shadow-xs group-hover:scale-105 transition-transform" alt="JAS International" />
            <div class="leading-none">
                <div class="flex items-center gap-1.5">
                    <span class="font-display font-extrabold text-xl sm:text-2xl text-blue-600 tracking-tight">JAS</span>
                    <span class="text-slate-300 font-light text-base select-none">|</span>
                    <span class="text-[10px] sm:text-[11px] font-black tracking-widest text-slate-600 uppercase">SINCE 2005</span>
                </div>
                <span class="block text-[9px] sm:text-[10px] font-bold uppercase tracking-widest text-slate-400 mt-1">International</span>
            </div>
        </a>

        <!-- Global Search Bar (Client-side Enhanced Navigation - No Full Page Reload) -->
        <form @onsubmit="ExecuteSearch" class="hidden md:flex flex-1 max-w-md lg:max-w-xl relative">
            <input
                id="site-search"
                type="search"
                @bind="searchQuery"
                @bind:event="oninput"
                placeholder="Search gadgets, smartphones, laptops, audio..."
                class="w-full rounded-full border border-slate-200/90 bg-slate-50/90 px-4 py-2.5 pl-10 pr-24 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-3 focus:ring-blue-100"
            />
            <span class="absolute left-3.5 top-3 text-slate-400">
                <Icon Name="search" Class="size-4" />
            </span>
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <button type="button" @onclick="() => searchQuery = string.Empty" class="absolute right-20 top-2.5 text-slate-400 hover:text-slate-600 p-0.5 text-xs font-bold cursor-pointer">
                    ✕
                </button>
            }
            <button type="submit" class="absolute right-1.5 top-1.5 rounded-full bg-blue-600 px-4 py-1.5 text-xs font-bold text-white shadow-xs hover:bg-blue-700 active:scale-95 transition cursor-pointer">
                Search
            </button>
        </form>

        <!-- Right Utility Actions (Gadget & Gear inspired) -->
        <div class="flex items-center gap-2 sm:gap-2.5">
            <!-- Offers Link -->
            <a href="/products?sort=newest" class="hidden xl:inline-flex items-center gap-1.5 text-xs font-bold text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-200/80 px-3 py-1.5 rounded-full transition shadow-2xs">
                <span>🔥 Offers</span>
            </a>

            <!-- Showroom / Store Locator -->
            <a href="/contact" class="hidden lg:inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 hover:text-blue-600 hover:bg-slate-100 px-3 py-1.5 rounded-full transition">
                <Icon Name="map-pin" Class="size-3.5 text-blue-600" />
                <span>Showroom</span>
            </a>

            <!-- Account / Auth -->
            <AuthorizeView>
                <Authorized Context="user">
                    <a href="/account" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700 hover:border-blue-200 transition">
                        <span class="flex size-6 items-center justify-center rounded-full bg-blue-600 text-[10px] text-white font-bold">
                            @(user.User.Identity?.Name?.FirstOrDefault().ToString().ToUpperInvariant() ?? "U")
                        </span>
                        <span class="hidden sm:inline max-w-[100px] truncate">Account</span>
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a href="/account/login" class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition">
                        <Icon Name="user" Class="size-4 text-slate-500" />
                        <span>Sign In</span>
                    </a>
                </NotAuthorized>
            </AuthorizeView>

            <!-- Admin Link if Admin -->
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <a href="/admin" class="hidden sm:inline-flex items-center gap-1 rounded-full bg-indigo-50 px-3 py-1.5 text-xs font-semibold text-indigo-700 hover:bg-indigo-100 transition ring-1 ring-indigo-500/20">
                        <Icon Name="dashboard" Class="size-3.5" />
                        <span>Admin</span>
                    </a>
                </Authorized>
            </AuthorizeView>

            <!-- Wishlist Link -->
            <a href="/wishlist" class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-rose-600 transition relative" aria-label="Wishlist">
                <Icon Name="heart" Class="size-4 text-rose-500" />
                <span class="hidden sm:inline">Wishlist</span>
                @if (Wishlist.Count > 0)
                {
                    <span class="flex size-4 items-center justify-center rounded-full bg-rose-500 text-[10px] font-bold text-white">
                        @Wishlist.Count
                    </span>
                }
            </a>

            <!-- Cart Trigger Button -->
            <button
                type="button"
                @onclick="() => open = true"
                class="inline-flex items-center gap-2 rounded-full bg-blue-600 px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition"
                aria-label="Open shopping cart"
            >
                <Icon Name="cart" Class="size-4" />
                <span>Cart</span>
                <span class="flex size-5 items-center justify-center rounded-full bg-white text-[11px] font-bold text-blue-700">
                    @Cart.ItemCount
                </span>
            </button>
        </div>
    </div>

    <!-- Mobile Quick Search Bar (Enhanced Client Navigation) -->
    <div class="md:hidden px-4 pb-2.5 pt-0.5">
        <form @onsubmit="ExecuteSearch" class="relative">
            <input
                id="site-search-mobile"
                type="search"
                @bind="searchQuery"
                @bind:event="oninput"
                placeholder="Search gadgets, smartphones, laptops..."
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 pl-9 pr-14 text-xs text-slate-800 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100"
            />
            <span class="absolute left-3 top-2.5 text-slate-400">
                <Icon Name="search" Class="size-3.5" />
            </span>
            <button type="submit" class="absolute right-1.5 top-1.5 rounded-lg bg-blue-600 px-2.5 py-1 text-[11px] font-bold text-white shadow-2xs hover:bg-blue-700 active:scale-95 transition">
                Go
            </button>
        </form>
    </div>

    <!-- Category Strip -->
    <div class="border-t border-slate-100 bg-white px-4 py-2 sm:px-6">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 overflow-x-auto text-xs font-medium text-slate-600 scrollbar-none">
            <div class="flex items-center gap-6 whitespace-nowrap">
                <a href="/products" class="hover:text-blue-600 transition font-semibold text-slate-900">All Gadgets</a>
                <a href="/category/phones" class="hover:text-blue-600 transition">Smartphones</a>
                <a href="/category/laptops" class="hover:text-blue-600 transition">Laptops</a>
                <a href="/category/headphones" class="hover:text-blue-600 transition">Audio &amp; Earbuds</a>
                <a href="/category/wearables" class="hover:text-blue-600 transition">Smart Watches</a>
                <a href="/category/speakers" class="hover:text-blue-600 transition">Bluetooth Speakers</a>
                <a href="/products?sort=newest" class="text-blue-600 font-semibold hover:underline">New Arrivals</a>
            </div>
            <div class="hidden sm:flex items-center gap-3 shrink-0 text-slate-400">
                <span class="text-[11px]">Free delivery on select products</span>
            </div>
        </div>
    </div>
</header>

<!-- 5-Tab Mobile Bottom Navigation Bar -->
<nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200/90 shadow-lg px-2 py-1.5 flex items-center justify-around text-[10px] font-semibold text-slate-500">
    <NavLink href="/" Match="NavLinkMatch.All" class="flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition hover:text-blue-600 [&.active]:text-blue-600 [&.active]:font-bold">
        <Icon Name="dashboard" Class="size-5" />
        <span>Home</span>
    </NavLink>
    
    <NavLink href="/products" class="flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition hover:text-blue-600 [&.active]:text-blue-600 [&.active]:font-bold">
        <Icon Name="box" Class="size-5" />
        <span>Shop</span>
    </NavLink>

    <!-- Cart Button with live Badge -->
    <button type="button" @onclick="() => open = true" class="flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition hover:text-blue-600 relative">
        <div class="relative">
            <Icon Name="cart" Class="size-5 text-slate-700" />
            @if (Cart.ItemCount > 0)
            {
                <span class="absolute -top-1.5 -right-2 flex size-4 items-center justify-center rounded-full bg-blue-600 text-[9px] font-bold text-white shadow-xs">
                    @Cart.ItemCount
                </span>
            }
        </div>
        <span>Cart</span>
    </button>

    <!-- Wishlist Button -->
    <NavLink href="/wishlist" class="flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition hover:text-rose-600 [&.active]:text-rose-600 [&.active]:font-bold relative">
        <div class="relative">
            <Icon Name="heart" Class="size-5 text-slate-700" />
            @if (Wishlist.Count > 0)
            {
                <span class="absolute -top-1.5 -right-2 flex size-4 items-center justify-center rounded-full bg-rose-500 text-[9px] font-bold text-white shadow-xs">
                    @Wishlist.Count
                </span>
            }
        </div>
        <span>Wishlist</span>
    </NavLink>

    <NavLink href="/orders" class="flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition hover:text-blue-600 [&.active]:text-blue-600 [&.active]:font-bold">
        <Icon Name="receipt" Class="size-5" />
        <span>Orders</span>
    </NavLink>

    <NavLink href="/account" class="flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition hover:text-blue-600 [&.active]:text-blue-600 [&.active]:font-bold">
        <Icon Name="user" Class="size-5" />
        <span>Account</span>
    </NavLink>
</nav>

<CartDrawer Open="open" OpenChanged="value => open = value" />

@code
{
    private bool open;
    private string searchQuery = "";

    private void ExecuteSearch()
    {
        var term = searchQuery.Trim();
        if (!string.IsNullOrWhiteSpace(term))
        {
            Nav.NavigateTo($"/products?q={Uri.EscapeDataString(term)}");
        }
        else
        {
            Nav.NavigateTo("/products");
        }
    }

    protected override void OnInitialized()
    {
        Cart.OnChange += Changed;
        Wishlist.OnChange += Changed;
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            await Cart.InitializeAsync();
            await Wishlist.EnsureLoadedAsync();
        }
    }

    private void Changed() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Cart.OnChange -= Changed;
        Wishlist.OnChange -= Changed;
    }
}
