@rendermode InteractiveAuto
@implements IDisposable
@inject CartService Cart

<header class="brand-header sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-md">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-4 px-4 py-3 sm:px-6">
        <a href="/" class="flex shrink-0 items-center gap-3">
            <img src="/jas-logo.png" width="56" height="56" class="w-14 rounded-xl" alt="JAS International" />
            <span>
                <strong class="font-display block text-2xl text-volt">JAS</strong>
                <span class="text-xs uppercase tracking-widest">International</span>
            </span>
        </a>
        <form
            action="/products"
            method="get"
            class="order-3 flex w-full gap-2 md:order-none md:ml-auto md:w-auto md:flex-1 md:max-w-lg"
        >
            <label class="sr-only" for="site-search">Search products</label>
            <input
                id="site-search"
                name="q"
                type="search"
                placeholder="Search products or model…"
                class="min-w-0 flex-1 rounded-full border border-slate-200 bg-mist px-4 py-2.5 text-sm"
            />
            <button class="shop-button rounded-full">Search</button>
        </form>
        <a href="/products" class="ml-auto text-sm md:ml-0">Shop</a>
        <AuthorizeView>
            <Authorized>
                <a href="/account" class="text-sm">Account</a>
            </Authorized>
            <NotAuthorized>
                <a href="/account/login" class="text-sm">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <a href="/admin" class="text-sm">Admin</a>
            </Authorized>
        </AuthorizeView>
        <button
            type="button"
            @onclick="() => open = true"
            class="cart-pill rounded-full px-4 py-2 text-sm"
            aria-label="Open cart"
        >
            Cart (@Cart.ItemCount)
        </button>
    </div>
</header>
<CartDrawer Open="open" OpenChanged="value => open = value" />

@code
{
    private bool open;

    protected override void OnInitialized() => Cart.OnChange += Changed;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            await Cart.InitializeAsync();
        }
    }

    private void Changed() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.OnChange -= Changed;
}
