@inject CartService Cart

@if (Open)
{
    <div class="fixed inset-0 z-[100]">
        <button class="absolute inset-0 bg-black/40" aria-label="Close cart" @onclick="Close">
        </button>
        <aside class="absolute right-0 top-0 flex h-full w-full max-w-md flex-col bg-white shadow-2xl">
            <div class="flex justify-between border-b p-5">
                <h2 class="text-xl font-semibold">Your cart</h2>
                <button @onclick="Close" aria-label="Close cart">✕</button>
            </div>
            <div class="flex-1 overflow-y-auto p-5">
                @if (Cart.Items.Count == 0)
                {
                    <p>Your cart is empty.</p>
                }
                @foreach (var item in Cart.Items)
                {
                    <div class="mb-5 flex gap-3">
                        <img src="@item.Image" alt="@item.Name" class="h-16 w-16 object-contain" />
                        <div>
                            <a href="/product/@item.Slug">@item.Name</a>
                            <p class="text-sm text-slate-500">@item.Variant</p>
                            <p>@item.Quantity × ৳@item.Price.ToString("N0")</p>
                        </div>
                    </div>
                }
                @if (Cart.Error is not null)
                {
                    <p class="text-red-600">@Cart.Error</p>
                }
            </div>
            <div class="border-t p-5">
                <p class="mb-4 font-semibold">Subtotal: ৳@Cart.Total.ToString("N0")</p>
                <a href="/cart" class="shop-button" @onclick="Close">View cart</a>
                <a href="/checkout" class="shop-button-secondary ml-2" @onclick="Close">Checkout</a>
            </div>
        </aside>
    </div>
}

@code
{
    [Parameter]
    public bool Open { get; set; }
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    private Task Close() => OpenChanged.InvokeAsync(false);
}
