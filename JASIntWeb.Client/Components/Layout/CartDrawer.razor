@inject NavigationManager NavManager
@if (Open)
{
    <div class="fixed inset-0 z-[100]">

        <!-- Backdrop -->
        <button type="button" class="absolute inset-0 bg-black/40 backdrop-blur-sm" aria-label="Close cart"
                @onclick="Close">
        </button>

        <!-- Drawer -->
        <aside class="absolute right-0 top-0 flex h-full w-full max-w-md
            flex-col bg-white shadow-2xl">

            <!-- Header -->
            <div class="flex items-center justify-between
                border-b border-slate-200 px-5 py-4">

                <div>
                    <h2 class="font-display text-lg font-semibold">
                        Your cart
                    </h2>

                    <p class="text-xs text-slate-500">
                        @Cart.ItemCount item@(Cart.ItemCount == 1 ? "" : "s")
                    </p>
                </div>

                <button type="button" @onclick="Close" class="rounded-full p-2 text-slate-500
                    hover:bg-slate-100" aria-label="Close cart">

                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="2">

                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />

                    </svg>

                </button>

            </div>

            <!-- Items -->
            <div class="flex-1 overflow-y-auto p-5">

                @if (Cart.Items.Count == 0)
                {
                    <div class="flex h-full flex-col items-center
                        justify-center text-center">

                        <div class="flex h-16 w-16 items-center
                            justify-center rounded-full bg-mist text-2xl">
                            🛒
                        </div>

                        <h3 class="mt-4 font-semibold">
                            Your cart is empty
                        </h3>

                        <p class="mt-1 text-sm text-slate-500">
                            Add some gadgets and they'll appear here.
                        </p>

                        <button type="button" @onclick="Close" class="mt-5 rounded-full bg-ink px-5 py-2.5
                            text-sm font-semibold text-white
                            hover:bg-slate-800">
                            Continue shopping
                        </button>

                    </div>
                }
                else
                {
                    <div class="space-y-4">

                        @foreach (var item in Cart.Items)
                        {
                            <div class="flex gap-3">

                                <img src="@item.Product.Image" alt="@item.Product.Name" class="h-20 w-20 rounded-xl object-cover
                                bg-slate-100" />

                                <div class="min-w-0 flex-1">

                                    <h3 class="text-sm font-medium">
                                        @item.Product.Name
                                    </h3>

                                    <p class="mt-1 text-sm font-semibold">
                                        ৳@item.Product.Price.ToString("N0")
                                    </p>

                                    <div class="mt-2 flex items-center gap-2">

                                        <button type="button" class="flex h-7 w-7 items-center
                                            justify-center rounded-full
                                            border border-slate-200"
                                                @onclick="() => Cart.Decrease(item.Product)">
                                            −
                                        </button>

                                        <span class="w-5 text-center text-sm">
                                            @item.Quantity
                                        </span>

                                        <button type="button" class="flex h-7 w-7 items-center
                                            justify-center rounded-full
                                            border border-slate-200"
                                                @onclick="() => Cart.Increase(item.Product)">
                                            +
                                        </button>

                                        <button type="button" class="ml-auto text-xs text-red-500
                                            hover:text-red-700" @onclick="() => Cart.Remove(item.Product)">
                                            Remove
                                        </button>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

            <!-- Footer -->
            @if (Cart.Items.Count > 0)
            {
                <div class="border-t border-slate-200 p-5">

                    <div class="flex items-center justify-between">
                        <span class="text-sm text-slate-500">
                            Subtotal
                        </span>

                        <span class="font-display text-xl font-semibold">
                            ৳@Cart.Total.ToString("N0")
                        </span>
                    </div>

                    <button type="button" class="mt-4 w-full rounded-full bg-ink
                        px-5 py-3 text-sm font-semibold text-white
                        hover:bg-slate-800">
                        Checkout
                    </button>

                </div>
            }

        </aside>

    </div>
}

@code {

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Inject]
    private CartService Cart { get; set; } = default!;

    private async Task Close()
    {
        await OpenChanged.InvokeAsync(false);
    }
}