@implements IDisposable
@inject CartService Cart

@if (Open)
{
    <div class="fixed inset-0 z-[100] flex justify-end">
        <button class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs transition-opacity duration-200" aria-label="Close cart" @onclick="Close">
        </button>
        <aside class="relative z-10 flex h-full w-full max-w-md flex-col bg-white shadow-2xl">
            <!-- Header -->
            <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5">
                <div class="flex items-center gap-2">
                    <h2 class="text-lg font-bold text-slate-900">Shopping Cart</h2>
                    <span class="rounded-full bg-blue-100 px-2 py-0.5 text-xs font-bold text-blue-700">@Cart.ItemCount</span>
                </div>
                <button @onclick="Close" class="size-8 rounded-full hover:bg-slate-100 text-slate-500 hover:text-slate-900 flex items-center justify-center font-bold text-sm transition" aria-label="Close cart">✕</button>
            </div>

            <!-- Free Shipping Bar -->
            @{
                var target = 5000m;
                var progress = Math.Min(100, (int)(Cart.Total / target * 100));
                var remaining = Math.Max(0, target - Cart.Total);
            }
            <div class="border-b border-slate-100 bg-slate-50 px-6 py-3">
                <div class="flex items-center justify-between text-[11px] mb-1.5 font-medium">
                    @if (remaining > 0)
                    {
                        <span class="text-slate-600">Add <strong class="text-blue-600 font-bold">৳@remaining.ToString("N0")</strong> for Free Delivery</span>
                    }
                    else
                    {
                        <span class="text-emerald-700 font-bold">🎉 Free Delivery Unlocked!</span>
                    }
                    <span class="font-bold text-slate-500">@progress%</span>
                </div>
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-slate-200">
                    <div class="h-full bg-blue-600 transition-all duration-300" style="width: @(progress)%"></div>
                </div>
            </div>

            <!-- Items -->
            <div class="flex-1 overflow-y-auto px-6 py-4 space-y-4">
                @if (Cart.Items.Count == 0)
                {
                    <div class="py-16 text-center">
                        <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-blue-50 text-blue-600 mb-3">
                            <svg class="size-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                            </svg>
                        </div>
                        <p class="font-bold text-slate-800 text-sm">Your cart is currently empty</p>
                        <p class="text-xs text-slate-500 mt-1">Browse our store and add authentic gadgets to get started.</p>
                        <a href="/products" class="btn-primary mt-5 text-xs py-2 px-4" @onclick="Close">Start Shopping</a>
                    </div>
                }
                else
                {
                    @foreach (var item in Cart.Items)
                    {
                        var isPending = pendingVariantId == item.VariantId;
                        <div @key="item.VariantId" class="flex gap-3.5 rounded-2xl border border-slate-100 bg-white p-3 shadow-2xs">
                            <img src="@item.Image" alt="@item.Name" class="size-16 shrink-0 rounded-xl object-contain bg-slate-50 p-1 border border-slate-100" />
                            <div class="flex-1 min-w-0 flex flex-col justify-between">
                                <div>
                                    <a href="/product/@item.Slug" class="font-semibold text-slate-900 text-xs hover:text-blue-600 transition line-clamp-1" @onclick="Close">@item.Name</a>
                                    <p class="text-[11px] text-slate-500">@item.Variant</p>
                                </div>
                                <div class="flex items-center justify-between mt-2">
                                    <strong class="text-xs font-bold text-slate-900 tabular-nums">৳@item.LineTotal.ToString("N0")</strong>
                                    
                                    <!-- Stepper in Drawer -->
                                    <div class="flex items-center gap-1 rounded-lg border border-slate-200 bg-slate-50 p-0.5">
                                        <button class="size-6 rounded bg-white text-slate-700 hover:bg-slate-100 text-xs font-bold flex items-center justify-center transition disabled:opacity-40" @onclick="() => Change(item, item.Quantity - 1)">−</button>
                                        <span class="w-6 text-center text-xs font-bold text-slate-800 tabular-nums">
                                            @if (isPending)
                                            {
                                                <span class="inline-block size-2 border border-blue-600 border-t-transparent rounded-full animate-spin"></span>
                                            }
                                            else
                                            {
                                                @item.Quantity
                                            }
                                        </span>
                                        <button disabled="@(item.Quantity >= item.Stock || item.Quantity >= 99)" class="size-6 rounded bg-white text-slate-700 hover:bg-slate-100 text-xs font-bold flex items-center justify-center transition disabled:opacity-40" @onclick="() => Change(item, item.Quantity + 1)">+</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Footer -->
            @if (Cart.Items.Count > 0)
            {
                <div class="border-t border-slate-200 bg-slate-50/60 p-6 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Subtotal</span>
                        <strong class="text-xl font-black text-slate-900 tabular-nums">৳@Cart.Total.ToString("N0")</strong>
                    </div>
                    <div class="grid grid-cols-2 gap-2 pt-2">
                        <a href="/cart" class="btn-secondary text-xs py-2.5 text-center font-bold" @onclick="Close">View Full Cart</a>
                        <a href="/checkout" class="btn-primary text-xs py-2.5 text-center font-bold shadow-md" @onclick="Close">Checkout Now →</a>
                    </div>
                </div>
            }
        </aside>
    </div>
}

@code
{
    [Parameter]
    public bool Open { get; set; }
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    private int? pendingVariantId;

    protected override void OnInitialized() => Cart.OnChange += Changed;

    private void Changed() => _ = InvokeAsync(StateHasChanged);

    private Task Close() => OpenChanged.InvokeAsync(false);

    private async Task Change(CartItemDto item, int quantity)
    {
        pendingVariantId = item.VariantId;
        StateHasChanged();
        try
        {
            await Cart.SetQuantityAsync(item.VariantId, quantity);
        }
        finally
        {
            pendingVariantId = null;
            StateHasChanged();
        }
    }

    public void Dispose() => Cart.OnChange -= Changed;
}
